(version 1)
(allow default)
(deny file-write* file-link)
(deny mach-lookup)
(allow mach-lookup (global-name "com.apple.bsd.dirhelper") (global-name "com.apple.system.opendirectoryd.libinfo") (global-name "com.apple.system.opendirectoryd.membership"))
(deny system-fcntl (fcntl-command 80 110))
(deny file-read* (subpath "/Users/check-owner"))
(allow file-read-metadata (subpath "/Users/check-owner"))
(allow file-write* (subpath "/Users/check-owner/land"))
(allow file-read* (subpath "/Users/check-owner/land"))
(allow file-write* (subpath "/private/tmp/land-run/target"))
(allow file-read* (subpath "/private/tmp/land-run/target"))
(allow file-write* (subpath "/private/tmp/land-run/tmp"))
(allow file-read* (subpath "/private/tmp/land-run/tmp"))
(allow file-write* (subpath "/private/tmp/land-run/scratch"))
(allow file-read* (subpath "/private/tmp/land-run/scratch"))
(allow file-write* (subpath "/private/tmp/land-run/cache"))
(allow file-read* (subpath "/private/tmp/land-run/cache"))
(deny file-write* (subpath "/private/var/folders/zz/land"))
(allow file-write-data (literal "/dev/null") (literal "/dev/tty"))
(allow file-read* (subpath "/Users/check-owner/.rustup"))
(deny file-read* (subpath "/Users/check-owner/.aws"))
(deny file-read* (subpath "/Users/check-owner/.claude"))
(deny file-read* (subpath "/Users/check-owner/.claude/.credentials.json"))
(deny file-read* (subpath "/Users/check-owner/.codex"))
(deny file-read* (subpath "/Users/check-owner/.codex/auth.json"))
(deny file-read* (subpath "/Users/check-owner/.config/gh"))
(deny file-read* (subpath "/Users/check-owner/.config/goose"))
(deny file-read* (subpath "/Users/check-owner/.config/goose/chatgpt_codex"))
(deny file-read* (subpath "/Users/check-owner/.config/goose/config.yaml"))
(deny file-read* (subpath "/Users/check-owner/.config/goose/gemini_oauth"))
(deny file-read* (subpath "/Users/check-owner/.config/goose/xai_oauth"))
(deny file-read* (subpath "/Users/check-owner/.config/opencode"))
(deny file-read* (subpath "/Users/check-owner/.contextstack/config"))
(deny file-read* (subpath "/Users/check-owner/.contextstack/config/.cs-init-node-token"))
(deny file-read* (subpath "/Users/check-owner/.contextstack/config/gateway/owner-token"))
(deny file-read* (subpath "/Users/check-owner/.contextstack/config/node.env"))
(deny file-read* (subpath "/Users/check-owner/.contextstack/credentials"))
(deny file-read* (subpath "/Users/check-owner/.contextstack/dev-state/director"))
(deny file-read* (subpath "/Users/check-owner/.contextstack/gateway"))
(deny file-read* (subpath "/Users/check-owner/.contextstack/state/director"))
(deny file-read* (subpath "/Users/check-owner/.cursor"))
(deny file-read* (subpath "/Users/check-owner/.gemini"))
(deny file-read* (subpath "/Users/check-owner/.gemini/gemini-credentials.json"))
(deny file-read* (subpath "/Users/check-owner/.gemini/google_accounts.json"))
(deny file-read* (subpath "/Users/check-owner/.gemini/installation_id"))
(deny file-read* (subpath "/Users/check-owner/.gemini/oauth_creds.json"))
(deny file-read* (subpath "/Users/check-owner/.gemini/settings.json"))
(deny file-read* (subpath "/Users/check-owner/.gnupg"))
(deny file-read* (subpath "/Users/check-owner/.grok"))
(deny file-read* (subpath "/Users/check-owner/.grok/auth.json"))
(deny file-read* (subpath "/Users/check-owner/.local/share/opencode"))
(deny file-read* (subpath "/Users/check-owner/.netrc"))
(deny file-read* (subpath "/Users/check-owner/.pi/agent"))
(deny file-read* (subpath "/Users/check-owner/.pi/agent/auth.json"))
(deny file-read* (subpath "/Users/check-owner/.pi/agent/models.json"))
(deny file-read* (subpath "/Users/check-owner/.pi/agent/settings.json"))
(deny file-read* (subpath "/Users/check-owner/.ssh"))
(deny file-read* (subpath "/Users/check-owner/.zshrc.secrets"))
(deny file-read* (subpath "/Users/check-owner/Library/Keychains"))
(deny file-read* (subpath "/Users/check-owner/land/clients/web/auth.json"))
(deny file-read* (subpath "/Users/check-owner/main/clients/web/auth.json"))
(deny network*)
(allow network-bind network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(allow network-bind network-inbound (require-all (local unix-socket) (subpath "/private/tmp/land-run/scratch")))
(allow network-outbound (require-all (remote unix-socket) (subpath "/private/tmp/land-run/scratch")))
(deny network-outbound (remote ip "localhost:8780"))
(deny network-outbound (remote ip "localhost:9200"))
(deny network-outbound (remote ip "localhost:53210"))
(deny file-read* (regex #"^/private/tmp/com\.apple\.launchd\.[^/]+/"))
(deny file-write* (regex #"^/private/tmp/com\.apple\.launchd\.[^/]+/"))
(deny network-outbound (regex #"^/private/tmp/com\.apple\.launchd\.[^/]+/"))
(deny file-read* (regex #"^/tmp/com\.apple\.launchd\.[^/]+/"))
(deny file-write* (regex #"^/tmp/com\.apple\.launchd\.[^/]+/"))
(deny network-outbound (regex #"^/tmp/com\.apple\.launchd\.[^/]+/"))
(deny file-read* (regex #"^/private/var/run/com\.apple\.launchd\.[^/]+/"))
(deny file-write* (regex #"^/private/var/run/com\.apple\.launchd\.[^/]+/"))
(deny network-outbound (regex #"^/private/var/run/com\.apple\.launchd\.[^/]+/"))
(deny file-read* (regex #"^/var/run/com\.apple\.launchd\.[^/]+/"))
(deny file-write* (regex #"^/var/run/com\.apple\.launchd\.[^/]+/"))
(deny network-outbound (regex #"^/var/run/com\.apple\.launchd\.[^/]+/"))
(deny file-read* (regex #"^/Users/check\-owner/\.ssh/"))
(deny file-write* (regex #"^/Users/check\-owner/\.ssh/"))
(deny network-outbound (regex #"^/Users/check\-owner/\.ssh/"))
(deny file-read* (literal "/Users/check-owner/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"))
(deny file-write* (literal "/Users/check-owner/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"))
(deny network-outbound (literal "/Users/check-owner/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"))
(deny file-read* (literal "/Users/check-owner/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"))
(deny file-write* (literal "/Users/check-owner/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"))
(deny network-outbound (literal "/Users/check-owner/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh"))
(deny file-read* (literal "/private/tmp/agent.sock"))
(deny file-write* (literal "/private/tmp/agent.sock"))
(deny network-outbound (literal "/private/tmp/agent.sock"))
(deny process-exec (literal "/bin/launchctl"))
