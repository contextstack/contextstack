APP_NAME=ContextStack
APP_ENV=local
APP_KEY=
# Keep debug off for device builds: with it on, NativePHP writes every navigation URI to storage/logs/edge-nav.log,
# and pairing and invite links carry their one-time codes in the URI.
APP_DEBUG=false

# The app's bundle ID, for example com.example.contextstack.
NATIVEPHP_APP_ID=
# Your Apple developer team ID, needed only to install on a real device.
NATIVEPHP_DEVELOPMENT_TEAM=

# The Director's address, for example http://100.x.y.z:8780 over Tailscale.
DIRECTOR_URL=
