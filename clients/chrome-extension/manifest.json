{
  "manifest_version": 3,
  "name": "ContextStack Browser",
  "version": "0.1.0",
  "description": "Read visible page text for ContextStack on approved sites.",
  "minimum_chrome_version": "106",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "scripting",
    "tabGroups",
    "webNavigation",
    "webRequest"
  ],
  "optional_permissions": ["contentSettings"],
  "optional_host_permissions": ["https://*/*", "<all_urls>"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_popup": "permissions.html" }
}
