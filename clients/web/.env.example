APP_NAME=ContextStack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# client-web is a client of the Director (tests/director-spec/CLIENT-API.md). It keeps no database: its only state is
# this device's connection file (CLIENT_WEB_SETTINGS, default storage/app/private/client-web/connection.json).
DIRECTOR_URL=http://127.0.0.1:8780
# The Director's local credential, used on the Director's own machine until this device is paired.
# DIRECTOR_LOCAL_CREDENTIAL=~/.contextstack/state/director/local-credential

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=8

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# No database: sessions and cache are files, nothing is queued.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
