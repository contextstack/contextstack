# client-web's env for an installed release (ADR 0017). No secrets live here: node-release --serve-client-web copies
# this file once to ~/.contextstack/config/client-web/client-web.env (mode 0600, directory 0700), replaces __ROOT__
# with the install root (~/.contextstack), __URL__ with the listen URL and __DIRECTOR_URL__ with the Rust Director
# served on the same host (else http://127.0.0.1:8780), and writes a fresh APP_KEY straight into that copy (never
# printed). An existing client-web.env is never overwritten. The launchd agent passes DIRECTOR_ENV_FILE=<that path>;
# nothing reads a .env inside the release.
#
# client-web is a client of the Director (tests/director-spec/CLIENT-API.md): it keeps no database. Its only state is
# Laravel's storage (sessions, cache, compiled views) and this device's connection file, both in
# ~/.contextstack/state/client-web, outside the release, so switch and rollback keep them.
APP_NAME=ContextStack
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=__URL__
# Host names served besides loopback, IP addresses and APP_URL's host (comma-separated), e.g. a Tailscale MagicDNS
# name. Any other Host header is refused (DNS rebinding).
CLIENT_WEB_TRUSTED_HOSTS=

# Runtime state lives outside the release (ADR 0008).
LARAVEL_STORAGE_PATH=__ROOT__/state/client-web

# The Director this client talks to, and its local credential on the same machine (director-rs keeps it in its
# data dir, ~/.contextstack/state/director). A paired device token, once paired, is kept in storage/app/private.
DIRECTOR_URL=__DIRECTOR_URL__
DIRECTOR_LOCAL_CREDENTIAL=__ROOT__/state/director/local-credential

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Laravel's log goes to the agent's stderr: ~/.contextstack/logs/client-web.err.log.
LOG_CHANNEL=stderr
LOG_LEVEL=info

# No database: sessions and cache are files, nothing is queued.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="client-web@localhost"
MAIL_FROM_NAME="${APP_NAME}"
