#!/usr/bin/env python3
"""job-pull — accept the director's jobs into this node's dispatch shelf (CS phase 6).

Tick-called on a fleet node (policy/spool.json receiver kind "director"), never palette. Input {}.
GET api/v1/nodes/me/jobs answers {"jobs": [{job_id, spec, task, bundle_sha256, files: [{path, sha256,
bytes, mode}]}]}: a frozen spec, its task directory and the prompts it names, every file an object
by sha256. _node_intake.take verifies, materialises, queues and accepts each job exactly once (its
docstring is the contract); node-listen hands it the same lists from the held-open GET work, so
either may see a job first. A job the Director cancelled is skipped.

Exit 0 {"ok": true, "accepted": [ids], "failed": [{job_id, error}]}, or {"ok": true, "skip": "not a
node"} without a director receiver; an unreachable director is {"ok": true, "error": ...} (retried
next tick, nothing changed); exit 2 a malformed policy or missing token.
"""
import json
import sys

from _director_client import Client, DirectorUnreachable, receiver_config
from _node_intake import take
from _roots import RootsError, roots


def emit(value, code=0):
    print(json.dumps(value, sort_keys=True))
    raise SystemExit(code)


def main():
    try:
        json.loads(sys.stdin.read() or "{}")
        state = roots()
        policy_path = state["config"] / "policy/spool.json"
        receiver = json.loads(policy_path.read_text(encoding="utf-8")).get("receiver") if policy_path.is_file() else None
        if not isinstance(receiver, dict) or receiver.get("kind") != "director":
            emit({"ok": True, "skip": "not a node", "accepted": []})
        client = Client(receiver_config(receiver))
    except (ValueError, RootsError, OSError) as error:
        emit({"ok": False, "error": str(error)}, 2)
    try:
        offered = client.call("GET", "jobs").get("jobs") or []
    except (DirectorUnreachable, AttributeError) as error:
        emit({"ok": True, "error": str(error), "accepted": []})
    accepted, _, failed = take(client, offered, state["state"])
    emit({"ok": True, "accepted": accepted, "failed": failed})


if __name__ == "__main__":
    main()
