#!/usr/bin/env python3
"""Operator/runner: materialize a run workspace from prepared setup."""
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
if str(HERE) not in sys.path:
    sys.path.insert(0, str(HERE))
from _setup_workspace import materialize

LAB = HERE.parent.parent


def main():
    request = json.load(sys.stdin)
    if set(request) - {"setup", "workspace", "task", "lab"}:
        raise ValueError("unexpected setup-workspace request field")
    setup = Path(str(request.get("setup") or ""))
    workspace = Path(str(request.get("workspace") or ""))
    if not setup.is_dir() or not workspace.parent:
        raise ValueError("setup and workspace are required")
    lab = Path(request["lab"]) if request.get("lab") else LAB
    task = Path(str(request["task"])) if request.get("task") else None
    print(json.dumps(materialize(setup, workspace, task=task, lab=lab), sort_keys=True))


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError) as error:
        print("setup-workspace: " + str(error), file=sys.stderr)
        sys.exit(1)
