#!/usr/bin/env python3
# Append a local spec to the dispatch queue for schedule-tick or an operator.
# Product-class × local-coder refuses without override (PINNED routing).
# Dest-bound rows require grants/<id>.yaml.
from _dispatch import spec_value
from _estate_io import append_jsonl, state_dir
import json, re, sys, time
from pathlib import Path

from _grant import cover, parse_expiry, record_refusal
from _roots import roots
from _workspace_setup import metadata

HERE = Path(__file__).resolve().parent
CODE_ROOT = HERE.parent.parent
STATE = roots()["state"]
# the dispatch shelf tick drains: under the state root (default <code>/ledger, as before)
Q = STATE / "dispatch.jsonl"
CHORE = re.compile(
    r"(gofmt|pint|prune|readme|identity|gitignore|larastan|phpstan)",
    re.I,
)
PRODUCT = re.compile(r"(sotu|flowchart)", re.I)


a = json.load(sys.stdin)
lane = str(a.get("lane") or "production")
if lane not in {"production", "manager", "shadow", "probe"}:
    sys.exit("enqueue: lane must be production, manager, shadow, or probe")
if a.get("slot") is not None and parse_expiry(str(a["slot"])) is None:
    sys.exit("enqueue: slot must be an RFC3339 UTC timestamp")
effects = a.get("external_effects") or []
if (not isinstance(effects, list) or
        any(not isinstance(effect, str) or
            not re.fullmatch(r"[a-z][a-z0-9_]{0,63}", effect)
            for effect in effects) or
        len(effects) != len(set(effects))):
    sys.exit("enqueue: external_effects must be a unique array of effect ids")
spec = str(a.get("spec", ""))
if not spec.endswith(".yaml") or ".." in spec:
    sys.exit("enqueue: spec must be a yaml path")
p = (CODE_ROOT / spec).resolve() if not Path(spec).is_absolute() else Path(spec)
if not p.is_file() or not p.is_relative_to(CODE_ROOT.resolve()):
    sys.exit("enqueue: spec outside the code root")
rel = str(p.relative_to(CODE_ROOT))
text = p.read_text(encoding="utf-8")
if not spec_value(text, "model"):
    # Never filled in here: the spec names its model; PINNED.md only says which to copy.
    pinned_md = CODE_ROOT / "PINNED.md"
    pinned = spec_value(pinned_md.read_text(encoding="utf-8"), "pinned") if pinned_md.is_file() else ""
    sys.exit("enqueue: %s has no model: ; PINNED.md pins %s — add model: %s (or the template/model this experiment varies)"
             % (rel, pinned or "(no pinned: line)", pinned or "<model>"))
override = bool(a.get("override")) or "--override" in sys.argv
blob = rel + "\n" + text
if spec_value(text, "model") == "local-coder" and PRODUCT.search(blob) and not CHORE.search(blob) and not override:
    sys.exit("enqueue: product-class cell on local-coder requires override=true (PINNED routing)")
task = str(a.get("task") or "").strip()
dest = str(a.get("dest") or a.get("resource") or "").strip()
notes = metadata(CODE_ROOT / task if task and not Path(task).is_absolute() else Path(task)) if task else {}
repo = dest or str(notes.get("repo") or "").strip()
need_grant = bool(a.get("grant") or dest or notes.get("repo") or effects)
if lane == "probe" and not dest and not a.get("grant"):
    need_grant = False
gid = a.get("grant")
if need_grant:
    if not isinstance(gid, str) or not gid.strip():
        sys.exit("enqueue: grant id required")
    gid = gid.strip()
    # Task metadata identifies the corpus even for read-only setup snapshots.
    # Only an explicit destination/resource authorizes a later corpus commit.
    ok, err, grant = cover(gid, repo=repo or None, paths=[], commit=bool(dest), effects=effects)
    if not ok:
        # Short code is the clause before the first ';', else the whole remedy.
        code = err.split(";", 1)[0].strip() if ";" in err else err
        if "is estate:" in err:
            code = "grant estate mismatch"
        elif "expired" in err:
            code = "expired"
        elif "unregistered" in err:
            code = "grant not found"
        rid = record_refusal(CODE_ROOT, code=code, message=err, grant=grant, gid=gid,
                             context={"spec": rel, "repo": repo, "lane": lane})
        sys.exit("enqueue: %s [refusal %s]" % (err, rid))
else:
    gid = ""
profile = a.get("profile", spec_value(text, "profile").strip("\"'"))
if not isinstance(profile, str):
    sys.exit("enqueue: profile must be a string")
row = {
    "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    "id": str(time.time_ns()),
    "spec": rel, "state": "pending", "pid": 0, "lane": lane,
    "note": str(a.get("note") or ""),
}
for key in ("resource", "expected_head", "task", "batch_id", "schedule_id", "slot",
            "schedule_slot", "schedule_date", "schedule_timezone", "reference_root"):
    if a.get(key):
        row[key] = str(a[key])
if profile:
    row["profile"] = profile
for key in ("stale_after", "stale_after_seconds"):
    if key in a:
        row[key] = a[key]
if gid:
    row["grant"] = gid
if effects:
    row["external_effects"] = effects
Q.parent.mkdir(parents=True, exist_ok=True)
append_jsonl(Q, row, sort_keys=False, compact=False,
             sync=True, encoding='utf-8')
print(json.dumps({"ok": True, "spec": rel, "id": row["id"]}))
