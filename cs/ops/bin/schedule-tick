#!/usr/bin/env python3
# Deterministic schedule admission + corpus freshness scan.
# Node protocol 2 (NODE-PROTOCOL.md §9.5): each firing's identity <id>@<slot> is recorded (a
# firing_recorded row, fsync'd) before its job is enqueued; a slot recorded but never fired (a crash between the
# two) is `uncertain` and is not fired again unless retry_failed names it. `missed` (next to
# catch_up_window_minutes): skip records a slot first seen more than missed_grace_minutes (60) after it was due as a
# missed firing and does not run it; catch_up runs it, marking the fire row catch_up. A row without `missed` takes
# the caller's `missed_default` (node-listen, a protocol-2 node: skip, the protocol's default); with neither, the
# slot fires as it always has (a director host's tick). A row with command review-weekly is the weekly
# lane review (ops/bin/_review_schedule.py): no grant and no enqueue. It delivers one report and one
# attention item. A failed delivery is a void terminal on the dispatch shelf, and the same
# repeated_failure hold as any other schedule disables the row; a pass on that shelf breaks the streak.
# timezone "local" is the machine zone at fire time; any other timezone is unchanged.
from _estate_io import state_dir, append_jsonl, call_op, sha256_bytes
import fcntl, hashlib, json, os, re, shutil, subprocess, sys, time
from datetime import datetime, timedelta, timezone
from functools import partial
from pathlib import Path

from _estate_io import read_jsonl as estate_rows
from zoneinfo import ZoneInfo

HERE = Path(__file__).resolve().parent
if str(HERE) not in sys.path:
    sys.path.insert(0, str(HERE))
from _void import is_config_void, schedule_rows, repeated_failure
from _grant import schedule_error

CODE_ROOT = HERE.parent.parent
DEFAULT_SCHEDULES = state_dir(CODE_ROOT) / "schedules.jsonl"
DEFAULT_FIRES = state_dir(CODE_ROOT) / "schedule-fires.jsonl"
DEFAULT_DISPATCH = state_dir(CODE_ROOT) / "dispatch.jsonl"
LOCK = state_dir(CODE_ROOT) / "schedule.lock"
TERMINAL = {"done", "error", "operator_close", "cancelled"}
SILENCE_SLOTS = 3
MISSED_GRACE_MINUTES = 60


read_jsonl = partial(estate_rows, strict=True)


def field_values(text, low, high, sunday=False):
    values = set()
    for part in text.split(","):
        base, step = (part.split("/", 1) + ["1"])[:2] if "/" in part else (part, "1")
        step = int(step)
        if step < 1:
            raise ValueError("cron step must be positive")
        if base == "*":
            start, end = low, high
        elif "-" in base:
            start, end = map(int, base.split("-", 1))
        else:
            start = end = int(base)
        if start < low or end > high or start > end:
            raise ValueError("cron field out of range")
        values.update(range(start, end + 1, step))
    if sunday and 7 in values:
        values.remove(7); values.add(0)
    return values


def cron_zone(name):
    """ZoneInfo for a schedule timezone. Missing stays America/New_York. "local" is the machine zone."""
    if not name:
        name = "America/New_York"
    elif name == "local":
        from _review_schedule import local_zone_name
        name = local_zone_name()
    return ZoneInfo(name)


def weekly_review(row):
    return row.get("command") == "review-weekly"


def cron_matches(expression, local):
    parts = expression.split()
    if len(parts) != 5:
        raise ValueError("cron must have five fields")
    minute, hour, dom, month, dow = parts
    basic = (local.minute in field_values(minute, 0, 59) and
             local.hour in field_values(hour, 0, 23) and
             local.month in field_values(month, 1, 12))
    if not basic:
        return False
    dom_match = local.day in field_values(dom, 1, 31)
    cron_dow = (local.weekday() + 1) % 7
    dow_match = cron_dow in field_values(dow, 0, 7, sunday=True)
    return (dom_match and dow_match) if dom == "*" or dow == "*" else (dom_match or dow_match)


def latest_slot(row, now):
    zone = cron_zone(row.get("timezone"))
    cursor = now.astimezone(timezone.utc).replace(second=0, microsecond=0)
    window = int(row.get("catch_up_window_minutes", 64800))
    for _ in range(window + 1):
        if cron_matches(row["cron"], cursor.astimezone(zone)):
            return cursor
        cursor -= timedelta(minutes=1)
    return None


def schedule_metadata(schedule, slot):
    """Freeze the intended local day alongside the UTC schedule slot."""
    zone_name = str(schedule["timezone"])
    instant = datetime.fromisoformat(slot.replace("Z", "+00:00"))
    local = instant.astimezone(ZoneInfo(zone_name))
    return {
        "schedule_timezone": zone_name,
        "schedule_date": local.date().isoformat(),
        "schedule_slot": slot,
    }


def spec_uses_local_coder(schedule):
    path = CODE_ROOT / str(schedule.get("spec") or "")
    if path.is_file():
        return bool(re.search(r"^model:\s*local-coder\s*$", path.read_text(encoding="utf-8"), re.M))
    return True


def setup_source(schedule):
    """Resolve a setup snapshot source without granting destination authority."""
    return str(schedule.get("root") or schedule.get("setup_root") or "")




def prepare(schedule, slot=None, dispatch=None, ledger=None):
    source = setup_source(schedule)
    if not source:
        return {"head": ""}
    payload = {"task": schedule["task"], "dest": source}
    return call_op(CODE_ROOT, "setup-refresh", payload, failure="setup refresh failed")


def enqueue(schedule, slot, prepared):
    payload = {"spec": schedule["spec"],
               "schedule_id": schedule["id"], "slot": slot,
               "lane": schedule.get("lane", "shadow"),
               "note": "schedule %s slot %s" % (schedule["id"], slot)}
    payload.update(schedule_metadata(schedule, slot))
    for key in ("stale_after", "stale_after_seconds", "profile"):
        if key in schedule:
            payload[key] = schedule[key]
    if schedule.get("task"):
        payload["task"] = schedule["task"]
    if schedule.get("external_effects"):
        payload["external_effects"] = schedule["external_effects"]
    if schedule.get("grant"):
        payload["grant"] = schedule["grant"]
    if schedule.get("root"):
        payload["resource"] = schedule["root"]
        if prepared.get("head"):
            payload["expected_head"] = prepared["head"]
        if schedule.get("reference_root"):
            payload["reference_root"] = schedule["reference_root"]
    return call_op(CODE_ROOT, "enqueue", payload)["id"]


def stale_scan(rows, now):
    from _sandbox_policy import tool_argv  # okf is the cs-tools exe; imported here, copied test trees lack it
    found = []
    roots = sorted({str(row.get("root", "")) for row in rows if row.get("root")})
    for raw in roots:
        root = Path(raw).expanduser()
        if not root.is_dir():
            raise RuntimeError("stale root is not a directory: " + raw)
        result = subprocess.run(
            tool_argv(CODE_ROOT, "okf"), input=json.dumps({"action": "stale", "now": now.isoformat()}),
            text=True, capture_output=True, cwd=str(root),
        )
        if result.returncode != 0:
            raise RuntimeError((result.stderr or result.stdout or "stale scan failed").strip())
        for item in json.loads(result.stdout).get("stale", []):
            found.append({"root": str(root), **item})
    return found


def local_model_ready(args):
    if "local_model_ready" in args:
        if not isinstance(args["local_model_ready"], bool):
            raise ValueError("local_model_ready must be boolean")
        return args["local_model_ready"]
    result = subprocess.run([str(HERE / "local-model-ready")], capture_output=True, text=True)
    return result.returncode == 0


def parse_time(value):
    if not isinstance(value, str) or not value:
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None


def validate_dependencies(rows):
    by_id = {row.get("id"): row for row in rows if row.get("id")}
    if len(by_id) != len([row for row in rows if row.get("id")]):
        raise ValueError("duplicate schedule id")
    visiting, visited = set(), set()

    def visit(schedule_id):
        if schedule_id in visited:
            return
        if schedule_id in visiting:
            raise ValueError("schedule dependency cycle includes " + schedule_id)
        visiting.add(schedule_id)
        row = by_id[schedule_id]
        requires = row.get("requires", [])
        accepts = row.get("accept_check_failure_from", [])
        if (not isinstance(requires, list) or len(requires) != len(set(requires)) or
                not isinstance(accepts, list) or len(accepts) != len(set(accepts)) or
                any(value not in requires for value in accepts)):
            raise ValueError("schedule dependencies must be unique; accepted failures must be a subset of requires: " + schedule_id)
        for dependency in requires:
            if not isinstance(dependency, str) or dependency not in by_id:
                raise ValueError("unknown schedule dependency for %s: %s" %
                                 (schedule_id, dependency))
            visit(dependency)
        visiting.remove(schedule_id)
        visited.add(schedule_id)

    for schedule_id in by_id:
        visit(schedule_id)
    return by_id

def dispatch_by_job(rows):
    latest = {}
    for row in rows:
        job = str(row.get("id") or row.get("job") or "")
        if job:
            latest[job] = row
    return latest


def dispatch_by_schedule_slot(dispatch):
    """Group each job's latest row by its frozen schedule identity and slot."""
    grouped = {}
    for row in dispatch.values():
        schedule_id = str(row.get("schedule_id") or "")
        slot = str(row.get("schedule_slot") or row.get("slot") or "")
        if schedule_id and slot:
            grouped.setdefault((schedule_id, slot), []).append(row)
    return grouped


def is_fire(row):
    """A real admission. Deferral rows share this shelf and must not consume a slot."""
    return bool(row.get("job")) and row.get("event") != "schedule_deferred"


def terminal_rows(schedule_id, slot, history, dispatch, scheduled_dispatch):
    """Return unique job states, including direct operator retries for the slot."""
    selected = {}
    for attempt in history:
        if attempt.get("id") != schedule_id or attempt.get("slot") != slot:
            continue
        job = str(attempt.get("job") or "")
        if job and job in dispatch and is_fire(attempt):
            selected[job] = dispatch[job]
    for row in scheduled_dispatch.get((schedule_id, slot), []):
        job = str(row.get("id") or row.get("job") or "")
        if job:
            selected[job] = row
    return list(selected.values())

def attempt_state(schedule, slot, history, dispatch, scheduled_dispatch, now):
    attempts = [row for row in history
                if row.get("id") == schedule["id"] and row.get("slot") == slot
                and is_fire(row)]
    states = terminal_rows(schedule["id"], slot, history, dispatch,
                           scheduled_dispatch)
    if not attempts and not states:
        marks = [row for row in history if row.get("id") == schedule["id"] and row.get("slot") == slot]
        if any(row.get("event") == "schedule_deferred" and row.get("reason") == "missed" for row in marks):
            return "missed"
        if any(row.get("event") == "firing_recorded" for row in marks):
            return "uncertain"
        return "unseen"
    if any(row.get("state") == "done" for row in states):
        return "done"
    if any(row.get("state") in {"pending", "running"} for row in states):
        return "inflight"
    latest = states[-1] if states else None
    if latest and latest.get("state") == "error" and latest.get("verdict") == "void":
        if schedule.get("retry") is False:
            return "failed"
        if is_config_void(latest):
            return "failed"
        attempted_at = parse_time(attempts[-1].get("ts"))
        backoff = int(schedule.get("retry_after_minutes", 5))
        if attempted_at and now < attempted_at + timedelta(minutes=backoff):
            return "retry_backoff"
        return "retryable"
    if latest and latest.get("state") in TERMINAL:
        return "failed"
    return "claimed"

def successful_dependency_slot(dependency, required, history, dispatch,
                               scheduled_dispatch, accept_check_failure=False):
    slots = {str(row.get("slot") or "") for row in history
             if row.get("id") == dependency and row.get("slot") and is_fire(row)}
    slots.update(slot for schedule_id, slot in scheduled_dispatch
                 if schedule_id == dependency and slot)
    successes = []
    for slot in slots:
        attempted_slot = parse_time(slot)
        states = terminal_rows(dependency, slot, history, dispatch,
                               scheduled_dispatch)
        if (attempted_slot and attempted_slot >= required and
                any(row.get("state") == "done" or (accept_check_failure and row.get("state") == "error" and row.get("verdict") == "fail" and row.get("stop") == "check") for row in states)):
            successes.append(attempted_slot)
    return max(successes) if successes else None

def dependency_wait(schedule, slot, schedules, history, dispatch,
                    scheduled_dispatch, now):
    slot_time = parse_time(slot)
    accepts = set(schedule.get("accept_check_failure_from", []))
    for dependency in schedule.get("requires", []):
        if not schedules[dependency].get("enabled", False):
            return {"id": schedule["id"], "slot": slot,
                    "reason": "dependency_disabled", "dependency": dependency}
        required = latest_slot(schedules[dependency], slot_time)
        required_slot = required.isoformat().replace("+00:00", "Z") if required else ""
        if not required or not successful_dependency_slot(
                dependency, required, history, dispatch, scheduled_dispatch, dependency in accepts):
            return {"id": schedule["id"], "slot": slot,
                    "reason": "dependency_not_ready", "dependency": dependency,
                    "required_slot": required_slot}
    return None



def recent_due_slots(row, now, n=SILENCE_SLOTS):
    """Last N cron slots that are at least 30 minutes old and after enable."""
    slots, cursor = [], now - timedelta(minutes=30)
    enabled = parse_time(row.get("enabled_at") or row.get("ts"))
    widened = {**row, "catch_up_window_minutes": max(int(row.get("catch_up_window_minutes", 1440)), 1440 * n)}
    for _ in range(n):
        slot = latest_slot(widened, cursor)
        if not slot or (enabled and slot < enabled):
            break
        slots.append(slot)
        cursor = slot - timedelta(minutes=1)
    return slots


def zero_fires_past_slot(schedules, fires, now):
    """Enabled stage with zero fires across N consecutive due slots."""
    fired = {(r.get("id"), parse_time(r.get("slot"))) for r in fires
             if r.get("job") and r.get("job") != "dry-run"}
    alerts = []
    for row in schedules:
        if not row.get("enabled"):
            continue
        slots = recent_due_slots(row, now)
        if len(slots) < SILENCE_SLOTS:
            continue
        if any((row["id"], slot) in fired for slot in slots):
            continue
        rendered = [slot.isoformat().replace("+00:00", "Z") for slot in slots]
        alerts.append({"kind": "schedule_silence", "id": "schedule-silence-" + row["id"],
                       "schedule_id": row["id"], "spec": row.get("spec"), "slot": rendered[0],
                       "slots": rendered, "severity": "high",
                       "stop": "zero fires across %d consecutive slots" % SILENCE_SLOTS,
                       "verdict": "silent"})
    return alerts


def record_deferral(fires, now, item):
    row = {"event": "schedule_deferred",
           "ts": now.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")}
    row.update(item)
    fires.parent.mkdir(parents=True, exist_ok=True)
    append_jsonl(fires, row, sort_keys=True, compact=False, sync=False, encoding="utf-8")


def node_dispatch(schedule, slot):
    """a schedule naming `node` is fired as a director job, never a local enqueue. The command is
    CS_DIRECTOR_DISPATCH (a JSON argv, e.g. ["php", "<director>/artisan", "director:node-dispatch"]); its
    last stdout line is the job's JSON. The slot's state then comes from the director estate's dispatch
    shelf (CS_DIRECTOR_ESTATE_ROOT), where each node's job_terminal row lands."""
    raw = os.environ.get("CS_DIRECTOR_DISPATCH") or ""
    try:
        argv = json.loads(raw) if raw else None
    except ValueError:
        argv = None
    if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
        raise NodeDispatchUnavailable("CS_DIRECTOR_DISPATCH is not a JSON argv")
    argv = argv + [schedule["node"], schedule["spec"], "--schedule=" + schedule["id"], "--slot=" + slot]
    if schedule.get("task"):
        argv.append("--task=" + schedule["task"])
    if schedule.get("grant"):
        argv.append("--grant=" + schedule["grant"])
    result = subprocess.run(argv, capture_output=True, text=True, timeout=300)
    if result.returncode:
        raise RuntimeError("director node-dispatch: " + (result.stderr or result.stdout).strip()[-500:])
    return json.loads(result.stdout.strip().splitlines()[-1])["job_id"]


def late(row, slot, now):
    """A slot first seen this long after it was due was missed (the node was off), not merely waited for."""
    grace = row.get("missed_grace_minutes", MISSED_GRACE_MINUTES)
    if row.get("missed", "skip") not in ("skip", "catch_up") or type(grace) is not int or grace < 1:
        raise ValueError("schedule %s: missed is skip or catch_up; missed_grace_minutes a positive integer" % row["id"])
    return now - slot > timedelta(minutes=grace)


def record_dispatch_terminal(path, schedule, verdict, state, stop, code, note=""):
    """A review delivery's terminal, on the dispatch shelf repeated_failure reads.

    Other schedules get this row from the job (enqueue's id, then tick's terminal): id, state,
    verdict, stop, schedule_id. A review has no job, so each attempt gets a new id — the first
    terminal for an id wins, and a streak counts distinct jobs. The same stop keeps the streak;
    a pass breaks it. No slot: attempt_state would treat the week as already fired, and a void
    with no fire row has nothing to back off from. The firing stays unrecorded, so the week
    retries until the hold. Not an enqueue.
    """
    job = str(time.time_ns())
    terminal = {
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "id": job, "job": job, "state": state, "pid": 0, "code": code, "origin": "dispatch",
        "verdict": verdict, "stop": stop, "schedule_id": schedule["id"],
        "lane": schedule.get("lane") or "host",
    }
    if note:
        terminal["note"] = note
    path.parent.mkdir(parents=True, exist_ok=True)
    append_jsonl(path, terminal, sort_keys=False, compact=False, sync=True, encoding="utf-8")
    return terminal


def record_firing(fires, row, slot, now, revision):
    """The firing's identity, durable before its job is enqueued (protocol 2: never re-run blindly)."""
    fires.parent.mkdir(parents=True, exist_ok=True)
    append_jsonl(fires, {"event": "firing_recorded", "id": row["id"], "slot": slot, "firing_id": "%s@%s" % (row["id"], slot),
                         "schedule_revision": revision,
                         "ts": now.astimezone(timezone.utc).isoformat().replace("+00:00", "Z")},
                 sort_keys=True, compact=False, sync=True, encoding="utf-8")


class NodeDispatchUnavailable(RuntimeError):
    """No director dispatch command on this host: the node schedule defers, it does not fail."""


def director_dispatch_rows():
    root = os.environ.get("CS_DIRECTOR_ESTATE_ROOT") or ""
    shelf = Path(root) / "dispatch.jsonl" if root else None
    return read_jsonl(shelf) if shelf and shelf.is_file() else []


def main():
    args = json.loads(sys.stdin.read() or "{}")
    now = datetime.fromisoformat(args.get("now") or datetime.now(timezone.utc).isoformat())
    if now.tzinfo is None:
        raise ValueError("now must include an offset")
    schedules = Path(args.get("schedules") or DEFAULT_SCHEDULES)
    fires = Path(args.get("fires") or DEFAULT_FIRES)
    dispatch_path = Path(args.get("dispatch") or DEFAULT_DISPATCH)
    rows = schedule_rows(schedules)
    schedules_by_id = validate_dependencies(rows)
    retry_failed = args.get("retry_failed", [])
    if (not isinstance(retry_failed, list) or len(retry_failed) != len(set(retry_failed)) or
            any(not isinstance(value, str) or value not in schedules_by_id
                for value in retry_failed)):
        raise ValueError("retry_failed must be a unique array of known schedule ids")
    retry_failed = set(retry_failed)
    if args.get("missed_default") not in (None, "skip", "catch_up"):
        raise ValueError("missed_default is skip or catch_up")
    lock = Path(args.get("lock") or LOCK)
    lock.parent.mkdir(parents=True, exist_ok=True)
    with lock.open("a") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        history = read_jsonl(fires)
        revisions = {}
        for raw in read_jsonl(schedules) if schedules.is_file() else []:
            revisions[raw.get("id")] = revisions.get(raw.get("id"), 0) + 1
        dispatch_history = read_jsonl(dispatch_path) + director_dispatch_rows()
        dispatch = dispatch_by_job(dispatch_history)
        scheduled_dispatch = dispatch_by_schedule_slot(dispatch)
        ledger_path = state_dir(CODE_ROOT) / "ledger.jsonl"
        ledger_rows = read_jsonl(ledger_path) if ledger_path.is_file() else []
        admitted = []
        due = []
        deferred = []
        for row in rows:
            if not row.get("enabled", False):
                continue
            failure = repeated_failure(row, dispatch_history)
            if failure:
                row.update(event="schedule_updated", enabled=False, hold=failure,
                           ts=now.isoformat(), actor_id="ops:schedule-tick", actor_kind="automated")
                append_jsonl(schedules, row, sort_keys=True, compact=False, sync=True, encoding="utf-8")
                deferred.append({"id": row["id"], "reason": failure})
                continue
            if not weekly_review(row):
                authority_error = schedule_error(row)
                if authority_error:
                    deferred.append({"id": row["id"], "reason": authority_error})
                    continue
            slot = latest_slot(row, now)
            rendered = slot.isoformat().replace("+00:00", "Z") if slot else ""
            if not slot:
                continue
            state = attempt_state(row, rendered, history, dispatch,
                                  scheduled_dispatch, now)
            if state == "retry_backoff":
                deferred.append({"id": row["id"], "slot": rendered,
                                 "reason": "retry_backoff"})
                continue
            if state == "uncertain":
                if row["id"] not in retry_failed:
                    deferred.append({"id": row["id"], "slot": rendered, "reason": "firing_uncertain"})
                    continue
                state = "retryable"
            policy = row.get("missed") or args.get("missed_default")
            if state == "unseen" and policy and late(dict(row, missed=policy), slot, now) and not any(
                    h.get("id") == row["id"] and h.get("slot") == rendered for h in history):  # deferred = seen, not missed
                if policy != "catch_up":
                    deferred.append({"id": row["id"], "slot": rendered, "reason": "missed"})
                    continue
                row = dict(row, _catch_up=True)
            if state == "failed":
                if row["id"] in retry_failed:
                    state = "retryable"
                else:
                    deferred.append({"id": row["id"], "slot": rendered,
                                     "reason": "prior_attempt_failed"})
                    continue
            if state not in {"unseen", "retryable"}:
                continue
            due.append((row, rendered))
        ready = local_model_ready(args) if any(not weekly_review(row) for row, _slot in due) else True
        for row, rendered in due:
            if not weekly_review(row) and spec_uses_local_coder(row) and not ready and not row.get("node"):  # a node runs its own model
                deferred.append({"id": row["id"], "slot": rendered,
                                 "reason": "local_coder_unavailable"})
                continue
            waiting = dependency_wait(row, rendered, schedules_by_id,
                                      history, dispatch, scheduled_dispatch, now)
            if waiting:
                deferred.append(waiting)
                continue
            job = "dry-run"
            if weekly_review(row):
                # Deliver first. The firing is recorded only after the report exists, so a crash
                # between the two still leaves one file (deliver_weekly is idempotent per local date).
                # The dispatch terminal is the same record other schedules leave when a firing fails:
                # repeated_failure holds the row once that streak reaches failure_hold_after.
                if not args.get("dry_run", False):
                    try:
                        from _review_schedule import deliver_weekly
                        delivered = deliver_weekly(Path(schedules).parent, row, rendered, now)
                    except Exception as error:
                        record_dispatch_terminal(
                            dispatch_path, row, "void", "error", "review_failed", 1,
                            str(error).replace("\n", " ")[:500])
                        deferred.append({"id": row["id"], "slot": rendered,
                                         "reason": "review_failed: %s" % error})
                        continue
                    record_dispatch_terminal(dispatch_path, row, "pass", "done", "done", 0)
                    record_firing(fires, row, rendered, now, revisions.get(row["id"]))
                    job = delivered["job"]
            elif row.get("node") and not args.get("dry_run", False):
                record_firing(fires, row, rendered, now, revisions.get(row["id"]))
                try:
                    job = node_dispatch(row, rendered)
                except NodeDispatchUnavailable as error:
                    deferred.append({"id": row["id"], "slot": rendered, "reason": "director_dispatch_unavailable: %s" % error})
                    continue
            elif not args.get("dry_run", False):
                record_firing(fires, row, rendered, now, revisions.get(row["id"]))
                prepared = prepare(row, rendered, dispatch, ledger_rows)
                job = enqueue(row, rendered, prepared)
            event = {"ts": now.astimezone(timezone.utc).isoformat().replace("+00:00", "Z"),
                     "id": row["id"], "slot": rendered, "job": job,
                     "lane": row.get("lane", "shadow")}
            if row.get("_catch_up"):
                event["catch_up"] = True
            fires.parent.mkdir(parents=True, exist_ok=True)
            append_jsonl(fires, event, sort_keys=True, compact=False,
                         sync=False, encoding='utf-8')
            history.append(event)
            admitted.append(event)
        for item in deferred:
            record_deferral(fires, now, item)
        fcntl.flock(handle.fileno(), fcntl.LOCK_UN)
    stale = [] if args.get("scan_stale") is False else stale_scan(rows, now)
    if admitted or deferred or stale:
        print(json.dumps({"ok": True, "admitted": admitted, "deferred": deferred,
                          "stale": stale}, sort_keys=True))


if __name__ == "__main__":
    try:
        main()
    except (KeyError, ValueError, OSError, RuntimeError, json.JSONDecodeError) as error:
        print("schedule-tick: " + str(error), file=sys.stderr)
        sys.exit(1)
