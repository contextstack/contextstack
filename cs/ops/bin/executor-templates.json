  "codex": {
    "harness": {"id": "codex", "label": "Codex", "provider": "openai"},
    "_comment": "Codex CLI 0.171.0: codex exec --help lists --model; codex debug models supplies the slugs with visibility=list.",
    "model_flag": "--model",
    "models": {
      "gpt-6.2-sol": "gpt-6.2-sol",
      "gpt-6.2-astra": "gpt-6.2-astra",
      "gpt-6.1-terra": "gpt-6.1-terra",
      "gpt-6.1-sol": "gpt-6.1-sol",
      "gpt-6-astra": "gpt-6-astra",
      "gpt-6-sol": "gpt-6-sol",
      "gpt-6-luna": "gpt-6-luna",
      "gpt-5.6-sol": "gpt-5.6-sol",
      "gpt-5.6-terra": "gpt-5.6-terra",
      "gpt-5.6-luna": "gpt-5.6-luna"
    },
    "binary": "codex",
    "args": [
      "exec",
      "--json",
      "--skip-git-repo-check",
      "--dangerously-bypass-approvals-and-sandbox",
      "--ignore-user-config",
      "{{prompt}}"
    ],
    "env": {
      "CODEX_HOME": "{{tmp}}/codex-home",
      "TMPDIR": "{{tmp}}/os-tmp",
      "TMP": "{{tmp}}/os-tmp",
      "TEMP": "{{tmp}}/os-tmp"
    },
    "env_drop": [
      "OPENAI_API_KEY"
    ],
    "cost_class": "subscription",
    "cost_usd": 0,
    "cost_per_1k": 0.015,
    "auth": "subscription",
    "copies": {
      "{{tmp}}/codex-home/auth.json": "~/.codex/auth.json"
    },
    "sockets_allow": [],
    "home_reads": []
  },
  "gemini-cli": {
    "unavailable_reason": "Retired by Google for individual accounts; use Antigravity for Gemini models",
    "harness": {"id": "gemini-cli", "label": "Gemini CLI", "provider": "google"},
