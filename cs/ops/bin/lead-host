#!/usr/bin/env python3
"""CLI for the hosted lead session host (serve daemon or one-shot diagnostics).

``serve`` exits on idle timeout, missing state, or parent exit; ``ensure_serving`` spawns it detached on turn.
Concurrent turns on one conversation serialize in the host process (see ``_lead_host``).
"""
import argparse
import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

from _lead_host import client_turn, fail, resolve_conversation_id, serve_loop  # noqa: E402
from _roots import roots  # noqa: E402

LAB = HERE.parent.parent


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="lead-host")
    sub = ap.add_subparsers(dest="cmd", required=True)
    serve = sub.add_parser("serve", help="hold one live CLI session for a conversation")
    serve.add_argument("--conversation", help="conversation id (default: hosted-lead.json)")
    serve.add_argument("--model", default="sonnet")
    serve.add_argument("--cli", default=os.environ.get("LEAD_CLI_BIN", "claude"))
    serve.add_argument("--no-sandbox", action="store_true")
    turn = sub.add_parser("turn", help="run one turn against the session (debug)")
    turn.add_argument("workspace", type=Path)
    turn.add_argument("--conversation")
    turn.add_argument("--model", default="sonnet")
    turn.add_argument("--cli", default=os.environ.get("LEAD_CLI_BIN", "claude"))
    turn.add_argument("--no-sandbox", action="store_true")
    turn.add_argument("--timeout", type=float, default=120)
    args = ap.parse_args(argv)
    r = roots(LAB, os.environ)
    config_root, state = r["config"], r["state"]
    sandbox = not args.no_sandbox
    if args.cmd == "serve":
        cid = resolve_conversation_id(config_root, args.conversation)
        if os.environ.get("LEAD_HOST_QUIET") != "1":
            print("lead-host: serving %s" % cid, file=sys.stderr)
        return serve_loop(cid, config_root, state, model=args.model, cli_binary=args.cli, sandbox=sandbox)
    if args.cmd == "turn":
        reply = client_turn(
            args.workspace,
            conversation_id=args.conversation,
            config_root=config_root,
            state=state,
            model=args.model,
            cli_binary=args.cli,
            sandbox=sandbox,
            timeout=args.timeout,
        )
        sys.stdout.write(reply + "\n")
        return 0
    fail("unknown command")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
