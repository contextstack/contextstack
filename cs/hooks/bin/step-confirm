#!/usr/bin/env python3
# pre_tool hook: a human at a terminal confirms each tool call. stdin is the
# call {name, args}; Enter runs it (exit 0), q aborts the run (exit 2), anything
# else runs it. The terminal is /dev/tty, or $LAB_STEP_TTY: a fifo, or a regular
# file consumed one line per call so a fixture can script "\nq\n" (the prompt
# then goes to stderr). No terminal that opens, or a script that ran out: exit 2
# with a message — a step-confirm in a dispatched spec aborts, never runs blind.
import json, os, stat, sys

call = json.load(sys.stdin)
path = os.environ.get("LAB_STEP_TTY") or "/dev/tty"
prompt = "→ %s %s\n[step] Enter=run, q=abort: " % (
    call.get("name"), json.dumps(call.get("args"), separators=(",", ":"), sort_keys=True))
try:
    if stat.S_ISREG(os.stat(path).st_mode):
        with open(path, encoding="utf-8") as f:
            lines = f.readlines()
        with open(path, "w", encoding="utf-8") as f:
            f.writelines(lines[1:])
        sys.stderr.buffer.write(prompt.encode("utf-8"))
        if not lines:
            raise OSError("script exhausted")
        line = lines[0]
    else:
        if stat.S_ISCHR(os.stat(path).st_mode):
            with open(path, "w", encoding="utf-8") as out:
                out.write(prompt)
        else:
            sys.stderr.buffer.write(prompt.encode("utf-8"))
        with open(path, encoding="utf-8") as f:
            line = f.readline()
except OSError:
    print("step-confirm: no terminal; refusing by default")
    sys.exit(2)
sys.exit(2 if line.strip() == "q" else 0)
