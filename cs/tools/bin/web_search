#!/usr/bin/env python3
# Keyless public web discovery with cached search bytes.
import json, sys
import _calllog
from _web import search

try:
    args = json.load(sys.stdin)
    _calllog.record("web_search", args)
    print(json.dumps(search(args.get("query"), args.get("count", 5)), sort_keys=True))
except (KeyError, TypeError, ValueError, OSError, RuntimeError, json.JSONDecodeError) as error:
    print("web_search: " + str(error), file=sys.stderr); sys.exit(1)
