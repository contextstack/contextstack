#!/usr/bin/env python3
# Grounded HTTPS fetch with durable full-byte evidence.
import json, sys
import _calllog
from _web import fetch, fail

try:
    args = json.load(sys.stdin)
    _calllog.record("web_fetch", args)
    record, raw, path = fetch(args.get("url"))
    preview = ""
    if record["content_type"].lower().startswith(("text/", "application/json", "application/xml")):
        preview = raw[:2000].decode("utf-8", errors="replace")
    print(json.dumps({"ok": True, "evidence": path, **record, "preview": preview}, sort_keys=True))
except (KeyError, TypeError, ValueError, OSError, RuntimeError, json.JSONDecodeError) as error:
    print("web_fetch: " + str(error), file=sys.stderr); sys.exit(1)
