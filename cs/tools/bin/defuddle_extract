#!/usr/bin/env python3
"""Derive clean Markdown from already-fetched HTML without network access."""
import hashlib
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

import _calllog
from _web import append_manifest, atomic_json, fail, safe_directory

VERSION = "defuddle@0.19.3+linkedom@0.18.13"
MAX_DERIVED_BYTES = 5 * 1024 * 1024


def safe_existing(root, raw, prefix):
    if not isinstance(raw, str) or not raw or Path(raw).is_absolute():
        fail(prefix + " path must be relative")
    path = root / raw
    if path.is_symlink() or not path.is_file() or not path.resolve().is_relative_to(root):
        fail(prefix + " path is unsafe or missing")
    return path


try:
    args = json.load(sys.stdin)
    _calllog.record("defuddle_extract", args)
    root = Path.cwd().resolve()
    evidence_path = safe_existing(root, args.get("evidence"), "evidence")
    if evidence_path.parent != root / "_evidence/fetches":
        fail("evidence must be a canonical fetch receipt")
    receipt = json.loads(evidence_path.read_text(encoding="utf-8"))
    if receipt.get("kind") != "fetch":
        fail("Defuddle requires raw static-fetch HTML evidence")
    if not str(receipt.get("content_type") or "").lower().startswith("text/html"):
        fail("Defuddle source content_type is not text/html")
    body = safe_existing(root, receipt.get("body_path"), "body")
    if body.parent != root / "_evidence/bodies":
        fail("body must be in the canonical evidence store")
    raw = body.read_bytes()
    source_sha = hashlib.sha256(raw).hexdigest()
    if source_sha != receipt.get("sha256"):
        fail("source body hash does not match fetch receipt")
    node = shutil.which("node")
    if not node:
        fail("node is unavailable")
    adapter = Path(__file__).resolve().parent.parent / "defuddle/extract.mjs"
    result = subprocess.run(
        [node, str(adapter), str(body), str(receipt.get("final_url") or "")],
        capture_output=True, text=True,
        env={**os.environ, "NO_PROXY": "*", "no_proxy": "*"},
        timeout=30,
    )
    if result.returncode:
        fail("Defuddle failed: " + (result.stderr or result.stdout).strip())
    parsed = json.loads(result.stdout)
    content = str(parsed.get("content") or "").strip() + "\n"
    cooked = content.encode("utf-8")
    if not cooked.strip() or len(cooked) > MAX_DERIVED_BYTES:
        fail("derived Markdown is empty or too large")
    derived_sha = hashlib.sha256(cooked).hexdigest()
    derived_dir = safe_directory("_evidence/derived")
    output = derived_dir / (derived_sha + ".defuddle.md")
    if output.is_symlink():
        fail("derived evidence destination is a symlink")
    if output.is_file() and hashlib.sha256(output.read_bytes()).hexdigest() != derived_sha:
        fail("derived evidence digest collision")
    if not output.exists():
        output.write_bytes(cooked)
    options = {"markdown": True, "use_async": False}
    derivation_id = hashlib.sha256(
        (source_sha + "\0" + VERSION + "\0" + json.dumps(options, sort_keys=True)).encode()
    ).hexdigest()
    derivations = safe_directory("_evidence/derivations")
    record_path = derivations / (derivation_id + ".json")
    record = {
        "schema_version": "0.1", "kind": "derived_extraction",
        "tool": VERSION, "options": options,
        "source_evidence": str(evidence_path.relative_to(root)),
        "source_body": str(body.relative_to(root)), "source_sha256": source_sha,
        "source_url": receipt.get("final_url"),
        "body_path": str(output.relative_to(root)), "sha256": derived_sha,
        "bytes": len(cooked), "metadata": parsed.get("metadata") or {},
    }
    atomic_json(record_path, record)
    append_manifest(derivations / "manifest.jsonl", record)
    print(json.dumps({"ok": True, "derivation": str(record_path.relative_to(root)),
                      **record, "preview": content[:4000]}, sort_keys=True))
except (KeyError, TypeError, ValueError, OSError, RuntimeError,
        subprocess.TimeoutExpired, json.JSONDecodeError) as error:
    print("defuddle_extract: " + str(error), file=sys.stderr)
    sys.exit(1)
