#!/usr/bin/env python3
# lab tool: regex search over workspace files. Output clipped to 8KB.
import json, os, re, sys
import _calllog

a = json.load(sys.stdin)
_calllog.record("search", a)
pat = re.compile(a["pattern"])
hits = []
for root, dirs, files in os.walk("."):
    dirs[:] = [d for d in dirs if d not in (".git",)]
    for name in files:
        p = os.path.join(root, name)
        try:
            lines = open(p, errors="replace").read().splitlines()
        except OSError:
            continue
        for i, line in enumerate(lines, 1):
            if pat.search(line):
                hits.append("%s:%d:%s" % (p, i, line))
out = "\n".join(hits)[:8192]
print(out if out else "(no matches)", end="")
