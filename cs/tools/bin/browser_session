#!/usr/bin/env python3
"""Open one allowlisted HTTPS page in the dedicated Chrome the host broker runs.

The tool speaks one JSON line to ops/bin/browser-broker over the unix socket cs-sandbox grants
(CS_SOCKET_BROWSER_<SET>). It never speaks CDP and has no network. The set comes from the name it runs
under: browser_session is `public`; a set is added as a symlink tools/bin/browser_<set> -> browser_session
with its own descriptor asking for socket browser-<set> (the wrapper reads <name>.json beside the name).
CS_BROWSER_BROKER_EXEC (fixtures only) names a program that answers the same line on stdin/stdout.
"""
import hashlib
import json
import os
import socket
import subprocess
import sys
from pathlib import Path

import _calllog
from _web import append_manifest, atomic_json, fail, normalize_url, safe_directory

MAX_REPLY = 8 * 1024 * 1024
TIMEOUT = 120


def ask(set_name, request):
    line = json.dumps(request, sort_keys=True).encode() + b"\n"
    fake = os.environ.get("CS_BROWSER_BROKER_EXEC")
    if fake:
        done = subprocess.run([fake], input=line, capture_output=True, timeout=TIMEOUT)
        raw = done.stdout
    else:
        var = "CS_SOCKET_BROWSER_" + set_name.upper().replace("-", "_")
        path = os.environ.get(var)
        if not path:
            fail("no browser broker socket granted for set %s (%s unset)" % (set_name, var))
        conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        conn.settimeout(TIMEOUT)
        try:
            conn.connect(path)
        except OSError as error:
            fail("browser broker unreachable at %s: %s" % (var, error.strerror or error))
        conn.sendall(line)
        raw = b""
        while not raw.endswith(b"\n") and len(raw) <= MAX_REPLY:
            chunk = conn.recv(1 << 16)
            if not chunk:
                break
            raw += chunk
        conn.close()
    if len(raw) > MAX_REPLY or not raw.strip():
        fail("browser broker reply is empty or exceeds %d bytes" % MAX_REPLY)
    reply = json.loads(raw)
    if not isinstance(reply, dict):
        fail("browser broker reply is not an object")
    return reply


def store(relative_dir, digest, suffix, raw):
    directory = safe_directory(relative_dir)
    destination = directory / (digest + suffix)
    if destination.is_symlink():
        fail("browser evidence destination is a symlink")
    if not destination.is_file():
        tmp = directory / (".tmp-" + digest)
        tmp.write_bytes(raw)
        tmp.replace(destination)
    return str(destination.relative_to(Path.cwd()))


try:
    invoked = os.path.basename(sys.argv[0])
    set_name = "public" if invoked == "browser_session" else invoked.removeprefix("browser_").replace("_", "-")
    args = json.load(sys.stdin)
    _calllog.record("browser_session", args)
    if not isinstance(args, dict) or set(args) - {"url"}:
        fail("args must be {url}")
    requested = normalize_url(args.get("url"))
    evidence = safe_directory("_evidence")
    reply = ask(set_name, {"verb": "open", "url": requested})
    if reply.get("ok") is not True:
        blocked = reply.get("blocked") or []
        fail("browser broker refused: %s%s" % (reply.get("error"), "; blocked %s" % blocked if blocked else ""))
    text = reply.get("text")
    if not isinstance(text, str) or not text.strip():
        fail("browser rendered no visible text")
    raw = text.encode("utf-8")
    digest = hashlib.sha256(raw).hexdigest()
    if digest != reply.get("sha256"):
        fail("page text does not match the broker's sha256")
    record = {"schema_version": "0.1", "kind": "browser", "renderer": "chrome-cdp-broker",
              "set": set_name, "requested_url": requested, "final_url": reply.get("final_url"),
              "status": reply.get("status"), "title": reply.get("title"),
              "content_type": "text/plain; charset=utf-8", "bytes": len(raw), "sha256": digest,
              "body_path": store("_evidence/bodies", digest, ".txt", raw),
              "navigations": reply.get("navigations") or [], "blocked": reply.get("blocked") or []}
    record_id = hashlib.sha256(("browser_session\0" + requested + "\0" + digest).encode()).hexdigest()
    record_path = Path("_evidence/fetches") / (record_id + ".json")
    safe_directory("_evidence/fetches")
    atomic_json(record_path, record)
    append_manifest(evidence / "manifest.jsonl", record)
    print(json.dumps({"ok": True, "evidence": str(record_path), **record,
                      "preview": text[:4000]}, sort_keys=True))
except (KeyError, TypeError, ValueError, OSError, RuntimeError, subprocess.TimeoutExpired) as error:
    print("browser_session: " + str(error), file=sys.stderr)
    sys.exit(1)
