#!/usr/bin/env python3
# code_root tool: write a file, creating parent dirs. Confined to the workspace.
import json, os, sys
import _calllog

a = json.load(sys.stdin)
_calllog.record("fs_write", a)
p = a["path"]
workspace = os.path.realpath(os.getcwd())
target = os.path.realpath(p)
if ".." in p.split("/") or os.path.commonpath([workspace, target]) != workspace:
    error = "path escapes workspace: " + p
    if repo := os.environ.get("CS_REPO_VIEW"):
        repo = os.path.abspath(repo)
        if os.path.commonpath([os.path.abspath(p), repo]) == repo:
            error += (". The repository view is read-only. Write deliverables in your workspace "
                      "with a relative path, e.g. answer.md.")
    basename = os.path.basename(p.rstrip("/"))
    if basename in ("", ".", ".."):
        basename = "answer.md"
    error += f"\nYour workspace is {os.getcwd()}; write there or use a relative path such as {basename}."
    sys.exit(error)
d = os.path.dirname(p)
if d:
    os.makedirs(d, exist_ok=True)
with open(p, "w") as f:
    f.write(a["content"])
print("wrote %s (%d bytes)" % (p, len(a["content"])), end="")
