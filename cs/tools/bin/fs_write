#!/usr/bin/env python3
# lab tool: write a file, creating parent dirs. Confined to the workspace.
import json, os, sys
import _calllog

a = json.load(sys.stdin)
_calllog.record("fs_write", a)
p = a["path"]
if os.path.isabs(p) or ".." in p.split("/"):
    sys.exit("path escapes workspace: " + p)
d = os.path.dirname(p)
if d:
    os.makedirs(d, exist_ok=True)
with open(p, "w") as f:
    f.write(a["content"])
print("wrote %s (%d bytes)" % (p, len(a["content"])), end="")
