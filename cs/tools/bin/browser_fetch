#!/usr/bin/env python3
"""Render one public HTTPS URL using the separate-profile broker."""
import hashlib
import ipaddress
import json
import os
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import urlsplit

import _calllog
from _broker_client import ask
from _web import append_manifest, atomic_json, fail, normalize_url, public_address, safe_directory

MAX_ARCHIVE = 20 * 1024 * 1024
MAX_FETCH_REPLY = 40 * 1024 * 1024


def store_bytes(relative_dir, digest, suffix, raw):
    directory = safe_directory(relative_dir)
    destination = directory / (digest + suffix)
    if destination.is_symlink():
        fail("browser evidence destination is a symlink")
    if destination.is_file():
        if hashlib.sha256(destination.read_bytes()).hexdigest() != digest:
            fail("browser evidence digest collision")
    else:
        with tempfile.NamedTemporaryFile(prefix="browser-", dir=directory, delete=False) as handle:
            temp = Path(handle.name)
            try:
                handle.write(raw)
                handle.flush()
                os.fsync(handle.fileno())
                temp.replace(destination)
            finally:
                temp.unlink(missing_ok=True)
    return str(destination.relative_to(Path.cwd()))



try:
    args = json.load(sys.stdin)
    _calllog.record("browser_fetch", args)
    if not isinstance(args, dict) or set(args) - {"url", "archive", "links"}:
        fail("args must be {url, archive?, links?}")
    requested = normalize_url(args.get("url"))
    hostname = urlsplit(requested).hostname
    if hostname == "tasks.google.com":
        fail("Google Tasks requires the scheduled reader and native host")
    try:
        literal = ipaddress.ip_address(hostname)
    except ValueError:
        literal = None
    if literal is not None:
        public_address(hostname)
    want_archive = args.get("archive", False)
    want_links = args.get("links", False)
    if not isinstance(want_archive, bool) or not isinstance(want_links, bool):
        fail("archive and links must be booleans")
    reply = ask("public", {"verb": "open", "url": requested, "archive": want_archive,
                           "links": want_links}, MAX_FETCH_REPLY)
    if reply.get("ok") is not True:
        fail("browser broker refused: %s" % reply.get("error"))
    status = reply.get("status")
    if not isinstance(status, (int, float)) or not 200 <= status < 300:
        fail("browser returned HTTP status %s" % status)
    text = reply.get("text")
    if not isinstance(text, str) or not text.strip():
        fail("browser rendered no visible text")
    raw = text.encode("utf-8")
    digest = hashlib.sha256(raw).hexdigest()
    if digest != reply.get("sha256"):
        fail("page text does not match the broker's sha256")
    evidence = safe_directory("_evidence")
    body_path = store_bytes("_evidence/bodies", digest, ".txt", raw)
    link_fields = {}
    if want_links:
        links_from_broker = reply.get("links")
        if not isinstance(links_from_broker, list) or len(links_from_broker) > 20000:
            fail("rendered link map is not a bounded array")
        links, seen_links = [], set()
        for item in links_from_broker:
            if not isinstance(item, dict):
                continue
            label = str(item.get("text") or "").strip()[:500]
            href = str(item.get("href") or "").strip()
            if not href.startswith(("https://", "http://")):
                continue
            key = (label, href)
            if key in seen_links:
                continue
            seen_links.add(key)
            links.append({"text": label, "href": href})
        canonical_links = (json.dumps(links, ensure_ascii=False, sort_keys=True,
                                      separators=(",", ":")) + "\n").encode("utf-8")
        links_sha = hashlib.sha256(canonical_links).hexdigest()
        link_fields = {"links_path": store_bytes("_evidence/links", links_sha, ".json",
                                                   canonical_links),
                       "links_sha256": links_sha, "link_count": len(links)}
    archive_fields = {}
    if want_archive:
        archive = reply.get("archive")
        archive_raw = archive.encode("utf-8") if isinstance(archive, str) else b""
        if 0 < len(archive_raw) <= MAX_ARCHIVE:
            archive_sha = hashlib.sha256(archive_raw).hexdigest()
            archive_fields = {"archive_path": store_bytes("_evidence/archives", archive_sha,
                                                            ".mhtml", archive_raw),
                              "archive_sha256": archive_sha, "archive_bytes": len(archive_raw)}
        else:
            archive_fields = {"archive_omitted": reply.get("archive_omitted", "empty_or_exceeds_limit")}
    retrieved = datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")
    record = {"schema_version": "0.1", "kind": "browser", "renderer": "chrome-cdp-broker",
              "requested_url": requested, "final_url": normalize_url(reply["final_url"]),
              "status": status, "content_type": "text/plain; charset=utf-8",
              "retrieved_at": retrieved, "bytes": len(raw), "sha256": digest,
              "body_path": body_path, "redirects": reply.get("navigations") or [],
              **link_fields, **archive_fields}
    record_id = hashlib.sha256(("browser\0" + requested + "\0" + digest).encode()).hexdigest()
    safe_directory("_evidence/fetches")
    record_path = Path("_evidence/fetches") / (record_id + ".json")
    atomic_json(record_path, record)
    append_manifest(evidence / "manifest.jsonl", record)
    print(json.dumps({"ok": True, "evidence": str(record_path), **record,
                      "preview": raw[:4000].decode("utf-8", errors="replace")}, sort_keys=True))
except (KeyError, TypeError, ValueError, OSError, RuntimeError, subprocess.TimeoutExpired) as error:
    print("browser_fetch: " + str(error), file=sys.stderr)
    sys.exit(1)
