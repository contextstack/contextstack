#!/usr/bin/env python3
"""node-bundle: build the node's offline install bundle (one release), or verify a release installed from one.

Plan.CS.v2.1 section 7 "Packaging the rest", "Runtime inventory": an offline image and
a release of the persistent ~/.contextstack layout (scripts/node-install). Stdlib only.

  node-bundle build [--target linux-aarch64|linux-x86_64|macos-aarch64|macos-x86_64] [--director-rs] [--client-web [--composer-auth FILE]] OUT_DIR
      On a connected machine. Assembles in a system temp directory and moves the finished tree onto OUT_DIR
      (must not exist) only at the end, so a failed build leaves nothing there:
        uv/uv            the uv binary for the target (GitHub release tarball, its .sha256 checked)
        python/<tag>/<archive>.tar.gz
                         the python-build-standalone build of .python-version for the target, in uv's mirror
                         layout (checked against the release's SHA256SUMS here, and by uv at install time)
        release/         exactly what scripts/node-install puts at ~/.contextstack/releases/<id>/:
          cs/       the code root (KIT, whatever the checkout calls it): tracked files only, outside ledger/, specs/, tasks/ and ESTATE, as the commit has them, plus
                         tools/defuddle/node_modules (generated before stage; a manifest tool's "requires" tree, gitignored)
          bin/           cs-harness, cs-sandbox, cs-tools, cs-gateway; no cs-go and
                         no csgateway: the Go runner and gateway are archived (the owner 2026-11-10, ADR 0011), earlier
                         releases keep theirs, and a build needs no Go toolchain. Built here by cargo from the working
                         tree; only for this host's target, otherwise recorded
                         required, not bundled (Linux binaries arrive with phase 3b)
          bin/cs-director
                         only with --director-rs (a host that serves the Rust Director, Director.Plan step 3): built
                         by cargo -p cs-director like the others; node-release --serve-director-rs runs it
          gateway/models.json
                         the gateway's catalog (gateway/models.json)
          client-web/    only with --client-web (a host serving client-web, ADR 0017): the app from CLIENT_WEB_SRC, its
                         committed files outside CLIENT_WEB_EXCLUDE, plus vendor/ (`composer install --no-dev`, the
                         build host's composer auth, or --composer-auth FILE: an auth.json passed as COMPOSER_AUTH, never
                         copied or printed; Flux Pro needs one), public/build/ (`npm ci && npm run build`) and
                         bootstrap/cache/{packages,services}.php from one boot. No .env, storage/, tests/ or node_modules/:
                         its env and storage live outside the release (node-release --serve-client-web). php, composer
                         and npm come from the build host's PATH; npm needs the network.
        bundle.json      target, release id <YYYYMMDD>-<short sha>[-d<hash>] (-d: the working tree differed from
                         the commit; the hash is over the file hashes; a production build comes from an export,
                         `git archive HEAD | tar -x -C X`, then X/cs/scripts/node-bundle build --commit <sha>, which
                         carries the commit's files only and is never -d; npm ci restores the defuddle tree), versions, URLs, sha256 of the uv tarball,
                         the Python archive and every file under release/, the manifest tools, "binaries" and the
                         lab commit. "target" and "release" are the lines scripts/node-install reads.
      Refuses when a tool or helper imports anything outside the standard library.
  node-bundle deps
      That scan alone, no network: the manifest tools, the helpers they reach and any non-stdlib import by
      importer; exit 1 if there is one. Cheap enough for a scripts/check rule.
  node-bundle verify BUNDLE RELEASE
      Run by scripts/node-install under the release's interpreter. Checks the host matches the bundle's target,
      every bundle.json file hash in the bundle and in RELEASE, the interpreter version and location, every
      bundled binary and its target/release/ link (where descriptors and the sandbox launcher resolve cs-tools
      and cs-sandbox: <repo> is RELEASE, the directory holding the code root), and each manifest tool's runtime
      (python3 from RELEASE; node, curl, bwrap or sandbox-exec, gstack browse, Playwright from the host).
      Prints one JSON report. Exit 0 all present; 2 a host runtime missing (the tools needing it are listed);
      1 the release itself is wrong.
"""
import argparse
import ast
import errno
import hashlib
import io
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

LAB = Path(__file__).resolve().parents[1]
TRIPLE = {"linux-aarch64": "aarch64-unknown-linux-gnu", "linux-x86_64": "x86_64-unknown-linux-gnu",
          "macos-aarch64": "aarch64-apple-darwin", "macos-x86_64": "x86_64-apple-darwin"}
UV_RELEASES = "https://github.com/astral-sh/uv/releases/download"
EXCLUDE = ("ledger/", "specs/", "tasks/")  # the estate's records: a node carries none (phase 6, ADR 0009)
EXCLUDE_FILES = ("ESTATE",)  # an install names itself in config/ESTATE; the checkout's "dev" never ships
REQUIRES_TREES = ("tools/defuddle/node_modules",)  # built by requires_trees() (npm ci); gitignored but bundled on purpose
# bin/<name>: (build argv, cwd relative to the repo, built file relative to the repo)
BINARIES = {
    "cs-harness": (None, ".", "target/release/cs-harness"),  # the Rust CS runner
    "cs-sandbox": (None, ".", "target/release/cs-sandbox"),
    "cs-tools": (None, ".", "target/release/cs-tools"),
    "cs-gateway": (None, ".", "target/release/cs-gateway"),
}
CARGO = ["cargo", "build", "--release", "--locked", "-q", "-p", "cs-harness", "-p", "cs-sandbox", "-p", "cs-tools",
         "-p", "cs-gateway"]
# CLI key --director-rs; bin ships cs-director.
OPTIONAL_BINARIES = {"director-rs": ("cs-director", "target/release/cs-director", "cs-director")}
# Descriptors resolve target/release/{cs-tools,cs-sandbox}.
TARGET_LINKS = {"cs-tools": "target/release/cs-tools", "cs-sandbox": "target/release/cs-sandbox"}
KIT = "cs"
CLIENT_WEB_SRC = "clients/web"  # client-web's folder in the checkout
CLIENT_WEB = "client-web"  # its folder in a release, whatever the checkout calls it
CLIENT_WEB_EXCLUDE = (".agents/", ".claude/", ".codex/", ".cursor/", ".factory/", ".github/", ".grok/", ".pi/", "tests/",
                      "storage/", "node_modules/", "vendor/", "public/build/", "public/hot", ".env", "auth.json",
                      ".mcp.json", "opencode.json", "boost.json", "AGENTS.md", "CLAUDE.md", "phpunit.xml", "phpstan.neon",
                      "pint.json", ".editorconfig", ".gitattributes", ".npmrc")
CLIENT_WEB_KEEP = (".env.install.example",)  # the install template (no secrets); every other .env* stays out
CLIENT_WEB_BUILD = (  # run in release/client-web/; the build host's env without APP_*, DIRECTOR_*, DB_*, GIT_*
    ["composer", "install", "--no-dev", "--optimize-autoloader", "--no-interaction", "--no-progress"],
    ["npm", "ci", "--silent", "--no-audit", "--no-fund"],
    ["npm", "run", "build", "--silent"],
    ["php", "artisan", "list", "--no-interaction"])  # one boot writes bootstrap/cache/services.php
CLIENT_WEB_NEEDS = ("vendor/autoload.php", "public/index.php", "public/build/manifest.json", "bootstrap/cache/packages.php",
                    "bootstrap/cache/services.php", ".env.install.example")
CLIENT_WEB_PHP = 80300  # PHP_VERSION_ID it needs (composer.json "php": "^8.3")


def kit_root(release):
    """The release code root."""
    return Path(release) / KIT


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "contextstack-node-bundle"})
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            return r.read()
    except urllib.error.HTTPError as error:  # name the URL: a bare 404 traceback hid which download failed
        sys.exit("node-bundle: %s: HTTP %s" % (url, error.code))


def host_target():
    os_name = {"darwin": "macos", "linux": "linux"}.get(platform.system().lower(), platform.system().lower())
    arch = {"arm64": "aarch64", "amd64": "x86_64"}.get(platform.machine().lower(), platform.machine().lower())
    return "%s-%s" % (os_name, arch)


def manifest_tools():
    return json.loads((LAB / "tools/manifest.json").read_text(encoding="utf-8"))["tools"]


def python_closure(tools):
    """Tools plus every local module they import, transitively; external imports by importer."""
    stdlib, dirs = set(sys.stdlib_module_names), [LAB / "tools/bin", LAB / "ops/bin"]
    files, external, queue = {}, {}, [(t["name"], LAB / "tools/bin" / t["name"]) for t in tools if t["runtime"] == "python3"]
    while queue:
        name, path = queue.pop()
        if name in files:
            continue
        files[name] = path
        tree = ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
        for node in ast.walk(tree):
            mods = [a.name for a in node.names] if isinstance(node, ast.Import) else \
                   [node.module] if isinstance(node, ast.ImportFrom) and node.module and node.level == 0 else []
            for mod in (m.split(".")[0] for m in mods):
                if mod in stdlib:
                    continue
                local = next((d / (mod + ".py") for d in dirs if (d / (mod + ".py")).is_file()), None)
                if local:
                    queue.append((mod, local))
                else:
                    external.setdefault(name, []).append(mod)
    return sorted(set(files.values())), external


def git_run(argv, **kw):
    """git about this checkout only: without the caller's GIT_* (a commit hook sets GIT_DIR and GIT_INDEX_FILE,
    which pointed an export's git calls back at the real repository and its staged index)."""
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    return subprocess.run(argv, env=env, **kw)


def in_git():
    """True in a git work tree; False in an export (`git archive HEAD | tar -x`), which has no .git."""
    return git_run(["git", "-C", str(LAB), "rev-parse", "--is-inside-work-tree"], capture_output=True,
                          text=True).stdout.strip() == "true"


def release_files():
    """Code-root paths (relative to lab/) a release carries, outside EXCLUDE, plus REQUIRES_TREES. In a work tree:
    tracked files only (plus REQUIRES_TREES). In an export: every file it holds (the commit's, nothing else)."""
    if in_git():
        out = git_run(["git", "-C", str(LAB), "ls-files", "-z", "--cached"],
                             capture_output=True, check=True).stdout
        found = out.decode("utf-8").split("\0")
    else:
        found = [str(p.relative_to(LAB)) for p in LAB.rglob("*") if p.is_file()]
    rels = {r for r in found if r and r not in EXCLUDE_FILES and not r.startswith(EXCLUDE) and not r.startswith(REQUIRES_TREES)}
    for tree in REQUIRES_TREES:
        rels.update(str(p.relative_to(LAB)) for p in (LAB / tree).rglob("*") if p.is_file())
    return sorted(r for r in rels if "__pycache__" not in r and (LAB / r).is_file())


def bundle_tree_porcelain(extra_paths=()):
    """Porcelain lines for changes under paths that feed the bundle (repo root), outside ledger/, specs/, tasks/."""
    repo, code = LAB.parent, LAB.name
    paths = [code, "modelgateway", "harness", "sandbox", "tools", "gateway", "Cargo.lock", "Cargo.toml", *extra_paths]
    out = git_run(["git", "-C", str(repo), "status", "--porcelain", "--", *paths,
                          ":!%s/ledger" % code, ":!%s/specs" % code, ":!%s/tasks" % code],
                         capture_output=True, text=True, check=True).stdout
    return [line for line in out.splitlines() if line.strip()]


def refuse_dirty_tree(allow_dirty, extra_paths=()):
    """Refuse build when the working tree has local changes under bundle paths (public releases ship tracked files only)."""
    if allow_dirty or not in_git():
        return
    dirty = bundle_tree_porcelain(extra_paths)
    if dirty:
        sys.exit("node-bundle: refusing a dirty working tree (pass --allow-dirty to override):\n" + "\n".join(dirty))


def requires_trees():
    """An export has no gitignored trees: install tools/defuddle/node_modules from its lockfile (npm ci)."""
    nm = LAB / "tools/defuddle/node_modules"
    if not nm.is_dir():
        subprocess.run(["npm", "ci", "--silent", "--no-audit", "--no-fund"], cwd=str(nm.parent), check=True)


def client_web_files(src):
    """Committed client-web paths (relative to src) a release carries: git ls-files in a work tree, every file in an
    export; outside CLIENT_WEB_EXCLUDE except CLIENT_WEB_KEEP."""
    if in_git():
        out = git_run(["git", "-C", str(src), "ls-files", "-z", "--cached"], capture_output=True, check=True).stdout
        found = [r for r in out.decode("utf-8").split("\0") if r]
    else:
        found = [str(p.relative_to(src)) for p in src.rglob("*") if p.is_file() or p.is_symlink()]
    return sorted(r for r in found if r in CLIENT_WEB_KEEP or not r.startswith(CLIENT_WEB_EXCLUDE))


def build_client_web(dest, composer_auth=None):
    """dest/ = client-web ready to serve: committed files, vendor (no dev), built assets, package manifests.
    Returns bundle.json's "client_web" entry."""
    src = LAB.parent / CLIENT_WEB_SRC
    for rel in client_web_files(src):
        (dest / rel).parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src / rel, dest / rel, follow_symlinks=False)
    env = {k: v for k, v in os.environ.items() if not k.startswith(("GIT_", "DIRECTOR_", "DB_", "APP_", "LARAVEL_"))}
    if composer_auth:
        env["COMPOSER_AUTH"] = Path(composer_auth).read_text(encoding="utf-8")
    scratch = dest.parent / ".client-web-build-storage"  # Laravel's storage during the build; never shipped
    for d in ("framework/cache/data", "framework/views", "framework/sessions", "logs"):
        (scratch / d).mkdir(parents=True, exist_ok=True)
    env["LARAVEL_STORAGE_PATH"] = str(scratch)
    try:
        for argv in CLIENT_WEB_BUILD:
            subprocess.run(argv, cwd=str(dest), env=env, check=True, stdout=subprocess.DEVNULL if "artisan" in argv else None)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
        shutil.rmtree(dest / "node_modules", ignore_errors=True)
    missing = [n for n in CLIENT_WEB_NEEDS if not (dest / n).is_file()]
    if missing:
        sys.exit("node-bundle: the client-web build has no %s" % ", ".join(missing))
    php = subprocess.run(["php", "-r", "echo PHP_VERSION;"], capture_output=True, text=True, env=env).stdout.strip()
    return {"src": CLIENT_WEB_SRC, "path": CLIENT_WEB, "built_with_php": php or None, "requires_php_id": CLIENT_WEB_PHP,
            "composer_lock_sha256": sha256(dest / "composer.lock")}


def cargo_argv(optional=()):
    """The one cargo build: the node's binaries plus the OPTIONAL_BINARIES asked for."""
    return CARGO + [a for name in optional for a in ("-p", OPTIONAL_BINARIES[name][0])]


def build_binaries(target, dest, optional=()):
    """{name: built file} for this host's target, built from the working tree; {} for any other target. A name in
    `optional` (OPTIONAL_BINARIES) is built too (build refuses one for another target before writing)."""
    if target != host_target():
        return {}
    repo = LAB.parent
    subprocess.run(cargo_argv(optional), cwd=str(repo), check=True)
    dest.mkdir(parents=True, exist_ok=True)
    built = {}
    for name, (argv, cwd, file) in BINARIES.items():
        if argv:
            subprocess.run([a.format(out=dest / name) for a in argv], cwd=str(repo / cwd), check=True)
            built[name] = dest / name
        else:
            built[name] = repo / file
    for name in optional:
        built[OPTIONAL_BINARIES[name][2]] = repo / OPTIONAL_BINARIES[name][1]
        built[name] = built[OPTIONAL_BINARIES[name][2]]  # --director-rs lookups still find the file
    return built


def stage(out, target, bins):
    """Write OUT/release/ (cs/, bin/, gateway/models.json) from this checkout and `bins` {name: file}.
    Returns (files {"release/<rel>": sha256}, binaries [{name, path, bundled, reason?}])."""
    rel_root, files = out / "release", {}
    for rel in release_files():
        dst = rel_root / KIT / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(LAB / rel, dst, follow_symlinks=False)
    models = LAB.parent / "gateway/models.json"
    (rel_root / "gateway").mkdir(parents=True, exist_ok=True)
    shutil.copy2(models, rel_root / "gateway/models.json")
    binaries = []
    ship = list(BINARIES)
    for flag, spec in OPTIONAL_BINARIES.items():
        # Callers key the file by the flag (director-rs) or by the shipped name (cs-director).
        if (flag in bins or spec[2] in bins) and spec[2] not in ship:
            ship.append(spec[2])
    for name in ship:
        src = bins.get(name)
        if src is None:
            for flag, spec in OPTIONAL_BINARIES.items():
                if spec[2] == name:
                    src = bins.get(flag)
                    break
        if src is None:
            binaries.append({"name": name, "path": "bin/" + name, "bundled": False,
                             "reason": "no %s build on this %s host (Linux binaries arrive with phase 3b): required, "
                                       "not bundled" % (target, host_target())})
            continue
        dst = rel_root.joinpath("bin", name)
        dst.parent.mkdir(parents=True, exist_ok=True)
        if Path(src).resolve() != dst.resolve():
            shutil.copy2(src, dst)
        binaries.append({"name": name, "path": "bin/" + name, "bundled": True})
    bin_dir = rel_root / "bin"
    if any(b["name"] in TARGET_LINKS and b["bundled"] for b in binaries):
        tr = rel_root / "target" / "release"
        tr.mkdir(parents=True, exist_ok=True)
        for name in ("cs-tools", "cs-sandbox"):
            src = bin_dir / name
            if not src.is_file():
                continue
            dst = rel_root / TARGET_LINKS[name]
            if dst.exists() or dst.is_symlink():
                dst.unlink()
            try:
                os.link(src, dst)
            except OSError:
                shutil.copy2(src, dst)
    for p in sorted(rel_root.rglob("*")):
        rel = p.relative_to(rel_root)
        if p.is_symlink():
            files["release/" + str(rel)] = hashlib.sha256(("symlink:" + os.readlink(p)).encode()).hexdigest()
        elif p.is_file():
            files["release/" + str(rel)] = sha256(p)
    return files, binaries


def release_id(files, commit=None, extra_paths=()):
    """<YYYYMMDD>-<short sha>, plus -d<hash of the file hashes> when the shipped tree differs from the commit.
    From an export, `commit` (--commit) names it and the tree is the commit's by construction: never -d."""
    repo = LAB.parent
    if commit:
        return "%s-%s" % (datetime.now(timezone.utc).strftime("%Y%m%d"), commit[:9]), False
    short = git_run(["git", "-C", str(repo), "rev-parse", "--short=9", "HEAD"], capture_output=True,
                           text=True, check=True).stdout.strip()
    code = LAB.name  # the checkout's code root (cs since the cs/ rename)
    paths = [code, "modelgateway", "harness", "sandbox", "tools", "gateway", "Cargo.lock", "Cargo.toml", *extra_paths]
    dirty = git_run(["git", "-C", str(repo), "status", "--porcelain", "--", *paths, ":!%s/ledger" % code,
                            ":!%s/specs" % code, ":!%s/tasks" % code], capture_output=True, text=True, check=True).stdout.strip()
    rid = "%s-%s" % (datetime.now(timezone.utc).strftime("%Y%m%d"), short)
    if dirty:
        rid += "-d" + hashlib.sha256(json.dumps(files, sort_keys=True).encode()).hexdigest()[:6]
    return rid, bool(dirty)


def uv_version():
    uv = os.environ.get("UV") or shutil.which("uv") or str(Path.home() / ".local/bin/uv")
    return uv, subprocess.run([uv, "--version"], capture_output=True, text=True, check=True).stdout.split()[1]


MIRROR = "https://releases.astral.sh/github/"


def sums_url(archive_url):
    """The release's SHA256SUMS. uv may resolve archives through Astral's mirror, which serves the archives but not
    SHA256SUMS (2026-11-13, HTTP 404 on CI), so read the list from the same release on GitHub."""
    base = archive_url.rsplit("/", 1)[0]
    if base.startswith(MIRROR):
        base = "https://github.com/astral-sh/" + base[len(MIRROR):]
    return base + "/SHA256SUMS"


def python_download(uv, version, target):
    key = "cpython-%s-%s-%s" % (version, target, "gnu" if target.startswith("linux") else "none")
    out = subprocess.run([uv, "python", "list", "--all-platforms", "--all-versions", "--show-urls", "--only-downloads"],
                         capture_output=True, text=True, check=True).stdout
    for line in out.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0] == key:
            return parts[1]
    sys.exit("node-bundle: uv %s has no download named %s (uv python list --all-platforms --all-versions)" % (uv, key))


def incoming_path(dest):
    """A same-filesystem sibling of dest, used only when the temp dir is on another volume."""
    dest = Path(dest)
    return dest.with_name(".%s.incoming.%d" % (dest.name, os.getpid()))


def discard_partial(staging, dest):
    """Remove a failed build's temp dir and any half-copied sibling. Never removes a finished dest."""
    staging, dest = Path(staging), Path(dest)
    if staging.exists() and not (dest.exists() and os.path.samefile(staging, dest)):
        shutil.rmtree(staging, ignore_errors=True)
    inc = incoming_path(dest)
    if inc.exists() and not inc.is_symlink() and not (dest.exists() and os.path.samefile(inc, dest)):
        shutil.rmtree(inc, ignore_errors=True)


def place_bundle(staging, dest):
    """Move a finished bundle onto dest. The name appears only once the tree is complete."""
    staging, dest = Path(staging), Path(dest)
    if dest.exists():
        sys.exit("node-bundle: %s exists; choose a new directory" % dest)
    dest.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.rename(staging, dest)
        return
    except OSError as error:
        if error.errno != errno.EXDEV:
            raise
    inc = incoming_path(dest)
    try:
        if inc.exists():
            shutil.rmtree(inc)
        shutil.copytree(staging, inc, symlinks=True)
        os.rename(inc, dest)
    except BaseException:
        if inc.exists() and not inc.is_symlink():
            shutil.rmtree(inc, ignore_errors=True)
        raise
    shutil.rmtree(staging, ignore_errors=True)


def _assemble(a, out, target, uv, uvver, version):
    """Write a complete bundle into `out` (a temp directory). Returns (release id, python tag, files, binaries)."""
    requires_trees()
    optional = ["director-rs"] if a.director_rs else []
    bins = build_binaries(target, out / "release/bin", optional)
    client_web = build_client_web(out / "release" / CLIENT_WEB, a.composer_auth) if a.client_web else None
    files, binaries = stage(out, target, bins)
    rid, dirty = release_id(files, a.commit, [OPTIONAL_BINARIES[n][0] for n in optional] + ([CLIENT_WEB_SRC] if client_web else []))
    report = {"created": datetime.now(timezone.utc).isoformat(timespec="seconds"), "target": target, "release": a.release_version or rid,
              "lab_commit": a.commit or git_run(["git", "-C", str(LAB), "rev-parse", "HEAD"], capture_output=True,
                                                      text=True).stdout.strip(),
              "dirty": dirty, "python": {"version": version}, "uv": {"version": uvver}, "tools": [], "files": files,
              "binaries": binaries, "client_web": client_web}
    # uv binary for the target, hash-checked against the release's .sha256.
    name = "uv-%s.tar.gz" % TRIPLE[target]
    url = "%s/%s/%s" % (UV_RELEASES, uvver, name)
    data = fetch(url)
    want = fetch(url + ".sha256").decode().split()[0]
    got = hashlib.sha256(data).hexdigest()
    if got != want:
        sys.exit("node-bundle: %s sha256 %s, release says %s" % (name, got, want))
    (out / "uv").mkdir(parents=True)
    with tarfile.open(fileobj=io.BytesIO(data)) as tar:
        member = next(m for m in tar.getmembers() if m.name.endswith("/uv"))
        (out / "uv/uv").write_bytes(tar.extractfile(member).read())
    (out / "uv/uv").chmod(0o755)
    report["uv"].update({"url": url, "archive_sha256": got, "binary_sha256": sha256(out / "uv/uv")})
    # Python archive, in uv's mirror layout: <mirror>/<release tag>/<archive>.
    url = python_download(uv, version, target)
    tag, fname = url.rsplit("/", 2)[1:]
    fname = fname.replace("%2B", "+")
    data = fetch(url)
    got = hashlib.sha256(data).hexdigest()
    sums = fetch(sums_url(url)).decode()  # one file per release, "<sha256>  <archive>"
    want = next((l.split()[0] for l in sums.splitlines() if l.split()[-1:] == [fname]), None)
    if got != want:
        sys.exit("node-bundle: %s sha256 %s, release SHA256SUMS says %s" % (fname, got, want))
    (out / "python" / tag).mkdir(parents=True)
    (out / "python" / tag / fname).write_bytes(data)
    report["python"].update({"build": tag, "url": url, "file": "python/%s/%s" % (tag, fname), "sha256": got})
    tools = manifest_tools()
    report["tools"] = [{"name": t["name"], "runtime": t["runtime"], "requires": t.get("requires", [])} for t in tools]
    write_meta(out, report)
    return rid, tag, files, binaries


def build(a):
    if a.director:
        sys.exit("node-bundle: --director (the Laravel director's release tree) was retired on 2026-11-11; "
                 "--director-rs bundles the Rust Director")
    if a.release_version:
        core = r"(0|[1-9][0-9]*)"
        identifier = r"(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)"
        if not re.fullmatch(rf"v{core}\.{core}\.{core}(-{identifier}(\.{identifier})*)?", a.release_version):
            sys.exit("node-bundle: --release-version requires a strict semver tag")
    out = Path(a.out_dir)
    if in_git() == bool(a.commit):
        sys.exit("node-bundle: --commit SHA is for a `git archive` export (no .git), and an export needs it")
    if out.exists():
        sys.exit("node-bundle: %s exists; choose a new directory" % out)
    target = a.target or host_target()
    if target not in TRIPLE:
        sys.exit("node-bundle: target must be one of %s" % ", ".join(TRIPLE))
    if a.composer_auth and not (a.client_web and Path(a.composer_auth).is_file()):
        sys.exit("node-bundle: --composer-auth FILE needs --client-web and a readable file")
    if a.director_rs and target != host_target():
        sys.exit("node-bundle: --director-rs is built only for this host's target (%s), not %s" % (host_target(), target))
    extra = ([OPTIONAL_BINARIES["director-rs"][0]] if a.director_rs else []) + ([CLIENT_WEB_SRC] if a.client_web else [])
    refuse_dirty_tree(getattr(a, "allow_dirty", False), extra)
    version = (LAB / ".python-version").read_text(encoding="utf-8").strip()
    tools = manifest_tools()
    _, external = python_closure(tools)
    if external:
        sys.exit("node-bundle: non-stdlib imports, cannot bundle without dependencies: %s" % json.dumps(external))
    uv, uvver = uv_version()
    staging = Path(tempfile.mkdtemp(prefix="node-bundle-"))
    try:
        rid, tag, files, binaries = _assemble(a, staging, target, uv, uvver, version)
        place_bundle(staging, out)
    except BaseException:
        discard_partial(staging, out)
        raise
    if a.publish_dir:
        from node_publish import publish
        publish(out, a.publish_dir, a.channel)
    total = sum(p.stat().st_size for p in out.rglob("*") if p.is_file())
    print("node-bundle: %s release %s for %s: python %s (%s), uv %s, %d files, %d binaries, %.1f MB" %
          (out, rid, target, version, tag, uvver, len(files), sum(b["bundled"] for b in binaries), total / 1e6))



def write_meta(out, report):
    """bundle.json, indent 2: scripts/node-install reads its "target" and "release" lines with sed."""
    (out / "bundle.json").write_text(json.dumps(report, indent=2, sort_keys=False) + "\n", encoding="utf-8")


def deps(a):
    tools = manifest_tools()
    helpers, external = python_closure(tools)
    print(json.dumps({"python_version": (LAB / ".python-version").read_text(encoding="utf-8").strip(),
                      "tools": [t["name"] for t in tools], "runtimes": sorted({t["runtime"] for t in tools}),
                      "python_files": [str(p.relative_to(LAB)) for p in helpers], "external_imports": external}, indent=2))
    return 1 if external else 0


def probe(req, prefix):
    """Where a manifest 'requires' entry is satisfied on this host, or None (same lookup as the tool)."""
    estate = Path(os.environ.get("LAB_ESTATE_RUNTIME") or prefix / ".estate/runtime")  # browser_fetch.estate_runtime
    if req.startswith("tools/"):
        p = kit_root(prefix) / req.split()[0]
        return str(p) if p.is_file() else None
    if req.startswith("target/"):  # a runtime exe tool's bin, relative to the release holding lab/
        p = prefix / req
        return str(p) if p.is_file() and os.access(p, os.X_OK) else None
    if req.startswith("gstack browse"):
        cands = [os.environ.get("LAB_BROWSE"), estate / "browse", Path.home() / ".claude/skills/gstack/browse/dist/browse"]
        return next((str(c) for c in cands if c and Path(c).is_file() and os.access(c, os.X_OK)), None)
    if req.startswith("Playwright"):
        cache = os.environ.get("PLAYWRIGHT_BROWSERS_PATH") or estate / "ms-playwright"
        root = Path(cache) / req.split()[1]  # chromium_headless_shell-<revision>
        return str(root) if root.is_dir() else None
    return shutil.which(req.split()[0])


def verify(a):
    bundle, prefix = Path(a.bundle).resolve(), Path(a.prefix).resolve()
    meta = json.loads((bundle / "bundle.json").read_text(encoding="utf-8"))
    bad = []
    if meta["target"] != host_target():
        bad.append("bundle built for %s, host is %s" % (meta["target"], host_target()))
    for rel, want in meta["files"].items():
        for p in (bundle / rel, prefix / rel.split("/", 1)[1]):  # the bundle as shipped and the installed release
            if p.is_symlink():
                got = hashlib.sha256(("symlink:" + os.readlink(p)).encode()).hexdigest()
                if got != want:
                    bad.append("%s symlink hash differs" % p)
            elif not p.is_file() or sha256(p) != want:
                bad.append("%s %s" % (p, "missing" if not p.is_file() else "sha256 differs"))
    for b in meta.get("binaries", []):
        p = prefix / b["path"]
        if b["bundled"] and not (p.is_file() and os.access(p, os.X_OK)):
            bad.append("%s missing or not executable" % p)
        link = TARGET_LINKS.get(b["name"])
        if b["bundled"] and link:
            lp = prefix / link
            ok = lp.is_file() and p.is_file() and os.path.samefile(lp, p)
            if not ok:
                bad.append("%s missing or not the same file as %s" % (prefix / link, b["path"]))
    py = Path(sys.executable).resolve()
    want = meta["python"]["version"]
    if not str(py).startswith(str(prefix)) or platform.python_version() != want:
        bad.append("interpreter %s is %s, want %s under %s" % (py, platform.python_version(), want, prefix))
    sandbox = "sandbox-exec" if host_target().startswith("macos") else "bwrap"
    unbundled = {TARGET_LINKS[b["name"]]: b.get("reason", "") for b in meta.get("binaries", [])
                 if not b["bundled"] and b["name"] in TARGET_LINKS}
    tools, missing = [], {}
    for t in meta["tools"]:
        runtime = sys.executable if t["runtime"] == "python3" else shutil.which(t["runtime"])
        need = t["runtime"]
        if t["runtime"] == "exe":  # the descriptor's bin, under the release (the repo holding lab/) unless absolute
            sys.path.insert(0, str(LAB / "ops/bin"))
            import _sandbox_policy  # tool_argv; imported here so capture-stimulus can load this file anywhere
            need = _sandbox_policy.tool_argv(LAB, t["name"])[0]
            runtime = need if Path(need).is_file() and os.access(need, os.X_OK) else None
        found = {req: probe(req, prefix) for req in t["requires"]}
        found = {("%s (%s)" % (k, unbundled[k]) if k in unbundled else k): v for k, v in found.items()}
        if t["name"] == "exec":  # one sandbox per platform, not both
            found = {k: v for k, v in found.items() if k == sandbox}
        lacking = [k for k, v in found.items() if v is None] + ([need] if runtime is None else [])
        tools.append({"name": t["name"], "runtime": t["runtime"], "interpreter": runtime, "requires": found, "ok": not lacking})
        for k in lacking:
            missing.setdefault(k, []).append(t["name"])
    if meta.get("client_web"):  # served by the host's php (node-release --serve-client-web)
        php = shutil.which("php")
        got = subprocess.run([php, "-r", "echo PHP_VERSION_ID;"], capture_output=True, text=True).stdout.strip() if php else ""
        ok = got.isdigit() and int(got) >= meta["client_web"].get("requires_php_id", CLIENT_WEB_PHP)
        tools.append({"name": "client-web", "runtime": "php", "interpreter": php, "requires": {}, "ok": ok})
        if not ok:
            missing.setdefault("php >= 8.3", []).append("client-web")
    out = {"bundle": str(bundle), "prefix": str(prefix), "target": meta["target"], "release": meta.get("release"),
           "lab_commit": meta.get("lab_commit"),
           "python": {"path": str(py), "version": platform.python_version(), "want": want, "build": meta["python"].get("build")},
           "uv": meta["uv"]["version"], "files_checked": len(meta["files"]), "errors": bad, "tools": tools,
           "missing_host_runtimes": missing, "ok": not bad and not missing}
    print(json.dumps(out, indent=2))
    return 1 if bad else 2 if missing else 0


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n", 1)[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    b = sub.add_parser("build", help="build an offline bundle (connected machine)")
    b.add_argument("--target", help="one of %s (default: this host)" % ", ".join(TRIPLE))
    b.add_argument("--director-rs", action="store_true", help="include bin/cs-director (a host serving the Rust Director)")
    b.add_argument("--client-web", action="store_true", help="include client-web/ (a host serving client-web)")
    b.add_argument("--composer-auth", metavar="FILE", help="composer auth.json for --client-web (never copied or printed)")
    # Retired, kept only so it refuses clearly instead of abbreviating to --director-rs.
    b.add_argument("--director", action="store_true", help=argparse.SUPPRESS)
    b.add_argument("--commit", help="the commit an export was made from (git archive has no .git): required there")
    b.add_argument("--release-version", help="semver tag used as the published release identity")
    b.add_argument("--publish-dir", help="also write tar.gz, .sha256 and channel JSON here (outside OUT_DIR)")
    b.add_argument("--channel", choices=("stable", "latest"), default="stable", help="published index channel")
    b.add_argument("--allow-dirty", action="store_true",
                   help="build despite an untracked or modified working tree under bundle paths")
    b.add_argument("out_dir")
    sub.add_parser("deps", help="dependency scan only (no network)")
    v = sub.add_parser("verify", help="verify a release installed by scripts/node-install")
    v.add_argument("bundle")
    v.add_argument("prefix", metavar="release")
    a = ap.parse_args()
    return {"build": build, "deps": deps, "verify": verify}[a.cmd](a)


if __name__ == "__main__":
    sys.exit(main())
