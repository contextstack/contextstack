#!/usr/bin/env python3
"""Gate rules-tier commits while scripts/check is red.

pre-commit: run check (caller passes output path + rc). Green always
passes. Red with no rules-tier paths fails. Red with rules-tier paths
defers to commit-msg (exit 0) so a check-red: subject can land.

commit-msg: a deferred red rules commit is refused unless the subject
starts with check-red: and names each parsed FAIL family. Unparseable
red output cannot be excepted. Authorization is recorded here;
post-commit records a landed commit only after HEAD moves.
"""
import importlib.util
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

MAX_CHECK_OUTPUT = 4000
_HERE = Path(__file__).resolve().parent
_spec = importlib.util.spec_from_file_location("estate_classify", _HERE / "estate_classify.py")
_mod = importlib.util.module_from_spec(_spec)
_spec.loader.exec_module(_mod)
is_rules = _mod.is_rules

def root():
    # lab may be its own repo or a subfolder of one; git runs from here and
    # --relative keeps paths lab-relative and drops paths outside lab.
    return _HERE.parent


def git_path(name):
    return root() / subprocess.check_output(
        ["git", "rev-parse", "--git-path", name], text=True, cwd=root()).strip()


def staged_paths():
    raw = subprocess.check_output(["git", "diff", "--cached", "--name-only", "--relative", "-z"],
                                  cwd=root())
    return [p.decode("utf-8", errors="surrogateescape") for p in raw.split(b"\0") if p]


def fail_families(output):
    families = []
    seen = set()
    for line in output.splitlines():
        if "FAIL — " not in line:
            continue
        rest = line.split("FAIL — ", 1)[1].strip()
        if rest.startswith("specs/") or "with no archive" in rest or "no dispatch job" in rest:
            key = "rule 7 live specs"
        elif "cap 80" in rest or "lines (cap 80)" in rest:
            key = "doc cap"
        else:
            key = rest
        if key not in seen:
            seen.add(key)
            families.append(key)
    return families


def names_family(message, family):
    text = message.lower()
    if family == "rule 7 live specs":
        return any(tok in text for tok in ("rule 7", "spec-queue", "stale spec", "live spec", "not archived"))
    if family == "doc cap":
        return any(tok in text for tok in ("doc cap", "cap 80", "80-line", "80 lines"))
    needle = family.lower()
    if len(needle) <= 24:
        return needle in text
    return needle[:24] in text or needle in text


def append_event(lab, row):
    sys.path.insert(0, str(_HERE.parent / "ops/bin"))
    from _estate_io import state_dir
    path = Path(os.environ.get("LAB_ESTATE_ALERTS") or state_dir(lab) / "estate-commit.jsonl")
    if not os.environ.get("LAB_ESTATE_ALERTS") and not os.environ.get("LAB_STATE_ROOT") and not path.parent.is_dir():  # never recreate <lab>/ledger
        raise SystemExit("check-red-gate: no state root: lab/ledger has left this checkout and LAB_STATE_ROOT is not set. Record check-red rows where the estate lives: LAB_CONFIG_ROOT=$HOME/.contextstack/config LAB_STATE_ROOT=$HOME/.contextstack/state")
    path.parent.mkdir(parents=True, exist_ok=True)
    sys.path.insert(0, str(_HERE.parent / "ops/bin"))
    from _estate_io import estate_dir
    if (estate_dir(lab) / "ESTATE").exists() or (lab / "ledger/estate-cutover.json").exists():
        from _estate_io import estate_row
        row = estate_row(path, row)
    with path.open("a", encoding="utf-8") as dest:
        dest.write(json.dumps(row, sort_keys=True, separators=(",", ":")) + "\n")
        dest.flush()
        os.fsync(dest.fileno())
    return path


def iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def author():
    try:
        ident = subprocess.check_output(["git", "var", "GIT_AUTHOR_IDENT"], text=True).strip()
    except subprocess.CalledProcessError:
        ident = subprocess.check_output(["git", "config", "user.name"], text=True).strip()
    return ident


def cmd_pre_commit(out_path, rc):
    sidecar = git_path("check-red-output")
    output = Path(out_path).read_text(encoding="utf-8", errors="replace") if Path(out_path).is_file() else ""
    rules = [p for p in staged_paths() if is_rules(p)]
    if int(rc) == 0:
        sidecar.unlink(missing_ok=True)
        return 0
    if not rules:
        sidecar.unlink(missing_ok=True)
        return 1
    sidecar.write_text(output, encoding="utf-8")
    sys.stderr.write(
        "pre-commit: check is red and rules-tier paths are staged; "
        "commit-msg checks ops cap-debt separately; other reds require check-red: naming the failing rules\n"
    )
    return 0


def cmd_commit_msg(msg_path):
    sidecar = git_path("check-red-output")
    message = Path(msg_path).read_text(encoding="utf-8", errors="replace")
    subject = next((ln.strip() for ln in message.splitlines() if ln.strip()), "")
    if not sidecar.is_file():
        return 0
    output = sidecar.read_text(encoding="utf-8", errors="replace")
    # commit-msg has independently enforced the actual indexed ops cap first.
    # Its debt lane may discharge only that exact failure, never a fixture red.
    lines = [line for line in output.splitlines()
             if not line.startswith("check: FAIL — ops cap: ")]
    if lines != output.splitlines():
        output = "\n".join(lines)
        if "check: ops-cap-only-failure" in lines and not fail_families(output):
            sidecar.unlink(missing_ok=True)
            return 0
        sidecar.write_text(output, encoding="utf-8")
    rules = [p for p in staged_paths() if is_rules(p)]
    families = fail_families(output)
    if not subject.lower().startswith("check-red:"):
        sys.stderr.write(
            "commit-msg: FAIL — rules-tier commit while check is red must start with "
            "check-red: and name the failing rule(s) it is not responsible for\n"
        )
        return 1
    if not families:
        sys.stderr.write(
            "commit-msg: FAIL — check is red but no 'FAIL — ' lines were parsed; "
            "cannot authorize an unnamed exception\n"
        )
        return 1
    missing = [fam for fam in families if not names_family(message, fam)]
    if missing:
        sys.stderr.write(
            "commit-msg: FAIL — check-red: subject does not name failing rule(s): "
            + "; ".join(missing[:8]) + "\n"
        )
        return 1
    append_event(root(), {
        "ts": iso(),
        "event": "check_red_rules_authorized",
        "state": "authorized",
        "reason": "check-red",
        "author": author(),
        "files": rules,
        "subject": subject,
        "check_output": output[-MAX_CHECK_OUTPUT:],
    })
    return 0


def cmd_post_commit():
    sidecar = git_path("check-red-output")
    if not sidecar.is_file():
        return 0
    output = sidecar.read_text(encoding="utf-8", errors="replace")
    subject = subprocess.check_output(["git", "log", "-1", "--format=%s"], text=True, cwd=root()).strip()
    if not subject.lower().startswith("check-red:"):
        sidecar.unlink(missing_ok=True)
        return 0
    commit = subprocess.check_output(["git", "rev-parse", "HEAD"], text=True, cwd=root()).strip()
    files = subprocess.check_output(
        ["git", "diff-tree", "--no-commit-id", "--name-only", "--relative", "-r", "HEAD"],
        text=True, cwd=root(),
    ).splitlines()
    append_event(root(), {
        "ts": iso(),
        "event": "check_red_rules_commit",
        "state": "ok",
        "reason": "check-red",
        "author": author(),
        "files": [p for p in files if is_rules(p)],
        "subject": subject,
        "commit": commit,
        "check_output": output[-MAX_CHECK_OUTPUT:],
    })
    sidecar.unlink(missing_ok=True)
    return 0


def main(argv):
    if len(argv) < 2:
        print("usage: check-red-gate pre-commit <output> <rc> | commit-msg <path> | post-commit",
              file=sys.stderr)
        return 2
    if argv[1] == "pre-commit":
        return cmd_pre_commit(argv[2], argv[3] if len(argv) > 3 else "1")
    if argv[1] == "commit-msg":
        return cmd_commit_msg(argv[2])
    if argv[1] == "post-commit":
        return cmd_post_commit()
    print("unknown mode", argv[1], file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
