if [ "$ops_cap_fail" -ne 0 ]; then
  [ "$fail" -ne 0 ] || echo "check: ops-cap-only-failure"
  fail=1
fi
if [ "$fail" -eq 0 ]; then echo "check: ok"; fi
exit "$fail"
