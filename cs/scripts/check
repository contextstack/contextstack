# The Rust gateway rule 0 just built, against its black-box contract suite: the offline fast subset (all but six
# slow timing cases; ~20 s). No cargo: rule 0 built nothing, so this is skipped with it (G1 2).
if command -v cargo >/dev/null 2>&1; then
  bg_rule "the Rust gateway (target/release/cs-gateway) fails its black-box contract suite: modelgateway-spec --fast --impl rust" \
    env CSGATEWAY_BIN="$(cd .. && pwd)/target/release/cs-gateway" ../tests/gateway-spec/run --fast --impl rust
fi
# cs-sandbox's own tests, including the golden test that the Rust cli-executor profile equals the Python
# sandbox_cmd profile byte for byte. CI also runs them, but nothing pushes yet, so the gate must (5th pass).
if command -v cargo >/dev/null 2>&1; then
  bg_rule "the Rust sandbox profiles drift from the Python ones or cs-sandbox fails its tests (cd .. && cargo test --locked -p cs-sandbox)" \
    sh -c 'cd .. && cargo test --locked -q -p cs-sandbox'
fi
bg_rule "HOME read allowlists or centralized Seatbelt read rules regressed" \
  tasks/regressions/home-read-allowlist/check
bg_rule "Seatbelt path literals must preserve UTF-8 and escape quotes, not JSON-escape or splice raw paths (sbpl-quote)" \
  tasks/regressions/sbpl-quote/check
bg_rule "production Python emits Seatbelt rules" tasks/regressions/no-python-sbpl/check
