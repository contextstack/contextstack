#!/usr/bin/env bash
# checkout check — the constitution as a linter. Subject to its own caps.
set -u
# No rule inherits the caller's git: a commit hook exports GIT_DIR, GIT_INDEX_FILE and GIT_WORK_TREE (git may add
# GIT_PREFIX, GIT_AUTHOR_*, ...), which turned fixture repos' git init/add/commit into writes to the real repository
# (2026-11-10, tasks/regressions/check-git-env). Every git call finds its repo from its own -C or cwd.
while IFS= read -r v; do unset "$v"; done < <(compgen -e | grep '^GIT_')
# Nor the caller's roots: once the ledger lives in ~/.contextstack/state, an operator shell exports CS_STATE_ROOT, and
# a rule that inherited it would write fixture rows into the real estate. Rules that need a root set their own.
unset CS_CODE_ROOT CS_CONFIG_ROOT CS_STATE_ROOT CS_WORKSPACES_ROOT
# cs resolves its installed estate and worker profiles through these overrides.
unset CS_ROOT CS_INSTALL_ROOT CS_AGENTS_DIR
# Nor cs land's own commit bypass: its pre-commit runs this check, and a test of the land lock would inherit it.
unset CS_LAND_COMMIT
# Parallel fixtures need more startup headroom than standalone runs. Only harness
# waits opt into this scale; behavioral deadlines remain unchanged.
export CHECK_TIMEOUT_SCALE="${CHECK_TIMEOUT_SCALE:-3}"
cd "$(dirname "$0")/.."
# In a lane, use the granted pin for python3 shebangs as well as installer fixtures.
if [ -n "${UV_PYTHON_INSTALL_DIR:-}" ] && [ -r .python-version ] && command -v uv >/dev/null 2>&1; then
  if pinned_python=$(uv python find --offline --managed-python --no-project "$(cat .python-version)" 2>/dev/null) \
    && [ -x "$pinned_python" ]; then
    export PATH="$(dirname "$pinned_python"):$PATH"
  fi
fi
python3 scripts/check_timeout.py || { echo "check: CHECK_TIMEOUT_SCALE must be a finite positive number" >&2; exit 1; }
# The public curl | sh installer must stay plain POSIX sh (it runs before any Python exists).
sh -n scripts/install.sh || { echo "check: scripts/install.sh no longer parses as POSIX sh" >&2; exit 1; }
# BEGIN background check harness
fail=0
ops_cap_fail=0
say() { echo "check: FAIL — $*"; fail=1; }

bg_rule() {
  local msg="$1" log
  shift
  log=$(mktemp)
  ( "$@" >"$log.output" 2>&1 || printf '%s\n' "$msg" > "$log" ) &
  _bg_pids="${_bg_pids:-} $!"
  _bg_logs="${_bg_logs:-} $log"
}
wait_rules() {
  local pid log
  for pid in ${_bg_pids:-}; do
    wait "$pid" || true
  done
  for log in ${_bg_logs:-}; do
    if [ -s "$log" ]; then
      say "$(cat "$log")"
      cat "$log.output"
      # cs land keeps only FAIL lines; keep the rule's whole output where the owner can read it.
      kept="${TMPDIR:-/tmp}/check-failed-$(date +%Y%m%d-%H%M%S)-${log##*/}.log"
      cp "$log.output" "$kept" 2>/dev/null && echo "check: FAIL output kept: $kept"
    fi
    rm -f "$log" "$log.output"
  done
  _bg_pids=""
  _bg_logs=""
}
# END background check harness

# 11–40 fire in parallel; each rule still runs.
if [ "${CS_SPILL_ONLY:-}" != 1 ]; then
# Only the full check scans the shared checkout; isolated fixtures must not inherit unrelated findings.
# Scratch dirs inside the work tree race parallel scans and node-bundle walks (three red lands on 2026-11-12).
in_tree=$(grep -rlE 'dir=(Path\.cwd\(\)|os\.getcwd\(\))' tasks/regressions 2>/dev/null | grep -v '/fixtures/' || true)
[ -z "$in_tree" ] || say "regressions make scratch dirs inside the work tree (use the system temp dir): $in_tree"
# Raw environment copies inherit the installed estate; use the shared fixture environment.
raw_env=$(python3 - <<'PYENV'
import pathlib, re
# Only environments handed to a process: `**os.environ` spreads, and copies assigned to `env`/`env_*` or passed as
# `env=`. Snapshots (`before = os.environ.copy()`) and comparisons are observations and stay allowed.
pattern = re.compile(r"\*\*\s*os\.environ\s*[,}]|\benv\w*\s*=\s*(?:dict\s*\(\s*os\.environ\s*[,)]|os\.environ\.copy\s*\(\s*\))")
root = pathlib.Path("tasks/regressions")
for path in sorted([*root.glob("*/check"), *root.glob("*/fixtures/*.py")]):
    try:
        source = path.read_text()
    except OSError:
        continue
    if pattern.search(source):
        print(path)
PYENV
)
[ -z "$raw_env" ] || say "regressions copy raw os.environ; use hermetic_env() from regressions/_lib/hermetic_env.py: $raw_env"

# 0. fs_read and fs_edit are target/release/cs-tools; the rules below exec them. target/release/cs-harness
# is the default runner (_runner) the runner regressions and rule 6 use, and target/release/cs-gateway
#    the gateway the gateway fixtures start (target/release/cs-director the Director cs-init serves); target/release/cs-sandbox the wrapper the sandbox rules confine with (a
# stale one refuses a newer policy, e.g. $TOOL_PYTHON). Built here: cargo is incremental (a no-op when current), so an edited
#    crate or a fresh checkout never runs a stale or missing tool, runner or gateway. No cargo on PATH: skipped,
#    said, and rule 1e names the gap. Nothing here builds Go: the Go runner and gateway are archived (ADR 0011).
if command -v cargo >/dev/null 2>&1; then
  # A successful build means cargo found every binary current; mark them so (a Cargo.lock change for another crate
  # leaves cs-harness untouched, and the runner freshness rule compares mtimes against Cargo.lock).
  (cd .. && cargo build --release --locked -q -p cs-tools -p cs-harness -p cs-sandbox -p cs-gateway -p cs-director \
    && touch target/release/cs-harness) || say "cs-tools, cs-harness, cs-sandbox, cs-gateway or cs-director does not build (cargo build --release -p cs-tools -p cs-harness -p cs-sandbox -p cs-gateway -p cs-director at the repo root)"
  # Regressions copy ops/bin into partial estates with no release bin/: render profiles with this build.
  export CS_SANDBOX_BIN="${CS_SANDBOX_BIN:-$(cd .. && pwd)/target/release/cs-sandbox}"
  # The public repository's CI runs `cargo fmt --all --check` first; keep the same bar here.
  (cd .. && cargo fmt --all --check >/dev/null) || say "Rust code is not rustfmt-formatted (run cargo fmt --all at the repo root)"
  (cd .. && cargo clippy --release --locked --all-targets -p cs-tools -p cs-harness -p cs-sandbox -p cs-gateway -p cs-director -- -D warnings) || say "cs-director, cs-gateway, cs-harness, cs-sandbox or cs-tools has Clippy warnings (cargo clippy --release --all-targets -p cs-tools -p cs-harness -p cs-sandbox -p cs-gateway -p cs-director -- -D warnings at the repo root)"
else
  echo "check: skip cs-tools build: no cargo on PATH; tools whose descriptor names target/release/cs-tools cannot run, and the gateway contract suite is skipped" >&2
fi
# 0b. defuddle_extract runs tools/defuddle/extract.mjs against its vendored node_modules, which are gitignored
#     (package-lock.json is tracked). A fresh checkout installs them here from the lockfile, as rule 0 builds
#     cs-tools, so its fixture never fails on a missing dependency. No npm on PATH: skipped and said.
if [ ! -d tools/defuddle/node_modules ]; then
  if command -v npm >/dev/null 2>&1; then
    (cd tools/defuddle && npm ci --silent --no-audit --no-fund >/dev/null 2>&1) || say "tools/defuddle dependencies do not install (cd cs/tools/defuddle && npm ci)"
  else
    echo "check: skip defuddle install: no npm on PATH; defuddle_extract's derive fixture cannot pass (cd cs/tools/defuddle && npm ci)" >&2
  fi
fi
# These fixtures enforce short process deadlines; run before the parallel batch.
tasks/regressions/fake-provider/check || say "estate gateway capacity exceeds its share or fake provider contract fails"
tasks/regressions/dispatch-timeout-recovery/check || say "dispatcher timeout does not cancel, release capacity, or admit the next job"
tasks/regressions/fake-cli/check || say "fake claude loses its argument/environment recording contract"
tasks/regressions/cli-providers/check || say "profiled CLI credentials, isolation or terminal evidence regressed"
tasks/regressions/cli-pins-per-machine/check || say "per-machine CLI pins regressed"
tasks/regressions/profiled-executor-roots/check || say "a profiled CLI template (opencode, pi, ...) with separate code, state, config and workspaces roots fails on a task outside the code root, lands under the code root, or keeps incomplete evidence"
tasks/regressions/muse-executor/check || say "Muse credentials, process boundary, frozen context or terminal evidence regressed"
tasks/regressions/evidence-backup-long-path/check || say "evidence backup accepts an unsafe long-path sender or loses retained evidence"
tasks/regressions/director-backup/check || say "Director WAL snapshot, encrypted backup, restore or retention regressed"
python3 ops/bin/_vitals_test.py || say "vitals parsers, resource guard, or job intake hold regressed"
python3 ops/bin/_job_linux_test.py || say "Linux subreaper cleanup regressed"
python3 ops/bin/_job_memory_test.py || say "per-job memory cap or pi harness cost/usage regressed"
tasks/regressions/job-double-fork/check || say "double-fork job ownership, detached memory cap or PID identity regressed"
python3 ops/bin/_lanes_test.py || say "lane HEAD/branch-ref verification or the setsid process sweep regressed"
tasks/regressions/tracked-secret-history/check || say "a lane is still allowed when a secret-named file survives only in history, on another ref, or under a different case (#54)"
tasks/regressions/transcript-redaction/check || say "a transcript, event, or task_output still returns a director token, PEM block, auth header, URL password, or provider token (#43)"
# node-install runs node-bundle's cargo build, and cargo re-links every target/release binary even when nothing changed
# (each path is briefly missing), so in the batch it raced the rules that exec them: "cs-tools ... is not built",
# a gateway case that could not spawn (2026-11-11). Serial, before the batch; no batch rule may run cargo.
tasks/regressions/node-install/check || say "the node image no longer installs offline from a bundle, or a manifest tool needs more than the pinned interpreter"
bg_rule "a regression has no full-check entry or documented exclusion" python3 scripts/check-regression-coverage.py
bg_rule "landing loses owner changes, lane exclusivity, or gate cleanup" tasks/regressions/cs-land/check
