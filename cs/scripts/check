python3 scripts/ops-cap.py check || ops_cap_fail=1

# 1b. Every op keeps its executable bit IN GIT: a sidecar'd op or a shebang
#     file recorded as 100644 is refused by the operator UI and by a mode-
#     preserving copy, while fixtures that chmod their copies never notice.
for f in $(git ls-files -s ops/bin | awk '$1=="100644"{print $4}' | grep -v '\.json$\|/_'); do
  if [ -f "${f}.json" ] || head -c2 "$f" 2>/dev/null | grep -q '^#!'; then
    say "$f is not executable in git (mode 100644): git update-index --chmod=+x $f"
  fi
done
# 1c. Node image: nothing in a bin dir is unreachable from the live
#     roots (specs/sweeps and specs/judgments retired), tools/manifest.json is
#     the traversal's output, and every tool descriptor's runtime is its shebang.
unreach=$(python3 scripts/tool-reach --no-sweeps --unreachable | tr '\n' ' ')
[ -z "$unreach" ] || say "unreachable from every live root (scripts/tool-reach --no-sweeps): ${unreach}— delete it or name it from a spec, hook, op, the runner, OPERATOR.md or fixture"
python3 scripts/tool-reach --manifest | diff -q - tools/manifest.json >/dev/null 2>&1 ||
  say "tools/manifest.json drifts from the traversal — scripts/tool-reach --manifest > tools/manifest.json"
rt_bad=$(python3 - <<'PY'
import json, os, glob
for d in sorted(glob.glob("tools/bin/*.json")):
    exe = d[:-5]
    if not os.path.isfile(exe): continue
    try: rt = json.load(open(d)).get("runtime")
    except ValueError as e: print(f"{d} (invalid JSON: {e})"); continue
    sb = open(exe, errors="replace").readline().rstrip("\n")
    parts = sb[2:].split() if sb.startswith("#!") else []
    if parts and os.path.basename(parts[0]) == "env": parts = parts[1:]
    want = os.path.basename(parts[0]) if parts else None
    if rt != want: print(f"{d} (runtime {rt!r}, shebang {want!r})")
PY
)
[ -z "$rt_bad" ] || say "tool descriptor runtime missing or not its shebang: $(echo $rt_bad)"
# 1d. Descriptors follow MCP's tool definition fields: inputSchema, never schema/input_schema/input;
#     bin (a path, relative to the repo holding checkout/ unless absolute) and args (strings) only with runtime exe,
#     which has bin and no file of its own in tools/bin (the runners exec bin + args, never the file pair).
desc_bad=$(python3 - <<'PY'
import json, os, glob
for d in sorted(glob.glob("tools/bin/*.json")):
    try: j = json.load(open(d))
    except ValueError: continue  # 1c names it
    bad = [k for k in ("schema", "input_schema", "input") if k in j] + ([] if "inputSchema" in j else ["no inputSchema"])
    exe = j.get("runtime") == "exe"
    if exe and not (isinstance(j.get("bin"), str) and j["bin"]): bad.append("exe without bin")
    if not exe and ("bin" in j or "args" in j): bad.append("bin/args without runtime exe")
    if "args" in j and not (isinstance(j["args"], list) and all(isinstance(a, str) for a in j["args"])): bad.append("args not strings")
    if exe and os.path.exists(d[:-5]): bad.append("exe with a file pair executable")
    if bad: print(f"{d} ({', '.join(bad)})")
PY
)
[ -z "$desc_bad" ] || say "tool descriptor not in MCP shape (inputSchema; bin/args only with runtime exe): $(echo $desc_bad)"
# 1e. A runtime exe descriptor's bin exists and is executable whenever a release build exists
#     (../target/release); with none at all, skipped and said, since rule 0 could not build without cargo.
if [ -d ../target/release ]; then
  exe_bad=$(python3 - <<'PY'
import glob, json, os, sys
sys.path.insert(0, "ops/bin")
import _sandbox_policy
for d in sorted(glob.glob("tools/bin/*.json")):
    try: j = json.load(open(d))
    except ValueError: continue  # 1c names it
    if j.get("runtime") != "exe" or not j.get("bin"): continue  # 1d names a missing bin
    b = _sandbox_policy.tool_argv(".", os.path.basename(d)[:-5])[0]
    if not (os.path.isfile(b) and os.access(b, os.X_OK)): print(f"{d} ({j['bin']})")
PY
)
  [ -z "$exe_bad" ] || say "runtime exe descriptor names a bin that is not built: $(echo $exe_bad) — cargo build --release at the repo root"
else
  echo "check: skip rule 1e (exe bins built): no ../target/release" >&2
fi
python3 scripts/node-bundle deps >/dev/null 2>&1 || say "a manifest tool imports outside the standard library (scripts/node-bundle deps; the node ships a pinned interpreter and nothing else)"
# 2. Doc cap: every markdown file <= 80 lines (ledger/, setup/, and
#    product stimulus goal.md under tasks/work|sweeps are exempt).
while IFS= read -r f; do
  n=$(wc -l < "$f" | tr -d ' ')
  [ "$n" -le 80 ] || say "$f is $n lines (cap 80) — a doc that long is hiding a spec"
done < <(find . \( -path './.git' -o -path './ledger' -o -path '*/setup' -o -path '*/node_modules' \
  -o -path './tasks/work' -o -path './tasks/sweeps' \) -prune -o -name '*.md' -print)
# Re-include non-goal markdown under work/sweeps (notes stay capped).
while IFS= read -r f; do
  case "$f" in */goal.md) continue ;; esac
  n=$(wc -l < "$f" | tr -d ' ')
  [ "$n" -le 80 ] || say "$f is $n lines (cap 80) — a doc that long is hiding a spec"
done < <(find ./tasks/work ./tasks/sweeps \( -path '*/setup' \) -prune -o -name '*.md' -print 2>/dev/null)

# 3. Specs: required keys.
#    (specs/sweeps and specs/judgments were archived in the 2026-11-09 prune;
#    the -e guard keeps an absent or empty dir silent.)
for s in specs/*.yaml; do
  [ -e "$s" ] || continue
  for k in id tools budget tasks trials; do
    grep -q "^$k:" "$s" || say "$s missing '$k:'"
  done
  grep -qE '^model:[[:space:]]*[^[:space:]#]+' "$s" ||
    say "$s has no model: (PINNED.md pins $(sed -n 's/^pinned:[[:space:]]*//p' PINNED.md 2>/dev/null | head -1))"
done

# 4. Archived specs must carry a verdict.
for s in specs/archive/*.yaml; do
  [ -e "$s" ] || continue
  grep -q "^verdict:" "$s" || say "$s archived without a verdict line"
done

# 5. Tasks: goal.md + executable check. goal.md is stimulus only.
for t in tasks/*/ tasks/work/*/ tasks/regressions/*/ tasks/sweeps/*/; do
  [ "$t" != "tasks/regressions/_lib/" ] || continue
  [ -d "$t" ] || continue
  # tasks/regressions/_lib/ holds shared fixture helpers (hermetic_env.py), not a task.
  case "$t" in tasks/judgments/|tasks/regressions/|tasks/regressions/_lib/|tasks/work/|tasks/sweeps/) continue ;; esac
  [ -f "${t}goal.md" ] || say "$t missing goal.md"
  [ -x "${t}check" ] || say "$t check missing or not executable"
  grep -q '<!--' "${t}goal.md" 2>/dev/null && say "${t}goal.md has a comment — move it to notes.md"
done

# 6. The running thing must not lag its source (stale binary).
if ! runner_freshness=$(python3 ops/bin/_runner.py 2>&1); then
  say "$runner_freshness"
elif [ -n "$runner_freshness" ]; then
  printf '%s\n' "$runner_freshness" >&2
fi

# 7. (Spec queue rule retired with the lab, 2026-11-13.)

# 8. Authority is one-way: checkout files never cite the vault.
if grep -rq 'markdown/ContextStack' PINNED.md INVARIANTS.md SCHEMA.md README.md CLAUDE.md OPERATOR.md specs/ prompts/ 2>/dev/null; then
  say "a checkout file cites the vault — authority flows checkout→vault, never back"
fi
fi

# 9. runtime spill stays untracked (checkout, dest, post-prune workspaces).
last_prune=${CS_SPILL_PRUNE:-}
[ -z "$last_prune" ] && last_prune=$(head -1 ledger/last-prune 2>/dev/null || true)
[ -z "$last_prune" ] && last_prune="2026-09-04T15:05:00"
tracked_spill() { [ -n "$(git -C "$1" ls-files -- .cs-out .cs-calls.jsonl .cs-doom-mark 2>/dev/null)" ]; }
if tracked_spill .; then
  say ".cs-* is tracked — runtime spill was harvested; git rm --cached it"
fi
if [ -z "${CS_SPILL_DESTS:-}" ] && [ -z "${CS_SPILL_RUNS_ROOT:-}" ]; then
  for notes in tasks/work/*/notes.md tasks/sweeps/*/notes.md; do
    [ -f "$notes" ] || continue
    repo=$(sed -n 's/^repo:[[:space:]]*//p' "$notes" | head -1)
    [ -n "$repo" ] && [ -e "$repo/.git" ] && tracked_spill "$repo" && say ".cs-* tracked in dest $repo"
  done
  for d in tasks/work/*/setup; do
    [ -e "$d/.git" ] || continue
    tracked_spill "$d" && say ".cs-* tracked in $d"
  done
fi
for repo in ${CS_SPILL_DESTS:-}; do
  [ -e "$repo/.git" ] && tracked_spill "$repo" && say ".cs-* tracked in dest $repo"
done
runs_root=${CS_SPILL_RUNS_ROOT:-ledger/runs}
if [ -d "$runs_root" ]; then
  while IFS= read -r d; do
    [ -e "$d/.git" ] || continue
    { [ -e "$d/.cs-out" ] || [ -e "$d/.cs-calls.jsonl" ] || [ -e "$d/.cs-doom-mark" ]; } || continue
    tracked_spill "$d" && say ".cs-* tracked in $d"
  done < <(find "$runs_root" -maxdepth 2 -type d -name workspace -newermt "$last_prune" 2>/dev/null)
fi
if [ "${CS_SPILL_ONLY:-}" = 1 ]; then
  [ "$fail" -eq 0 ] && echo "check: spill ok"
  exit "$fail"
fi

# 10. The ledger only grows. A working ledger smaller than HEAD's is a
#     truncation in progress (2026-09-01: live file cut to 13 rows). Once the ledger has left the checkout for the
# state root there is nothing here to compare, and cs/ledger must not come back.
if [ -n "$(git ls-tree --name-only HEAD -- ledger 2>/dev/null)" ] || [ -n "$(git ls-files -- ledger 2>/dev/null | head -1)" ]; then
  ledger_tracked=1
else
  ledger_tracked=
fi
if [ -z "$ledger_tracked" ] && [ -e ledger ] && git rev-parse -q --verify HEAD >/dev/null 2>&1; then
  say "cs/ledger reappeared after the ledger left the checkout: state lives in CS_STATE_ROOT (~/.contextstack/state); remove it and find the writer"
fi
if [ -d ledger ] && git rev-parse -q --verify HEAD >/dev/null 2>&1; then
  hn=$(git show HEAD:./ledger/ledger.jsonl 2>/dev/null | wc -l | tr -d ' ')
  wn=$(wc -l < ledger/ledger.jsonl 2>/dev/null | tr -d ' ')
  [ "${wn:-0}" -ge "${hn:-0}" ] || say "ledger.jsonl has $wn rows but HEAD has $hn — append-only violated; recover from git before anything else"
fi


