PYTHON = sys.executable


def lay_out_home(home: Path, director_url: str, owner_token: str, node: str):
    """Fake ~/.contextstack layout with install.json, local-credential, and current/cs."""
    root = home / ".contextstack"
    rel = root / "releases/r1"
    (rel / "cs/scripts").mkdir(parents=True)
    (rel / "cs/ops/bin").mkdir(parents=True)
    (rel / ".complete").write_text("", encoding="utf-8")
    for name in ("cs", "cs_mcp.py", "cs_agents.py", "cs_runs.py", "cs_review.py"):
        shutil.copy2(KIT / "scripts" / name, rel / "cs/scripts" / name)
    for name in ("_lead_socket.py", "_job_reason.py", "_review_collect.py", "_review_render.py", "_review_score.py"):
        shutil.copy2(KIT / "ops/bin" / name, rel / "cs/ops/bin" / name)
    shutil.copytree(AGENTS_DIR, rel / "cs/agents")
    os.symlink("releases/r1", root / "current")
    (root / "config").mkdir(parents=True)
    (root / "config/install.json").write_text(
        json.dumps({"director": director_url, "node": node}),
        encoding="utf-8",
    )
    cred_dir = root / "state/director"
    cred_dir.mkdir(parents=True, mode=0o700)
    cred_dir.chmod(0o700)
    cred = cred_dir / "local-credential"
    cred.write_text(owner_token + "\n", encoding="utf-8")
    cred.chmod(0o600)
    return root, cred


def create_lane_job(target, owner_token, node_name, idx, *, lane, task_type, agent, model, retry_of=None, attempt=1):
    """Upload bundle files and create a lane intent + job on the Director via POST /api/v1/client/intents."""
    files_list = []
    for rel_path, (content, mode) in wire.JOB_FILES.items():
        digest = wire.sha(content)
        ans = wire.request(target.url, "PUT", "/api/v1/client/objects/" + digest, token=owner_token, raw=content)
        assert ans.status in (200, 201), ans
        files_list.append({"path": rel_path, "sha256": digest, "bytes": len(content), "mode": mode})

    agent_sha = hashlib.sha256((AGENTS_DIR / f"{agent}.md").read_bytes()).hexdigest()
    meta = {
        "source": "cs-mcp",
        "lane": lane,
        "repo": "cs",
        "agent": agent,
        "agent_sha256": agent_sha,
        "model": model,
        "task_type": task_type,
        "attempt": str(attempt),
    }
    if retry_of:
        meta["retry_of"] = retry_of
        meta["retry_root"] = retry_of

    ans = wire.request(
        target.url,
        "POST",
        "/api/v1/client/intents",
        token=owner_token,
        headers={"Idempotency-Key": f"weekly-review-intent-{idx}"},
        body={
            "node": node_name,
            "spec": "spec.yaml",
            "task": "tasks/t",
            "files": files_list,
            "trials": 1,
            "meta": meta,
            "title": f"Lane {lane}",
        },
    )
    assert ans.status == 201, ans
    return ans.json["jobs"][0]["job_id"]


def finish_lane_job(
    target,
    node,
    owner_token,
    idx,
    job_id,
    *,
    model,
    verdict="pass",
    stop="completed",
    seconds=180,
    tokens=1500,
    reason="",
    stuck_md=None,
    allowance_rejected=False,
    decision=None,
    decision_note=None,
):
    """Accept job on node, upload run envelope (with optional stuck.md) + job_terminal, and optionally decide."""
    acc = node.accept(job_id)
    assert acc.status in (200, 201), acc

    run_id = f"20261111-1200{idx:02d}-m4-{job_id.lower()[:8]}-t1"
    overrides = {
        "check.json": json.dumps(
            {"verdict": verdict, "exit_code": 0 if verdict == "pass" else 1, "skipped": False, "output": "done\n"}
        ).encode("utf-8"),
    }
    if stuck_md is not None:
        overrides["stuck.md"] = stuck_md.encode("utf-8")

    run = wire.run_fixture(run_id, overrides=overrides)
    in_tok = int(tokens * 0.7)
    out_tok = int(tokens - in_tok)
    row_dict = {
        "run_id": run_id,
        "transcript": "ledger/runs/" + run_id,
        "verdict": verdict,
        "stop": stop,
        "seconds": seconds,
        "turns": 4,
        "tool_calls": 9,
        "cost_usd": 0,
        "est_usd": 0.0,
        "est_basis": "subscription",
        "cost_class": "subscription",
        "model": model,
        "reason": reason or stop,
    }
    row_line = json.dumps(row_dict)
    run["row_line"] = row_line
    run["envelope"]["job_id"] = job_id
    run["envelope"]["row_sha256"] = wire.sha(row_line)
    run["envelope"]["usage"] = {
        "input_tokens": in_tok,
        "output_tokens": out_tok,
        "cache_read_tokens": 0,
        "cache_creation_tokens": 0,
        "reasoning_tokens": 0,
        "est_usd": 0.0,
        "est_basis": "rate",
        "charged_usd": 0.0,
        "source": {"class": "subscription", "model": model, "reported_model": model},
        "allowance": {"via": "subscription", "rejected": bool(allowance_rejected), "windows": []},
    }

    for data in run["files"].values():
        put_ans = node.call("PUT", "objects/" + wire.sha(data), raw=data)
        assert put_ans.status in (200, 201), put_ans

    env_ans = node.call("POST", "envelopes", body={"envelope": run["envelope"], "row_line": run["row_line"]})
    assert (env_ans.json or {}).get("status") == "acked", env_ans

    job_state = "done" if verdict == "pass" else "error"
    term_body = {
        "state": job_state,
        "director_job": job_id,
        "run_id": run_id,
        "verdict": verdict,
        "stop": stop,
        "reason": reason or stop,
    }
    term_row = json.dumps(term_body)
    term_env = {
        "envelope_version": 1,
        "event_id": "job_terminal:" + job_id,
        "job_id": job_id,
        "files": [],
        "envelope_sha256": wire.sha(b""),
        "row_sha256": wire.sha(term_row),
    }
    term_ans = node.call("POST", "envelopes", body={"envelope": term_env, "row_line": term_row})
    assert (term_ans.json or {}).get("status") == "acked", term_ans

    if decision in ("approve", "reject"):
        dec_body = {"decision": decision}
        if decision_note:
            dec_body["note"] = decision_note
        dec_ans = wire.request(
            target.url,
            "POST",
            f"/api/v1/client/runs/{run_id}/decision",
            token=owner_token,
            headers={"Idempotency-Key": f"idem-dec-{idx}"},
            body=dec_body,
        )
        assert dec_ans.status == 201, dec_ans
    return run_id


def main():
    binary = Path(os.environ.get("DIRECTOR_BIN") or REPO / "target/release/cs-director")
    if not binary.is_file():
        print("SKIP weekly-review: no director-rs at %s (cargo build --release -p cs-director)" % binary)
        return 0
    tmp = tempfile.mkdtemp(prefix="weekly-review-target-", suffix=".noindex")
    home = Path(tempfile.mkdtemp(prefix="weekly-review-home-", suffix=".noindex"))
    target = RustTarget(tmp, binary)
    try:
        ctx = Ctx("weekly-review", target)
        node = ctx.node2()
        owner = target.local_token()
        lay_out_home(home, target.url, owner, node.name)

        # 1-5: 5 review jobs on reviewer / cursor-codex (all pass; 1 approved, 4 rejected).
        review_notes = [
            None,
            "missed null check on empty payload",
            "false positive on lock ordering",
            "skipped edge-case test assertion",
            "wrong severity on migration warning",
        ]
        review_secs = [120, 180, 240, 300, 360]  # median = 240s = 4.0 min
        review_toks = [1000, 1200, 1500, 1800, 2000]  # median = 1500
        for i in range(5):
            idx = i + 1
            jid = create_lane_job(
                target, owner, node.name, idx, lane=f"rev-{idx}", task_type="review", agent="reviewer", model="cursor-codex"
            )
            finish_lane_job(
                target,
                node,
                owner,
                idx,
                jid,
                model="cursor-codex",
                verdict="pass",
                stop="completed",
                seconds=review_secs[i],
                tokens=review_toks[i],
                reason="completed review pass",
                decision="approve" if i == 0 else "reject",
                decision_note=review_notes[i],
            )

        # 6-8: 3 feature jobs on coder / cursor-sol (1 pass + approve, 2 stuck with stuck.md).
        jid_feat_ok = create_lane_job(
            target, owner, node.name, 6, lane="feat-ok", task_type="feature", agent="coder", model="cursor-sol"
        )
        finish_lane_job(
            target,
            node,
            owner,
            6,
            jid_feat_ok,
            model="cursor-sol",
            verdict="pass",
            stop="completed",
            seconds=300,  # 5.0 min
            tokens=4000,
            reason="feature checks green",
            decision="approve",
        )

        jid_stuck_1 = create_lane_job(
            target, owner, node.name, 7, lane="feat-stuck-loop", task_type="feature", agent="coder", model="cursor-sol"
        )
        finish_lane_job(
            target,
            node,
            owner,
            7,
            jid_stuck_1,
            model="cursor-sol",
            verdict="fail",
            stop="stuck:loop",
            seconds=600,  # 10.0 min
            tokens=8000,
            reason="stuck:loop: repeated failing edit on src/parser.rs",
            stuck_md=(
                "# stuck: loop\n\n"
                "- okf pytest failed 3x on tests/test_parser.py\n"
                "- Authorization: Bearer secret-stuck-token-999999\n"
            ),
        )

        jid_stuck_2 = create_lane_job(
            target, owner, node.name, 8, lane="feat-stuck-noprog", task_type="feature", agent="coder", model="cursor-sol"
        )
        finish_lane_job(
            target,
            node,
            owner,
            8,
            jid_stuck_2,
            model="cursor-sol",
            verdict="fail",
            stop="stuck:no_progress",
            seconds=480,  # 8.0 min (median across [5, 10, 8] = 8.0 min)
            tokens=6000,  # median across [4000, 8000, 6000] = 6000
            reason="stuck:no_progress: 4 read turns without edit",
            stuck_md="# stuck: no_progress\n\n- 4 consecutive read-only turns in cs/scripts\n",
        )

        # 9: 1 retry of jid_stuck_1 on coder / codex that passes and is approved.
        jid_retry = create_lane_job(
            target,
            owner,
            node.name,
            9,
            lane="feat-stuck-loop",
            task_type="feature",
            agent="coder",
            model="codex",
            retry_of=jid_stuck_1,
            attempt=2,
        )
        finish_lane_job(
            target,
            node,
            owner,
            9,
            jid_retry,
            model="codex",
            verdict="pass",
            stop="completed",
            seconds=240,  # 4.0 min
            tokens=3200,
            reason="completed retry cleanly",
            decision="approve",
        )

        # 10-11: 2 bugfix jobs on coder / cursor-composer (1 provider_limit stop, 1 pass).
        jid_limit = create_lane_job(
            target, owner, node.name, 10, lane="bugfix-limit", task_type="bugfix", agent="coder", model="cursor-composer"
        )
        finish_lane_job(
            target,
            node,
            owner,
            10,
            jid_limit,
            model="cursor-composer",
            verdict="fail",
            stop="provider_limit",
            seconds=60,  # 1.0 min
            tokens=500,
            reason="provider_limit: Cursor fast-request quota exhausted",
            allowance_rejected=True,
        )

        jid_bugfix_ok = create_lane_job(
            target, owner, node.name, 11, lane="bugfix-ok", task_type="bugfix", agent="coder", model="cursor-composer"
        )
        finish_lane_job(
            target,
            node,
            owner,
            11,
            jid_bugfix_ok,
            model="cursor-composer",
            verdict="pass",
            stop="completed",
            seconds=180,  # 3.0 min (median across [1, 3] = 2.0 min)
            tokens=2500,  # median across [500, 2500] = 1500
            reason="bugfix verified",
            decision="approve",
        )

        # 12: 1 verification job on verifier / cursor-agent that hits memory_cap.
        jid_mem = create_lane_job(
            target, owner, node.name, 12, lane="verify-mem", task_type="verification", agent="verifier", model="cursor-agent"
        )
        finish_lane_job(
            target,
            node,
            owner,
            12,
            jid_mem,
            model="cursor-agent",
            verdict="fail",
            stop="memory_cap",
            seconds=420,  # 7.0 min
            tokens=5100,
            reason="memory_cap: job RSS 9500 MB exceeded 9216 MB cap",
        )

        # 13: 1 old job that we backdate to 10 days ago to verify --since filtering.
        jid_old = create_lane_job(
            target, owner, node.name, 13, lane="old-lane", task_type="feature", agent="coder", model="codex"
        )
        run_old = finish_lane_job(
            target,
            node,
            owner,
            13,
            jid_old,
            model="codex",
            verdict="pass",
            stop="completed",
            seconds=120,
            tokens=900,
            reason="old completed job",
        )

        # Report active provider_limits on node via POST status.
        st_ans = node.call(
            "POST",
            "status",
            body={
                "active": [],
                "node_version": "weekly-review-test",
                "provider_limits": [
                    {
                        "template": "cursor-composer",
                        "message": "Cursor usage limit reached until reset",
                        "resets_at": "2099-01-01T00:00:00Z",
                        "recorded_at": "2026-11-11T12:00:00Z",
                    }
                ],
            },
        )
        assert st_ans.status in (200, 202, 204), st_ans

        # Backdate jid_old and run_old to 10 days ago in director.sqlite.
        old_iso = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(time.time() - 10 * 86400))
        db_path = target.data / "director.sqlite"
        conn = sqlite3.connect(str(db_path))
        try:
            cols_jobs = [r[1] for r in conn.execute("PRAGMA table_info(jobs)").fetchall()]
            for col in ("created_at", "accepted_at", "finished_at"):
                if col in cols_jobs:
                    conn.execute(f"UPDATE jobs SET {col} = ? WHERE job_id = ?", (old_iso, jid_old))
            cols_runs = [r[1] for r in conn.execute("PRAGMA table_info(runs)").fetchall()]
            if "received_at" in cols_runs:
                conn.execute("UPDATE runs SET received_at = ? WHERE run_id = ?", (old_iso, run_old))
            conn.commit()
        finally:
            conn.close()

        env = {
            k: v
            for k, v in hermetic_env().items()
            if k not in ("LAB_STATE_ROOT", "LAB_CONFIG_ROOT", "CSGATEWAY_ENDPOINT")
        }
        env["HOME"] = str(home)

        # 1. Run `cs review weekly --json` (default --since 7).
        proc_json = subprocess.run(
            [PYTHON, str(CS_BIN), "review", "weekly", "--json"],
            env=env,
            capture_output=True,
            text=True,
            timeout=30,
        )
        assert proc_json.returncode == 0, (proc_json.returncode, proc_json.stdout, proc_json.stderr)
        assert owner not in proc_json.stdout and owner not in proc_json.stderr
        assert "secret-stuck-token-999999" not in proc_json.stdout

        doc = json.loads(proc_json.stdout)
        assert doc["window_days"] == 7.0
        assert doc["total_jobs"] == 12, f"expected 12 jobs in 7d window, got {doc['total_jobs']}"

        # Verify table rows.
        table_by_key = {(r["task_type"], r["agent"], r["model"]): r for r in doc["table"]}
        assert len(table_by_key) == 5, list(table_by_key.keys())

        r_rev = table_by_key[("review", "reviewer", "cursor-codex")]
        assert r_rev["jobs"] == 5
        assert r_rev["passed"] == 5 and r_rev["pass_rate"] == 1.0
        assert r_rev["decided"] == 5 and r_rev["approved"] == 1 and r_rev["rejected"] == 4
        assert r_rev["approve_rate"] == 0.2
        assert r_rev["median_minutes"] == 4.0
        assert r_rev["median_tokens"] == 1500
        assert r_rev["stops"] == {"stuck": 0, "provider_limit": 0, "memory_cap": 0}

        r_feat_sol = table_by_key[("feature", "coder", "cursor-sol")]
        assert r_feat_sol["jobs"] == 3
        assert r_feat_sol["passed"] == 1 and r_feat_sol["pass_rate"] == 0.3333
        assert r_feat_sol["approve_rate"] == 1.0
        assert r_feat_sol["median_minutes"] == 8.0
        assert r_feat_sol["median_tokens"] == 6000
        assert r_feat_sol["stops"] == {"stuck": 2, "provider_limit": 0, "memory_cap": 0}

        r_feat_codex = table_by_key[("feature", "coder", "codex")]
        assert r_feat_codex["jobs"] == 1
        assert r_feat_codex["passed"] == 1 and r_feat_codex["pass_rate"] == 1.0
        assert r_feat_codex["approve_rate"] == 1.0
        assert r_feat_codex["median_minutes"] == 4.0
        assert r_feat_codex["median_tokens"] == 3200
        assert r_feat_codex["stops"] == {"stuck": 0, "provider_limit": 0, "memory_cap": 0}

        r_bug = table_by_key[("bugfix", "coder", "cursor-composer")]
        assert r_bug["jobs"] == 2
        assert r_bug["passed"] == 1 and r_bug["pass_rate"] == 0.5
        assert r_bug["approve_rate"] == 1.0
        assert r_bug["median_minutes"] == 2.0
        assert r_bug["median_tokens"] == 1500
        assert r_bug["stops"] == {"stuck": 0, "provider_limit": 1, "memory_cap": 0}

        r_ver = table_by_key[("verification", "verifier", "cursor-agent")]
        assert r_ver["jobs"] == 1
        assert r_ver["passed"] == 0 and r_ver["pass_rate"] == 0.0
        assert r_ver["approve_rate"] is None
        assert r_ver["median_minutes"] == 7.0
        assert r_ver["median_tokens"] == 5100
        assert r_ver["stops"] == {"stuck": 0, "provider_limit": 0, "memory_cap": 1}

        # Verify worst lanes (4 rejected + 2 stuck + 1 retried child + 1 limit error + 1 memory_cap error = 9).
        worst_by_job = {w["job_id"]: w for w in doc["worst_lanes"]}
        assert len(worst_by_job) == 9, list(worst_by_job.keys())
        for w in doc["worst_lanes"]:
            assert isinstance(w["autopsy"], list) and len(w["autopsy"]) == 2, w
            assert all(isinstance(line, str) and line.strip() for line in w["autopsy"]), w

        # Check stuck lane autopsy uses reason + stuck.md and redacts Bearer token.
        w_stuck = worst_by_job[jid_stuck_1]
        assert "stuck" in w_stuck["categories"] and "retried" in w_stuck["categories"]
        assert w_stuck["has_stuck_md"] is True
        assert "stuck:loop" in w_stuck["autopsy"][0]
        assert "stuck.md: stuck: loop" in w_stuck["autopsy"][1]
        assert "okf pytest failed 3x" in w_stuck["autopsy"][1]
        assert "secret-stuck-token-999999" not in w_stuck["autopsy_text"]

        # Check rejected lane autopsy includes decision note.
        rejected_lanes = [w for w in doc["worst_lanes"] if w["status"] == "rejected"]
        assert len(rejected_lanes) == 4
        assert any("missed null check on empty payload" in w["autopsy_text"] for w in rejected_lanes)

        # Check retried child lane autopsy includes retry lineage.
        w_retry = worst_by_job[jid_retry]
        assert w_retry["categories"] == ["retried"]
        assert f"retry_of={jid_stuck_1}" in w_retry["autopsy"][1]

        # Verify provider-limit events by template.
        assert len(doc["provider_limits"]) == 1, doc["provider_limits"]
        lim = doc["provider_limits"][0]
        assert lim["template"] == "cursor-composer"
        assert lim["count"] == 1
        assert lim["job_stops"] == 1
        assert jid_limit in lim["job_ids"]

        # Verify deterministic proposals (up to 3, concrete & checkable).
        props = doc["proposals"]
        assert len(props) == 3, props
        assert props[0] == "reviewer profile: move from cursor-codex to codex — 4/5 rejects came from it", props
        assert props[1] == (
            "coder profile (feature): move from cursor-sol to codex — "
            "2/3 jobs stopped on stuck:* (pass rate 33%)"
        ), props
        assert props[2] == (
            "coder profile (cursor-composer): route default from cursor-composer to codex — "
            "1 provider_limit event(s) recorded"
        ), props

        # 2. Verify `--since 14` includes the 10-day-old job (13 jobs total).
        proc_14 = subprocess.run(
            [PYTHON, str(CS_BIN), "review", "weekly", "--since", "14", "--json"],
            env=env,
            capture_output=True,
            text=True,
            timeout=30,
        )
        assert proc_14.returncode == 0, proc_14.stderr
        doc_14 = json.loads(proc_14.stdout)
        assert doc_14["total_jobs"] == 13, doc_14["total_jobs"]

        # 3. Verify Markdown output (`cs review weekly`).
        proc_md = subprocess.run(
            [PYTHON, str(CS_BIN), "review", "weekly"],
            env=env,
            capture_output=True,
            text=True,
            timeout=30,
        )
        assert proc_md.returncode == 0, proc_md.stderr
        md = proc_md.stdout
        assert owner not in md
        assert "# Weekly Lane Review (last 7d — 12 jobs)" in md
        assert "## Task Type × Agent/Model" in md
        assert "| review | reviewer/cursor-codex | 5 | 100% (5/5) | 20% (1/5) | 4.0 | 1500 | 0 / 0 / 0 |" in md
        assert "| feature | coder/cursor-sol | 3 | 33% (1/3) | 100% (1/1) | 8.0 | 6000 | 2 / 0 / 0 |" in md
        assert "## Worst Lanes" in md
        assert "stuck.md: stuck: loop" in md
        assert "## Provider-Limit Events by Template" in md
        assert "| cursor-composer | 1 | 1 |" in md
        assert "## Proposed Changes" in md
        assert "1. reviewer profile: move from cursor-codex to codex — 4/5 rejects came from it" in md

        # 4. Verify launchd plist template (`cs review weekly --plist` and loop-watcher file).
        proc_plist = subprocess.run(
            [PYTHON, str(CS_REVIEW), "weekly", "--plist"],
            env=env,
            capture_output=True,
            text=True,
            timeout=15,
        )
        assert proc_plist.returncode == 0, proc_plist.stderr
        parsed_plist = plistlib.loads(proc_plist.stdout.encode("utf-8"))
        assert parsed_plist["Label"] == "com.contextstack.weekly-review"
        assert parsed_plist["StartCalendarInterval"] == {"Weekday": 1, "Hour": 8, "Minute": 0}
        assert parsed_plist["ProgramArguments"][1:3] == ["review", "weekly"]

        print("weekly-review regression: ok")
        return 0
    finally:
        target.close()
        shutil.rmtree(tmp, ignore_errors=True)
        shutil.rmtree(home, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
