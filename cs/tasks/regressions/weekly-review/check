KIT = Path(__file__).resolve().parents[3]
REPO = KIT.parent
sys.dont_write_bytecode = True
sys.path.insert(0, str(REPO / "tests/director-spec"))
sys.path.insert(0, str(KIT / "scripts"))

from harness import wire  # noqa: E402
