def fail(msg):
    problems.append(msg)
    print("FAIL " + msg)


def expect(cond, msg):
    (print("ok   " + msg) if cond else fail(msg))


SHIMS = {
    "launchctl": r'''
a = sys.argv[1:]
loaded = os.path.join(S, "loaded")
os.makedirs(loaded, exist_ok=True)
if a[0] == "print":
    f = os.path.join(loaded, a[1].rsplit("/", 1)[-1])
    if not os.path.exists(f):
        sys.stderr.write("Could not find service\n"); sys.exit(113)
    sys.stdout.write("%s = {\n" % a[1] + open(f).read() + "}\n")
elif a[0] == "bootstrap":
    open(os.path.join(loaded, os.path.basename(a[2])[:-6]), "w").write("\tstate = running\n\tpid = 5151\n")
elif a[0] == "bootout":
    f = os.path.join(loaded, a[1].rsplit("/", 1)[-1])
    os.path.exists(f) and os.unlink(f)
''',
    "curl": r'''
url = sys.argv[-1]
for key, (code, body) in json.load(open(os.path.join(S, "http.json"))):
    if key in url:
        sys.stdout.write((body if isinstance(body, str) else json.dumps(body)) + "\n%d" % code); sys.exit(0)
sys.stdout.write("\n000"); sys.exit(7)
''',
    "ssh": r'''
sys.exit(int(open(os.path.join(S, "ssh_rc")).read()) if os.path.exists(os.path.join(S, "ssh_rc")) else 255)
''',
    "fixture-shell": "sys.exit(0)",
    "fdesetup": r'''
f = os.path.join(S, "fdesetup.txt")
sys.stdout.write(open(f).read() if os.path.exists(f) else "FileVault is On.\n")
''',
}


def write_shims(shim):
    (shim / "bin").mkdir(parents=True)
    for name, body in SHIMS.items():
        p = shim / "bin" / name
        p.write_text("#!%s\nimport json, os, sys\nS = %r\nopen(os.path.join(S, 'calls.log'), 'a').write(%r + ' ' + "
                     "' '.join(sys.argv[1:]) + '\\n')\n%s" % (sys.executable, str(shim), name, body))
        p.chmod(0o755)


def cs(home, shim, *args, platform=None, timeout=120):
    env = _bundle.dead_network_env(home, PATH="%s:%s" % (shim / "bin", os.environ.get("PATH", "/usr/bin:/bin")))
    env["SHELL"] = str(shim / "bin/fixture-shell")
    env.pop("CS_PLATFORM", None)
    if platform:
        env["CS_PLATFORM"] = platform
    script = home / ".contextstack/current/cs/scripts/cs"
    if not script.is_file():
        script = CS_SCRIPT
    r = subprocess.run([str(script), *args], capture_output=True, text=True, env=env, cwd="/", timeout=timeout)
    outputs.append(r.stdout + r.stderr)
    return r


def loaded(shim, label, text):
    (shim / "loaded").mkdir(exist_ok=True)
    (shim / "loaded" / label).write_text(text)


def tunnel_plist(home, label, port, sock, **extra):
    d = {"Label": label, "ProgramArguments": ["/usr/bin/ssh", "-M", "-S", str(sock), "-N", "-L",
                                              "127.0.0.1:%d:127.0.0.1:%d" % (port, port + 10), "spark"],
         "KeepAlive": True, "StandardOutPath": str(home / ".contextstack/logs" / (label + ".out.log")),
         "StandardErrorPath": str(home / ".contextstack/logs" / (label + ".err.log")), **extra}
    (home / "Library/LaunchAgents" / (label + ".plist")).write_bytes(plistlib.dumps(d))


def plant(home, root, shim):
    """The faces of a running node: logs, state shelves, node.env, a credentials file, tunnels, launchd, HTTP."""
    (root / "config/node.env").write_text("export CONTEXTSTACK_NODE_TOKEN=%s\n" % TOKEN)
    (root / "config/node.env").chmod(0o600)
    (root / "credentials").mkdir(mode=0o700)
    (root / "credentials/openai").write_text(CRED + "\n")
    (root / "credentials/openai").chmod(0o600)
    logs = root / "logs"
    (logs / "csgateway.out.log").write_text("gateway line 1\ngateway line 2\ngateway line 3\n")
    (logs / "csgateway.err.log").write_text("warn: ANTHROPIC_API_KEY=%s from env\n" % LOG_KEY)
    (logs / "node.out.log").write_text("debug Authorization: Bearer %s\n" % TOKEN + json.dumps(
        {"ok": True, "skip": "empty", "job_pull": {"ok": True, "error": "director unreachable: connection refused"}}) + "\n")
    (logs / (T1 + ".err.log")).write_text("ssh: tunnel line\n")
    state = root / "state"
    for j in ("j1", "j2", "j3"):
        (state / "jobs" / j).mkdir(parents=True)
        (state / "jobs" / j / "job.json").write_text(json.dumps({"job_id": j, "spec": "spec-%s.yaml" % j}))
    rows = [("d1", "pending", "j1"), ("d1", "running", None), ("d1", "done", None), ("d2", "pending", "j2"), ("d2", "running", None)]
    with open(state / "dispatch.jsonl", "a") as f:
        for i, (d, st, job) in enumerate(rows):
            row = {"id": d, "state": st, "ts": "2026-11-10T10:0%d:00Z" % i, **({"director_job": job, "spec": str(state / "jobs" / job / ("spec-%s.yaml" % job))} if job else {})}
            row.update({"verdict": "pass"} if st == "done" else {})
            f.write(json.dumps(row) + "\n")
    (state / "outbox/acked").mkdir(parents=True)
    (state / "outbox/job_j1.json").write_text("{}\n")
    (state / "outbox/run-r1.json").write_text("{}\n")
    sockdir = home / ".local/share/dgx-spark/ssh"
    sockdir.mkdir(parents=True)
    (sockdir / "api-tunnel.sock").write_text("")  # left behind by a dead master
    tunnel_plist(home, T1, 8000, sockdir / "api-tunnel.sock", WorkingDirectory=str(home / "sites/contextstack/modelgateway"),
                 EnvironmentVariables={"OPENAI_API_KEY": PLIST_KEY})
    tunnel_plist(home, T2, 8001, sockdir / "api2-tunnel.sock")
    gw_plist = home / "Library/LaunchAgents" / (GW + ".plist")  # the Keychain, opted into explicitly
    p = plistlib.loads(gw_plist.read_bytes())
    p["EnvironmentVariables"]["CSGATEWAY_CREDENTIALS"] = "keychain"
    gw_plist.write_bytes(plistlib.dumps(p))
    loaded(shim, GW, "\tstate = running\n\tpid = 4242\n\tenvironment = {\n\t\tOPENAI_API_KEY => %s\n\t}\n" % PLIST_KEY)
    loaded(shim, NODE, "\tstate = not running\n\tlast exit code = 0\n")
    loaded(shim, T1, "\tstate = spawn failed\n\tlast exit code = 78: EX_CONFIG\n")
    loaded(shim, T2, "\tstate = running\n\tpid = 6262\n")
    health = {"status": "healthy", "catalog_revision": "r-test123", "models_available": 2, "providers_active": ["vllm"],
              "discovery_stale": ["vllm-spark2"]}
    models = {"models": [{"name": "local-coder", "provider": "vllm", "available": True, "tier": 2},
                         {"name": "local-reasoner", "provider": "vllm-spark2", "available": False, "tier": 3}]}
    (shim / "http.json").write_text(json.dumps([["127.0.0.1:8000/", [200, "{}"]], [":9200/v1/health", [200, health]],
                                                [":9200/v1/models", [200, models]], ["/api/v1/nodes/me", [401, {"error": "unauthenticated"}]]]))


def doctor(home, shim, **kw):
    r = cs(home, shim, "doctor", "--json", **kw)
    try:
        return r, {f["check"]: f for f in json.loads(r.stdout)}
    except ValueError:
        return r, {}


