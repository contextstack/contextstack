    with scratch_dir(prefix="cs-hermetic-scope-") as tmp:
        home = Path(tmp)
        bindir, agents = home / ".local/bin", home / "Library/LaunchAgents"
        bindir.mkdir(parents=True)
        agents.mkdir(parents=True)
        owned_link = names[0]
        (bindir / owned_link).symlink_to("/tmp/contextstack-owned-link")
        (bindir / "agy").write_text("foreign-cli\n")
        (agents / "com.contextstack.node.plist").write_text("owned-agent\n")
        (agents / "com.other.app.plist").write_text("foreign-agent\n")
        before = _bundle.contextstack_host_snapshots(home)
        (bindir / "agy").write_text("foreign-cli-rewritten\n")
        (agents / "com.other.app.plist").write_text("foreign-agent-rewritten\n")
        expect(before == _bundle.contextstack_host_snapshots(home),
               "foreign ~/.local/bin and LaunchAgents changes do not fail the scoped snapshot")
        (bindir / owned_link).unlink()
        (bindir / owned_link).symlink_to("/tmp/contextstack-owned-link-moved")
        expect(before[0] != _bundle.contextstack_host_snapshots(home)[0],
               "a ContextStack PATH link change fails the scoped ~/.local/bin snapshot")
        before = _bundle.contextstack_host_snapshots(home)
        (agents / "com.contextstack.node.plist").write_text("owned-agent-rewritten\n")
        expect(before[1] != _bundle.contextstack_host_snapshots(home)[1],
               "a com.contextstack.* plist change fails the scoped LaunchAgents snapshot")


def main():
    part_hermetic_scope()
    part_device()
    part_init_agent()
    uv, managed = _bundle.host_python()
    if uv is None:
        print("SKIP cs-cli: %s" % managed)
        return 1 if problems else 0
    before = _bundle.contextstack_host_snapshots()
    agents = _bundle.real_agents()
    tmp = Path(tempfile.mkdtemp(prefix="cs-cli-", suffix=".noindex"))
    try:
        part_install(tmp, uv, managed)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    after = _bundle.contextstack_host_snapshots()
    expect(before == after,
           "ContextStack-owned ~/.local/bin links and ~/Library/LaunchAgents plists are unchanged")
    leak = _bundle.launchd_untouched(agents)
    expect(not leak, leak or "the real launchd domain gained no com.contextstack.* job and restarted none")
    print("check: cs-cli %d problem(s)" % len(problems))
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
