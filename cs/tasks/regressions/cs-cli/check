                         stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, cwd="/")
    out = b""
    def wait_output(marker):
        nonlocal out
        deadline = time.monotonic() + check_timeout(30)
        while marker not in out and time.monotonic() < deadline:
            readable, _, _ = select.select([p.stdout], [], [], max(0, deadline - time.monotonic()))
            if not readable:
                break
            chunk = os.read(p.stdout.fileno(), 65536)
            if not chunk:
                break
            out += chunk
        return marker in out

    try:
        # The last header is flushed after the follower captures all starting offsets.
        ready = wait_output(("==> %s <==" % (root / "logs/csgateway.err.log")).encode())
        expect(ready, "logs -f: follower is ready before appending")
        if ready:
            with open(root / "logs/csgateway.out.log", "a") as f:
                f.write("followed ANTHROPIC_API_KEY=%s\n" % LOG_KEY)
            wait_output(b"followed ANTHROPIC_API_KEY=<redacted>")
    finally:
        p.terminate()
        try:
            rest, err = p.communicate(timeout=check_timeout(10))
        except subprocess.TimeoutExpired:
            p.kill()
            rest, err = p.communicate()
        out = out.decode("utf-8", "replace") + rest
    outputs.append(out + err)
    expect("followed ANTHROPIC_API_KEY=<redacted>" in out, "logs -f: a new line arrives, redacted: %r" % out[-300:])

