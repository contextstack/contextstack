def url_in_files(root, shim):
    """Paths under the fake HOME or shim whose contents hold the fixture URL (the stub script itself is expected)."""
    found = []
    stub = (root / "current/bin/cs-director").resolve()
    for base in (root, shim):
        if not base.exists():
            continue
        for p in base.rglob("*"):
            try:
                if not p.is_file() or p.resolve() == stub:
                    continue
                text = p.read_text(encoding="utf-8", errors="replace")
            except OSError:
                continue
            if UI_URL in text or "fixture-ui-code-9f3a" in text:
                found.append(str(p.relative_to(base)))
    return found


