    calls = (shim / "calls.log").read_text()
    expect("ssh -S %s -O check spark" % (home / ".local/share/dgx-spark/ssh/api-tunnel.sock") in calls,
           "doctor asks ssh whether the control socket has a live master")
    node_plist = home / "Library/LaunchAgents" / (NODE + ".plist")
    p = plistlib.loads(node_plist.read_bytes())
    p["EnvironmentVariables"]["PATH"] = "/usr/bin:/bin"
    node_plist.write_bytes(plistlib.dumps(p))
    (root / "state").chmod(0o755)
    (root / "workspaces").rmdir()
    link = home / ".local/bin/cs"  # the runner's PATH command (cs-go / cs-harness); `code_root` is retired
    link.unlink()
    os.symlink(str(root / "releases/20990000-gone/bin/cs-go"), link)
    r, f = doctor(home, shim)
    r_text = cs(home, shim, "doctor")
    want = {"agent PATH %s" % NODE: "/opt/homebrew/bin", "root state": "chmod 700", "root workspaces": "mkdir -m 700",
            "link cs": "cs release switch"}
    expect(all(k in f and not f[k]["ok"] and v in (f[k]["detail"] + f[k]["fix"]) for k, v in want.items()),
           "doctor: agent PATH without Homebrew, wrong-mode and missing roots, a link into a missing release: %s"
           % {k: f.get(k) for k in want})
    expect(r_text.returncode == 1 and r_text.stdout.count("fix: ") == 7, "doctor text: one fix line per problem (7)\n%s" % r_text.stdout)
    (root / "state").chmod(0o700)

    # Model health uses the installed node's state, with no gateway calls.
