    r = cs(home, shim, "jobs", "--json")
    jobs = {j["job"]: j for j in json.loads(r.stdout or "{}").get("jobs", [])} if r.returncode == 0 else {}
    expect(jobs.get("j1", {}).get("state") == "finished done/pass" and jobs["j1"]["send"] == "waiting to send"
