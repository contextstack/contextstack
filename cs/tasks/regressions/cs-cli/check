    r = cs(home, shim, "jobs")
    expect(r.returncode == 0 and "run envelopes waiting to send: 1" in r.stdout, "jobs: the run-envelope backlog")

    r = cs(home, shim, "logs", "gateway", "-n", "2")
    expect(r.returncode == 0 and "gateway line 2\ngateway line 3" in r.stdout and "gateway line 1" not in r.stdout
