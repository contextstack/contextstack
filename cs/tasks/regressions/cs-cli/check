    r = cs(home, shim, "logs", "node")
    expect(r.returncode == 0 and "Bearer <redacted>" in r.stdout, "logs node: the node token redacted")
    r = cs(home, shim, "logs", "tunnels")
    expect(r.returncode == 0 and "ssh: tunnel line" in r.stdout and "(no such file)" in r.stdout, "logs tunnels: the plists' log paths")
    follow_env = _bundle.dead_network_env(home, PATH="%s:%s" % (shim / "bin", os.environ["PATH"]))
