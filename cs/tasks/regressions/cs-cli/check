def write_browser_shims(shim, fail=False):
    """Fake open/xdg-open first on PATH. Record the opener name, never the URL."""
    (shim / "bin").mkdir(parents=True, exist_ok=True)
    body = ("#!%s\nimport json, os, stat, sys\nfrom pathlib import Path\n"
            "name = os.path.basename(sys.argv[0])\n"
            "page = Path(sys.argv[1])\n"
            "ok = len(sys.argv) == 2 and 'code=' not in sys.argv[1] and page.is_file()\n"
            "ok = ok and stat.S_IMODE(page.stat().st_mode) == 0o600 and stat.S_IMODE(page.parent.stat().st_mode) == 0o700\n"
            "ok = ok and 'location.replace(' in page.read_text() and '#code=' in page.read_text()\n"
            "open(os.path.join(%r, 'browser-argv.json'), 'w').write(json.dumps(sys.argv[1:]))\n"
            "open(os.path.join(%r, 'browser.log'), 'a').write(name + (' ok\\n' if ok else ' bad\\n'))\n"
            "sys.exit(%d)\n")
    for name in ("open", "xdg-open"):
        p = shim / "bin" / name
        p.write_text(body % (sys.executable, str(shim), str(shim), 1 if fail else 0))
        p.chmod(0o755)


