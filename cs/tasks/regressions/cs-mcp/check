class Server:
    def __init__(self, url, credential, node, env=None, command=None):
        self.proc = subprocess.Popen(command or [sys.executable, "-I", str(KIT / "scripts/cs"), "mcp", "--director", url,
                                      "--credential-file", str(credential), "--node", node],
                                     stdin=subprocess.PIPE, stdout=subprocess.PIPE, text=True,
                                     env=dict(env or {}, PATH=os.environ.get("PATH", "/usr/bin:/bin"), HOME=tempfile.mkdtemp(suffix=".noindex")))
        self.serial, self.seen, self.pending = 0, [], {}

    def send(self, method, params=None):
        self.serial += 1
        self.proc.stdin.write(json.dumps({"jsonrpc": "2.0", "id": self.serial, "method": method, "params": params or {}}) + "\n")
        self.proc.stdin.flush()
        return self.serial

    def read(self, ident):
        if ident in self.pending:
            return self.pending.pop(ident)
        while True:
            line = self.proc.stdout.readline()
            self.seen.append(line)
            reply = json.loads(line)
            rid = reply.get("id")
            if rid == ident:
                return reply
            self.pending[rid] = reply

    def rpc(self, method, params=None):
        return self.read(self.send(method, params))

    def tool(self, name, **args):
        result = self.rpc("tools/call", {"name": name, "arguments": args})["result"]
        return json.loads(result["content"][0]["text"]), result["isError"]

    def close(self):
        self.proc.stdin.close()
        self.proc.wait(timeout=10)


def finish_stuck(node, job_id, run_id, reason="stuck:repeat"):
    stuck = b"Stop: stuck:repeat\n\nRecent tool calls\n- Bash: same failing cmd\n"
    transcript = b"\n".join(json.dumps(e).encode() for e in (
        {"type": "assistant", "message": {"content": [{"type": "text", "text": "Spinning."}]}},
        {"type": "result", "result": "Stuck."}))
    run = wire.run_fixture(run_id, overrides={
        "check.json": json.dumps({"verdict": "fail", "exit_code": 1, "skipped": False, "output": "fail\n"}).encode(),
        "stuck.md": stuck, "transcript.md": transcript})
    for data in run["files"].values():
        node.call("PUT", "objects/" + wire.sha(data), raw=data)
    a = node.call("POST", "envelopes", body={"envelope": run["envelope"], "row_line": run["row_line"]})
    assert (a.json or {}).get("status") == "acked", a
    body = {"state": "error", "director_job": job_id, "run_id": run_id, "reason": reason,
            "stop": "error: no_row: " + reason}
    row = json.dumps(body)
    term = {"envelope_version": 1, "event_id": "job_terminal:" + job_id, "job_id": job_id, "files": [],
            "envelope_sha256": wire.sha(b""), "row_sha256": wire.sha(row)}
    a = node.call("POST", "envelopes", body={"envelope": term, "row_line": row})
    assert (a.json or {}).get("status") == "acked", a


def finish(node, job_id, run_id, state="done", reason=None):
    """The node reports the run (check pass, a diff, a transcript) and the job's end, as spool-send would.
    For an error end with no run, pass run_id=None and state='error' with a reason."""
    if run_id:
        transcript = b"\n".join(json.dumps(e).encode() for e in (
            {"type": "assistant", "message": {"content": [{"type": "text", "text": "Edited a.txt."}]}},
            {"type": "result", "result": "Done: a.txt says hello."}))
        run = wire.run_fixture(run_id, overrides={
            "check.json": json.dumps({"verdict": "pass", "exit_code": 0, "skipped": False, "output": "ok\n"}).encode(),
            "transcript.md": transcript, "evidence/candidate.diff": b"--- a/a.txt\n+++ b/a.txt\n@@ -1 +1 @@\n-hi\n+hello\n"})
        for data in run["files"].values():
            node.call("PUT", "objects/" + wire.sha(data), raw=data)
        a = node.call("POST", "envelopes", body={"envelope": run["envelope"], "row_line": run["row_line"]})
        assert (a.json or {}).get("status") == "acked", a
    body = {"state": state, "director_job": job_id}
    if run_id:
        body["run_id"] = run_id
    if reason:
        body["reason"] = reason
        body["stop"] = "error: no_row: " + reason
    row = json.dumps(body)
    term = {"envelope_version": 1, "event_id": "job_terminal:" + job_id, "job_id": job_id, "files": [],
            "envelope_sha256": wire.sha(b""), "row_sha256": wire.sha(row)}
    a = node.call("POST", "envelopes", body={"envelope": term, "row_line": row})
    assert (a.json or {}).get("status") == "acked", a


def model_injection_offline():
    module_spec = importlib.util.spec_from_file_location("cs_mcp_security", KIT / "scripts/cs_mcp.py")
    module = importlib.util.module_from_spec(module_spec)
    module_spec.loader.exec_module(module)

    class NoDirectorAccess:
        def __getattr__(self, name):
            raise AssertionError("invalid model reached Director: " + name)

    with scratch_dir(prefix="cs-mcp-model-") as root:
        with patch.dict(os.environ, {"HOME": root, "CS_INSTALL_ROOT": root}), \
             patch.object(module.agents, "kit_dir", return_value=KIT), \
             patch.object(module.agents, "agents_dir", return_value=KIT / "agents"):
            tools = module.Tools(NoDirectorAccess(), "fixture-node")
            for value in ("codex\nid: hosted-lead", "codex\n", "co\ndex", " codex", "codex ",
                          "codex:foo", "codex#foo", "[codex]", "unknown-executor"):
                try:
                    tools.start_task(title="x", goal="x", model=value)
                except module.Refused as error:
                    expect("model" in str(error), "offline invalid model refused before Director access: %r" % value)
                else:
                    expect(False, "invalid model was accepted: %r" % value)
            expect(module.validate_model("codex") == "codex", "known executor model accepted")

    class BuiltinDirector:
        def get(self, path):
            return {}

        def post(self, path, body, key=None):
            expect(key == body.get("dispatch_id"), "dispatch ID passed as transport key", (key, body))
            expect(path == "intents" and "lane" in body and "files" not in body,
                   "start_task sends built-in lane form without files", body)
            return {"intent": {"intent_id": "built-in", "task": "tasks/test"},
                    "jobs": [{"job_id": "built-in-job", "state": "offered"}]}

    with patch.object(module.agents, "kit_dir", return_value=KIT):
        module.Tools(BuiltinDirector(), "fixture-node").start_task(title="Test", goal="Do it", model="codex")
        tools = module.Tools(BuiltinDirector(), "fixture-node")
        tools.start_task(title="Test", goal="Do it", model="codex", dispatch_id="offline:1")
        for bad in ("", "has space", "x" * 129, 42):
            try:
                tools.start_task(title="Test", goal="Do it", dispatch_id=bad)
            except module.Refused as error:
                expect("dispatch_id" in str(error), "invalid dispatch ID refused offline")
            else:
                expect(False, "invalid dispatch ID accepted")
        with patch.object(tools.d, "get", return_value={"intents": [], "jobs": []}) as lookup:
            expect(tools.find_task("offline:1") == {"intents": [], "jobs": []}, "offline recovery lookup")
            lookup.assert_called_once_with("intents?dispatch_id=offline%3A1")


    class RenamingDirector(BuiltinDirector):
        def post(self, path, body, key=None):
            answer = super().post(path, body, key)
            answer["intent"]["task"] = "tasks/hello-1"
            answer["jobs"][0]["meta"] = {"lane": "hello-1", "model": "claude-code"}
            return answer

    with patch.object(module.agents, "kit_dir", return_value=KIT):
        result = module.Tools(RenamingDirector(), "fixture-node").start_task(
            title="Hello", goal="Do it", model="codex", repo="hello", lane="hello")
        expect(result["workspace"]["lane"] == "hello-1" and result["workspace"]["branch"] == "lane/hello-1"
               and result["lane_renamed"] == {"from": "hello", "to": "hello-1"},
               "MCP reports the Director's non-colliding lane", result)
        expect(result["model"] == "claude-code" and result["model_chosen"] == "claude-code",
               "MCP reports the executor selected for the offer", result)

    class TaskDirector:
        def get(self, path):
            jobs = [{"job_id": "retry", "intent_id": "task", "state": "offered"},
                    {"job_id": "first", "intent_id": "task", "state": "error"}]
            if path == "intents":
                return {"intents": [{"intent_id": "task", "title": "One task"}], "jobs": jobs}
            if path == "intents/task":
                return {"intent": {"intent_id": "task", "title": "One task"}, "jobs": jobs, "runs": []}
            if path == "jobs/first":
                return jobs[1]
            if path == "runs":
                return {"runs": []}
            raise AssertionError(path)

    tools = module.Tools(TaskDirector(), "fixture-node")
    lanes = tools.list_tasks(active_only=True)["lanes"]
    expect(len(lanes) == 1 and {j["job_id"] for j in lanes[0]["jobs"]} == {"first", "retry"},
           "offline: one active task includes its failed and offered jobs", lanes)
    status = tools.task_status("first")
    expect(status.get("intent_id") == "task" and len(status.get("jobs", [])) == 2,
           "offline: status of a prior job includes the task's attempts", status)
    try:
        tools.retry_task("first", model="codex")
    except module.Refused as error:
        expect("third attempt" in str(error), "offline: retry limit counts jobs without retry metadata")
    else:
        expect(False, "retry with two jobs was accepted")



def bridged_watch(target, node):
    """Real start_task through the sandbox proxy authenticates its host-side watch."""
    spec = importlib.util.spec_from_file_location("lead_mcp", KIT / "ops/bin/_lead_mcp.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    with scratch_dir(prefix="cs-mcp-watch-") as raw:
        root = Path(raw).resolve()
        path = root / "socket"
        token = "serve-token-fixture"
        (root / "token").write_text(token)
        (root / "token").chmod(0o600)
        received = []
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as listener:
            listener.bind(str(path))
            listener.listen(1)
            listener.settimeout(10)

            def watch():
                with listener.accept()[0] as conn:
                    received.append(json.loads(conn.recv(65536)))
                    conn.sendall(b'{"ok":true}\n')

            worker = threading.Thread(target=watch, daemon=True)
            worker.start()
            config = {"mcpServers": {"contextstack": {"command": sys.executable, "args": [
                "-I", str(KIT / "scripts/cs"), "mcp", "--no-land", "--director", target.url,
                "--credential-file", str(target.data / "local-credential"), "--node", node.name]}}}
            bridge = module.HostMCPBridge(config, root,
                env=dict(PATH=os.environ.get("PATH", "/usr/bin:/bin"), HOME=str(root), LEAD_HOST_SOCKET=str(path)))
            try:
                proxy = bridge.config["mcpServers"]["contextstack"]
                server = Server(target.url, target.data / "local-credential", node.name,
                                command=[proxy["command"], *proxy["args"]])
                try:
                    started, err = server.tool("start_task", title="Bridged watch", goal="Do nothing.",
                                               repo="contextstack", lane="bridged-watch")
                    worker.join(timeout=10)
                    expect(not err and received == [{"op": "watch_job", "job_id": started.get("job_id"),
                                                     "lane": "bridged-watch", "token": token}],
                           "bridged host start_task authenticates watch_job with private serve token", received)
                    expect(token not in "".join(server.seen) + json.dumps(bridge.config),
                           "serve token stays out of MCP output and proxy config")
                finally:
                    server.close()
            finally:
                bridge.close()


def main():
    spec = importlib.util.spec_from_file_location("review_cases", HERE / "review_cases.py")
    cases = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(cases)
    spec = importlib.util.spec_from_file_location("review_mcp", KIT / "scripts/cs_mcp.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    cases.check(module, scratch_dir)
    model_injection_offline()
    subprocess.run([sys.executable, str(HERE / "output_fallback.py")], check=True, env={**hermetic_env()})
    binary = Path(os.environ.get("DIRECTOR_BIN") or REPO / "target/release/cs-director")
    if not binary.is_file():
        print("SKIP cs-mcp: no director-rs at %s (cargo build --release -p cs-director)" % binary)
        return 1 if problems else 0
    tmp = tempfile.mkdtemp(prefix="cs-mcp-", suffix=".noindex")
    target = RustTarget(tmp, binary)
    try:
        ctx = Ctx("cs-mcp", target)
        node = ctx.node2()
        bridged_watch(target, node)
        token = target.local_token()
        server = Server(target.url, target.data / "local-credential", node.name)
        try:
            scenario(server, node, target, token, tmp)
        finally:
            server.close()
        expect(not any(token in line for line in server.seen), "the local credential never appears in the output")
        fixture = fixture_agents(tmp)
        profile_link = target.tmp / "code/cs/agents"
        profile_link.unlink()
        profile_link.mkdir()
        for name, text in (("tester", TESTER), ("looker", LOOKER)):
            (profile_link / (name + ".md")).write_text(text)
        profiles = Server(target.url, target.data / "local-credential", node.name, env={"CS_AGENTS_DIR": fixture})
        try:
            agents_scenario(profiles, target, token)
        finally:
            profiles.close()
    finally:
        target.close()
    print("cs-mcp: %s" % ("FAIL (%d)" % len(problems) if problems else "ok"))
    return 1 if problems else 0


