def scenario(server, node, target, token, tmp):
    init = server.rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}})["result"]
    expect(init["capabilities"] == {"tools": {}} and init["protocolVersion"] == "2025-06-18", "initialize", init)
    server.proc.stdin.write(json.dumps({"jsonrpc": "2.0", "method": "notifications/initialized"}) + "\n")
    names = {t["name"] for t in server.rpc("tools/list")["result"]["tools"]}
    want = {"start_task", "list_agents", "list_tasks", "task_status", "task_output", "wait_tasks", "cancel_task", "decide", "usage",
            "machines", "list_repos", "land_task", "needs_you", "clear_needs_you", "retry_task", "find_task"}
    expect(names == want, "tools/list names the tools", names)

    # 1b. the shipped profiles (cs/agents), and a budget over the gateway's hour refused before any upload.
    shipped, err = server.tool("list_agents")
    by = {a["name"]: a for a in shipped.get("agents", [])}
    expect(not err and set(by) >= {"coder", "reviewer", "researcher", "verifier"} and not any("error" in a for a in by.values())
           and by["coder"]["writes"] is True and by["reviewer"]["writes"] is False and by["researcher"]["lane"] is False
           and all(set(a) >= {"name", "description", "model", "writes", "lane"} for a in by.values()),
           "list_agents: the shipped profiles parse", shipped)
    before = stored(target)
    refused, err = server.tool("start_task", title="x", goal="x", budget={"seconds": 3601})
    expect(err and "3600" in refused.get("error", "") and stored(target) == before, "seconds > 3600 refused, nothing uploaded", refused)

    for model in ("codex\nid: hosted-lead", "codex\n", "co\ndex", " codex", "codex ",
                  "codex:foo", "codex#foo", "[codex]", "unknown-executor"):
        before = stored(target)
        refused, err = server.tool("start_task", title="Injection", goal="x", model=model)
        expect(err and "model" in refused.get("error", "") and stored(target) == before,
               "invalid model refused before any upload: %r" % model, refused)

    # 2. start_task builds and submits the bundle.
    started, err = server.tool("start_task", title="Say hello", goal="Make a.txt say hello.\n", repo="contextstack",
                               lane="say-hello", task_type="feature")
    expect(not err and started.get("job_id") and started["task"] == "tasks/say-hello", "start_task submits", started)
    job_id = started["job_id"]
    owner = lambda path: wire.request(target.url, "GET", "/api/v1/client/" + path, token=token)
    job = owner("jobs/" + job_id).json
    job = job.get("job", job)
    files = {f["path"]: f["mode"] for f in job["files"]}
    expect(files == {"spec.yaml": 420, "prompts/system.md": 420, "tasks/say-hello/goal.md": 420,
                     "tasks/say-hello/check": 493}, "the bundle: spec, prompt, goal, executable check", files)
    spec = owner("jobs/%s/files/spec.yaml" % job_id).body.decode()
    expect("model: cursor-sol\n" in spec and "\nintent: " in spec and "\nrepo: contextstack\n" in spec
           and "\nlane: say-hello\n" in spec and "base" not in spec and "tasks: [tasks/say-hello]" in spec,
           "spec names the model, the stamp and the workspace", spec)
    expect(by["coder"]["model"] == "cursor-sol" and by["reviewer"]["model"] == "cursor-codex"
           and by["researcher"]["model"] == "cursor-composer" and by["verifier"]["model"] == "cursor-agent",
           "shipped profiles default off Claude onto Cursor templates", by)
    check = owner("jobs/%s/files/tasks/say-hello/check" % job_id).body.decode()
    expect(check.startswith("#!/bin/sh") and "exit 0" in check, "no check given: the no check", check)
    expect(job["meta"].get("source") == "cs-mcp" and job["meta"].get("lane") == "say-hello"
           and job["meta"].get("task_type") == "feature", "meta tags", job["meta"])

    # 3. status while offered, then live.
    lanes, _ = server.tool("list_tasks")
    expect([l["state"] for l in lanes["lanes"] if l["job_id"] == job_id] == ["offered"]
           and lanes["lanes"][0]["title"] == "Say hello", "list_tasks shows it offered", lanes)
    node.accept(job_id)
    run_id = "cs-mcp-run-%d" % int(time.time())
    a = node.events(run_id, job_id, [delta(1, "Hel"), delta(2, "lo"), stop(3)])
    expect(a.status in (200, 201, 202), "node sends live events", a)
    status, _ = server.tool("task_status", job_id=job_id)
    expect(status["state"] == "accepted" and status.get("live_run_id") == run_id and status.get("live_events") == 3,
           "task_status names the live run", status)
    out, _ = server.tool("task_output", job_id=job_id)
    expect(out.get("partial_output") == "Hello", "task_output gives the partial text", out)

    # 4. wait_tasks: a timeout, then an early return when the job ends during the wait.
    slow = server.send("tools/call", {"name": "wait_tasks", "arguments": {"job_ids": [job_id], "timeout_seconds": 3}})
    fast = server.send("tools/call", {"name": "list_tasks", "arguments": {}})
    t0 = time.time()
    fast_reply = server.read(fast)["result"]
    fast_took = time.time() - t0
    slow_reply = server.read(slow)["result"]
    fast_lanes = json.loads(fast_reply["content"][0]["text"])
    slow_wait = json.loads(slow_reply["content"][0]["text"])
    expect(fast_took < 2 and not fast_reply.get("isError")
           and [l["job_id"] for l in fast_lanes.get("lanes", []) if l.get("job_id") == job_id] == [job_id]
           and slow_wait.get("timed_out") and slow_wait.get("still_running") == [job_id],
           "a slow wait_tasks does not block concurrent list_tasks; replies stay matched by id", [fast_took, slow_wait])

    waited, _ = server.tool("wait_tasks", job_ids=[job_id], timeout_seconds=1)
    expect(waited["timed_out"] and waited["still_running"] == [job_id], "wait_tasks times out while running", waited)
    ident = server.send("tools/call", {"name": "wait_tasks", "arguments": {"job_ids": [job_id], "timeout_seconds": 60}})
    t0 = time.time()
    threading.Timer(1.5, finish, (node, job_id, run_id)).start()
    reply = server.read(ident)["result"]
    waited, took = json.loads(reply["content"][0]["text"]), time.time() - t0
    expect(not waited["timed_out"] and [e["job_id"] for e in waited["ended"]] == [job_id] and took < 2,
           "wait_tasks returns when the job ends (%.1fs)" % took, waited)

    # 5. output, decision.
    out, _ = server.tool("task_output", job_id=job_id)
    expect(out.get("check", {}).get("verdict") == "pass" and out.get("diff", {}).get("files") == ["a.txt"]
           and "Done: a.txt says hello." in out.get("transcript_tail", ""), "task_output after the run", out)
    decided, err = server.tool("decide", decision="approve", job_id=job_id, note="looks right")
    expect(not err and decided.get("decision") == "approve" and decided.get("run_id") == run_id, "decide approves", decided)
    status, _ = server.tool("task_status", job_id=job_id)
    expect(status["state"] == "done" and status.get("run", {}).get("decision") == "approve", "status shows the decision", status)

    # 5b. a check body without a #! line still execs on the node (it got "Exec format error", 2026-11-11).
    sys.path.insert(0, str(REPO / "cs/scripts"))
    import cs_mcp
    expect(cs_mcp.as_script("test -f a.txt") == "#!/bin/sh\ntest -f a.txt\n"
           and cs_mcp.as_script("#!/bin/bash\ntrue\n") == "#!/bin/bash\ntrue\n"
           and cs_mcp.as_script("  ") == cs_mcp.NO_CHECK, "a plain check body gets #!/bin/sh")

    # 5c. an errored job end carries its reason through task_status, list_tasks, wait_tasks and task_output.
    failed, _ = server.tool("start_task", title="Boom", goal="Refuse.\n")
    fail_id = failed["job_id"]
    node.accept(fail_id)
    why = "executor: gateway refused or unavailable: invalid executor or timeout"
    finish(node, fail_id, None, state="error", reason=why)
    status, _ = server.tool("task_status", job_id=fail_id)
    expect(status.get("state") == "error" and status.get("error") == why, "task_status shows the error reason", status)
    lanes, _ = server.tool("list_tasks")
    listed = next((l for l in lanes["lanes"] if l["job_id"] == fail_id), {})
    expect(listed.get("error") == why, "list_tasks shows the error reason", listed)
    waited, _ = server.tool("wait_tasks", job_ids=[fail_id], timeout_seconds=5)
    ended = next((e for e in waited.get("ended", []) if e["job_id"] == fail_id), {})
    expect(ended.get("error") == why, "wait_tasks shows the error reason", waited)
    out, _ = server.tool("task_output", job_id=fail_id)
    expect(out.get("error") == why and out.get("note") != "no run yet",
           "task_output returns the error instead of 'no run yet'", out)

    # 6. cancel, usage, nodes, land, an unknown job.
    second, _ = server.tool("start_task", title="Another", goal="Anything.\n", check="#!/bin/sh\ntest -f b.txt\n")
    cancel, err = server.tool("cancel_task", job_id=second["job_id"], reason="not needed")
    expect(not err and cancel.get("state") == "requested" and cancel.get("job_id") == second["job_id"], "cancel_task", cancel)
    usage, err = server.tool("usage")
    expect(not err and "total" in usage, "usage answers", usage)
    nodes, err = server.tool("machines")
    expect(not err and node.name in [n["name"] for n in nodes["machines"]], "machines lists the node", nodes)
    repos = [{"name": "example", "path": "/tmp/example", "branch": "main"}]
    reported = node.call("POST", "status", body={"repos": repos})
    expect(reported.status == 200, "node reports repos", reported)
    listed, err = server.tool("list_repos")
    expect(not err and {**repos[0], "node": node.name} in listed.get("repos", []),
           "list_repos returns Director inventory", listed)
    land, err = server.tool("land_task", repo="contextstack", lane="say-hello")
    expect(not err and (land.get("available") is False or land.get("status") == "refused"),
           "land_task: cs land refuses an unknown repo, or is not in this release yet", land)
    for bad in ({"repo": "contextstack"}, {"repo": "contextstack", "lane": "Bad Name"}):
        refused, err = server.tool("start_task", title="x", goal="x", **bad)
        expect(err and "error" in refused, "start_task refuses %s" % bad, refused)
    missing, err = server.tool("task_status", job_id="no-such-job")
    expect(err and "404" in missing.get("error", ""), "an unknown job is an isError result", missing)

    # 7. a worker-thread tool fault is a JSON-RPC error (-32603) with the right id; the server keeps serving.
    fault = Server(target.url, target.data / "local-credential", node.name, env={"CS_MCP_TEST_RAISE": "usage"})
    try:
        fault.rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}})
        ident = fault.send("tools/call", {"name": "usage", "arguments": {}})
        broke = fault.read(ident)
        err = broke.get("error") or {}
        expect(broke.get("id") == ident and err.get("code") == -32603 and "fixture fault" in err.get("message", "")
               and "result" not in broke and "Traceback" not in json.dumps(broke),
               "a tool fault on the worker pool is JSON-RPC -32603", broke)
        lanes, err = fault.tool("list_tasks")
        expect(not err and isinstance(lanes.get("lanes"), list), "list_tasks still works after a worker fault", lanes)
    finally:
        fault.close()

    # 8. concurrent land_task on one repo: busy, not wait; another repo is not blocked.
    stub = Path(tmp) / "slow-land.py"
    stub.write_text(LAND_STUB)
    lander = Server(target.url, target.data / "local-credential", node.name, env={"CS_MCP_LAND_STUB": str(stub)})
    try:
        lander.rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}})
        desc = next(t for t in lander.rpc("tools/list")["result"]["tools"] if t["name"] == "land_task")["description"]
        expect("busy" in desc.lower() and "not wait" in desc.lower(), "land_task documents busy, not wait", desc)
        slow = lander.send("tools/call", {"name": "land_task", "arguments": {"repo": "contextstack", "lane": "say-hello"}})
        busy_id = lander.send("tools/call", {"name": "land_task", "arguments": {"repo": "contextstack", "lane": "other"}})
        other_id = lander.send("tools/call", {"name": "land_task", "arguments": {"repo": "other-repo", "lane": "x"}})
        t0 = time.time()
        busy = lander.read(busy_id)
        busy_took = time.time() - t0
        busy_body = json.loads(busy["result"]["content"][0]["text"])
        expect(busy_took < 1 and busy["result"].get("isError") and "busy" in busy_body.get("error", "").lower()
               and "contextstack" in busy_body.get("error", ""), "a concurrent land on the same repo is busy", busy_body)
        other = lander.read(other_id)
        other_took = time.time() - t0
        expect(other_took < 2.5 and not other["result"].get("isError"),
               "land_task on a different repo is not blocked (%.2fs)" % other_took, other)
        lander.read(slow)
    finally:
        lander.close()

    # 9. a long-running server follows ~/.contextstack/current: release A, switch to B, delete A.
    release_switch(target.url, target.data / "local-credential", node.name, tmp)

    # 10. retry_task: keeps model, allow_fallback for profile chain, previous-attempt goal, refuse pass and third attempt.
    retry_task_scenario(target, node, token, tmp)


