TESTER = """---
name: tester
description: a fixture profile
model: claude-code-sonnet
writes: true
lane: false
check: "test -f done.txt"
budget: {turns: 42, seconds: 900, usd: 0}
task_type: test
---
You are the fixture tester. Say TESTER-PROMPT.
"""
LOOKER = TESTER.replace("name: tester", "name: looker").replace("writes: true", "writes: false").replace(
    "lane: false", "lane: true").replace("TESTER-PROMPT", "LOOKER-PROMPT")
BROKEN = "---\nname: broken\ndescription: x\nmodel: claude-code-opus\nwrites: maybe\nlane: false\n---\nbody\n"
LONG = TESTER.replace("name: tester", "name: long").replace("seconds: 900", "seconds: 7200")


MINI_CODER = """---
name: coder
description: fixture coder
model: cursor-sol
writes: true
lane: true
check: ""
budget: {turns: 1, seconds: 60, usd: 0}
task_type: feature
---
Fixture coder body.
"""
MINI_VERIFIER = MINI_CODER.replace("description: fixture coder", "description: fixture verifier").replace(
    "Fixture coder body.", "Fixture verifier body.")

RETRY_CODER = MINI_CODER.replace(
    'task_type: feature\n---',
    'task_type: feature\nfallback: ["codex", "cursor-composer"]\n---',
)


def lay_out_release(root, rid, agents_md, kit_src):
    """One release under root/releases/<rid> with cs/scripts and a custom agents dir."""
    rel = root / "releases" / rid
    kit = rel / "cs"
    scripts = kit / "scripts"
    scripts.mkdir(parents=True)
    for name in ("cs", "cs_mcp.py", "cs_agents.py", "cs_runs.py"):
        shutil.copy2(kit_src / "scripts" / name, scripts / name)
    ops = kit / "ops/bin"
    ops.mkdir(parents=True)
    shutil.copy2(kit_src / "ops/bin/executor-templates.json", ops / "executor-templates.json")
    shutil.copy2(kit_src / "ops/bin/_lead_socket.py", ops / "_lead_socket.py")
    (kit / "agents").mkdir()
    for stem, text in agents_md.items():
        (kit / "agents" / (stem + ".md")).write_text(text)
    return kit


def release_switch(director_url, credential, node, tmp):
    root = Path(tmp) / "install"
    root.mkdir()
    releases = root / "releases"
    releases.mkdir()
    lay_a = lay_out_release(root, "rel-a", {"coder": MINI_CODER}, KIT)
    lay_b = lay_out_release(root, "rel-b", {"coder": MINI_VERIFIER}, KIT)
    current = root / "current"
    current.symlink_to(releases / "rel-a")
    stub = Path(tmp) / "rel-land-stub.py"
    stub.write_text(LAND_STUB)
    env = {"CS_INSTALL_ROOT": str(root), "CS_MCP_LAND_STUB": str(stub)}
    rel_srv = Server(director_url, credential, node, env=env)
    try:
        rel_srv.rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}})
        listed, err = rel_srv.tool("list_agents")
        by = {a["name"]: a for a in listed.get("agents", []) if not a.get("error")}
        expect(not err and by.get("coder", {}).get("description") != "fixture coder",
               "list_agents ignores local release A profiles", listed)
        land, err = rel_srv.tool("land_task", repo="contextstack", lane="say-hello")
        expect(not err and land.get("lane") == "say-hello" and land.get("available") is False,
               "land_task uses release A's cs while current points at A", land)
        current.unlink()
        current.symlink_to(releases / "rel-b")
        shutil.rmtree(releases / "rel-a")
        expect(not lay_a.exists(), "release A removed")
        listed, err = rel_srv.tool("list_agents")
        by = {a["name"]: a for a in listed.get("agents", []) if not a.get("error")}
        expect(not err and by.get("coder", {}).get("description") != "fixture verifier",
               "list_agents stays with Director after local release switch", listed)
        land, err = rel_srv.tool("land_task", repo="contextstack", lane="lane-b")
        expect(not err and land.get("lane") == "lane-b" and land.get("available") is False,
               "land_task resolves cs through current release B", land)
    finally:
        rel_srv.close()


def fixture_agents(tmp):
    where = Path(tmp) / "agents"
    where.mkdir()
    for name, text in (("tester", TESTER.replace("claude-code-sonnet", "codex")), ("looker", LOOKER), ("broken", BROKEN), ("long", LONG)):
        (where / (name + ".md")).write_text(text)
    (where / "local-only.md").write_text(TESTER.replace("name: tester", "name: local-only"))
    return str(where)


def retry_agents_dir(tmp):
    where = Path(tmp) / "retry-agents"
    where.mkdir()
    (where / "coder.md").write_text(RETRY_CODER.replace('fallback: ["codex", "cursor-composer"]', 'fallback: ["codex"]'))
    return str(where)


def retry_task_scenario(target, node, token, tmp):
    agents_dir = retry_agents_dir(tmp)
    state_root = Path(tmp) / "limits-state"
    state_root.mkdir()
    sys.path.insert(0, str(KIT / "ops" / "bin"))
    from _provider_limits import record_limit  # noqa: E402

    record_limit(state_root, "codex", {"message": "limited", "resets_at": "2099-01-01T00:00:00Z", "via": "test"})
    plain = Server(target.url, target.data / "local-credential", node.name, env={"CS_AGENTS_DIR": agents_dir})
    try:
        plain.rpc("initialize", {})
        s2, err = plain.tool("start_task", title="Stuck2", goal="Goal.\n", agent="coder", repo="contextstack", lane="stuck-plain")
        s2_id = s2["job_id"]
        node.accept(s2_id)
        finish_stuck(node, s2_id, "run-plain", reason="provider_limit")
        r2, err = plain.tool("retry_task", job_id=s2_id)
        expect(not err and r2.get("model") == "cursor-sol", "retry_task keeps the prior model by default", r2)
    finally:
        plain.close()
    server = Server(target.url, target.data / "local-credential", node.name,
                    env={"CS_AGENTS_DIR": agents_dir, "LAB_STATE_ROOT": str(state_root)})
    owner = lambda path: wire.request(target.url, "GET", "/api/v1/client/" + path, token=token)
    try:
        server.rpc("initialize", {"protocolVersion": "2025-06-18", "capabilities": {}})
        record_limit(state_root, "cursor-sol", {"message": "limited", "resets_at": "2099-06-01T00:00:00Z", "via": "test"})
        record_limit(state_root, "codex", {"message": "limited", "resets_at": "2099-01-01T00:00:00Z", "via": "test"})
        fallback, err = server.tool("start_task", title="Limit pick", goal="Go.\n", agent="coder",
                                    repo="contextstack", lane="limit-pick")
        expect(not err and fallback.get("model") == "cursor-composer" and fallback.get("model_chosen") == "cursor-composer",
               "start_task implicit model skips limited chain", fallback)
        expect(fallback.get("skipped") == [{"model": "cursor-sol", "until": "2099-06-01T00:00:00Z"},
                                           {"model": "codex", "until": "2099-01-01T00:00:00Z"}],
               "start_task reports skipped limits", fallback)
        explicit_bad, err = server.tool("start_task", title="No", goal="No.\n", model="cursor-sol")
        expect(err and "usage-limited" in explicit_bad.get("error", "") and "2099-06-01" in explicit_bad.get("error", ""),
               "explicit limited model refused with reset time", explicit_bad)
        usage, err = server.tool("usage")
        expect(not err and any(r.get("template") == "cursor-sol" and r.get("resets_at") for r in usage.get("provider_limits", [])),
               "usage lists limited templates", usage)
        from _provider_limits import load as load_limits, save as save_limits  # noqa: E402
        cleared = load_limits(state_root)
        cleared.get("templates", {}).pop("cursor-sol", None)
        save_limits(state_root, cleared)
        stuck, err = server.tool("start_task", title="Stuck work", goal="Do the thing.\n", agent="coder",
                                 repo="contextstack", lane="stuck-retry")
        expect(not err and stuck.get("model") == "cursor-sol", "retry fixture starts on cursor-sol", stuck)
        job_id = stuck["job_id"]
        node.accept(job_id)
        run_id = "cs-mcp-retry-%d" % int(time.time())
        finish_stuck(node, job_id, run_id, reason="stuck:repeat")
        refused, err = server.tool("retry_task", job_id=job_id, model="codex")
        expect(err and "usage-limited" in refused.get("error", ""), "explicit limited retry model refused", refused)
        expect("allow_fallback=true" in refused.get("error", ""), "limited explicit retry names allow_fallback", refused)
        keep, err = server.tool("start_task", title="Keep model", goal="Keep goal.\n", agent="coder",
                                 repo="contextstack", lane="stuck-keep")
        keep_id = keep["job_id"]
        node.accept(keep_id)
        finish_stuck(node, keep_id, "cs-mcp-keep-%d" % int(time.time()), reason="stuck:repeat")
        kept, err = server.tool("retry_task", job_id=keep_id, note="same model path")
        expect(not err and kept.get("model") == "cursor-sol" and kept.get("retry_of") == keep_id,
               "retry_task keeps cursor-sol when it is not limited", kept)
        original_spec = owner("jobs/%s/files/spec.yaml" % job_id).body.decode()
        original_check = owner("jobs/%s/files/tasks/stuck-retry/check" % job_id).body
        record_limit(state_root, "cursor-sol", {"message": "limited", "resets_at": "2099-06-01T00:00:00Z", "via": "test"})
        limited_refuse, err = server.tool("retry_task", job_id=job_id)
        expect(err and "cursor-sol" in limited_refuse.get("error", "") and "allow_fallback=true" in limited_refuse.get("error", ""),
               "retry_task refuses limited prior model without allow_fallback", limited_refuse)
        retried, err = server.tool("retry_task", job_id=job_id, allow_fallback=True, note="try codex path")
        expect(not err and retried.get("model") == "cursor-composer" and retried.get("retry_of") == job_id,
               "retry_task allow_fallback skips limited codex for cursor-composer", retried)
        expect(retried.get("model_fallback") == {"from": "cursor-sol", "to": "cursor-composer"},
               "retry_task allow_fallback reports model_fallback", retried)
        expect(retried.get("intent_id") == stuck["intent_id"], "retry retains the task intent", retried)
        bundle = owner("intents/" + stuck["intent_id"]).json
        expect(len(bundle.get("jobs", [])) == 2, "one task has both attempt jobs", bundle)
        lanes, err = server.tool("list_tasks", limit=100)
        task_lanes = [lane for lane in lanes.get("lanes", []) if lane.get("intent_id") == stuck["intent_id"]]
        expect(not err and len(task_lanes) == 1 and len(task_lanes[0].get("jobs", [])) == 2,
               "list_tasks shows the task once with both jobs", lanes)
        status, err = server.tool("task_status", job_id=retried["job_id"])
        expect(not err and len(status.get("jobs", [])) == 2, "task_status includes both jobs", status)
        job = owner("jobs/" + retried["job_id"]).json.get("job", owner("jobs/" + retried["job_id"]).json)
        meta = job.get("meta") or {}
        expect(meta.get("retry_of") == job_id and meta.get("attempt") == "2", "retry meta", meta)
        goal = owner("jobs/%s/files/tasks/stuck-retry/goal.md" % retried["job_id"]).body.decode()
        expect(goal.startswith("## Previous attempt") and "stuck:repeat" in goal and "Recent tool calls" in goal
               and "try codex path" in goal and goal.rstrip().endswith("Do the thing."),
               "goal prepends previous attempt", goal[:400])
        spec = owner("jobs/%s/files/spec.yaml" % retried["job_id"]).body.decode()
        expect("model: cursor-composer\n" in spec and retried["model"] == "cursor-composer",
               "retry bundle uses the fallback model", spec)
        expect(re.sub(r"^intent:.*\n?", "", spec, flags=re.M) == re.sub(r"^intent:.*\n?", "", original_spec, flags=re.M).replace("model: cursor-sol\n", "model: cursor-composer\n")
               and owner("jobs/%s/files/tasks/stuck-retry/check" % retried["job_id"]).body == original_check,
               "retry preserves the original spec and check except the model", spec)
        again, err = server.tool("retry_task", job_id=job_id)
        expect(err and ("third" in again.get("error", "").lower() or "already" in again.get("error", "").lower()),
               "retry_task refuses a third attempt", again)
        retry_id = retried["job_id"]
        node.accept(retry_id)
        finish_stuck(node, retry_id, "cs-mcp-retry2-%d" % int(time.time()), reason="stuck:idle_turns")
        ok_retry, err = server.tool("retry_task", job_id=retry_id)
        expect(err and "attempt 2" in ok_retry.get("error", ""), "retry_task refuses retrying the retry job", ok_retry)

        # cursor-sol is usage-limited by the scenario above; this lane starts on a template that is not.
        failed, err = server.tool("start_task", title="No profile", goal="Original goal.\n", model="cursor-composer")
        failed_id = failed["job_id"]
        node.accept(failed_id)
        finish(node, failed_id, None, state="error", reason="provider_limit: quota exhausted")
        explicit, err = server.tool("retry_task", job_id=failed_id, model="cursor-composer")
        explicit_goal = owner("jobs/%s/files/tasks/no-profile/goal.md" % explicit["job_id"]).body.decode() if not err else ""
        expect(not err and explicit.get("model") == "cursor-composer" and "quota exhausted" in explicit_goal
               and explicit_goal.endswith("Original goal.\n"), "explicit retry without profile or run preserves error reason", explicit)

        passed, _ = server.tool("start_task", title="Green", goal="Done.\n", agent="coder", repo="contextstack",
                               lane="passed-lane")
        pass_id = passed["job_id"]
        node.accept(pass_id)
        pass_run = "cs-mcp-pass-%d" % int(time.time())
        finish(node, pass_id, pass_run)
        refuse, err = server.tool("retry_task", job_id=pass_id)
        expect(err and "passed" in refuse.get("error", "").lower(), "retry_task refuses a passed job", refuse)
    finally:
        server.close()


def stored(target):
    """Every file the Director keeps outside its database: an upload adds one."""
    return sorted(str(p) for p in target.data.rglob("*") if p.is_file() and "sqlite" not in p.name)


def agents_scenario(server, target, token):
    owner = lambda path: wire.request(target.url, "GET", "/api/v1/client/" + path, token=token)
    listed, err = server.tool("list_agents")
    by = {a["name"]: a for a in listed.get("agents", [])}
    expect(not err and set(by) == {"tester", "looker"} and by["tester"]["model"] == "claude-code-sonnet",
           "list_agents reads Director profiles, excluding local-only profiles", listed)

    def bundle(job_id, task):
        job = owner("jobs/" + job_id).json
        job = job.get("job", job)
        get = lambda path: owner("jobs/%s/files/%s" % (job_id, path)).body.decode()
        return job, get("spec.yaml"), get("prompts/system.md"), get(task + "/check")

    dispatch = "mcp.lost-response:1"
    args = dict(title="Dispatch", goal="Do it.\n", agent="tester", dispatch_id=dispatch)
    server.tool("start_task", **args)  # Drop the accepted response.
    recovered, err = server.tool("find_task", dispatch_id=dispatch)
    replay, replay_err = server.tool("start_task", **args)
    expect(not err and not replay_err and len(recovered["intents"]) == 1
           and recovered["intents"][0]["intent_id"] == replay.get("intent_id")
           and recovered["jobs"][0]["job_id"] == replay.get("job_id"), "dispatch recovery and replay", recovered)
    conflict, err = server.tool("start_task", **dict(args, goal="Different"))
    expect(err and "different request" in conflict.get("error", ""), "dispatch conflict refused", conflict)
    recovered, err = server.tool("find_task", dispatch_id=dispatch)
    expect(not err and len(recovered["jobs"]) == 1, "dispatch conflict adds no work", recovered)
    a, err_a = server.tool("start_task", title="No dispatch", goal="Do it.\n", agent="tester")
    b, err_b = server.tool("start_task", title="No dispatch", goal="Do it.\n", agent="tester")
    expect(not err_a and not err_b and a.get("intent_id") != b.get("intent_id"), "no dispatch keeps fresh submissions")

    empty = stored(target)
    started, err = server.tool("start_task", title="Profiled", goal="Do it.\n", agent="tester")
    expect(len(stored(target)) > len(empty), "an upload shows in the Director's stored files (so 'nothing uploaded' means it)")
    job, spec, system, check = bundle(started.get("job_id"), started.get("task")) if not err else ({}, "", "", "")
    sha = hashlib.sha256(TESTER.encode()).hexdigest()
    expect(not err and "model: claude-code-sonnet\n" in spec and "budget: {turns: 42, tool_calls: 0, usd: 0.0, seconds: 900}" in spec
           and "TESTER-PROMPT" in system and check.startswith("#!/bin/sh\n") and "test -f done.txt" in check
           and started.get("agent") == "tester" and started.get("agent_sha256") == sha,
           "start_task(agent=tester): the profile's model, budget, system prompt and check", [started, spec, system, check])
    meta = job.get("meta") or {}
    expect(meta.get("agent") == "tester" and meta.get("agent_sha256") == sha and meta.get("task_type") == "test"
           and meta.get("model") == "claude-code-sonnet", "meta names the agent, its hash, its task type", meta)

    started, err = server.tool("start_task", title="Overridden", goal="Do it.\n", agent="tester", model="codex",
                               system="EXPLICIT-PROMPT\n", check="#!/bin/sh\nexit 0\n", budget={"turns": 7},
                               task_type="bugfix")
    job, spec, system, check = bundle(started.get("job_id"), started.get("task")) if not err else ({}, "", "", "")
    expect(not err and "model: codex\n" in spec and "budget: {turns: 7, tool_calls: 0, usd: 0.0, seconds: 900}" in spec
           and system == "EXPLICIT-PROMPT\n" and check == "#!/bin/sh\nexit 0\n"
           and (job.get("meta") or {}).get("task_type") == "bugfix" and (job.get("meta") or {}).get("agent") == "tester",
           "explicit arguments win over the profile (budget merged key by key)", [started, spec, system, check])

    started, err = server.tool("start_task", title="Look", goal="Review it.\n", agent="looker", repo="contextstack", lane="look")
    job, spec, system, check = bundle(started.get("job_id"), started.get("task")) if not err else ({}, "", "", "")
    expect(not err and "read-only" in check and "git status --porcelain" in check and "test -f done.txt" in check
           and "\nlane: look\n" in spec and "LOOKER-PROMPT" in system,
           "a read-only profile in a lane: its check fails if the worktree changed, then runs the profile's", check)

    before, intents = stored(target), len(owner("intents").json.get("intents", []))
    for args, says, what in (
            ({"agent": "nobody"}, "tester", "an unknown agent refused, naming the known ones"),
            ({"agent": "local-only"}, "tester", "a valid local-only profile cannot start"),
            ({"agent": "broken"}, "unknown agent", "a local-only profile cannot start"),
            ({"agent": "long"}, "unknown agent", "another local-only profile cannot start"),
            ({"agent": "tester", "budget": {"seconds": 4000}}, "3600", "an explicit seconds > 3600 refused"),
            ({"agent": "tester", "repo": "contextstack", "lane": "t"}, "scratch", "a lane: false profile refuses repo+lane"),
            ({"agent": "looker"}, "lane worktree", "a lane: true profile needs repo+lane")):
        refused, err = server.tool("start_task", title="x", goal="x", **args)
        expect(err and says in refused.get("error", ""), what, refused)
    expect(stored(target) == before and len(owner("intents").json.get("intents", [])) == intents,
           "nothing uploaded or submitted for a refused start_task")


