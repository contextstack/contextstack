        sys.path.insert(0, str(CODE_ROOT / "ops/bin"))
        from _toolchains import LOGIN_LOOKUP
        program = (
            "def _write_atomic(path, data, mode):\n from pathlib import Path\n path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)\n path.write_bytes(data); path.chmod(mode)\n"
            "import sys; from pathlib import Path; from types import SimpleNamespace; "
            "sys.path.insert(0, %r); import cs_init; "
            "init = cs_init.Init.__new__(cs_init.Init); "
            "init.config = Path.home() / '.contextstack/config'; "
            "init.args = SimpleNamespace(verbose='--verbose' in sys.argv); "
            "init.cs = SimpleNamespace(HOME=Path.home(), CURRENT=Path.home() / '.contextstack/current'); "
            "init.nr = __import__('types').SimpleNamespace(SYSTEM_PATH='/usr/bin:/bin', write_atomic=_write_atomic); "
            "lines = []; init.say = lines.append; "
            "init.detail = (lambda line: lines.append(line)) if ('--verbose' in sys.argv) else (lambda line: None); "
            "init.step_toolchains(); print('\\n'.join(lines))"
        ) % (str(CODE_ROOT / "scripts"),)

        def detect(paths, verbose=False):
            shell.write_text("#!%s\nimport sys\nassert sys.argv[1:] == ['-lc', %r]\nprint(%r, end='')"
                             % (sys.executable, LOGIN_LOOKUP, "".join(str(p) + "\n" for p in paths)))
            shell.chmod(0o755)
            result = subprocess.run([sys.executable, "-c", program, *(["--verbose"] if verbose else [])],
                                    env=env, capture_output=True, text=True, timeout=15)
            expect(result.returncode == 0, "toolchain detection succeeds: " + result.stderr)
            return result.stdout

        paths = [binaries / name for name in ("php", "composer")]
