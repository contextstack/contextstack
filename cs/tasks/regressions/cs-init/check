def test_welcome_completion():
    from unittest.mock import patch
    import io
    sys.path.insert(0, str(CODE_ROOT / "scripts"))
    import cs_init
    with scratch_dir(prefix="cs-welcome-test-") as tmp:
        data = Path(tmp)
        (data / "local-credential").write_text("fixture-only")
        init = cs_init.Init.__new__(cs_init.Init)
        init.data, init.url = data, "http://fixture"
        init.args = SimpleNamespace(no_first_job=False, timeout=0)
        marker = {"node": "fixture", "first_job": {"state": "done", "agent": "codex"}}
        init.marker_data = lambda: json.loads(json.dumps(marker))
        init.write_marker = lambda value: marker.update(value)
        state, reply, calls = "queued", None, []
        fail_post = False

        def response(req, timeout):
            calls.append(req)
            if req.full_url.endswith("/conversations"):
                value = {"conversation": {"conversation_id": "same-conversation"}}
            elif req.full_url.endswith("/turns"):
                if fail_post:
                    raise OSError("POST failed")
                expect(not marker["welcome"].get("turn"), "enqueue never marks welcome complete")
                value = {"turn": {"turn_id": "turn-%d" % marker["welcome"].get("attempt", 0)}}
            else:
                value = {"turns": [{"turn_id": marker["welcome"]["turn_id"], "state": state, "reply": reply}]}
            return io.BytesIO(json.dumps(value).encode())

        def prepare_error(expected):
            try:
                init.prepare_welcome()
            except Exception as error:
                expect(expected in str(error), "welcome reports %s: %s" % (expected, error))
            else:
                expect(False, "welcome must report %s" % expected)

        with patch("urllib.request.urlopen", side_effect=response):
            prepare_error("timed out")
            expect(not marker["welcome"].get("turn") and marker["welcome"].get("turn_id"),
                   "timeout retains conversation and pending turn without marking completion")
            before = len([r for r in calls if r.get_method() == "POST"])
            prepare_error("timed out")
            expect(len([r for r in calls if r.get_method() == "POST"]) == before,
                   "rerun reconciles the timed-out pending turn instead of enqueuing another")
            state = "error"
            prepare_error("ended error")
            expect(marker["welcome"]["conversation"] == "same-conversation" and not marker["welcome"].get("turn_id"),
                   "failed welcome keeps conversation and permits a new attempt")
            fail_post = True
            prepare_error("POST failed")
            expect(marker["welcome"]["conversation"] == "same-conversation" and not marker["welcome"].get("turn"),
                   "POST failure retains conversation without marking completion")
            fail_post = False
            state = "done"
            prepare_error("without a reply")
            reply = "Welcome!"
            init.prepare_welcome()
            expect(marker["welcome"].get("turn") is True, "only a finished turn with a reply marks welcome complete")
            expect(sum(r.full_url.endswith("/conversations") for r in calls) == 1,
                   "every welcome retry uses the original conversation")
            keys = [r.get_header("Idempotency-key") for r in calls if r.full_url.endswith("/turns")]
            expect(keys[0] != keys[1] and keys[1] == keys[2] and keys[2] != keys[3],
                   "terminal failures use new turn keys; ambiguous POST failures retain their key")



