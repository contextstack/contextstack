# launchd for a fake HOME: bootstrap starts the plist's command (env as written, 9200 mapped to $EMU_GW_PORT)
# in its own session and appends that child's pid and pgid. bootout SIGTERMs the group, then SIGKILLs a survivor.
# print answers whether it runs, kickstart -k restarts it. The pidfile is only the current child; `children`
# keeps every one, including a process a restart replaced.
LAUNCHCTL = r'''#!%s
import os, plistlib, signal, subprocess, sys, time
emu, port = os.environ["LAUNCHD_EMU"], os.environ["EMU_GW_PORT"]
args = sys.argv[1:]
open(os.path.join(emu, "calls.log"), "a").write("launchctl %%s\n" %% " ".join(args))
def read_int(path):
    try:
        return int(open(path).read())
    except (OSError, ValueError):
        return None
def pid(label):
    p = read_int(os.path.join(emu, label + ".pid"))
    if not p:
        return None
    try:
        os.kill(p, 0)
    except OSError:
        return None
    return p
def pgid_of(label):
    return read_int(os.path.join(emu, label + ".pgid")) or pid(label)
def group_alive(g):
    try:
        os.killpg(g, 0)
        return True
    except OSError:
        return False
def stop(label):
    p, g = pid(label), pgid_of(label)
    if not g or g <= 1 or g == os.getpgrp():
        if p and p > 1:
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.kill(p, sig)
                except OSError:
                    pass
        return
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(g, sig)
        except OSError:
            if p and p > 1:
                try:
                    os.kill(p, sig)
                except OSError:
                    pass
        for _ in range(30):
            if not group_alive(g) and pid(label) is None:
                return
            time.sleep(0.1)
def track(proc, label, path):
    try:
        g = os.getpgid(proc.pid)
    except OSError:
        g = proc.pid
    with open(os.path.join(emu, "children"), "a") as fh:
        fh.write("%%d %%d\n" %% (proc.pid, g))
    for name, value in ((label + ".pid", proc.pid), (label + ".pgid", g), (label + ".path", path)):
        with open(os.path.join(emu, name), "w") as fh:
            fh.write(str(value))
def start(path):
    d = plistlib.load(open(path, "rb"))
    env = {k: str(v).replace("127.0.0.1:9200", "127.0.0.1:" + port) for k, v in d["EnvironmentVariables"].items()}
    if env.get("CSGATEWAY_PORT") == "9200":
        env["CSGATEWAY_PORT"] = port
    env.update(HOME=os.environ["HOME"], CSGATEWAY_CLI_ENDPOINT="http://127.0.0.1:%%s/v1/agent/cli.run" %% port)
    for k in ("HTTP_PROXY", "HTTPS_PROXY", "http_proxy", "https_proxy", "ALL_PROXY", "NO_PROXY", "no_proxy"):
        if k in os.environ:
            env[k] = os.environ[k]
    proc = subprocess.Popen(d["ProgramArguments"], cwd=d["WorkingDirectory"], env=env, stdin=subprocess.DEVNULL,
                            stdout=open(d["StandardOutPath"], "a"), stderr=open(d["StandardErrorPath"], "a"),
                            start_new_session=True)
    track(proc, d["Label"], path)
if args[0] == "print":
    sys.exit(0 if pid(args[1].rsplit("/", 1)[1]) else 113)
if args[0] == "bootstrap":
    start(args[2])
elif args[0] == "bootout":
    stop(args[1].rsplit("/", 1)[1])
elif args[0] == "kickstart":
    label = args[-1].rsplit("/", 1)[1]
    stop(label)
    start(open(os.path.join(emu, label + ".path")).read())
'''

