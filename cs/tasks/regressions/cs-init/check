        expected = [{"name": name, "bin": str(binaries)} for name in ("php", "composer")]
        expect(destination.is_file() and json.loads(destination.read_text()) == expected,
               "login shell tools written with real directories")
        expect(destination.stat().st_mode & 0o777 == 0o644, "toolchains mode is 0644")
        expect(output.strip().splitlines() == ["php: %s" % binaries, "composer: %s" % binaries],
               "one plain line per toolchain added")
        custom = '[{"name": "custom", "bin": "/custom"}]\n'
        destination.write_text(custom)
        detect(paths)
        expect('"custom"' in destination.read_text() and '"php"' in destination.read_text(),
               "existing toolchains merged, not dropped")
        destination.unlink()
        (home / "php").write_text("fixture")
        expect(detect([home / "php"]).strip() == "" and not destination.exists(), "HOME tool directory skipped")
        credential = home / ".ssh"
        credential.mkdir()
        (credential / "php").write_text("fixture")
        expect(detect([credential / "php"]).strip() == "" and not destination.exists(), "credential directory skipped")
        expect(detect([]).strip() == "" and not destination.exists(), "no tools leaves no file or output")
        output = detect(paths, verbose=True)
        expect(all("%s: %s" % (name, binaries) in output for name in ("php", "composer")),
