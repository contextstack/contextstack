        token_line = [l for l in node_env.read_text().splitlines() if "CONTEXTSTACK_NODE_TOKEN=" in l] if node_env.is_file() else []
        token = token_line[0].split("=", 1)[1] if token_line else ""
        expect(len(token) >= 8 and node_env.stat().st_mode & 0o777 == 0o600, "node token in config/node.env, 0600")
        expect(token and token not in out, "the token is never printed")
        expect(not (root / "config/.cs-init-node-token").exists(), "no registration file left behind")
        spool = json.loads((root / "config/policy/spool.json").read_text())
        expect(spool.get("receiver", {}).get("url") == "http://127.0.0.1:%d" % port and spool["receiver"].get("node") == "test-mac",
               "the node's receiver is its own Director: %s" % spool.get("receiver"))
        marker = json.loads((root / "config/cs-init.json").read_text()) if (root / "config/cs-init.json").is_file() else {}
        first = marker.get("first_job") or {}
        expect(first.get("state") == "done" and first.get("agent") == "claude", "first job done through claude: %s" % first)
        expect("Claude Code answered: %s" % REPLY in out and "first job: done" not in out, "the reply is printed once")
        db = root / "state/director/director.sqlite"
        done = jobs(db)
        expect(len(done) == 2 and any(j == first.get("job") and state == "done" for j, state in done),
               "the Director has the completed hello and welcome turn: %s" % done)
        calls = [json.loads(l) for l in (tmp / "claude-calls.jsonl").read_text().splitlines()]
        expect(any("--print" in c for c in calls), "the job ran the fake claude through the claude-code template")
        calls_before = (emu / "calls.log").read_text()
        snap = snapshot(root / "config", agents)
        r2 = subprocess.run(argv[:3] + argv[5:], env=env, cwd="/", capture_output=True, text=True, timeout=120)
        out2 = r2.stdout + r2.stderr
        print("---- rerun ----\n%s----" % out2)
        expect(r2.returncode == 0 and "services:" not in out2 and "done earlier" in out2, "a rerun reports the state")
        expect(snapshot(root / "config", agents) == snap, "a rerun rewrites nothing under config/ or LaunchAgents")
        new_calls = (emu / "calls.log").read_text()[len(calls_before):]
        expect("bootstrap" not in new_calls and "kickstart" not in new_calls, "a rerun loads nothing: %r" % new_calls)
        expect({j for j, _ in jobs(db)} == {j for j, _ in done}, "a rerun creates no job")
        fake_key = "sk-FAKEtestkey0123456789"  # a stand-in: never a real key
        r3 = subprocess.run(argv[:3] + ["--api-key", "openai", "--no-first-job"], env=env, cwd="/", capture_output=True,
                            text=True, timeout=120, input=fake_key + "\n")
        stored = sorted(p.name for p in (root / "credentials").iterdir()) if (root / "credentials").is_dir() else []
        modes = {oct(p.stat().st_mode & 0o777) for p in (root / "credentials").iterdir()} if stored else set()
        expect(r3.returncode == 0 and stored and modes == {"0o600"}, "--api-key: stored in the file store, 0600: %s %s %s"
               % (stored, modes, (r3.stdout + r3.stderr)[-300:] if r3.returncode else ""))
        expect(fake_key not in r3.stdout + r3.stderr, "--api-key: the key is never printed")
        expect("kickstart" in (emu / "calls.log").read_text(), "--api-key: the gateway restarts to read it")
        print("cs init took %.1fs on a fresh install (first job included)" % took)
    finally:
        try:
            try:
                cleanup_error = cleanup_fixture()
            except Exception as exc:
                cleanup_error = str(exc)
            if cleanup_error:
                fail("fixture cleanup: %s" % cleanup_error)
            left, ps_err = None, None
            for _ in range(5):
                left, ps_err = fixture_processes(_fixture["prefixes"] or [])
                if ps_err or not left:
                    break
                time.sleep(0.2)
            if ps_err:
                fail("no process left whose command line contains the fixture root: %s" % ps_err)
            else:
                shown = (left or [])[:8]
                extra = "" if not left or len(left) <= 8 else " ... +%d" % (len(left) - 8)
                expect(not left, "no process left whose command line contains the fixture root%s" % (
                    ": " + "; ".join(shown) + extra if left else ""))
            why = _bundle.launchd_untouched(before)
            expect(not why, "the real launchd domain is untouched%s" % (": " + why if why else ""))
        finally:
            if problems and os.environ.get("CS_INIT_KEEP"):
                print("kept %s" % tmp)
            else:
                shutil.rmtree(tmp, ignore_errors=True)
    print("cs-init: %s" % ("FAIL (%d)" % len(problems) if problems else "ok"))
    return 1 if problems else 0


if __name__ == "__main__":
