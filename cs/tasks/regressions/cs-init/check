# The fixture directory the services were started under. Set before any child, cleared only by process exit.
# atexit and the SIGTERM handler both call cleanup_fixture, as does the test's finally (a timeout or an
# exception still has to stop the session-leaders the pidfile kill used to miss).
_fixture = {"prefixes": None, "emu": None}
_in_cleanup = False


def _usable_prefixes(paths):
    """Absolute `csi-<unique>` directories only, so a sweep cannot match `/tmp` or a sibling name."""
    out = []
    for raw in paths:
        text = str(raw).rstrip("/")
        name = os.path.basename(text)
        parent = os.path.dirname(text)
        if (text.startswith("/") and parent not in ("", "/") and name.startswith("csi-")
                and len(name) > len("csi-") and text not in out):
            out.append(text)
    return out


def _command_matches(command, prefixes):
    """True when `command` contains a prefix as a path, not as the start of a longer directory name."""
    if not command:
        return False
    for prefix in prefixes:
        start = 0
        while True:
            i = command.find(prefix, start)
            if i < 0:
                break
            end = i + len(prefix)
            before = i == 0 or command[i - 1] in " \t='\"::"
            after = end == len(command) or command[end] in "/ \t'\"::"
            if before and after:
                return True
            start = i + 1
    return False


def _ps_command_rows():
    """`(rows, error)` from `ps -axo pid,command`. `-ww` keeps a long argv from being cut before the fixture path."""
    try:
        proc = subprocess.run(["ps", "-ww", "-axo", "pid,command"], capture_output=True, text=True)
    except OSError as exc:
        return [], "ps -axo pid,command: %s" % exc
    if proc.returncode != 0:
        detail = (proc.stderr or "").strip() or "exit %s" % proc.returncode
        return [], "ps -axo pid,command: %s" % detail
    rows = []
    for line in proc.stdout.splitlines():
        parts = line.strip().split(None, 1)
        if len(parts) < 2:
            continue
        try:
            pid = int(parts[0])
        except ValueError:
            continue
        rows.append((pid, parts[1]))
    return rows, None


def _ps_pid_command(pid):
    """`('ok', command)`, `('dead', None)`, or `('error', message)` for one pid."""
    try:
        proc = subprocess.run(["ps", "-p", str(pid), "-ww", "-o", "command="], capture_output=True, text=True)
    except OSError as exc:
        return "error", str(exc)
    if proc.returncode < 0:
        return "error", "ps exited %s" % proc.returncode
    err = (proc.stderr or "").strip()
    low = err.lower()
    if "not permitted" in low or "operation not permitted" in low:
        return "error", err or "ps not permitted"
    if proc.returncode == 0:
        return "ok", proc.stdout.strip()
    if proc.returncode == 1 and (not err or "no matching" in low or "no such" in low or "invalid process" in low):
        return "dead", None
    if proc.returncode == 1 and not proc.stdout.strip():
        return "dead", None
    return "error", err or "ps exited %s" % proc.returncode


def _tracked_groups(emu):
    """Every pgid the fake launchctl recorded, pidfile and the append-only children list."""
    groups, seen = [], set()

    def add(pgid):
        if isinstance(pgid, int) and pgid > 1 and pgid != os.getpgrp() and pgid not in seen:
            seen.add(pgid)
            groups.append(pgid)

    root = Path(emu) if emu else None
    if root is None or not root.is_dir():
        return groups
    children = root / "children"
    if children.is_file():
        for line in children.read_text().splitlines():
            parts = line.split()
            if not parts:
                continue
            try:
                add(int(parts[1] if len(parts) > 1 else parts[0]))
            except ValueError:
                continue
    for pidfile in root.glob("*.pid"):
        pgid_file = pidfile.with_suffix(".pgid")
        try:
            add(int(pgid_file.read_text()) if pgid_file.is_file() else int(pidfile.read_text()))
        except (OSError, ValueError):
            continue
    return groups


def _should_signal_group(pgid, prefixes):
    """False when this pgid has been reused by a process outside the fixture. A dead leader is still ours:
    its group can hold children. When ps cannot answer, the pgid is one this test recorded."""
    if pgid <= 1 or pgid == os.getpgrp():
        return False
    state, info = _ps_pid_command(pgid)
    if state == "ok":
        return _command_matches(info or "", prefixes)
    return True


def _signal_group(pgid, sig):
    if pgid <= 1 or pgid == os.getpgrp():
        return
    try:
        os.killpg(pgid, sig)
    except OSError:
        pass


def _signal_if_fixture(pid, sig, prefixes):
    """SIG* one pid only after a fresh command line still shows the fixture root."""
    if pid <= 1 or pid in (os.getpid(), os.getppid()):
        return False
    state, info = _ps_pid_command(pid)
    if state != "ok" or not _command_matches(info or "", prefixes):
        return False
    try:
        os.kill(pid, sig)
    except OSError:
        return False
    return True


def _sweep(prefixes, sig):
    """Last resort: `ps -axo pid,command`, exact fixture-root prefix only. Returns an error string or None."""
    rows, err = _ps_command_rows()
    if err:
        return err
    for pid, _cmd in rows:
        if _command_matches(_cmd, prefixes):
            _signal_if_fixture(pid, sig, prefixes)
    return None


def fixture_processes(prefixes):
    """Command lines that still contain the fixture root, or `(None, error)` when ps cannot be read."""
    prefixes = _usable_prefixes(prefixes)
    rows, err = _ps_command_rows()
    if err:
        return None, err
    left = []
    for pid, cmd in rows:
        if pid in (os.getpid(), os.getppid()) or not _command_matches(cmd, prefixes):
            continue
        left.append("%d %s" % (pid, cmd))
    return left, None


def stop_fixture(prefixes, emu):
    """SIGTERM every tracked group, wait, SIGKILL whoever is still in it, then sweep the fixture root."""
    prefixes = _usable_prefixes(prefixes)
    if not prefixes:
        return "no fixture prefix"
    groups = [g for g in _tracked_groups(emu) if _should_signal_group(g, prefixes)]
    for pgid in groups:
        _signal_group(pgid, signal.SIGTERM)
    if groups:
        time.sleep(0.5)
        for pgid in groups:
            if _should_signal_group(pgid, prefixes):
                _signal_group(pgid, signal.SIGKILL)
    err = _sweep(prefixes, signal.SIGTERM)
    rows, sweep_err = _ps_command_rows()
    err = err or sweep_err
    if not err and any(_command_matches(cmd, prefixes) for _pid, cmd in rows):
        time.sleep(0.4)
        err = _sweep(prefixes, signal.SIGKILL) or err
    return err


def cleanup_fixture():
    global _in_cleanup
    if _in_cleanup or not _fixture["prefixes"]:
        return None
    _in_cleanup = True
    try:
        return stop_fixture(_fixture["prefixes"], _fixture["emu"])
    finally:
        _in_cleanup = False


atexit.register(cleanup_fixture)


def _on_sigterm(signum, _frame):
    cleanup_fixture()
    raise SystemExit(128 + signum)


def test_agent_probes():
    spec = importlib.util.spec_from_file_location("cs_init_fixture", CODE_ROOT / "scripts/cs_init.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    with scratch_dir(prefix="cs-init-agents-") as raw:
        home, binary = Path(raw) / "home", Path(raw) / "bin/goose"
        (home / ".config/goose").mkdir(parents=True, exist_ok=True)
        binary.parent.mkdir()
        binary.write_text("#!/bin/sh\necho goose 9.9.9\n")
        binary.chmod(0o755)
        reads = []

        class FakeCs:
            HOME = home

            @staticmethod
            def read_json(path, default):
                reads.append(path)
                return default

        init = module.Init.__new__(module.Init)
        init.cs = FakeCs()
        init.run = lambda argv, *args, **kwargs: subprocess.CompletedProcess(argv, 0, "goose 9.9.9\n", "")
        agent = init.probe("goose", str(binary.parent))
        expect(agent["signed_in"] is False, "goose: its config directory alone is not signed in")
        config = home / ".config/goose/config.yaml"
        config.write_text("active_provider: fixture\n")
        config.chmod(0)
        try:
            agent = init.probe("goose", str(binary.parent))
        finally:
            config.chmod(0o600)
        expect(agent["signed_in"] is True and reads == [],
               "goose: config.yaml is the provider artifact, detected without reading its contents")

        output = []
        init.args = SimpleNamespace(no_first_job=False, first_job=False, agent=None)
        init.marker_data = lambda: {}
        init.say = output.append
        agents = [{"name": name, "template": template, "path": str(binary), "signed_in": False}
                  for name, template in module.AGENTS.items()]
        rc = init.step_first_job("fixture", agents)
        init.prepare_welcome = lambda: fail("no-agent init must not create a welcome conversation")
        init.next_steps()
        expect(rc == 1 and output[0] == "Almost ready: ContextStack needs a coding agent."
               and output[-1] == "Then run: cs init" and len(output) == 6,
               "no-agent ending names four agents and asks to rerun init")
        expect(all(module.LABELS[n] in output[i] and module.sign_in_command(n) in output[i]
                   for i, n in enumerate(("claude", "codex", "cursor-agent", "gemini"), 1)),
               "no-agent ending uses shared sign-in commands")
        expect(not any("ContextStack is ready" in line or "conversation" in line for line in output),
               "no-agent ending has no ready line or conversation link")




