                init.next_steps()
            expect(output[-3] == "ContextStack is ready." and "#code=secret" in output[-2],
                   "opener failure prints URL and reason")
            marker["welcome"].pop("turn")
            marker["welcome"].pop("turn_id")
            with patch("urllib.request.urlopen", side_effect=OSError("turn POST failed")):
                init.next_steps()
