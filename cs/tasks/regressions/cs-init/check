        make_temp = tempfile.mkdtemp
        with patch("urllib.request.urlopen", side_effect=response), patch("sys.stdin.isatty", return_value=True), \
             patch.object(cs_ui, "issue_url", return_value="http://127.0.0.1:8780/ui/#code=secret"), \
             patch.object(cs_ui.subprocess, "run", side_effect=opener), patch.object(cs_ui.subprocess, "Popen"), \
             patch.object(cs_ui.tempfile, "mkdtemp", side_effect=lambda **kw: make_temp(dir=data, prefix="pair-")):
            init.next_steps()
            init.next_steps()
            expect(len(requests) == 3, "welcome conversation and turn are created once, then verified on rerun")
            expect(output == ["ContextStack is ready.", "Opened your first conversation in the browser.",
                              "Later: cs ui opens it again · cs lead create sets up the hosted lead · cs doctor checks for problems"] * 2,
                   "successful browser opens never print the pairing URL")
            expect(all("#code=secret" in page and "conversation=welcome-1" in page for page in opened),
                   "open receives a private redirect to the paired conversation")
            init.args.no_open = True
            init.next_steps()
            expect(len(opened) == 2 and "#code=secret&conversation=welcome-1" in output[-2] and
                   "expires in 5 minutes" in output[-2] and "works once" in output[-2],
                   "--no-open prints the one-time URL and its expiry, skipping the opener")
            init.args.no_open = False
            with patch("sys.stdin.isatty", return_value=False):
                init.next_steps()
            expect(len(opened) == 2 and "#code=secret&conversation=welcome-1" in output[-2] and
                   "expires in 5 minutes" in output[-2] and "works once" in output[-2],
                   "non-TTY prints the one-time URL and its expiry, skipping the opener")
            init.args.yes = True
            init.next_steps()
            expect(len(opened) == 2 and "#code=secret&conversation=welcome-1" in output[-2] and
                   "expires in 5 minutes" in output[-2] and "works once" in output[-2],
                   "--yes prints the paired conversation URL without opening")
