def test_login_and_fallback():
    spec = importlib.util.spec_from_file_location("cs_init_login", CODE_ROOT / "scripts/cs_init.py")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    with scratch_dir(prefix="cs-init-login-") as raw:
        root = Path(raw)
        exe = root / "codex"
        state = root / "signed-in"
        exe.write_text("#!/bin/sh\ncase \"$*\" in\n  --version) echo fake;;\n  'login status') test -f '%s' && echo 'Logged in';;\n  login) touch '%s';;\nesac\n" % (state, state))
        exe.chmod(0o755)
        init = module.Init.__new__(module.Init)
        init.args = SimpleNamespace(yes=False, no_first_job=False, first_job=False, agent=None, timeout=1)
        init.agent_path = lambda: str(root) + ":/usr/bin:/bin"
        init.cs = SimpleNamespace(HOME=root)
        init.config = root
        init.nr = SimpleNamespace(write_atomic=lambda p, data, mode: p.write_bytes(data))
        output, prompts = [], []
        init.say = output.append
        init.interactive = lambda: not init.args.yes
        import builtins
        old_input = builtins.input
        builtins.input = lambda prompt: prompts.append(prompt) or ""
        try:
            agents = init.step_agents()
            expect(prompts == ["Sign in to Codex now? [Y/n] "], "signed-out Codex is offered official login")
            expect(state.exists() and any(a["name"] == "codex" and a["signed_in"] is True for a in agents),
                   "fake login flips state and re-probe reports signed in")
            expect("Found Codex — not signed in" in output and "Found Codex — signed in" in output,
                   "plain-language status before and after login")
            expect(any(a["name"] == "codex" and a["signed_in"] for a in json.loads((root / "agents.json").read_text())),
                   "post-login capability snapshot records signed-in agent")
            prompts.clear()
            init.step_agents()
            expect(not prompts, "one signed-in agent is enough; no further login prompts")
            state.unlink()
            prompts.clear()
            init.args.yes = True
            init.step_agents()
            expect(not state.exists() and not prompts, "--yes never launches or prompts for login")
            init.args.yes = False
            init.interactive = lambda: False
            init.step_agents()
            expect(not state.exists() and not prompts, "non-TTY never launches or prompts for login")
        finally:
            builtins.input = old_input
        init.config = root
        install = {"keep": "existing"}
        def write_atomic(path, data, mode):
            path.write_bytes(data)
        init.nr = SimpleNamespace(load_record=lambda: install, write_atomic=write_atomic)
        init.marker_data = lambda: {"first_job": {"state": "failed"}}
        init.write_marker = lambda data: None
        init.wait_up = lambda: (True, True)
        init.url = "http://fixture"
        init.data = root
        init.cs = SimpleNamespace(CURRENT=root, read_body=lambda text: json.loads(text))
        init.run = lambda argv, *a, **kw: subprocess.CompletedProcess(argv, 0, '{"job_id":"fixture"}', '')
        init.job_row = lambda job: ("done", "run", None)
        replies = iter([module.REPLY])
        rows = iter([("failed", "run", None), ("done", "run", None)])
        init.job_row = lambda job: next(rows)
        init.reply = lambda run: (next(replies), root)
        candidates = [{"name": name, "template": module.AGENTS[name], "path": str(exe), "signed_in": True}
                      for name in ("claude", "codex")]
        rc = init.step_first_job("fixture", candidates)
        expect(rc == 0 and any("Codex answered: hello from ContextStack ✓" == line for line in output),
               "first agent has no answer; next signed-in agent answers")
        saved = json.loads((root / "install.json").read_text()) if (root / "install.json").exists() else {}
        expect(saved.get("default_agent") == "codex" and saved.get("default_model") == "codex" and saved.get("keep") == "existing",
               "verified default agent and model recorded without discarding install fields")


