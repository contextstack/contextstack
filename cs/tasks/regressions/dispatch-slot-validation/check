#!/usr/bin/env python3
import json
import shutil
import subprocess
import tempfile
from pathlib import Path
import sys
sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))  # frozen copies too
from scratch import scratch_dir
from hermetic_env import hermetic_env

CODE_ROOT = Path(__file__).resolve().parents[3]

with scratch_dir(prefix="dispatch-slot-") as raw:
    root = Path(raw)
    (root / "ops/bin").mkdir(parents=True)
    (root / "specs").mkdir()
    (root / "ledger").mkdir()
    for name in ('_dispatch.py', '_estate_io.py', '_roots.py', "enqueue", "_grant.py", "_workspace_setup.py"):
        shutil.copy2(CODE_ROOT / "ops/bin" / name, root / "ops/bin" / name)
    (root / "specs/fixture.yaml").write_text("id: fixture\nmodel: local-coder\n", encoding="utf-8")
    enqueue = root / "ops/bin/enqueue"
    bad = subprocess.run(
        [str(enqueue)],
        input=json.dumps({"spec": "specs/fixture.yaml", "slot": "manual-2026-09-02T18:35:00Z"}),
        text=True, capture_output=True, cwd=root,
     env={**hermetic_env()})
    assert bad.returncode != 0
    assert "RFC3339 UTC" in bad.stderr
    assert not (root / "ledger/dispatch.jsonl").exists()
    good = subprocess.run(
        [str(enqueue)],
        input=json.dumps({"spec": "specs/fixture.yaml", "slot": "2026-09-02T18:35:00Z"}),
        text=True, capture_output=True, cwd=root,
     env={**hermetic_env()})
    assert good.returncode == 0, good.stderr
    row = json.loads((root / "ledger/dispatch.jsonl").read_text(encoding="utf-8"))
    assert row["slot"] == "2026-09-02T18:35:00Z"
    probe = subprocess.run(
        [str(enqueue)],
        input=json.dumps({"spec": "specs/fixture.yaml", "lane": "probe",
                          "schedule_id": "probe-hello-smoke",
                          "slot": "2026-09-04T10:00:00Z"}),
        text=True, capture_output=True, cwd=root,
     env={**hermetic_env()})
    assert probe.returncode == 0, probe.stderr
    last = (root / "ledger/dispatch.jsonl").read_text(encoding="utf-8").splitlines()[-1]
    assert json.loads(last)["lane"] == "probe"
    assert json.loads(last)["schedule_id"] == "probe-hello-smoke"
    bad_lane = subprocess.run(
        [str(enqueue)],
        input=json.dumps({"spec": "specs/fixture.yaml", "lane": "nightly"}),
        text=True, capture_output=True, cwd=root,
     env={**hermetic_env()})
    assert bad_lane.returncode != 0
    assert "production, manager, shadow, or probe" in bad_lane.stderr
    # `manager` is the Manager batch's scheduling position, not a free-form
    # label: it must be accepted, or shadow-cycle cannot queue a batch at all.
    good_lane = subprocess.run(
        [str(enqueue)],
        input=json.dumps({"spec": "specs/fixture.yaml", "lane": "manager"}),
        text=True, capture_output=True, cwd=root,
     env={**hermetic_env()})
    assert good_lane.returncode == 0, good_lane.stderr
    last = (root / "ledger/dispatch.jsonl").read_text().splitlines()[-1]
    assert json.loads(last)["lane"] == "manager"

print("check: dispatch slot validation ok")
