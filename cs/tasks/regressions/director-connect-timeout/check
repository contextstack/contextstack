#!/usr/bin/env python3
"""director-connect-timeout regression (goal.md): a node's director call gives up connecting within
CONNECT_TIMEOUT_S, keeps the long read timeout for an answering director, and job-pull stays quick and quiet."""
import http.server
import json
import os
import socket
import subprocess
import sys
import tempfile
import threading
import time
from pathlib import Path
sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))  # frozen copies too
from scratch import scratch_dir
from hermetic_env import hermetic_env

CODE_ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(CODE_ROOT / "ops/bin"))
import _director_client as dc  # noqa: E402

problems = []


def expect(cond, msg):
    print(("ok   " if cond else "FAIL ") + msg)
    if not cond:
        problems.append(msg)


class Slow(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        time.sleep(4.5)  # longer than the connect timeout, shorter than the read timeout
        body = b'{"jobs": []}'
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("ContextStack-Protocol", "1")  # node protocol 1 (tests/director-spec/NODE-PROTOCOL.md)
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *a):
        pass


def client(url):
    with scratch_dir(prefix="director-client-config-") as raw:
        config = Path(raw)
        token = config / "node.env"
        token.write_text("DC_TEST_TOKEN=test-token\n")
        token.chmod(0o600)
        previous = os.environ.get("CS_CONFIG_ROOT")
        os.environ["CS_CONFIG_ROOT"] = str(config)
        try:
            return dc.Client(dc.receiver_config({"url": url, "node": "t", "token_env": "DC_TEST_TOKEN"}))
        finally:
            if previous is None:
                os.environ.pop("CS_CONFIG_ROOT", None)
            else:
                os.environ["CS_CONFIG_ROOT"] = previous


def main():
    expect(dc.CONNECT_TIMEOUT_S <= 3.0, "connect timeout is %ss (at most 3 s)" % dc.CONNECT_TIMEOUT_S)

    # 1. A connect that never completes: the call fails at the connect timeout, not the 30 s read timeout.
    seen = []
    real = socket.create_connection

    def hanging(address, timeout=None, *a, **k):
        seen.append(timeout)
        time.sleep(timeout or 0)
        raise socket.timeout("timed out (simulated SYN drop)")
    socket.create_connection = hanging
    try:
        t0 = time.monotonic()
        try:
            client("http://192.0.2.1:8790").call("GET", "jobs")
            raised = False
        except dc.DirectorUnreachable:
            raised = True
        took = time.monotonic() - t0
    finally:
        socket.create_connection = real
    expect(raised and seen == [dc.CONNECT_TIMEOUT_S] and took < dc.CONNECT_TIMEOUT_S + 1.5,
           "hanging connect: DirectorUnreachable after %.1fs, connect timeout passed %s" % (took, seen))

    # 2. A director that answers slowly: the read timeout is still the client's (30 s), so the call succeeds.
    server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Slow)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    try:
        t0 = time.monotonic()
        out = client("http://127.0.0.1:%d" % server.server_address[1]).call("GET", "jobs")
        expect(out == {"jobs": []} and time.monotonic() - t0 > 4,
               "slow director (4.5 s answer): the read keeps the long timeout and succeeds")
    except dc.DirectorUnreachable as error:
        expect(False, "slow director: %s (the read timeout was cut to the connect timeout)" % error)
    finally:
        server.shutdown()

    # 3. job-pull as tick runs it, against an address that drops SYNs: quick, one JSON line, exit 0.
    with scratch_dir(prefix="director-connect-timeout-") as tmp:
        config, state = Path(tmp) / "config", Path(tmp) / "state"
        (config / "policy").mkdir(parents=True)
        state.mkdir()
        (config / "ESTATE").write_text("t\n")
        (config / "policy/spool.json").write_text(json.dumps({"version": 1, "min_free_bytes": 0, "receiver": {
            "kind": "director", "url": "http://192.0.2.1:8790", "node": "t", "token_env": "DC_TEST_TOKEN"}}))
        (config / "node.env").write_text("DC_TEST_TOKEN=test-token\n")
        (config / "node.env").chmod(0o600)
        env = {**hermetic_env(), 'CS_CONFIG_ROOT': str(config), 'CS_STATE_ROOT': str(state), 'PYTHONDONTWRITEBYTECODE': '1'}
        t0 = time.monotonic()
        r = subprocess.run([sys.executable, str(CODE_ROOT / "ops/bin/job-pull")], input="{}", text=True,
                           capture_output=True, env=env, cwd=str(CODE_ROOT), timeout=60)
        took = time.monotonic() - t0
        try:
            out = json.loads(r.stdout.strip().splitlines()[-1])
        except (ValueError, IndexError):
            out = {}
        expect(r.returncode == 0 and out.get("ok") is True and "error" in out and took < 8 and not r.stderr.strip(),
               "job-pull against an unreachable director (192.0.2.1): exit %s in %.1fs, %s" % (r.returncode, took, out))
    print("check: director-connect-timeout %d problem(s)" % len(problems))
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
