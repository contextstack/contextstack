#!/usr/bin/env python3
"""evidence-backup retains a post-1b run dir's terminal record (goal.md)."""
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))  # frozen copies too
from scratch import scratch_dir
from hermetic_env import hermetic_env

LAB = Path(__file__).resolve().parents[3]
BACKUP = LAB / "ops/bin/evidence-backup"
HAPPY = LAB / "tasks/regressions/runner-characterisation-v2/cases/happy-fs-write/expected.json"
NOT_RETAINED = {"workspace", "finalize.lock"}


def gnu_rsync():
    for candidate in ("/opt/homebrew/bin/rsync", "/usr/local/bin/rsync", shutil.which("rsync")):
        if not candidate:
            continue
        try:
            out = subprocess.run([candidate, "--version"], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.TimeoutExpired):
            continue
        if "openrsync" not in out and "version 3." in out:
            return candidate
    return None


def write_exec(path, text):
    path.write_text(text, encoding="utf-8")
    path.chmod(0o755)


real = gnu_rsync()
if not real:
    print("backup-omits-terminal-record: skipped, no GNU rsync 3.x (evidence-backup refuses without one)")
    sys.exit(0)
entries = json.loads(HAPPY.read_text(encoding="utf-8"))["runs"][0]["entries"]
with scratch_dir(prefix="backup-terminal-record-") as raw:
    base = Path(raw)
    run = base / "source/20261109-000000.000000000-fx-happy-fs-write-fx-t1"
    for name in entries:
        if name in ("evidence", "stimulus", "workspace"):
            (run / name).mkdir(parents=True)
            (run / name / "f.txt").write_text(name + "\n", encoding="utf-8")
        else:
            run.mkdir(parents=True, exist_ok=True)
            (run / name).write_text(name + "\n", encoding="utf-8")
    target = base / "target"
    socket = base / "socket"
    socket.touch()
    ssh = base / "ssh"  # mkdir and the workspace prune run locally; the rsync remote shell is never used
    write_exec(ssh, """#!/usr/bin/env python3
import subprocess, sys
argv = sys.argv[1:]
while argv and argv[0].startswith('-'):
    argv = argv[2:] if argv[0] in ('-S', '-o') else argv[1:]
sys.exit(subprocess.run(argv[1:]).returncode)
""")
    rsync = base / "rsync"  # GNU rsync with the op's filter, the host:path target made local
    write_exec(rsync, """#!/usr/bin/env python3
import os, sys
real, args, out = %r, sys.argv[1:], []
if '--version' in args:
    os.execv(real, [real, '--version'])
i = 0
while i < len(args):
    if args[i] == '-e':
        i += 2
        continue
    out.append(args[i])
    i += 1
out[-1] = out[-1].split(':', 1)[1]
os.execv(real, [real] + out)
""" % real)
    env = {**hermetic_env(), "EVIDENCE_BACKUP_SOCKET": str(socket), "EVIDENCE_BACKUP_SSH": str(ssh),
           "EVIDENCE_BACKUP_SOURCE": str(base / "source"), "EVIDENCE_BACKUP_RSYNC": str(rsync),
           "EVIDENCE_BACKUP_TARGET": "fixture:" + str(target) + "/", "TMPDIR": str(base)}
    done = subprocess.run([str(BACKUP)], env=env, text=True, capture_output=True, timeout=120)
    assert done.returncode == 0, (done.stdout, done.stderr)
    got = sorted(p.name for p in (target / run.name).iterdir())
    want = sorted(set(entries) - NOT_RETAINED)
    missing, extra = sorted(set(want) - set(got)), sorted(set(got) - set(want))
    assert not missing and not extra, "missing at the target: %s; unexpected: %s" % (missing, extra)
    for name in ("terminal.json", "messages.jsonl", "check.json", "finalized.json"):
        assert (target / run.name / name).read_text(encoding="utf-8") == name + "\n", name
print("backup-omits-terminal-record: a post-1b run dir backs up with %s; workspace and lock stay home" % ", ".join(want))
