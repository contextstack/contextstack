def code_copy(dest):
    """The reader code as an install runs it: ops, scripts and the files they read, no tasks/."""
    dest.mkdir()
    for name in ("ops", "scripts", "tools", "grants", "schedules", "policy", "specs"):
        if (CODE_ROOT / name).is_dir():
            shutil.copytree(CODE_ROOT / name, dest / name, symlinks=True,
                            ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
    for name in ("INVARIANTS.md", "PINNED.md"):
        if (CODE_ROOT / name).is_file():
            shutil.copy2(CODE_ROOT / name, dest / name)
    (dest / "grants").mkdir(exist_ok=True)  # the code root may ship no grants/ (2026-11-13)
    (dest / "grants/g-fixture.yaml").write_text(
        "id: g-fixture\nestate: dev\nrepo: %s\npaths: [tasks, specs]\ngates: [\"true\"]\n"
        "commit: true\nstatus: active\nexpiry: 2999-01-01T00:00:00Z\n" % (FX or "/nonexistent/fx"))


def strip_cutover(src, dest):
    """dest = src with every estate_cutover row removed (every other byte kept)."""
    shutil.copytree(src, dest, symlinks=True)
    removed = 0
    for path in sorted(dest.glob("*.jsonl")):
        raw = path.read_bytes()
        kept = [line for line in raw.splitlines(keepends=True)
                if b'"estate_cutover"' not in line or json.loads(line).get("event") != "estate_cutover"]
        removed += len(raw.splitlines()) - len(kept)
        path.write_bytes(b"".join(kept))
    return removed


class Root:
    """One state root and its own code copy; runs readers with only the install's roots set."""

    def __init__(self, scratch, name, state, config):
        self.state, self.code = state, scratch / ("code-" + name)
        code_copy(self.code)
        self.env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": str(scratch), "LANG": "C.UTF-8",
                    "TZ": "UTC", "PYTHONDONTWRITEBYTECODE": "1",
                    "CS_STATE_ROOT": str(state), "CS_CONFIG_ROOT": str(config)}

    def run(self, argv, payload=None):
        r = subprocess.run(argv, input=payload if isinstance(payload, str) else json.dumps(payload or {}), text=True,
                           capture_output=True, cwd=str(self.code), env=self.env, timeout=300)
        return r.returncode, r.stdout, r.stderr

    def op(self, name, payload=None):
        return self.run([sys.executable, str(self.code / "ops/bin" / name)], payload)

    def helpers(self):
        """The shelf-reading helpers ops import, called in one child with the roots set."""
        return self.run([sys.executable, "-c", HELPERS, str(self.code)])


HELPERS = r'''
