    ("scripts/report", lambda r: r.run([sys.executable, str(r.code / "scripts/report"), str(r.state / "ledger.jsonl")], "")),
    ("helpers (node-listen schedules, _void, _dispatch, _landing)", lambda r: r.helpers()),
]
KEPT = {NOW[:16]}
STAMP = re.compile(r"\d{4}-\d\d-\d\d[T ]\d\d:\d\d:\d\d(\.\d+)?(Z|[+-]\d\d:?\d\d)?")


def normal(text, root):
    """Output with the root's paths and wall-clock instants masked; instants (to the minute) of the shelves'
    domain rows and NOW are kept."""
    for path, name in ((root.state, "<state>"), (root.code, "<code>")):
        text = text.replace(os.path.realpath(path), name).replace(str(path), name)
    text = STAMP.sub(lambda m: m.group(0) if m.group(0)[:16] in KEPT else "<now>", text)
    return re.sub(r'"(scan_ms|elapsed_ms|seconds_since|age_s|age_seconds)": [0-9.]+', r'"\1": <n>', text)


def domain_rows(state):
    out = {}
    for path in sorted(state.glob("*.jsonl")):
        out[path.name] = [line for line in path.read_text(encoding="utf-8", errors="replace").splitlines()
                          if line.strip() and '"estate_cutover"' not in line]
    return out


def compare(cut, twin):
    for label, call in READERS:
        a, b = call(cut), call(twin)
        crashed = [w for w, (_, _, err) in (("cut", a), ("twin", b)) if "Traceback" in err]
        expect(not crashed, "%s: no traceback" % label, [(w, (a if w == "cut" else b)[2][-700:]) for w in crashed])
        na = (a[0], normal(a[1], cut), normal(a[2], cut))
        nb = (b[0], normal(b[1], twin), normal(b[2], twin))
        if label.startswith("helpers"):
            ha, hb = (json.loads(x[1] or "{}") for x in (na, nb))
            for h in (ha, hb):  # a traceback's tail is cut at a length that differs with the root's path
                h.update({k: dict(v, tb=None) for k, v in h.items() if isinstance(v, dict) and "raised" in v})
            raised = {k: v for k, v in ha.items() if isinstance(v, dict) and v.get("raised") == "KeyError"}
            expect(not raised, "helpers: no KeyError on the cut-over root", raised)
            diff = sorted(k for k in set(ha) | set(hb) if ha.get(k) != hb.get(k))
            expect(a[0] == 0 and not diff, "helpers: every helper returns the same on both roots",
                   {k: (ha.get(k), hb.get(k)) for k in diff} or a[2][-500:])

            continue
        expect(na == nb, "%s: same exit and output with and without the cutover rows" % label,
               {"cut": na, "twin": nb} if na != nb else "")
    ra, rb = domain_rows(cut.state), domain_rows(twin.state)
    shelves = sorted(n for n in set(ra) | set(rb) if [normal(x, cut) for x in ra.get(n, [])] !=
                     [normal(x, twin) for x in rb.get(n, [])])
    expect(not shelves, "the shelves the readers appended to hold the same domain rows on both roots",
           {n: (ra.get(n, [])[-2:], rb.get(n, [])[-2:]) for n in shelves})


def unit():
    sys.path.insert(0, str(CODE_ROOT / "ops/bin"))
    import _estate_io
    with scratch_dir(prefix="cutover-readers-unit-") as raw:
        path = Path(raw) / "x.jsonl"
        row = {"event": "estate_cutover", "from": "dev", "to": "workstation", "aliases": ["dev"], "estate": "workstation"}
        path.write_text('{"id": "a"}\n' + json.dumps(row) + '\n[1]\n')
        expect(_estate_io.read_jsonl(path, strict=True) == [{"id": "a"}, [1]]
               and _estate_io.read_jsonl(path, strict=False) == [{"id": "a"}]
               and list(_estate_io.iter_jsonl(path, strict=True, errors="strict", objects_only=False)) == [{"id": "a"}, [1]],
               "read_jsonl/iter_jsonl skip estate_cutover rows and keep every other value as before")
        expect(_estate_io.read_jsonl(path, strict=True, with_bookkeeping=True) == [{"id": "a"}, row, [1]],
               "with_bookkeeping=True still yields them")


def main(argv):
    unit()
    given = None
    if argv[:1] == ["--state-copy"] and len(argv) == 2:
        given = Path(os.path.realpath(argv[1]))
        if (given.as_posix() + "/").startswith(os.path.realpath(REAL) + "/") or not given.is_dir():
            print("refused: --state-copy takes a copy of a state root, never ~/.contextstack itself")
            return 2
    elif argv:
        print(__doc__)
        return 2
    scratch = Path(os.path.realpath(tempfile.mkdtemp(prefix="cutover-readers-", suffix=".noindex")))
    try:
        state, config = scratch / "state", scratch / "config"
        config.mkdir()
        if (CODE_ROOT.parent / "target/release").is_dir():  # <code>/../target/release/cs-tools, as in a release; check builds it
            (scratch / "target").symlink_to(CODE_ROOT.parent / "target")
        if given is None:
            state.mkdir()
            fixture_state(state)
            (config / "ESTATE").write_text("workstation\n")
            env = {"PATH": os.environ.get("PATH", ""), "HOME": str(scratch), "CS_STATE_ROOT": str(state),
                   "CS_CONFIG_ROOT": str(config)}
            r = subprocess.run([sys.executable, str(CODE_ROOT / "ops/bin/estate-cutover")], text=True, capture_output=True,
                               input=json.dumps({"estate": "workstation", "mode": "write"}), env=env, cwd=str(CODE_ROOT))
            out = json.loads((r.stdout or "{}").strip().splitlines()[-1] or "{}")
            expect(r.returncode == 0 and len(out.get("rows_appended", [])) == len(SHELVES),
                   "the real estate-cutover cut the fixture over dev -> workstation, one row on each shelf",
                   out or r.stderr[-500:])
        else:
            shutil.copytree(given, state, symlinks=True)
            record = json.loads((state / "estate-cutover-v2.json").read_text())
            (config / "ESTATE").write_text(record["estate"] + "\n")
            import hashlib
            (config / "estate-cutover-v2.sha256").write_text(
                hashlib.sha256((state / "estate-cutover-v2.json").read_bytes()).hexdigest() + "\n")
        KEPT.update(m.group(0)[:16] for rows in domain_rows(state).values() for line in rows
                    for m in STAMP.finditer(line))
        twin = scratch / "twin"
        removed = strip_cutover(state, twin)
        expect(removed >= 1, "the twin root is the cut-over root less its %d estate_cutover row(s)" % removed)
        cut_root, twin_root = Root(scratch, "cut", state, config), Root(scratch, "twin", twin, config)
        code, out, err = cut_root.op("estate-cutover", {"mode": "verify"})
        expect(code == 0 and json.loads(out.strip().splitlines()[-1]).get("ok"),
               "readers that must see the cutover rows still do: estate-cutover verify passes", (out + err)[-600:])
        compare(cut_root, twin_root)
        code, out, err = cut_root.op("estate-cutover", {"mode": "verify"})
        expect(code == 0, "estate-cutover verify still passes after every reader ran (rows they appended say workstation)",
               (out + err)[-600:])
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
    print("\ncheck: estate-cutover-readers %d assertion(s) failed%s"
          % (len(FAILED), (": " + "; ".join(FAILED)) if FAILED else ""))
    return 1 if FAILED else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
