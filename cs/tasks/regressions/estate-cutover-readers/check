def expect(cond, label, detail=""):
    print("%s %s%s" % ("ok  " if cond else "FAIL", label, (" : " + str(detail)[:900]) if detail else ""))
    if not cond:
        FAILED.append(label)


def jsonl(rows):
    return "".join(json.dumps(r, sort_keys=True) + "\n" for r in rows)


