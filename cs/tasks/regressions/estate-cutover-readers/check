def call(name, fn):
    try:
        out[name] = json.loads(json.dumps(fn(), sort_keys=True, default=str))
    except Exception as error:
        out[name] = {"raised": type(error).__name__, "error": str(error), "tb": traceback.format_exc()[-400:]}
