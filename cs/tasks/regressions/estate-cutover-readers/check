call("_landing verdict/dispatch", lambda: [_landing._verdict_for_run(code, "run-a"), _landing._dispatch_exists(code, "1")])
print(json.dumps(out, sort_keys=True))
'''

# (label, how to run it) — every reader op and script of a state shelf; payloads keep them read-only or dry-run,
# except where the reader's real call appends (schedule-tick as node-listen runs it, void-watch, trigger-check,
# and then the shelves they wrote are compared too.
READERS = [
    ("schedule-tick (dry run)", lambda r: r.op("schedule-tick", {"now": NOW, "dry_run": True, "scan_stale": False,
                                                                "local_model_ready": True})),
    ("schedule-tick (as node-listen runs it)", lambda r: r.op("schedule-tick", '{"missed_default": "skip"}')),
