#!/usr/bin/env python3
"""P0 sixth verification pass: process environments are a credential boundary.

Offline checks always run. Host verification: check --darwin-probe runs a decoy
attack under the production executor profile and proves the old launch shape leaks.
Only temporary HOME/config data and fake tokens are used.
"""
import sys
from pathlib import Path
sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))
from scratch import scratch_dir

import ast
