#!/usr/bin/env python3
"""The hosted lead reaches its own MCP bridge socket under its real profile, and no other.

2026-11-12: the socket allowlist (#63) and the lead-mcp-* lane deny also cut the lead off from
its own bridge, so every hosted turn ran without tools ("MCP server disconnected").
Host-only: --darwin-probe."""
import sys
from pathlib import Path
sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))
from scratch import scratch_dir

import json, os, socket, subprocess, sys, tempfile, threading
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parents[2] / "ops/bin"))
if "--darwin-probe" not in sys.argv or sys.platform != "darwin":
    print("lead-bridge-reach: SKIP (host-only; run with --darwin-probe on macOS)")
    raise SystemExit(0)
os.environ.setdefault("CS_EXECUTOR_ALLOW_UNSANDBOXED", "0")
import _lead_host


def listener(path):
    s = socket.socket(socket.AF_UNIX); s.bind(str(path)); s.listen(4)

    def serve():
        # Closing the listener at the end aborts a pending accept(); that is the normal stop, not a failure
        # (an unhandled abort in this daemon thread raced interpreter shutdown and failed a land, 2026-11-12).
        for _ in range(4):
            try:
                conn, _addr = s.accept()
            except OSError:
                return
            conn.close()

    threading.Thread(target=serve, daemon=True).start()
    return s


own_dir = Path(tempfile.mkdtemp(prefix="lead-mcp-", dir="/tmp", suffix=".noindex"))
other_dir = Path(tempfile.mkdtemp(prefix="lead-mcp-", dir="/tmp", suffix=".noindex"))
own, other = own_dir / "mcp.sock", other_dir / "mcp.sock"
servers = [listener(own), listener(other)]
probe = ("import socket,sys\nfor p in sys.argv[1:]:\n s=socket.socket(socket.AF_UNIX)\n"
         " try:\n  s.connect(p); print('ok')\n except OSError as e: print('denied', e.errno)\n")
try:
    with scratch_dir(prefix="lead-bridge-") as raw:
        root = Path(raw).resolve()
        ws, tmp, runtime = root / "ws", root / "tmp", root / "state/lead-sessions/con_x/home"
        for d in (ws, tmp, runtime):
            d.mkdir(parents=True)
        _lead_host._SANDBOX_CMD_CACHE = None
        build = _lead_host.sandbox_builder(ws, tmp, tmp / "sandbox.sb", write_roots=(runtime,), allow_sockets=(own,))
        cmd = build(sys.executable, ["-c", probe, str(own), str(other)])
        done = subprocess.run(cmd, cwd=ws, capture_output=True, text=True, timeout=30,
                              env={"PATH": "/usr/bin:/bin", "HOME": str(Path.home())})
        lines = done.stdout.split()
        assert done.returncode == 0 and lines[:1] == ["ok"], ("own bridge unreachable", done.stdout, done.stderr)
        assert "denied" in done.stdout.splitlines()[1], ("another lead bridge reachable", done.stdout)
finally:
    for s in servers:
        s.close()
    for d in (own_dir, other_dir):
        for f in d.iterdir():
            f.unlink()
        d.rmdir()
print("lead-bridge-reach: PASS (own bridge reachable; other lead-mcp sockets denied)")
