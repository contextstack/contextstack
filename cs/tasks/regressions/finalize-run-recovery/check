def test_tick(rep, fx, mode):
    """mode estate: the runner leaves no row (ESTATE missing refuses it). mode publish: the
    runner's own finalize-run fails at publish, so a ledger row IS present, finalized.json is
    not, and the runner exits 3 (item 5): tick must still report finalization_pending and
    withhold completion, finalization stays pending until the sweep succeeds."""
    publish = mode == "publish"
    estate = fx.fresh("tick-" + mode)
    template_run = run_dir_of(estate)
    (estate / "fixture/template-runs").mkdir()
    shutil.move(str(template_run), str(estate / "fixture/template-runs" / template_run.name))
    ops = estate / "ops/bin"
    if publish:
        copy_exec(ops / "publish-evidence", ops / "publish-evidence.real")
        (ops / "publish-evidence").write_text(FAILING_PUBLISH, encoding="utf-8")
    else:
        (estate / "ESTATE").unlink()  # the first finalize attempt must refuse the row
    for source in (CODE_ROOT / "ops/bin").iterdir():
        if source.is_file() and not (ops / source.name).exists():
            shutil.copy2(source, ops / source.name)
    for name in ("corpus-audit", "void-watch"):
        (ops / name).write_text("#!/bin/sh\necho '{\"ok\":true,\"skip\":\"fixture\"}'\n", encoding="utf-8")
        (ops / name).chmod(0o755)
    (ops / "local-model-ready").write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
    (ops / "local-model-ready").chmod(0o755)
    (estate / "grants").mkdir()
    (ops / "run-api").write_text(FAKE_LAB.replace("__FINALIZE__", repr(publish)), encoding="utf-8")
    (ops / "run-api").chmod(0o755)

    git_env = clean_env(estate, GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_NOSYSTEM="1")
    subprocess.run(["git", "init", "-q", str(estate)], check=True, env=git_env)
    subprocess.run(["git", "-C", str(estate), "-c", "user.name=Fixture", "-c", "user.email=f@example.invalid",
                    "commit", "--allow-empty", "-qm", "fixture"], check=True, env=git_env)

    def op(name, payload):
        return subprocess.run([sys.executable, str(ops / name)], input=json.dumps(payload), text=True,
                              capture_output=True, cwd=str(estate), env=git_env, timeout=120)

    tag = "tick-%s" % mode
    lane = "production" if publish else "probe"
    enq = op("enqueue", {"spec": "specs/fx.yaml", "lane": lane, "task": TASK_REL, "note": "recovery"})
    rep.expect(enq.returncode == 0, "%s: job enqueued on lane %s" % (tag, lane), enq.stderr[-300:])
    jid = json.loads(enq.stdout.strip().splitlines()[-1])["id"]
    tick1 = op("tick", {})
    out1 = json.loads(tick1.stdout.strip().splitlines()[-1]) if tick1.stdout.strip() else {}
    rep.expect("Traceback" not in tick1.stderr and out1.get("code") == 3 and out1.get("ok") is False,
               "%s: runner exit 3 is reported as code 3" % tag, (out1, tick1.stderr[-400:]))
    dispatch = [json.loads(l) for l in (estate / "ledger/dispatch.jsonl").read_text().splitlines() if l.strip()]
    terminal = [r for r in dispatch if str(r.get("id") or r.get("job")) == jid and r.get("state") in {"done", "error"}]
    run_name = template_run.name
    rep.expect(len(terminal) == 1 and terminal[0]["state"] == "error" and terminal[0]["code"] == 3
               and terminal[0]["verdict"] == "void" and terminal[0]["stop"] == "finalization_pending"
               and terminal[0]["run_id"] == run_name and terminal[0]["transcript"] == "ledger/runs/" + run_name,
               "%s: dispatch TERMINAL row state error, code 3, stop finalization_pending, run_id/transcript" % tag,
               terminal)
    expected_rows = len(PRIOR_ROWS) + (1 if publish else 0)
    rows1 = [json.loads(l) for l in rows_of(estate)]
    rep.expect(len(rows1) == expected_rows and (not publish or rows1[-1]["transcript"] == "ledger/runs/" + run_name),
               "%s: %s" % (tag, "the finalizer's own row is present, nothing invented beside it" if publish
                           else "no ledger row yet (the fact is not invented)"), len(rows1))
    run_dir = estate / "ledger/runs" / run_name
    error = json.loads((run_dir / "finalize.error").read_text(encoding="utf-8")) if (run_dir / "finalize.error").is_file() else {}
    rep.expect(bool(error) and not (run_dir / "finalized.json").exists()
               and (("publish-evidence failed" in error.get("error", "")) if publish else ("ESTATE" in error.get("error", ""))),
               "%s: the first retry ran and recorded its error" % tag, (error, entries(run_dir)))
    # Next tick: the cause is repaired, the dir is past the grace window -> the sweep finishes it.
    if publish:
        copy_exec(ops / "publish-evidence.real", ops / "publish-evidence")
    else:
        (estate / "ESTATE").write_text("dev\n", encoding="utf-8")
    old = time.time() - 120
    os.utime(run_dir / "terminal.json", (old, old))
    tick2 = op("tick", {})
    out2 = json.loads(tick2.stdout.strip().splitlines()[-1]) if tick2.stdout.strip() else {}
    rep.expect("Traceback" not in tick2.stderr and out2.get("finalize_sweep") == {"attempted": 1, "finalized": 1, "pending": 0},
               "%s: the sweep reports attempted 1, finalized 1, pending 0" % tag, (out2, tick2.stderr[-400:]))
    rows = [json.loads(l) for l in rows_of(estate)]
    rep.expect(len(rows) == len(PRIOR_ROWS) + 1 and rows[-1]["verdict"] == "pass"
               and rows[-1]["transcript"] == "ledger/runs/" + run_name and (run_dir / "finalized.json").is_file()
               and (run_dir / "ready_for_inspection").is_file(),
               "%s: the sweep leaves exactly one ledger row, finalized.json and the inspection marker" % tag,
               rows[-1] if rows else None)
    tick3 = op("tick", {})
    out3 = json.loads(tick3.stdout.strip().splitlines()[-1]) if tick3.stdout.strip() else {}
    rep.expect("finalize_sweep" not in out3 and len(rows_of(estate)) == len(rows),
               "%s: nothing left to sweep, nothing appended, completion never fired" % tag, out3)
    if publish:
        test_orphan_sweep(rep, estate, run_dir, op)


def test_orphan_sweep(rep, estate, finalized_run, op):
    """Report cell dirs a dead runner left (follow-up): tick's sweep removes only old, unclaimed ones."""
    cells, pending = estate / "ledger/sandbox-reports", estate / "ledger/runs/fx-pending"
    pending.mkdir()
    (pending / "terminal.json").write_text("{}", encoding="utf-8")  # young: inside the finalize grace, never attempted
    gone = str(finalized_run / "workspace")  # its run is finalized: nothing will claim this cwd again
    plan = {"old-orphan": (gone, 48), "young-orphan": (gone, 1), "old-claimed": (str(pending / "workspace"), 48),
            "old-torn": (None, 48)}
    for name, (cwd, hours) in plan.items():
        (cells / name).mkdir(parents=True)
        report = cells / name / "1-1.json"
        report.write_text(json.dumps({"cwd": cwd, "tool": "/x", "backend": "fake"}) if cwd else '{"cwd": "/', encoding="utf-8")
        old = time.time() - hours * 3600
        os.utime(report, (old, old))
        os.utime(cells / name, (old, old))
    tick = op("tick", {})
    out = json.loads(tick.stdout.strip().splitlines()[-1]) if tick.stdout.strip() else {}
    rep.expect("Traceback" not in tick.stderr and out.get("finalize_sweep") == {
        "attempted": 0, "finalized": 0, "pending": 0, "orphans_removed": 1, "orphans_kept": 2},
        "orphan sweep: tick reports 1 removed, 2 kept (claimed, torn); the young dir is not a candidate",
        (out, tick.stderr[-400:]))
    left = sorted(p.name for p in cells.iterdir())
    rep.expect(left == ["old-claimed", "old-torn", "young-orphan"],
               "orphan sweep: the old unclaimed dir is gone; young, claimed and torn remain", left)


