def test_durable_entry(rep, fx):
    """S0: terminal.json and the run dir are fsync'd before any step; nothing else changes."""
    plain, watched = fx.fresh("durable-plain"), fx.fresh("durable-watched")
    finalize(plain)
    log = watched / "fixture/fsync-log.json"
    r = subprocess.run([sys.executable, "-c", FSYNC_WRAP, str(watched / "ops/bin/finalize-run")], cwd=str(watched),
                       env=clean_env(watched, FSYNC_LOG=str(log)), text=True, capture_output=True, timeout=120,
                       input=json.dumps({"run_dir": str(run_dir_of(watched))}))
    synced = json.loads(log.read_text()) if log.is_file() else []
    run_dir = os.path.realpath(run_dir_of(watched))
    rep.expect(r.returncode == 0 and synced[:2] == [os.path.join(run_dir, "terminal.json"), run_dir],
               "durable: terminal.json then the run dir are the first fsyncs, before any step writes", synced[:3])

    def view(estate):
        d = run_dir_of(estate)
        row = json.loads(rows_of(estate)[-1])
        row.pop("ts")
        done = json.loads((d / "finalized.json").read_text())
        return (row, (d / "check.json").read_text(), (d / "transcript.md").read_text(), entries(d),
                done["steps"], done.get("error_class"))
    rep.expect(view(plain) == view(watched), "durable: row, check.json, transcript, entries and steps are unchanged")


def test_concurrent(rep, fx):
    estate = fx.fresh("concurrent")
    run_dir = run_dir_of(estate)
    ops = estate / "ops/bin"
    copy_exec(ops / "publish-evidence", ops / "publish-evidence.real")
    (ops / "publish-evidence").write_text(SLOW_PUBLISH, encoding="utf-8")
    before = len(rows_of(estate))
    payload = json.dumps({"run_dir": str(run_dir)})
    procs = [subprocess.Popen([str(ops / "finalize-run")], cwd=str(estate), env=clean_env(estate),
                              stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
             for _ in range(2)]
    import threading
    results = [None, None]
    def finish(i, proc):
        out, err = proc.communicate(input=payload, timeout=120)
        try:
            results[i] = (proc.returncode, json.loads(out.strip().splitlines()[-1]))
        except (ValueError, IndexError):
            results[i] = (proc.returncode, {"raw": out, "stderr": err})
    threads = [threading.Thread(target=finish, args=(i, p)) for i, p in enumerate(procs)]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()
    winners = [r for r in results if r[0] == 0 and r[1].get("state") == "finalized"]
    losers = [r for r in results if r[0] == 3 and r[1].get("state") == "pending"]
    rep.expect(len(winners) == 1 and len(losers) == 1, "concurrent: one finalized, one pending", results)
    rep.expect(all(r[1].get("state") != "finalized" for r in losers) and
               losers[0][1].get("reason") == "another finalizer holds the lock" if losers else False,
               "concurrent: the loser names the lock and never claims finalized", results)
    rep.expect(len(rows_of(estate)) == before + 1, "concurrent: exactly one row", len(rows_of(estate)) - before)
    rep.expect((run_dir / "evidence/manifest.json").is_file() and footer_count(run_dir) == 1
               and (run_dir / "finalized.json").is_file() and not (run_dir / "finalize.error").exists(),
               "concurrent: one evidence record, one footer, one finalized.json, no finalize.error",
               entries(run_dir))


def test_kill_retry(rep, fx):
    for step in ("check", "transcript", "publish", "row"):  # envelope: test_envelope
        estate = fx.fresh("kill-" + step)
        run_dir = run_dir_of(estate)
        before = len(rows_of(estate))
        rc, out, err = finalize(estate, FINALIZE_RUN_CRASH_AFTER=step)
        rep.expect(rc == 137 and not (run_dir / "finalized.json").exists(),
                   "kill after %s: op died at the boundary, no finalized.json" % step, (rc, err[-200:]))
        check_before = (run_dir / "check.json").read_bytes()
        reached = {"check": 0, "transcript": 1, "publish": 2, "row": 3}[step]
        rep.expect((run_dir / "transcript.md").exists() == (reached >= 1)  # rendered and footered together
                   and footer_count(run_dir) == (1 if reached >= 1 else 0)
                   and (run_dir / "evidence/manifest.json").is_file() == (reached >= 2)
                   and len(rows_of(estate)) - before == (1 if reached >= 3 else 0),
                   "kill after %s: exactly the completed steps are on disk" % step, entries(run_dir))
        # A rerun of the check would now FAIL; the retry must keep the persisted pass.
        (run_dir / "workspace/hello.txt").unlink()
        rc2, out2, err2 = finalize(estate)
        rep.expect(rc2 == 0 and out2.get("state") == "finalized" and out2.get("verdict") == "pass",
                   "kill after %s: retry completes with the original verdict" % step, (rc2, out2, err2[-200:]))
        rep.expect((run_dir / "check.json").read_bytes() == check_before,
                   "kill after %s: check.json byte-identical, never rerun" % step)
        rows = [json.loads(l) for l in rows_of(estate)[before:]]
        rep.expect(len(rows) == 1 and rows[0]["verdict"] == "pass" and footer_count(run_dir) == 1
                   and (run_dir / "evidence/manifest.json").is_file() and (run_dir / "finalized.json").is_file(),
                   "kill after %s: one row, one footer, one record, finalized" % step, (len(rows), entries(run_dir)))
        if step == "row":
            done = json.loads((run_dir / "finalized.json").read_text(encoding="utf-8"))
            rep.expect(done["steps"]["row"] == "existing" and done["steps"]["publish"] == "ok"
                       and done["steps"]["check"] == "existing" and done["steps"]["render"] == "existing"
                       and done["steps"]["transcript"] == "existing" and done["steps"]["envelope"] == "written",
                       "kill after row: the retry found every step's output and appended nothing", done["steps"])


