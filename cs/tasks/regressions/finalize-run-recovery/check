def done_error_class(run_dir):
    done = json.loads((run_dir / "finalized.json").read_text(encoding="utf-8"))
    return done.get("error_class", "absent")


def envelope_of(estate, run_dir):
    path = estate / "ledger/outbox" / (run_dir.name + ".json")
    return json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}


def test_envelope(rep, fx):
    estate = fx.fresh("envelope")
    run_dir = run_dir_of(estate)
    rc, out, err = finalize(estate)
    env = envelope_of(estate, run_dir)
    line = rows_of(estate)[-1].encode("utf-8")
    paths = [f["path"] for f in env.get("files", [])]
    rep.expect(rc == 0 and env.get("envelope_version") == 1 and env.get("event_id") == "run_finalized:" + run_dir.name
               and env.get("run_id") == run_dir.name and env.get("transcript") == "ledger/runs/" + run_dir.name
               and env.get("row_sha256") == hashlib.sha256(line).hexdigest() and env.get("row_version") == 2
               and env.get("error_class") is None, "envelope: outbox/<run_id>.json binds the event, the row bytes", env)
    want = {"terminal.json", "messages.jsonl", "check.json", "transcript.md", "trace.jsonl", "stimulus/manifest.json",
            "evidence/manifest.json"}
    rep.expect(want <= set(paths) and paths == sorted(paths) and not any(
                   x.startswith(("workspace/", "finalized.json", "finalize.")) for x in paths)
               and all(hashlib.sha256((run_dir / f["path"]).read_bytes()).hexdigest() == f["sha256"]
                       and (run_dir / f["path"]).stat().st_size == f["bytes"] for f in env["files"]),
               "envelope: files cover the record, stimulus and evidence by size and sha256; never workspace or finalized.json",
               paths)
    trace = run_dir / "trace.jsonl"
    spans = [json.loads(line) for line in trace.read_bytes().splitlines()] if trace.is_file() else []
    rep.expect([span["kind"] for span in spans[-2:]] == ["finalization", "run"]
               and spans[-2]["attributes"]["verdict"] == "pass" and spans[-1]["outcome"] == "finalized",
               "envelope: trace ends with the finalization span and finalized root")
    row = json.loads(line)
    usage = env.get("usage") or {}
    rep.expect(set(usage) == {"input_tokens", "output_tokens", "est_usd", "est_basis", "charged_usd", "source"}
               and usage.get("est_usd") == row.get("est_usd") and usage.get("charged_usd") == row.get("cost_usd")
               and (usage.get("source") or {}).get("model") == (row.get("model") or None),
               "envelope: usage (node protocol 1) carries the row's est_usd, its cost_usd as charged_usd, and the model", usage)
    rep.expect(env.get("envelope_sha256") == hashlib.sha256("".join(
                   "%s:%s\n" % (f["path"], f["sha256"]) for f in env["files"]).encode()).hexdigest(),
               "envelope: envelope_sha256 is over the sorted path:sha256 lines")
    # A tampered envelope (another run's hashes under this name) is pending and never overwritten.
    estate = fx.fresh("envelope-mismatch")
    run_dir = run_dir_of(estate)
    rc, _, _ = finalize(estate, FINALIZE_RUN_CRASH_AFTER="envelope")
    path = estate / "ledger/outbox" / (run_dir.name + ".json")
    rep.expect(rc == 137 and path.is_file() and not (run_dir / "finalized.json").exists(),
               "kill after envelope: the envelope is on disk, no finalized.json", entries(run_dir))
    good = path.read_bytes()
    trace = run_dir / "trace.jsonl"
    sealed = trace.read_bytes()
    rc2, out2, _ = finalize(estate)
    done = json.loads((run_dir / "finalized.json").read_text(encoding="utf-8")) if rc2 == 0 else {}
    rep.expect(rc2 == 0 and done.get("steps", {}).get("envelope") == "existing" and path.read_bytes() == good
               and len(rows_of(estate)) == len(PRIOR_ROWS) + 1 and trace.read_bytes() == sealed,
               "kill after envelope: the retry reuses the envelope and trace, one row, finalized", done.get("steps"))
    (run_dir / "finalized.json").unlink()
    path.write_text(json.dumps({**json.loads(good), "envelope_sha256": "0" * 64}), encoding="utf-8")
    tampered = path.read_bytes()
    rc3, out3, _ = finalize(estate)
    rep.expect(rc3 == 3 and "differs from the recomputed" in out3.get("reason", "") and path.read_bytes() == tampered
               and not (run_dir / "finalized.json").exists(),
               "envelope mismatch: pending, reason names both hashes, the envelope is not overwritten", out3)


def test_enospc(rep, fx, scratch):
    estate = fx.fresh("enospc")
    run_dir = run_dir_of(estate)
    before = len(rows_of(estate))
    rc, out, _ = finalize(estate, FINALIZE_RUN_ENOSPC_BEFORE="row")
    error = json.loads((run_dir / "finalize.error").read_text(encoding="utf-8")) if (run_dir / "finalize.error").is_file() else {}
    rep.expect(rc == 3 and out.get("state") == "pending" and "No space left" in out.get("reason", "")
               and error.get("class") == "spool_full" and len(rows_of(estate)) == before
               and not (run_dir / "finalized.json").exists(),
               "enospc: finalize.error class spool_full, no row, pending", (rc, out, error))
    rc2, out2, _ = finalize(estate)
    rows = [json.loads(l) for l in rows_of(estate)[before:]]
    rep.expect(rc2 == 0 and out2.get("state") == "finalized" and len(rows) == 1 and rows[0].get("row_version") == 2,
               "enospc: the retry after space returns appends exactly one version 2 row", (rc2, out2, rows))
    estate = fx.fresh("enospc-envelope")
    run_dir = run_dir_of(estate)
    rc, out, _ = finalize(estate, FINALIZE_RUN_ENOSPC_BEFORE="envelope")
    error = json.loads((run_dir / "finalize.error").read_text(encoding="utf-8")) if (run_dir / "finalize.error").is_file() else {}
    rep.expect(rc == 3 and error.get("class") == "spool_full" and len(rows_of(estate)) == len(PRIOR_ROWS) + 1
               and not (estate / "ledger/outbox" / (run_dir.name + ".json")).exists(),
               "enospc before the envelope: the row stands, no envelope, class spool_full", (rc, error))
    rc2, _, _ = finalize(estate)
    rep.expect(rc2 == 0 and len(rows_of(estate)) == len(PRIOR_ROWS) + 1 and envelope_of(estate, run_dir),
               "enospc before the envelope: the retry writes it and appends nothing", rc2)


FSYNC_WRAP = r"""
import atexit, fcntl, json, os, runpy, sys
log, real = [], os.fsync
def path_of(fd):
    if hasattr(fcntl, "F_GETPATH"):
        return fcntl.fcntl(fd, fcntl.F_GETPATH, bytes(1024)).split(b"\0", 1)[0].decode()
    return os.readlink("/proc/self/fd/%d" % fd)
def fsync(fd):
    log.append(path_of(fd))
    return real(fd)
os.fsync = fsync
atexit.register(lambda: open(os.environ["FSYNC_LOG"], "w").write(json.dumps(log)))
script = sys.argv[1]
sys.argv = [script]
sys.path.insert(0, os.path.dirname(script))
runpy.run_path(script, run_name="__main__")
