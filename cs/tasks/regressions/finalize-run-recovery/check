def test_publish_marker(rep, fx):
    """Item 1: the publish skip is keyed on ready_for_inspection, not on the manifest."""
    for marker in (False, True):
        name = "marker-" + ("kept" if marker else "lost")
        estate = fx.fresh(name)
        run_dir = run_dir_of(estate)
        before = len(rows_of(estate))
        rc, _, _ = finalize(estate, FINALIZE_RUN_CRASH_AFTER="publish")
        rep.expect(rc == 137 and (run_dir / "evidence/manifest.json").is_file()
                   and (run_dir / "ready_for_inspection").is_file(),
                   "%s: killed after a complete publish (manifest and marker on disk)" % name, entries(run_dir))
        if not marker:  # the crash window between the manifest rename and the marker write
            (run_dir / "ready_for_inspection").unlink()
        ops = estate / "ops/bin"
        copy_exec(ops / "publish-evidence", ops / "publish-evidence.real")
        (ops / "publish-evidence").write_text(COUNTING_PUBLISH, encoding="utf-8")
        rc2, out2, err2 = finalize(estate)
        calls = estate / "fixture/publish-calls"
        called = calls.read_text(encoding="utf-8").count("called") if calls.is_file() else 0
        rep.expect(rc2 == 0 and out2.get("state") == "finalized" and out2.get("publish") == "ok"
                   and len(rows_of(estate)) == before + 1 and (run_dir / "finalized.json").is_file(),
                   "%s: retry finalizes with publish ok and one row" % name, (rc2, out2, err2[-200:]))
        rep.expect(called == (0 if marker else 1),
                   "%s: retry calls publish-evidence %s" % (name, "never" if marker else "once"), called)
        ready = (json.loads((run_dir / "ready_for_inspection").read_text(encoding="utf-8"))
                 if (run_dir / "ready_for_inspection").is_file() else {})
        ev = json.loads((run_dir / "evidence/manifest.json").read_text(encoding="utf-8"))
        rep.expect(bool(ready) and ready.get("evidence_sha") == ev.get("evidence_sha") and ready.get("run_id") == ev.get("run_id"),
                   "%s: ready_for_inspection present, naming the manifest's evidence_sha" % name, ready)
    # An incomplete capture (here: a frozen input drifted) never gets a marker; its manifest is complete output.
    estate = fx.fresh("marker-incomplete")
    run_dir = run_dir_of(estate)
    before = len(rows_of(estate))
    with (run_dir / "stimulus/goal.md").open("a", encoding="utf-8") as goal:
        goal.write("\ndrifted after the run\n")
    rc, _, _ = finalize(estate, FINALIZE_RUN_CRASH_AFTER="publish")
    ev = json.loads((run_dir / "evidence/manifest.json").read_text(encoding="utf-8"))
    rep.expect(rc == 137 and ev.get("capture_state") == "incomplete" and "frozen input drift" in ev.get("incomplete_reasons", [])
               and not (run_dir / "ready_for_inspection").exists(),
               "marker-incomplete: publish-evidence recorded an incomplete capture and wrote no marker", ev.get("incomplete_reasons"))
    ops = estate / "ops/bin"
    copy_exec(ops / "publish-evidence", ops / "publish-evidence.real")
    (ops / "publish-evidence").write_text(COUNTING_PUBLISH, encoding="utf-8")
    rc2, out2, err2 = finalize(estate)
    rep.expect(rc2 == 0 and out2.get("state") == "finalized" and out2.get("publish") == "ok"
               and len(rows_of(estate)) == before + 1 and not (estate / "fixture/publish-calls").exists()
               and not (run_dir / "ready_for_inspection").exists(),
               "marker-incomplete: retry finalizes with publish ok, calls publish-evidence never, no marker", (rc2, out2, err2[-200:]))


def test_stimulus_mismatch(rep, fx):
    """Item 4: a check.json for another stimulus is a fixture failure, never a rerun."""
    estate = fx.fresh("stimulus-mismatch")
    run_dir = run_dir_of(estate)
    before = len(rows_of(estate))
    frozen = json.loads((run_dir / "terminal.json").read_text(encoding="utf-8"))["stimulus_sha"]
    wrong = "f" * len(frozen)
    persisted = {"verdict": "pass", "exit_code": 0, "output": "", "skipped": False, "window": 60}
    rep.expect(len(frozen) == 64, "mismatch: the template froze a stimulus_sha", frozen)
    for ran in (wrong, ""):
        (run_dir / "check.json").write_text(json.dumps({**persisted, "stimulus_sha": ran}), encoding="utf-8")
        rc, out, _ = finalize(estate)
        reason = out.get("reason", "")
        rep.expect(rc == 3 and out.get("state") == "pending" and ('"%s"' % ran) in reason and frozen in reason
                   and "not a rerun" in reason,
                   "mismatch (%s): pending, reason names both hashes" % (ran[:8] or "empty"), (rc, out))
        error = (json.loads((run_dir / "finalize.error").read_text(encoding="utf-8"))
                 if (run_dir / "finalize.error").is_file() else {})
        rep.expect(len(rows_of(estate)) == before and not (run_dir / "finalized.json").exists()
                   and not (run_dir / "transcript.md").exists() and not (run_dir / "evidence").exists()
                   and frozen in error.get("error", "") and ran in error.get("error", ""),
                   "mismatch (%s): nothing appended or rendered; finalize.error holds the reason"
                   % (ran[:8] or "empty"), entries(run_dir))
    (run_dir / "check.json").write_text(json.dumps({**persisted, "stimulus_sha": frozen}), encoding="utf-8")
    check_before = (run_dir / "check.json").read_bytes()
    (run_dir / "workspace/hello.txt").unlink()  # a rerun would FAIL; the matching file must be reused
    rc2, out2, _ = finalize(estate)
    done = json.loads((run_dir / "finalized.json").read_text(encoding="utf-8")) if rc2 == 0 else {}
    rep.expect(rc2 == 0 and out2.get("state") == "finalized" and out2.get("verdict") == "pass"
               and (run_dir / "check.json").read_bytes() == check_before and done.get("steps", {}).get("check") == "existing"
               and len(rows_of(estate)) == before + 1,
               "mismatch: a matching check.json is reused as existing, one row, finalized", (rc2, out2))


