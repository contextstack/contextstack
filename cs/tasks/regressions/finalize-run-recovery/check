    shutil.rmtree(run_dir_of(estate))
    ops = estate / "ops/bin"
    for source in (CODE_ROOT / "ops/bin").iterdir():
        if source.is_file() and not (ops / source.name).exists():
            shutil.copy2(source, ops / source.name)
    runner = estate / "fixture/harness"
    runner.write_text(
        '#!/bin/sh\necho "$$" > fixture/harness.pid\nexec ' + shlex.quote(str(binary)) + ' "$@"\n')
    runner.chmod(0o755)
    check = estate / TASK_REL / "check"
    check.write_text(
        '#!/bin/sh\nread -r pid < ' + shlex.quote(str(estate / "fixture/harness.pid"))
        + '\nif kill -0 "$pid" 2>/dev/null; then exit 1; fi\nprintf "check\\n" >> checks\n'
        + 'test "$(cat hello.txt)" = hello\n')
    run_spec = estate / "specs/fx.yaml"
    run_spec.write_text(SPEC.replace("tool_calls: 10", "tool_calls: 1"))
    env = clean_env(estate, CS_RUNNER_BIN=str(runner))

    def dispatch():
        gateway = FakeGateway(GATEWAY[:1], estate)
        try:
            return subprocess.run([str(ops / "run-spec"), "specs/fx.yaml"], cwd=estate,
                                  env=dict(env, CSGATEWAY_ENDPOINT=gateway.endpoint),
                                  text=True, capture_output=True, timeout=30)
        finally:
            gateway.stop.set()
            gateway.close()

    done = dispatch()
    rep.expect(done.returncode == 0 and done.stdout.splitlines() == [
        "fx-recovery: 1 task(s) x 1 trial(s)",
        f"  {TASK_REL:<30} t1  pass stop=budget:tool_calls turns=1 tools=1 $0.0100",
        "  TOTAL 1/1 pass — rows in ledger/ledger.jsonl",
    ], "receipt: run-spec summary and budget verdict are unchanged", (done.stdout, done.stderr))
    first = run_dir_of(estate)
    count = first / "workspace/checks"
    rep.expect(count.read_text() == "check\n", "receipt: the frozen check ran once, after the harness exited")

    real = ops / "machine-finish"
    backup = ops / "machine-finish.real"
    real.rename(backup)
    real.write_text("""#!/usr/bin/env python3
import json, os, signal, sys
from pathlib import Path
request = json.load(sys.stdin)
run = Path(request["run_dir"])
assert request["receipt"]["adapter"] == "harness"
assert not (run / "terminal.json").exists() and not (run / "check.json").exists()
os.kill(os.getppid(), signal.SIGKILL)
""")
    real.chmod(0o755)
    interrupted = dispatch()
    backup.replace(real)
    run = next(path for path in (estate / "ledger/runs").iterdir() if path != first)
    receipt = run / "execution-receipt.json"
    rep.expect(interrupted.returncode == 1 and receipt.is_file() and not (run / "terminal.json").exists(),
               "receipt: launcher killed after the harness exited, before terminal or check",
               (interrupted.stdout, interrupted.stderr))
    old = time.time() - 120
    os.utime(receipt, (old, old))

    sweep = ("import json, runpy; "
             "print(json.dumps(runpy.run_path('ops/bin/tick')['finalize_sweep']()))")
    first_sweep, second_sweep = [
        json.loads(subprocess.check_output([sys.executable, "-c", sweep], cwd=estate, env=env, text=True))
        for _ in range(2)
    ]
    rows = [json.loads(line) for line in rows_of(estate)][len(PRIOR_ROWS):]
    comparable = ("spec", "model", "trial", "verdict", "stop", "turns", "tool_calls", "cost_usd", "row_version")
    rep.expect(first_sweep == {"attempted": 1, "finalized": 1, "pending": 0}
               and second_sweep == {"attempted": 0, "finalized": 0, "pending": 0}
               and (run / "workspace/checks").read_text() == "check\n" and len(rows) == 2
               and all(rows[0][key] == rows[1][key] for key in comparable),
               "receipt: sweep finalizes once and writes the same budget row", (first_sweep, second_sweep, rows))


def main():
    keep = "--keep" in sys.argv[1:]
    scratch = Path(tempfile.mkdtemp(prefix="finalize-run-recovery-", suffix=".noindex"))
    rep = Report()
    started = time.monotonic()
    try:
        binary = runner_binary(scratch)
        template = build_template(scratch, binary)
        if CODE_ROOT == template.resolve() or CODE_ROOT in template.resolve().parents:
            raise SystemExit("check: refusing live code_root root")
        fx = Fixture(scratch, template)
        test_happy(rep, fx)
        test_durable_entry(rep, fx)
        test_envelope(rep, fx)
        test_enospc(rep, fx, scratch)
        test_concurrent(rep, fx)
        test_kill_retry(rep, fx)
        test_estate(rep, fx)
        test_publish_failure(rep, fx)
        test_publish_marker(rep, fx)
        test_stimulus_mismatch(rep, fx)
        test_refusals(rep, fx)
        test_env(rep, fx)
        test_receipt_handoff(rep, fx, binary)
        test_tick(rep, fx, "estate")
        test_tick(rep, fx, "publish")
        if keep:
            print("estates kept at %s" % scratch)
    finally:
        if not keep:
            shutil.rmtree(scratch, ignore_errors=True)
    print()
    print("check: finalize-run-recovery %d assertion(s) failed%s, %.1fs"
          % (len(rep.failed), (": " + "; ".join(rep.failed)) if rep.failed else "", time.monotonic() - started))
    return 1 if rep.failed else 0


if __name__ == "__main__":
    sys.exit(main())
