def build_template(scratch, binary):
    """A real run dir left at the terminal.json boundary: the stub finalizer exits 3."""
    estate = scratch / "template"
    for d in ("ledger", "prompts", "tools/bin", "hooks/bin", "ops/bin", "specs", "tasks",
              "fixture", "home", "tmp"):
        (estate / d).mkdir(parents=True)
    (estate / "INVARIANTS.md").write_text("# fixture estate\n", encoding="utf-8")
    (estate / "ESTATE").write_text("dev\n", encoding="utf-8")
    shutil.copy2(CODE_ROOT / "prompts/coder-min.md", estate / "prompts/coder-min.md")
    for name in REAL_TOOLS:
        if not (CODE_ROOT / "tools/bin" / name).is_file() and (CODE_ROOT / "tools/bin" / (name + ".json")).is_file():
            install_exe(CODE_ROOT / "tools/bin" / (name + ".json"), CODE_ROOT, estate)
            continue
        copy_exec(CODE_ROOT / "tools/bin" / name, estate / "tools/bin" / name)
        if (CODE_ROOT / "tools/bin" / (name + ".json")).is_file():
            shutil.copy2(CODE_ROOT / "tools/bin" / (name + ".json"), estate / "tools/bin" / (name + ".json"))
    for name in REAL_OPS + OP_HELPERS:
        copy_exec(CODE_ROOT / "ops/bin" / name, estate / "ops/bin" / name)
    (estate / "ops/bin/finalize-run").write_text(STUB_FINALIZE, encoding="utf-8")
    shutil.copytree(CODE_ROOT / TASK_REL, estate / TASK_REL)
    (estate / TASK_REL / "check").chmod(0o755)
    (estate / "specs/fx.yaml").write_text(SPEC, encoding="utf-8")
    with open(estate / "ledger/ledger.jsonl", "w", encoding="utf-8") as f:
        for row in PRIOR_ROWS:
            f.write(json.dumps(row, sort_keys=True, separators=(",", ":")) + "\n")
    gateway = FakeGateway(GATEWAY, estate)
    try:
        proc = subprocess.run([str(estate / "ops/bin/run-spec"), "specs/fx.yaml"], cwd=str(estate),
                              env=clean_env(estate, CSGATEWAY_ENDPOINT=gateway.endpoint, CS_RUNNER_BIN=str(binary)),
                              text=True, capture_output=True, timeout=120)
    finally:
        gateway.stop.set()
        gateway.close()
    assert proc.stdout.splitlines() == [
        "fx-recovery: 1 task(s) x 1 trial(s)",
        f"  {TASK_REL:<30} t1       stop=done turns=2 tools=1 $0.0200",
        "  TOTAL 0/1 pass — rows in ledger/ledger.jsonl",
    ], proc.stdout
    runs = sorted((estate / "ledger/runs").iterdir())
    if proc.returncode != 3 or len(runs) != 1 or not (runs[0] / "terminal.json").is_file():
        raise SystemExit("check: template run did not stop at terminal.json: rc=%d stdout=%r stderr=%r"
                         % (proc.returncode, proc.stdout, proc.stderr))
    if "finalization pending" not in proc.stderr or (runs[0] / "check.json").exists():
        raise SystemExit("check: stub finalizer did not leave the dir untouched: %r" % proc.stderr)
    if not (runs[0] / "messages.jsonl").is_file() or (runs[0] / "transcript.md").exists():
        raise SystemExit("check: the runner must leave messages.jsonl and no transcript.md: %s"
                         % sorted(e.name for e in runs[0].iterdir()))
    copy_exec(CODE_ROOT / "ops/bin/finalize-run", estate / "ops/bin/finalize-run")
    return estate


class Fixture:
    def __init__(self, scratch, template):
        self.scratch, self.template, self.n = scratch, template, 0

    def fresh(self, name):
        self.n += 1
        estate = self.scratch / ("%02d-%s" % (self.n, name))
        clone_tree(self.template, estate)
        return estate


def run_dir_of(estate):
    return sorted((estate / "ledger/runs").iterdir())[0]


def rows_of(estate):
    path = estate / "ledger/ledger.jsonl"
    if not path.is_file():
        return []
    return [line for line in path.read_text(encoding="utf-8").splitlines() if line.strip()]


def finalize(estate, run_dir=None, env=None, **extra):
    r = subprocess.run([str(estate / "ops/bin/finalize-run")], cwd=str(estate),
                       env=env or clean_env(estate, **extra),
                       input=json.dumps({"run_dir": str(run_dir or run_dir_of(estate))}),
                       text=True, capture_output=True, timeout=120)
    try:
        out = json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        out = {}
    return r.returncode, out, r.stderr


def entries(run_dir):
    return sorted(e.name for e in run_dir.iterdir())


def footer_count(run_dir):
    if not (run_dir / "transcript.md").is_file():  # the render step has not run yet
        return 0
    return (run_dir / "transcript.md").read_text(encoding="utf-8").count("\n---\nstop ")




