#!/usr/bin/env python3
"""Named route is a hit regardless of parameter segments."""
import sys
from pathlib import Path
sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))
from scratch import scratch_dir

import os
import subprocess
import tempfile
from pathlib import Path

CODE_ROOT = Path(__file__).resolve().parents[3]
CHECKLIB = CODE_ROOT / "scripts/checklib.sh"
WRAPPER = '''#!/bin/sh
. "$CHECKLIB_PATH"
route_equiv students.progress
echo check: ok
'''


def git(cwd, env, *args):
    git_env = {
        **env,
        "GIT_AUTHOR_NAME": "Fixture",
        "GIT_AUTHOR_EMAIL": "f@example.test",
        "GIT_COMMITTER_NAME": "Fixture",
        "GIT_COMMITTER_EMAIL": "f@example.test",
    }
    return subprocess.run(
        ["git", "-C", str(cwd), *args],
        capture_output=True, text=True, check=True, env=git_env,
    )


def write(path, body):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(body, encoding="utf-8")
    return path


def run_check(ws, env, wrapper):
    wrapper.write_text(WRAPPER, encoding="utf-8")
    wrapper.chmod(0o755)
    return subprocess.run(
        [str(wrapper)], cwd=str(ws), capture_output=True, text=True, env=env,
    )


def assert_pass(result, label):
    text = result.stdout + result.stderr
    assert result.returncode == 0, f"{label}: {text}"
    assert "check: ok" in result.stdout, f"{label}: {text}"


def assert_fail(result, label):
    text = result.stdout + result.stderr
    assert result.returncode != 0, f"{label} unexpectedly passed: {text}"
    assert "students.progress" in text, f"{label}: {text}"


with scratch_dir(prefix="checklib-route-equiv-named-") as raw:
    root = Path(raw)
    env = {k: v for k, v in os.environ.items() if k != "CS_CHECK"}
    env.update(
        CHECKLIB_PATH=str(CHECKLIB),
        GIT_CONFIG_GLOBAL="/dev/null",
        GIT_CONFIG_SYSTEM="/dev/null",
    )
    ws = root / "workspace"
    ws.mkdir()
    subprocess.run(["git", "init", "-q", "-b", "main", str(ws)], check=True, env=env)
    git(ws, env, "config", "user.email", "f@example.test")
    git(ws, env, "config", "user.name", "Fixture")
    write(ws / "README.md", "inherited dest\n")
    git(ws, env, "add", "-A")
    git(ws, env, "commit", "-qm", "inherited dest")
    wrapper = ws / "check"

    named = (
        "<?php\n"
        "Route::livewire('students/{student}/progress', "
        "'pages::progress-report')->name('students.progress');\n"
    )
    write(ws / "routes/web.php", named)
    assert_pass(run_check(ws, env, wrapper), "named parameterized Livewire route")
    (ws / "routes/web.php").unlink()

    write(ws / "app/Page.php", "<?php return redirect()->route('students.progress');\n")
    assert_pass(run_check(ws, env, wrapper), "route() helper")
    (ws / "app/Page.php").unlink()

    write(ws / "routes/web.php", "<?php // leftover /students/progress path\n")
    assert_pass(run_check(ws, env, wrapper), "derived path")
    (ws / "routes/web.php").unlink()

    write(
        ws / "routes/web.php",
        "<?php\nRoute::livewire('students/{student}/progress', "
        "'pages::progress-report');\n",
    )
    assert_fail(run_check(ws, env, wrapper), "parameterized path without a name")

print("check: named route is a hit regardless of parameter segments")
