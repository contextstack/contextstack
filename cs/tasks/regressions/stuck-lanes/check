class FakeDirector:
    raw = b"Bearer fake-bearer-token-123456789 OPENAI_API_KEY=fake-api-key-123456789\n" + b"x" * 20000

    def get(self, path):
        if path.startswith("jobs/"):
            return {"job": {"job_id": "job-1", "state": "error", "run_id": "run-1"}}
        return {"run": {"run_id": "run-1", "files": [{"path": "stuck.md"}]}}

    def request(self, method, path):
        if path == "runs/run-1":  # the run itself is JSON, like the Director's; files are raw bytes
            return 200, self.get(path)
        return 200, self.raw


shown = cs_mcp.Tools(FakeDirector(), "dev").task_output("job-1", 50000)["stuck"]
assert "fake-bearer-token" not in shown and "fake-api-key" not in shown and "<redacted>" in shown, shown[:500]
assert len(shown.encode()) <= cs_mcp.STUCK_CHARS, len(shown.encode())


with scratch_dir(prefix="stuck-lanes-") as raw:
    root = Path(raw)
    code_root = root / "code_root"
    ops = code_root / "ops/bin"
    for path in (ops, code_root / "tasks", code_root / "specs", code_root / "prompts", code_root / "home/Library/Keychains", code_root / "ledger"):
