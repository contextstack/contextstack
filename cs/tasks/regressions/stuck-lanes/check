from _stuck import Monitor, REPORT_CHARS  # noqa: E402
from _agent_stream import signals  # noqa: E402


class State:
    def __init__(self, **files):
        self.files = files

    def __call__(self, paths=None):
        selected = paths if paths is not None else self.files
        return {path: self.files.get(path, "missing") for path in selected}


def monitor(**overrides):
    config = {"enabled": True, "repeat": 99, "idle_turns": 99, "edit_churn": 99}
    config.update(overrides)
    state = State(**{"app.py": "A"})
    return Monitor(config, state), state


def edit(mon, state, value):
    ident = "edit-%s" % value
    assert mon.feed([{"kind": "tool_call", "id": ident, "name": "fs_edit", "args": {"path": "app.py"}}]) is None
    state.files["app.py"] = value
    return mon.feed([{"kind": "tool_result", "id": ident, "failed": False, "text": "updated"}])


def failed_check(mon, ident, exit_code=None):
    assert mon.feed([{"kind": "tool_call", "id": ident, "name": "bash", "args": {"command": "pytest -q"}}]) is None
    event = {"kind": "tool_result", "id": ident, "text": "same check output"}
    if exit_code is None:
        event["failed"] = True
    else:
        event["exit_code"] = exit_code
    return mon.feed([event])


def passed_check(mon, ident, command="pytest -q"):
    assert mon.feed([{"kind": "tool_call", "id": ident, "name": "bash", "args": {"command": command}}]) is None
    return mon.feed([{"kind": "tool_result", "id": ident, "failed": False, "text": "all checks passed"}])


# Structured status wins over words in output, while an exit code still detects a text-free failure.
mapped = signals("codex", json.dumps({
    "type": "item.completed",
    "item": {"id": "cmd-1", "type": "command_execution", "command": "pytest -q",
             "aggregated_output": "quiet failure", "exit_code": 2},
}).encode())
assert mapped == [{"kind": "tool_result", "id": "cmd-1", "name": "shell",
                   "text": "quiet failure", "exit_code": 2}], mapped
mon, _state = monitor(repeat=3)
for n in range(3):
    mon.feed([{"kind": "tool_call", "id": "green-%d" % n, "name": "bash", "args": {"command": "pytest -q"}}])
    stopped = mon.feed([{"kind": "tool_result", "id": "green-%d" % n, "failed": False,
                        "text": "120 passed, 0 failed"}])
assert stopped is None and mon.stopped is None, mon.stopped
mon, _state = monitor(repeat=3)
for n in range(3):
    mon.feed([{"kind": "tool_call", "id": "fallback-%d" % n, "name": "bash",
              "args": {"command": "pytest -q"}}])
    stopped = mon.feed([{"kind": "tool_result", "id": "fallback-%d" % n,
                        "text": "120 passed, 0 failed, 0 errors"}])
assert stopped is None and mon.stopped is None, mon.stopped
mon, _state = monitor(repeat=2)
assert failed_check(mon, "exit-1", 1) is None
stopped = failed_check(mon, "exit-2", 1)
assert stopped and stopped["stop"] == "stuck:repeat", stopped

# Only failures repeated without a passing check in between are stuck.
mon, _state = monitor(repeat=3)
assert failed_check(mon, "repeat-1") is None
assert failed_check(mon, "repeat-2") is None
assert passed_check(mon, "repeat-green") is None
assert failed_check(mon, "repeat-after-green") is None
assert mon.stopped is None, mon.stopped
assert passed_check(mon, "other-green", "vendor/bin/phpstan analyse") is None
assert failed_check(mon, "repeat-after-other-green") is None
assert mon.stopped is None, mon.stopped
mon, _state = monitor(repeat=3)
assert failed_check(mon, "consecutive-1") is None
assert failed_check(mon, "consecutive-2") is None
stopped = failed_check(mon, "consecutive-3")
assert stopped and stopped["stop"] == "stuck:repeat", stopped

# Edit churn needs a cycle or the same failed check between edits; monotonic edits are progress.
mon, state = monitor(edit_churn=2)
assert edit(mon, state, "B") is None
stopped = edit(mon, state, "A")
assert stopped and stopped["stop"] == "stuck:edit_churn" and "earlier state" in stopped["reason"], stopped
mon, state = monitor(edit_churn=4)
for value in ("B", "C", "D", "E", "F", "G"):
    assert edit(mon, state, value) is None, mon.stopped
mon, state = monitor(edit_churn=2)
assert failed_check(mon, "check-1") is None
assert edit(mon, state, "B") is None
assert failed_check(mon, "check-2") is None
stopped = edit(mon, state, "C")
assert stopped and "same failing check" in stopped["reason"], stopped

# Idle turns stop true inactivity, but edits to an already-dirty path reset the counter.
mon, state = monitor(idle_turns=2)
assert mon.feed([{"kind": "turn"}]) is None
stopped = mon.feed([{"kind": "turn"}])
assert stopped and stopped["stop"] == "stuck:idle_turns", stopped
mon, state = monitor(idle_turns=2)
assert mon.feed([{"kind": "turn"}]) is None
assert edit(mon, state, "B") is None
assert mon.feed([{"kind": "turn"}]) is None
assert mon.feed([{"kind": "turn"}]) is None
assert edit(mon, state, "C") is None
assert mon.feed([{"kind": "turn"}]) is None

# The artifact and task_output defense both redact credentials and cap returned text.
