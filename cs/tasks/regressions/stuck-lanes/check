mon.feed([{"kind": "tool_call", "id": "secret", "name": "bash",
           "args": {"command": "OPENAI_API_KEY=fake-api-key-123456789 pytest"}}])
stopped = mon.feed([{"kind": "tool_result", "id": "secret", "failed": True,
                     "text": "Bearer fake-bearer-token-123456789 OPENAI_API_KEY=fake-api-key-123456789 failed"}])
report = mon.report("G" * (REPORT_CHARS * 2), stopped["stop"], stopped["reason"])
assert "fake-bearer-token" not in report and "fake-api-key" not in report and "<redacted>" in report, report
assert len(report.encode()) <= REPORT_CHARS, len(report.encode())

spec = importlib.util.spec_from_file_location("stuck_cs_mcp", CODE_ROOT / "scripts/cs_mcp.py")
