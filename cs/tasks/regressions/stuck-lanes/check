    from native_runtime import stage_native_runtime
    stage_native_runtime(ops)
    binary = root / "claude"
    binary.write_text(FAKE, encoding="utf-8")
    binary.chmod(0o755)
    (ops / "executor-templates.json").write_text(json.dumps({
        "fake-claude": {
            "binary": str(binary),
            "args": ["--print", "--output-format", "stream-json", "{{prompt}}"],
            "cost_class": "subscription",
            "cost_usd": 0,
            "cost_per_1k": 0.01,
            "auth": "subscription",
        },
    }), encoding="utf-8")
    (code_root / "ESTATE").write_text("dev\n", encoding="utf-8")
    (code_root / "prompts/system.md").write_text("You are a fixture.\n", encoding="utf-8")

    for task in ("stuck", "healthy", "off", "green", "secret"):
        work = code_root / "tasks" / task
        work.mkdir(parents=True, exist_ok=True)
        (work / "goal.md").write_text("Keep working.\n", encoding="utf-8")
        (work / "check").write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
        (work / "check").chmod(0o755)

    make_spec(code_root / "specs/stuck.yaml", "stuck", "fixture stuck repeat", 3)
    make_spec(code_root / "specs/healthy.yaml", "healthy", "fixture healthy", None)
    make_spec(code_root / "specs/off.yaml", "off", "fixture stuck off", "off")
    make_spec(code_root / "specs/green.yaml", "green", "fixture repeated green check", 3)
    make_spec(code_root / "specs/secret.yaml", "secret", "fixture redacted stuck report", 3)

    done, result, row, run_dir, seconds = run_case(code_root, "stuck", "stuck", "stuck")
    assert done.returncode == 1, (done.returncode, done.stderr, result)
    assert result["stop"] == "stuck:repeat", result
    assert row["stop"] == "stuck:repeat", row
    assert isinstance(row.get("reason"), str) and "failed" in row["reason"], row
    assert (run_dir / "stuck.md").is_file(), sorted(p.name for p in run_dir.iterdir())
    stuck_text = (run_dir / "stuck.md").read_text(encoding="utf-8")
    assert "Stop: stuck:repeat" in stuck_text and "Recent tool calls" in stuck_text, stuck_text
    assert seconds < 12, seconds  # the fixture would otherwise sleep for 20s after repeating failures

    done, result, row, run_dir, _seconds = run_case(code_root, "healthy", "healthy", "healthy")
    assert done.returncode == 0, (done.returncode, done.stderr, result)
    assert result["stop"] == "done" and row["stop"] == "done", (result, row)
    assert not (run_dir / "stuck.md").exists()

    done, result, row, run_dir, _seconds = run_case(code_root, "green_repeat", "green", "green")
    assert done.returncode == 0, (done.returncode, done.stderr, result)
    assert result["stop"] == "done" and row["stop"] == "done", (result, row)
    assert not (run_dir / "stuck.md").exists()

    done, result, row, run_dir, seconds = run_case(code_root, "secret", "secret", "secret")
    assert done.returncode == 1 and result["stop"] == "stuck:repeat", (done.returncode, result)
    stuck_text = (run_dir / "stuck.md").read_text(encoding="utf-8")
    assert "fake-bearer-token" not in stuck_text and "fake-api-key" not in stuck_text, stuck_text
    assert stuck_text.count("<redacted>") >= 2 and len(stuck_text.encode()) <= REPORT_CHARS, stuck_text
    assert "fake-bearer-token" not in json.dumps(row) and "fake-api-key" not in json.dumps(row), row
    assert seconds < 12, seconds

    done, result, row, run_dir, _seconds = run_case(code_root, "off", "off", "off")
    assert done.returncode == 0, (done.returncode, done.stderr, result)
    assert result["stop"] == "done" and row["stop"] == "done", (result, row)
    assert not (run_dir / "stuck.md").exists()

print("check: stuck-lanes — structured failures, redaction, edit churn, idle turns, healthy reruns and stuck:off")
