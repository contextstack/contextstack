#!/usr/bin/env python3
# Fixture-only tool for the runner characterisation cases. Not a lab tool:
# it exists so the fixtures can exercise the tool contract (stdin JSON, cwd,
# combined output, clipping, non-zero exit, timeouts) without depending on
# what a real tool happens to print.
import json
import os
import sys
import time

a = json.load(sys.stdin)
mode = a.get("mode")
if mode == "echo":
    print(json.dumps({"args": a, "cwd_base": os.path.basename(os.getcwd()),
                      "env_names": sorted(os.environ)}, sort_keys=True))
elif mode == "both":
    print("out-line")
    sys.stdout.flush()
    print("err-line", file=sys.stderr)
elif mode == "fail":
    print(a.get("out", ""))
    sys.exit(int(a.get("code", 3)))
elif mode == "big":
    sys.stdout.write("x" * int(a.get("bytes", 10000)))
elif mode == "sleep":
    time.sleep(float(a.get("seconds", 2)))
    print("slept %s" % a.get("seconds", 2))
elif mode == "write":
    with open(a["path"], "w", encoding="utf-8") as f:
        f.write(a["content"])
    print("fx wrote " + a["path"])
else:
    sys.exit("fx_tool: unknown mode %r" % (mode,))
