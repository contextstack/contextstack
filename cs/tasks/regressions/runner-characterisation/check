#!/usr/bin/env python3
"""Runner characterisation fixtures, contract v1 (Plan.CS.v2.1 §4, 2026-11-08).

Pinned to the pre-1b runner. The runner binary, and the real tools, hooks,
ops and prompt copied into each estate, come from git ref V1_REF (override
with $CS_RUNNER_V1_REF), extracted with `git archive` and built in a temp
dir, never from the working tree. $CS_RUNNER_BIN still overrides the
binary. This set is not re-cut when the runner changes: phase 1b's
contract lives in ../runner-characterisation-v2, and the diff between
the two cases/ trees is the record of what the shrink changed.

Not in scripts/check since 2026-11-10: it builds the archived Go runner (ADR 0011).
Its _harness.py stays shared with ../runner-characterisation-v2 and ../tool-identity.
"""
import os
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))
import _harness  # noqa: E402

V1_REF = "b8534dca0"  # pre-1b runner; the contract these fixtures pin
# Everything the harness reads from the source tree, at the pinned ref.
ARCHIVE_PATHS = ("cmd", "internal", "go.mod", "go.sum", "prompts", "tools/bin",
                 "hooks/bin", "ops/bin")


def source(scratch):
    ref = os.environ.get("CS_RUNNER_V1_REF", V1_REF)
    src = scratch / "v1-tree"
    src.mkdir()
    archive = subprocess.run(["git", "-C", str(_harness.LAB), "archive", ref, "--"] + list(ARCHIVE_PATHS),
                             capture_output=True)
    if archive.returncode:
        raise SystemExit("check: git archive %s failed:\n%s" % (ref, archive.stderr.decode("utf-8", "replace")))
    tar = subprocess.run(["tar", "-x", "-C", str(src)], input=archive.stdout, capture_output=True)
    if tar.returncode:
        raise SystemExit("check: tar failed:\n" + tar.stderr.decode("utf-8", "replace"))
    return _harness.runner_binary(src, scratch), src


if __name__ == "__main__":
    sys.exit(_harness.main(HERE, "runner characterisation v1 (%s)" % os.environ.get("CS_RUNNER_V1_REF", V1_REF), source))
