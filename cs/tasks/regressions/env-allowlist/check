def require_explicit_environments(text):
 for node in ast.walk(ast.parse(text)):
  if isinstance(node,ast.Call) and isinstance(node.func,ast.Attribute) and isinstance(node.func.value,ast.Name) and node.func.value.id=='subprocess':
   # Result/exception constructors do not create a process or inherit an environment.
   if node.func.attr in {'CompletedProcess','TimeoutExpired','CalledProcessError','SubprocessError'}:continue
   assert any(k.arg=='env' for k in node.keywords),('subprocess missing explicit environment',node.lineno)
for expression in ['subprocess.run(["true"])','subprocess.Popen(["true"])','subprocess.check_output(["true"])']:
 try:require_explicit_environments(expression)
 except AssertionError:pass
 else:raise AssertionError('unfiltered process launch accepted: '+expression)
