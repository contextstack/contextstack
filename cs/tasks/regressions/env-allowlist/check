 template={'binary':sys.executable,'args':['-c',"import json,os;open('model-env.json','w').write(json.dumps(dict(os.environ)));open('hello.txt','w').write('hello')"], 'cost_class':'free_local','cost_usd':0,'cost_per_1k':0,'auth':'none'}
