   (task/'preflight').write_text('#!'+sys.executable+'\nimport json,os\nopen("preflight-env.json","w").write(json.dumps(dict(os.environ)))\nprint(json.dumps({"run":False,"reason":"fixture no work"}))\nraise SystemExit(3)\n');(task/'preflight').chmod(0o755)
  env.update(CS_JOB_ID='env-'+mode,CS_TRIAL='1',CS_VIDEO_MUTATION='0')
