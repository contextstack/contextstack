#!/usr/bin/env python3
import json
import os
import subprocess
import tempfile
from pathlib import Path
import sys

sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))  # frozen copies too
from scratch import scratch_dir
from hermetic_env import hermetic_env

CODE_ROOT = Path(__file__).resolve().parents[3]
CANARY = "ESTATE_COOKIE_CANARY_7e95d3b2"

with scratch_dir(prefix="browser-cookie-isolation-") as raw:
    root = Path(raw)
    home = root / "home"
    cookies = home / ".config/google-chrome/Default/Cookies"
    cookies.parent.mkdir(parents=True)
    cookies.write_text(CANARY)
    workspace = root / "workspace"
    workspace.mkdir()
    fake = CODE_ROOT / "tools/bin/browser_fetch.fixtures/render/broker"
    legacy = root / "legacy-browse-started"
    old_browse = root / "browse"
    old_browse.write_text("#!/bin/sh\ntouch \"$LEGACY_MARKER\"\nexit 9\n")
    old_browse.chmod(0o755)
    env = {**hermetic_env(), "HOME": str(home), "CS_BROWSER_BROKER_EXEC": str(fake),
           "CS_BROWSER_STATE": str(root / "legacy-state"), "CS_BROWSE": str(old_browse),
           "LEGACY_MARKER": str(legacy)}
    for url in ("https://example.com/", "https://x.com/example", "https://www.linkedin.com/in/example/"):
        result = subprocess.run(
            [str(CODE_ROOT / "tools/bin/browser_fetch")],
            input=json.dumps({"url": url, "archive": True, "links": True}),
            cwd=workspace, env=env, text=True, capture_output=True,
        )
        assert result.returncode == 0, result.stderr
        receipt = json.loads(result.stdout)
        assert receipt["renderer"] == "chrome-cdp-broker" and "auth" not in receipt
        assert CANARY not in result.stdout + result.stderr
        assert (workspace / receipt["archive_path"]).is_file()

    blocked = subprocess.run(
        [str(CODE_ROOT / "tools/bin/browser_fetch")],
        input=json.dumps({"url": "https://tasks.google.com/tasks/"}),
        cwd=workspace, env=env, text=True, capture_output=True,
    )
    assert blocked.returncode != 0 and "scheduled reader" in blocked.stderr
    assert not legacy.exists() and not (root / "legacy-state").exists()
    for path in workspace.rglob("*"):
        if path.is_file():
            assert CANARY.encode() not in path.read_bytes(), path

print("check: browser_fetch uses only the public broker and leaves owner cookies untouched")
