#!/usr/bin/env python3
"""Secret-named files anywhere in reachable history refuse a lane. Names only. Temp repos."""
import sys
from pathlib import Path
sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))
from scratch import scratch_dir

import json
import os
import shlex
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True
KIT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(KIT / "ops/bin"))
import _lanes as lanes  # noqa: E402

FAILED = []
DECOY = b"decoy-bytes-not-a-secret\n"
GIT = shutil.which("git")


def expect(ok, what, detail=None):
    print(("ok   " if ok else "FAIL ") + what + ("" if ok or detail is None else " : %s" % detail))
    if not ok:
        FAILED.append(what)


def git_env():
    env = {k: v for k, v in os.environ.items() if not k.startswith(("GIT_", "CS_"))}
    env.update(GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_NOSYSTEM="1", GIT_AUTHOR_NAME="test",
               GIT_AUTHOR_EMAIL="test@example.com", GIT_COMMITTER_NAME="test",
               GIT_COMMITTER_EMAIL="test@example.com")
    return env


ENV = git_env()


def git(repo, *args):
    done = subprocess.run([GIT, "-C", str(repo), "-c", "core.hooksPath=/dev/null", *args],
                          env=ENV, capture_output=True)
    if done.returncode:
        raise SystemExit("git %s\n%s" % (" ".join(args), done.stderr.decode("utf-8", "replace")))
    return done.stdout


def blob(repo):
    done = subprocess.run([GIT, "-C", str(repo), "hash-object", "-w", "--stdin"],
                          input=DECOY, env=ENV, capture_output=True, check=True)
    return done.stdout.decode().strip()


def tree_commit(repo, parent, message, adds=(), removes=()):
    git(repo, "read-tree", parent)
    for path in removes:
        git(repo, "update-index", "--force-remove", "--", path)
    for path in adds:
        git(repo, "update-index", "--add", "--cacheinfo", "100644", blob(repo), path)
    tree = git(repo, "write-tree").decode().strip()
    args = ["commit-tree", tree, "-p", parent, "-m", message]
    return git(repo, *args).decode().strip()


def refuse(repo, allow=None):
    cfg = {**lanes.DEFAULTS, "name": "t", "path": Path(repo).resolve(),
           "tracked_secret_allowlist": list(allow or [])}
    try:
        lanes.refuse_tracked_secrets(cfg)
    except lanes.LaneError as error:
        return str(error)
    return ""


def wrap_git(directory):
    bindir = Path(directory) / "git-wrap"
    bindir.mkdir()
    (bindir / "git").write_text(
        "#!/bin/sh\nprintf '%%s\\n' \"$*\" >> \"$CS_GIT_WRAP_LOG\"\nexec %s \"$@\"\n" % shlex.quote(GIT))
    (bindir / "git").chmod(0o755)
    return bindir


def logged_commands(log_path):
    if not log_path.is_file():
        return []
    return log_path.read_text(encoding="utf-8").splitlines()


def main():
    lanes._SECRET_SCAN_CACHE.clear()
    with scratch_dir(prefix="tracked-secret-history-") as raw:
        root = Path(raw)
        repo = root / "repo"
        repo.mkdir()
        git(repo, "init", "-q", "-b", "main")
        git(repo, "commit", "-q", "--allow-empty", "-m", "root")
        base = git(repo, "rev-parse", "HEAD").decode().strip()
        added = tree_commit(repo, base, "add env",
                            adds=(".ENV", ".ENV.EXAMPLE", "nested/.env.production\nextra"))
        removed = tree_commit(repo, added, "drop env", removes=(".ENV", "nested/.env.production\nextra"))
        other = tree_commit(repo, removed, "other branch", adds=("Secrets.Env",))
        noted = tree_commit(repo, removed, "notes only", adds=("note.env",))
        renamed_base = tree_commit(repo, removed, "plain notes", adds=("notes.txt",))
        renamed = tree_commit(repo, renamed_base, "rename onto secret name",
                              removes=("notes.txt",), adds=("nested/App.Env",))
        sibling = tree_commit(repo, removed, "stash sibling")
        git(repo, "read-tree", removed)
        git(repo, "update-index", "--add", "--cacheinfo", "100644", blob(repo), "only-stash.env")
        stash_tree = git(repo, "write-tree").decode().strip()
        stash = git(repo, "commit-tree", stash_tree, "-p", removed, "-p", sibling, "-m", "WIP").decode().strip()
        git(repo, "update-ref", "refs/heads/main", removed)
        git(repo, "update-ref", "refs/heads/other", other)
        git(repo, "update-ref", "refs/heads/renamed", renamed)
        git(repo, "update-ref", "refs/stash", stash)
        git(repo, "update-ref", "refs/notes/commits", noted)
        tip_names = set(git(repo, "ls-tree", "-r", "--name-only", "refs/heads/main").decode().splitlines())
        expect(".ENV" not in tip_names and "Secrets.Env" not in tip_names, "main tip has no secret-named file", tip_names)
        expect(".ENV.EXAMPLE" in tip_names, "example fixture remains on the tip")

        log_path = root / "git.log"
        bindir = wrap_git(root)
        os.environ["PATH"] = str(bindir) + os.pathsep + os.environ.get("PATH", "")
        os.environ["CS_GIT_WRAP_LOG"] = str(log_path)
        message = refuse(repo)
        commands = logged_commands(log_path)
        expect(bool(message), "history refuses the lane", message or "allowed")
        for path, commit in ((".ENV", added), ("Secrets.Env", other), ("note.env", noted),
                             ("only-stash.env", stash), ("nested/App.Env", renamed),
                             ("nested/.env.production\nextra", added)):
            expect(repr(path) in message and commit in message, "refusal names %s and its commit" % path.split("\n")[0],
                   message)
        expect("'.ENV.EXAMPLE'" not in message, "example names are exempt", message)
        expect("git filter-repo" in message and "BFG" in message, "refusal says how to purge", message)
        expect(DECOY.decode() not in message, "refusal does not contain file contents")
        expect(any(" log " in " " + line + " " for line in commands), "scan walks history with git log")
        expect(not any("cat-file" in line or " show" in " " + line for line in commands),
               "scan never reads object contents", commands)
        cache = lanes.git_common_dir(repo) / "cs-tracked-secret-scan.json"
        cached = cache.read_text(encoding="utf-8")
        expect(DECOY.decode() not in cached and ".ENV" in cached, "cache stores names and commits, not contents")
        before = len(commands)
        lanes.scan_reachable_secrets = lambda _repo: (_ for _ in ()).throw(AssertionError("rescanned"))
        again = refuse(repo)
        expect(again == message, "same tips reuse the cached refusal")
        expect(len(logged_commands(log_path)) > before, "cache check still reads ref tips")
        expect(not any(" log " in " " + line + " " for line in logged_commands(log_path)[before:]),
               "cached lane start does not walk history again", logged_commands(log_path)[before:])
        allow_env = refuse(repo, allow=[".ENV"])
        expect(repr(".ENV") not in allow_env and "Secrets.Env" in allow_env,
               "allowlist drops only the exact path", allow_env)
        wrong_case = refuse(repo, allow=["secrets.env"])
        expect("Secrets.Env" in wrong_case, "allowlist is case-sensitive exact paths", wrong_case)

        child_log = root / "child.log"
        child = subprocess.run([sys.executable, "-c", CHILD],
                               env={**ENV, "PATH": str(bindir) + os.pathsep + ENV.get("PATH", ""),
                                    "REPO": str(repo), "KIT_OPS": str(KIT / "ops/bin"),
                                    "CS_GIT_WRAP_LOG": str(child_log)},
                               capture_output=True, text=True)
        expect(child.returncode == 2 and "filter-repo" in child.stderr, "a new process still refuses from the cache",
               child.stderr[-400:] + child.stdout[-200:])
        child_cmds = logged_commands(child_log)
        expect(child_cmds and not any(" log " in " " + line + " " for line in child_cmds),
               "a new process does not rescan unchanged tips", child_cmds)

        moved = tree_commit(repo, removed, "move tip")
        git(repo, "update-ref", "refs/heads/main", moved)
        moved_log = root / "moved.log"
        moved_child = subprocess.run([sys.executable, "-c", CHILD],
                                     env={**ENV, "PATH": str(bindir) + os.pathsep + ENV.get("PATH", ""),
                                          "REPO": str(repo), "KIT_OPS": str(KIT / "ops/bin"),
                                          "CS_GIT_WRAP_LOG": str(moved_log)},
                                     capture_output=True, text=True)
        expect(moved_child.returncode == 2, "a moved tip is still refused", moved_child.stderr[-300:])
        expect(any(" log " in " " + line + " " for line in logged_commands(moved_log)),
               "a new ref tip scans history again", logged_commands(moved_log))

        lone = root / "lone"
        lone.mkdir()
        git(lone, "init", "-q", "-b", "main")
        git(lone, "commit", "-q", "--allow-empty", "-m", "root")
        lone_base = git(lone, "rev-parse", "HEAD").decode().strip()
        lone_add = tree_commit(lone, lone_base, "one secret", adds=("Secrets.Env",))
        git(lone, "update-ref", "refs/heads/main", lone_add)
        lanes.scan_reachable_secrets = lanes_scan
        exact = refuse(lone, allow=["Secrets.Env"])
        expect(exact == "", "an exact allowlisted path does not refuse", exact)
        folded = refuse(lone, allow=["secrets.env"])
        expect("Secrets.Env" in folded and lone_add in folded, "a different case is not the allowlisted path", folded)
        sample = root / "sample"
        sample.mkdir()
        git(sample, "init", "-q", "-b", "main")
        git(sample, "commit", "-q", "--allow-empty", "-m", "root")
        sample_base = git(sample, "rev-parse", "HEAD").decode().strip()
        sample_add = tree_commit(sample, sample_base, "samples", adds=(".ENV.EXAMPLE", "Secrets.Env.sample"))
        git(sample, "update-ref", "refs/heads/main", sample_add)
        expect(refuse(sample) == "", "example and sample suffixes stay exempt", refuse(sample))
        stored = json.loads((lanes.git_common_dir(repo) / "cs-tracked-secret-scan.json").read_text(encoding="utf-8"))
        expect(stored.get("v") == 1 and any(tip[0] == "refs/stash" for tip in stored.get("tips") or []),
               "cache key includes the stash ref")
        expect(any(tip[0] == "refs/notes/commits" for tip in stored.get("tips") or []),
               "cache key includes notes refs")
    if FAILED:
        print("%d failed" % len(FAILED))
        return 1
    print("ok   tracked secret history")
    return 0


# Captured before main() replaces it with a cache trap. Allowlist cases restore this.
lanes_scan = lanes.scan_reachable_secrets

CHILD = r"""
import os, sys
from pathlib import Path
sys.path.insert(0, os.environ["KIT_OPS"])
import _lanes
cfg = {**_lanes.DEFAULTS, "name": "t", "path": Path(os.environ["REPO"]).resolve()}
