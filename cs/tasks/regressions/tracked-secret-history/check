    _lanes.refuse_tracked_secrets(cfg)
except _lanes.LaneError as error:
    sys.stderr.write(str(error))
    sys.exit(2)
"""


if __name__ == "__main__":
    # Rebind after CHILD so the allowlist cases call the real scanner, not the cache trap.
    try:
        sys.exit(main())
    finally:
        lanes.scan_reachable_secrets = lanes_scan
