#!/usr/bin/env python3
"""#56: ensure_serving restarts when sandbox mode does not match the running serve."""
import json
import os
import shutil
import socket as pysock
import sys
import tempfile
from pathlib import Path
from unittest.mock import patch

OPS = Path(__file__).resolve().parents[3] / "ops/bin"
sys.path.insert(0, str(OPS))

import _lead_host as lead  # noqa: E402

CONV = "reuse-sandbox-fixture"
tmp = tempfile.mkdtemp(prefix="sec-serve-sandbox-", dir="/tmp", suffix=".noindex")
try:
    root = Path(tmp)
    state = root / "state"
    cfg = root / "config"
    state.mkdir()
    cfg.mkdir()
    (cfg / "hosted-lead.json").write_text(json.dumps({"conversation_id": CONV}) + "\n")
    real = Path(f"/tmp/srvsb-{os.getpid()}.sock")
    real.unlink(missing_ok=True)
    listener = pysock.socket(pysock.AF_UNIX, pysock.SOCK_STREAM)
    listener.bind(str(real))
    listener.listen(1)
    started = []
    pops = []

    class FakePopen:
        def __init__(self, argv, stdout=None, **kwargs):
            started.append(argv)
            if stdout is not None:
                stdout.close()
            self.pid = 424242

        def poll(self):
            return None

    patches = (
        patch.object(lead, "socket_file", lambda *_a, **_k: real),
        patch.object(lead, "private_socket_dir", lambda *_a, **_k: None),
        patch.object(lead, "_wait_socket_ping", lambda *_a, **_k: True),
        patch.object(lead, "load_state", lambda *_a, **_k: {"serve_sandboxed": False, "serve_pid": 424242}),
        patch.object(lead.os, "kill", lambda *_a, **_k: pops.append("term")),
        patch.object(lead.subprocess, "Popen", FakePopen),
        patch.object(lead, "read_socket_token", lambda *_a, **_k: "token"),
    )
    for item in patches:
        item.start()
    old = {k: os.environ.get(k) for k in (
        "LEAD_HOST_NO_SANDBOX", "CS_EXECUTOR_ALLOW_UNSANDBOXED", "LAB_STATE_ROOT", "LAB_CONFIG_ROOT",
        "LEAD_HOST_SERVE_READY_S")}
    os.environ["LAB_STATE_ROOT"] = str(state)
    os.environ["LAB_CONFIG_ROOT"] = str(cfg)
    os.environ["LEAD_HOST_SERVE_READY_S"] = "5"
    os.environ.pop("LEAD_HOST_NO_SANDBOX", None)
    os.environ.pop("CS_EXECUTOR_ALLOW_UNSANDBOXED", None)
    try:
        out = lead.ensure_serving(CONV, state, cfg, model="stub", cli_binary="true", sandbox=True)
        assert out == real, out
        assert pops, "mismatched sandbox serve was not terminated"
        assert started and "serve" in started[-1], started
    finally:
        for item in reversed(patches):
            item.stop()
        for key, value in old.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value
    listener.close()
    real.unlink(missing_ok=True)
finally:
    shutil.rmtree(tmp, ignore_errors=True)

print("sec-serve-sandbox-reuse: ok")
