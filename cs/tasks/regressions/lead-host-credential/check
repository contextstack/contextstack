import http.server
import json
import os
import secrets
import stat
import sys
import threading
import urllib.parse
from pathlib import Path
from unittest.mock import patch

sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))
from hermetic_env import hermetic_env
import shutil
import tempfile

KIT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(KIT / "ops/bin"))
import _lead_host as lead
import _lead_wake

problems = []


def expect(cond, msg):
    print(("ok   " if cond else "FAIL ") + msg)
    if not cond:
        problems.append(msg)


class FakeDirector:
    def __init__(self):
        self.token = "fixture-node-token"
        self.installation = "inst_fixture"
        self.mints = []
        self.lead_tokens: set[str] = set()

        director = self

        class Handler(http.server.BaseHTTPRequestHandler):
            protocol_version = "HTTP/1.1"

            def log_message(self, *args):
                pass

            def _read_body(self):
                length = int(self.headers.get("Content-Length") or 0)
                return self.rfile.read(length) if length else b""

            def _json(self, status, body):
                data = json.dumps(body).encode()
                self.send_response(status)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(data)))
                self.send_header("ContextStack-Installation", director.installation)
                self.send_header("ContextStack-Protocol", "2")
                self.send_header("ContextStack-Protocol-Supported", "1,2")
                self.end_headers()
                self.wfile.write(data)

            def do_POST(self):
                headers = {k.lower(): v for k, v in self.headers.items()}
                auth = headers.get("authorization") or ""
                if "/api/v1/nodes/me/" in self.path:
                    self._read_body()
                    path = self.path.split("/api/v1/nodes/me/", 1)[-1]
                    if auth == "Bearer " + director.token and path.endswith("/lead-credential"):
                        cid = urllib.parse.unquote(path[: -len("/lead-credential")].rstrip("/").split("/")[-1])
                        tok = "cslead_" + secrets.token_hex(8)
                        director.mints.append(tok)
                        director.lead_tokens.add(tok)
                        self._json(
                            201,
                            {
                                "token": tok,
                                "credential_id": "cred_fixture",
                                "kind": "lead",
                                "conversation_id": cid,
                            },
                        )
                        return
                    self._json(404, {"error": "not_found"})
                    return
                self._json(404, {"error": "not_found"})

            def do_GET(self):
                headers = {k.lower(): v for k, v in self.headers.items()}
                auth = headers.get("authorization") or ""
                if self.path.startswith("/api/v1/client/"):
                    bearer = auth[7:].strip() if auth.startswith("Bearer ") else ""
                    if bearer not in director.lead_tokens:
                        self._json(401, {"error": "Unauthorized"})
                        return
                    if "/conversations/" in self.path and self.path.endswith("/thread"):
                        self._json(200, {"turns": [{"job_id": "job_turn_1"}]})
                        return
                    self._json(404, {"error": "not_found"})
                    return
                self._json(404, {"error": "not_found"})

        self.server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Handler)
        self.server.daemon_threads = True
        self.url = "http://127.0.0.1:%d" % self.server.server_address[1]
        threading.Thread(target=self.server.serve_forever, daemon=True).start()

    def close(self):
        self.server.shutdown()

fakeref = []
root_parent = Path(__file__).resolve().parents[3] / ".tmp-regression"
root_parent.mkdir(exist_ok=True)
root = Path(tempfile.mkdtemp(prefix="lead-host-credential-", dir=str(root_parent)))
try:
    cfg = root / "config"
    state = root / "state"
    jobs = state / "jobs"
    cfg.mkdir(parents=True)
    jobs.mkdir(parents=True)
    cid = "con_fetch"
    fake = FakeDirector()
    spool = {
        "version": 1,
        "receiver": {
            "kind": "director",
            "url": fake.url,
            "node": "home-node",
            "token_env": "DIRECTOR_SPEC_NODE_TOKEN",
            "installation": fake.installation,
        },
    }
    (cfg / "policy").mkdir()
    (cfg / "policy/spool.json").write_text(json.dumps(spool))
    sess = state / "lead-sessions" / cid
    sess.mkdir(parents=True)
    (sess / "meta.json").write_text(json.dumps({"director": fake.url, "node": "home-node", "model": "claude-code-sonnet", "conversation_id": cid}))
    ws = jobs / "job_turn_1"
    ws.mkdir()
    (ws / "job.json").write_text(json.dumps({"job_id": "job_turn_1", "task": "tasks/turn"}))
    env = {**hermetic_env(), "CS_CONFIG_ROOT": str(cfg), "CS_STATE_ROOT": str(state), "DIRECTOR_SPEC_NODE_TOKEN": fake.token}
    host = lead.ConversationHost(cid, state, cfg, model="claude-code-sonnet")
    with patch.dict(os.environ, env, clear=True):
        lead.ensure_session_credential(cid, cfg, state, "claude-code-sonnet")
        cred = lead.session_credential_path(state, cid)
        expect(cred.is_file(), "credential fetched from the Director")
        expect(stat.S_IMODE(cred.stat().st_mode) == 0o600, "credential mode 0600")
        expect(len(fake.mints) == 1, "Director minted once")
        text = cred.read_text(encoding="utf-8").strip()
        expect(text == fake.mints[0], "stored token matches mint")
        fake.lead_tokens.add(text)
        host.validate_workspace(ws)
        expect(True, "validate_workspace passes after fetch")

    # Stale lead credential: Client API 401, node refetch, one retry succeeds.
    fake2 = FakeDirector()
    cid2 = "con_refetch"
    sess2 = state / "lead-sessions" / cid2
    sess2.mkdir(parents=True, exist_ok=True)
    (sess2 / "meta.json").write_text(
        json.dumps({"director": fake2.url, "node": "home-node", "model": "claude-code-sonnet", "conversation_id": cid2})
    )
    stale = "cslead_stale_fixture"
    lead._write_session_credential_locked(state, cid2, stale)
    ws2 = jobs / "job_turn_1"
    # job bundle already exists from the fetch fixture
    host2 = lead.ConversationHost(cid2, state, cfg, model="claude-code-sonnet")
    with patch.dict(os.environ, {**env, "DIRECTOR_SPEC_NODE_TOKEN": fake2.token}, clear=True):
        host2.validate_workspace(ws2)
        cred2 = lead.session_credential_path(state, cid2)
        refreshed = cred2.read_text(encoding="utf-8").strip()
        expect(refreshed != stale, "401 refetch replaced the stale credential")
        expect(len(fake2.mints) == 1, "node route minted a replacement credential")
        expect(refreshed in fake2.lead_tokens, "replacement credential is accepted by the Client API")
    fake2.close()
    fake.close()
finally:
    shutil.rmtree(root, ignore_errors=True)

print("lead-host-credential: %s" % ("FAIL (%d)" % len(problems) if problems else "ok"))
sys.exit(1 if problems else 0)
