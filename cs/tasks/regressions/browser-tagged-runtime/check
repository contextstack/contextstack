#!/usr/bin/env python3
import json
import os
import subprocess
import tempfile
from pathlib import Path
import sys

sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))  # frozen copies too
from scratch import scratch_dir
from hermetic_env import hermetic_env

CODE_ROOT = Path(__file__).resolve().parents[3]

with scratch_dir(prefix="browser-tagged-runtime-") as raw:
    root = Path(raw)
    env = {**hermetic_env(), "CS_BROWSER_BROKER_EXEC": str(
        CODE_ROOT / "tools/bin/browser_fetch.fixtures/render/broker"),
        "CS_BROWSE": str(root / "missing-browse"),
        "PLAYWRIGHT_BROWSERS_PATH": str(root / "missing-playwright"),
        "CS_ESTATE_RUNTIME": str(root / "missing-tagged-runtime")}
    result = subprocess.run([str(CODE_ROOT / "tools/bin/browser_fetch")],
                            input=json.dumps({"url": "https://example.com/"}),
                            cwd=root, env=env, text=True, capture_output=True)
    assert result.returncode == 0, result.stderr
    assert json.loads(result.stdout)["renderer"] == "chrome-cdp-broker"

print("check: browser_fetch uses the public broker even with legacy runtime settings")
