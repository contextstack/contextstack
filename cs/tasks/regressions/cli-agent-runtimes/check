FAKE = """#!%(python)s
import json, os, sys
from pathlib import Path
stdin, devnull = os.fstat(0), os.stat("/dev/null")
report = {"argv": sys.argv[1:], "env": {k: os.environ.get(k) for k in %(keys)r}, "wrote": {},
