def test_report_lead_watch_unit() -> None:
    nudges: list[str] = []

    unit_state = Path(tempfile.mkdtemp(prefix="wake-unit-"))  # persisted watches need a session directory

    class Host:
        state = unit_state
        conversation_id = "con_unit_watch"

        def deliver_nudge(self, text):
            nudges.append(text)
            return True

    class Client:
        jobs = {
            "job_unit_1": {"job_id": "job_unit_1", "state": "done"},
            "job_unit_2": {"job_id": "job_unit_2", "state": "error"},
        }

        def get_job(self, job_id):
            return self.jobs[job_id]

    coord = _lead_wake.WakeCoordinator(
        Host(), director_url="unused", credential_file=Path("unused"),
        client_factory=lambda *_: Client(), batch_s=0,
    )
    # The ending events have already been lost before either watch exists.
    coord.watch_job("job_unit_1", lane="one")
    coord.watch_job("job_unit_2", lane="two")
    coord.tick_batch()
    expect(len(nudges) == 1 and all(job in nudges[0] for job in Client.jobs),
           "registration refetch batches already-ended jobs")
    coord._resync_after_hello()
    coord.tick_batch()
    expect(len(nudges) == 1, "reconnect refetch does not duplicate registration nudges")

    Client.jobs["job_reconnect"] = {"job_id": "job_reconnect", "state": "running"}
    coord.watch_job("job_reconnect")
    Client.jobs["job_reconnect"]["state"] = "done"
    class TimedOutStream:
        def readline(self):
            raise TimeoutError("idle HTTP stream")

    # A timed-out buffered reader must be discarded, not retried forever.
    class RetryAfterTimeout(Exception):
        pass

    timed_out = TimedOutStream()
    with patch.object(timed_out, "readline", side_effect=[TimeoutError(), RetryAfterTimeout()]):
        try:
            coord._follow(timed_out)
        except RetryAfterTimeout:
            expect(False, "timed-out event stream is reopened")
    opened = []

    def open_stream():
        opened.append(True)
        return type("Stream", (), {"close": lambda self: None})()

    def follow(stream):
        expect("job_reconnect" in coord._notified, "connect refetch precedes following events")
        coord.stop()

    with patch.object(coord, "_open_stream", open_stream), patch.object(coord, "_follow", follow):
        coord._run()
    coord.tick_batch()
    expect(bool(opened) and len(nudges) == 2 and "job_reconnect" in nudges[-1],
           "connect recovers an ending without an event")


def test_socket_not_listening(mode="bound") -> None:
    # A bound UNIX socket exists before listen(), and an exited serve leaves the
    # same file behind. Wait for a real refused connection before becoming ready.
    with scratch_dir(prefix="lead-socket-", dir=short_tmp()) as raw:
        path = Path(raw).resolve() / "host.sock"
        (path.parent / "token").write_text("fixture-auth")
        (path.parent / "token").chmod(0o600)
        refused = threading.Event()
        failures = []
        real_socket = socket.socket

        class Client(real_socket):
            def connect(self, address):
                try:
                    return super().connect(address)
                except (ConnectionRefusedError, FileNotFoundError):
                    refused.set()
                    raise

        with real_socket(socket.AF_UNIX, socket.SOCK_STREAM) as server:
            if mode == "bound":
                server.bind(str(path))
            elif mode == "stale":
                with real_socket(socket.AF_UNIX, socket.SOCK_STREAM) as stale:
                    stale.bind(str(path))

            def listen_later():
                try:
                    assert refused.wait(check_timeout(5)), "client never attempted the bound socket"
                    if mode != "bound":
                        path.unlink(missing_ok=True)
                        server.bind(str(path))
                    server.listen(1)
                    server.settimeout(check_timeout(5))
                    with server.accept()[0] as conn:
                        request = json.loads(conn.recv(65536))
                        assert request == {"op": "ping", "token": "fixture-auth"}, request
                        conn.sendall(b'{"ok":true}\n')
                except Exception as error:
                    failures.append(error)

            worker = threading.Thread(target=listen_later, daemon=True)
            worker.start()
            try:
                with patch.object(_lead_host.socket, "socket", Client):
                    assert _lead_host.socket_request(path, {"op": "ping"}, timeout=1) == {"ok": True}
            finally:
                worker.join(timeout=check_timeout(6))
            assert not worker.is_alive() and not failures, failures


def test_review_fixes_unit(root: Path, state: Path, cs_root: Path, env: dict) -> None:
    """Fixes from the 2026-11-15 lead-host review, pinned without a live serve."""
    import _lead_wake
    cfg = root / "unit-config"
    cfg.mkdir(parents=True)
    prev_env = dict(os.environ.items())
    os.environ.update(env)
    saved = os.environ.pop("LEAD_WAKE_DIRECTOR_URL", None)
    try:
        # A real install passes the config directory itself: install.json sits directly in it.
        (cfg / "install.json").write_text(json.dumps({"director": "http://127.0.0.1:1/"}), encoding="utf-8")
        expect(_lead_wake.resolve_director_url(cfg) == "http://127.0.0.1:1",
               "wake finds the Director in <config root>/install.json")
        expect(_lead_wake.resolve_director_url(cfg, {"director": "http://127.0.0.1:2"}) == "http://127.0.0.1:2",
               "the conversation's own Director address wins")
        (cfg / "install.json").unlink()
        expect(_lead_wake.resolve_director_url(cfg) is None, "no address means no wake (and it is logged)")
    finally:
        if saved is not None:
            os.environ["LEAD_WAKE_DIRECTOR_URL"] = saved

    host = _lead_host.ConversationHost(CONV, state, cs_root / "config", cli_binary="/usr/bin/true", sandbox=False)
    ws = workspace_turn(root, "unit", name="unit-ws").resolve()  # the host refuses unresolved (macOS /var) paths
    _FAKE.add_turn(CONV, ws.name)
    real_make = _lead_host.make_session
    _lead_host.make_session = lambda *a, **k: (_ for _ in ()).throw(RuntimeError("cli failed to launch"))
    try:
        try:
            host.handle_turn(ws, message="hi")
        except (Exception, SystemExit):
            pass
    finally:
        _lead_host.make_session = real_make
    expect(host._turn_depth == 0, "a failed session start does not leave wake-ups blocked", host._turn_depth)

    class TimeoutSession:
        alive = True
        session_id = None
        stopped = 0

        def run_turn(self, text, timeout=300):
            raise TimeoutError("slow")

        def send(self, text):
            self.sent = text

        def collect_turn(self, timeout=300):
            raise TimeoutError("slow")

        def stop(self):
            self.stopped += 1
            self.alive = False
            return 0

    sess = TimeoutSession()
    host._session = sess
    try:
        host.handle_turn(ws, message="hi")
    except TimeoutError:
        pass
    expect(sess.stopped == 1, "a timed-out turn stops its session so a late reply cannot leak into the next")
    expect(host._turn_depth == 0, "turn depth is restored after a timeout", host._turn_depth)

    sess2 = TimeoutSession()
    host._session = sess2
    secret = "cslead_fixture_secret_token_do_not_leak"
    delivered = host.deliver_nudge("Lane x job j1 ended: error, verdict —, error %s" % secret)
    expect(delivered, "a sent nudge counts as delivered even when its reply times out")
    expect(sess2.stopped == 1, "a timed-out wake reply stops the session too")
    log = _lead_host.sessions_root(state) / ("%s-serve.log" % CONV)
    text = log.read_text(encoding="utf-8") if log.is_file() else ""
    expect("NUDGE:" in text and secret not in text, "nudge text is redacted in the serve log", text[-300:])
    os.environ.clear()
    os.environ.update(prev_env)
    reset_conversation_artifacts(state)




