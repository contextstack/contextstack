def workspace_turn(root: Path, message: str, *, name: str = "turn-wake") -> Path:
    ws = Path(os.environ["CS_STATE_ROOT"]) / "jobs" / name
    if ws.exists():
        shutil.rmtree(ws)
    ws.mkdir(parents=True)
    (ws / "job.json").write_text(json.dumps({"job_id": name, "task": "tasks/turn", "spec": "spec.yaml"}))
    for rel, src in (
        ("spec.yaml", LEAD / "spec.yaml"),
        ("prompts/system.md", LEAD / "prompts/system.md"),
        ("session/mcp.json", LEAD / "session/mcp.json"),
        ("session/host.json", LEAD / "session/host.json"),
    ):
        dest = ws / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(src, dest)
    (ws / "conversation").mkdir(exist_ok=True)
    (ws / "conversation/context.md").write_text("Wake test.\n", encoding="utf-8")
    turn = ws / "tasks/turn"
    turn.mkdir(parents=True)
    (turn / "goal.md").write_text(message, encoding="utf-8")
    (turn / "check").write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
    (turn / "check").chmod(stat.S_IRWXU)
    return ws


