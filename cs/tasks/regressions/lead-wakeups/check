def boot_session(state: Path, cs_root: Path, env: dict, *, name: str = "turn-wake") -> Path:
    prev = dict(os.environ.items())
    os.environ.update(env)
    try:
        ws = workspace_turn(state.parent, "Hold while lanes run.", name=name)
        _FAKE.add_turn(CONV, ws.name)
        _lead_host.client_turn(
            ws,
            conversation_id=CONV,
            config_root=cs_root / "config",
            state=state,
            cli_binary=str(STUB),
            sandbox=False,
            timeout=60,
        )
    finally:
        os.environ.clear()
        os.environ.update(prev)
    return _lead_host.socket_file(state, CONV)


def test_single_nudge(state: Path, cs_root: Path, env: dict, fake: FakeDirector) -> None:
    reset_conversation_artifacts(state)
    fake.set_job("job_a", state="running", meta={"lane": "alpha"}, check={"verdict": "pass"})
    sock = boot_session(state, cs_root, env, name="turn-a")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(5)
        client.connect(str(sock))
        client.sendall(b'{"op":"watch_job","job_id":"job_forged"}\n')
        expect(bool(json.loads(client.recv(65536)).get("error")), "watch registration requires serve token")
    fake.set_job("job_forged", state="done", meta={"lane": "forged"})
    fake.emit_job_change("job_forged")
    with patch.dict(os.environ, LEAD_HOST_SOCKET=str(sock)):
        cs_mcp._report_lead_watch("job_a", lane="alpha")
    fake.set_job("job_a", state="done", meta={"lane": "alpha"}, check={"verdict": "pass"})
    fake.emit_job_change("job_a")
    ok = wait_until(lambda: len(nudges_from_transcript(state)) >= 1, 8)
    expect(ok, "watched job end produces a nudge")
    nudges = nudges_from_transcript(state)
    expect(len(nudges) == 1, "exactly one nudge", str(len(nudges)))
    expect(not nudges_from_transcript(state, job_id="job_forged"), "unauthenticated watch cannot inject wake-ups")
    if nudges:
        expect("job_a" in nudges[0] and "alpha" in nudges[0], "nudge names lane and job", nudges[0])
    ndjson = _lead_host.state_file(state, CONV).with_suffix(".ndjson")
    ok_wake = wait_until(lambda: len(director_wake_turns(fake, CONV)) >= 1, 30)  # the reply follows the nudge
    expect(ok_wake, "wake reply recorded on the Director")
    expect(count_stub_results(ndjson) == 2, "turn and wake each produce a CLI result", count_stub_results(ndjson))
    wakes = director_wake_turns(fake, CONV)
    if wakes:
        expect(wakes[0].get("reply", "").startswith("WAKE-REPLY"), "Director carries the wake reply", wakes[0])


def test_batch_two(state: Path, cs_root: Path, env: dict, fake: FakeDirector) -> None:
    reset_conversation_artifacts(state)
    fake.turns[CONV] = []
    fake.set_job("job_b1", state="running", meta={"lane": "b1"}, check={"verdict": "pass"})
    fake.set_job("job_b2", state="running", meta={"lane": "b2"}, check={"verdict": "pass"})
    sock = boot_session(state, cs_root, env, name="turn-b")
    fake.set_job("job_b1", state="done", meta={"lane": "b1"}, check={"verdict": "pass"})
    fake.set_job("job_b2", state="done", meta={"lane": "b2"}, check={"verdict": "fail"})
    fake.emit_job_change("job_b1")
    fake.emit_job_change("job_b2")
    # Both events precede registration: only a state refetch can recover them.
    watch_job(sock, "job_b1", lane="b1")
    watch_job(sock, "job_b2", lane="b2")
    time.sleep(float(env.get("LEAD_WAKE_BATCH_S", "0.15")) + 0.2)
    ok = wait_until(lambda: len(nudges_from_transcript(state, job_id="job_b1")) >= 1, 30)
    expect(ok, "batched endings produce a nudge")
    # The nudge is logged when sent; the reply and its wake turn follow. Wait for those before counting.
    wait_until(lambda: len(director_wake_turns(fake, CONV)) >= 1, 30)
    nudges = [n for n in nudges_from_transcript(state) if "job_b1" in n or "job_b2" in n]
    expect(len(nudges) == 1, "two endings become one nudge", str(len(nudges)))
    expect(count_stub_results(_lead_host.state_file(state, CONV).with_suffix(".ndjson")) == 2,
           "turn plus one batched wake reply")
    expect(len(director_wake_turns(fake, CONV)) == 1, "one wake turn on the Director")
    batched = director_wake_turns(fake, CONV)
    expect(bool(batched) and sorted((batched[0].get("detail") or {}).get("jobs") or []) == ["job_b1", "job_b2"],
           "batched wake turn lists both jobs", batched[0] if batched else None)
    expect(bool(nudges) and "job_b1" in nudges[0] and "job_b2" in nudges[0], "batch mentions both jobs",
           nudges[0] if nudges else "(no nudge)")


def test_nudge_after_turn(state: Path, cs_root: Path, env: dict, fake: FakeDirector) -> None:
    reset_conversation_artifacts(state)
    fake.turns[CONV] = []
    fake.set_job("job_late", state="running", meta={"lane": "late"}, check={"verdict": "pass"})
    prev = dict(os.environ.items())
    os.environ.update(env)
    ws = workspace_turn(state.parent, "Slow turn.", name="turn-slow")
    _FAKE.add_turn(CONV, ws.name)
    slow: list[str] = []

    def slow_turn():
        try:
            reply = _lead_host.client_turn(
                ws,
                conversation_id=CONV,
                config_root=cs_root / "config",
                state=state,
                cli_binary=str(STUB_DELAY),
                sandbox=False,
                timeout=60,
            )
            slow.append(reply)
        except Exception as error:
            slow.append(str(error))

    thread = threading.Thread(target=slow_turn, daemon=True)
    thread.start()
    sock = _lead_host.socket_file(state, CONV)
    expect(wait_until(sock.is_socket, 25), "slow turn opened serve socket")
    watch_job(sock, "job_late", lane="late")
    time.sleep(0.25)
    fake.set_job("job_late", state="done", meta={"lane": "late"}, check={"verdict": "pass"})
    fake.emit_job_change("job_late")
    time.sleep(0.5)
    expect(
        len(nudges_from_transcript(state, job_id="job_late")) == 0,
        "no nudge during in-flight turn",
        str(nudges_from_transcript(state, job_id="job_late")),
    )
    thread.join(timeout=45)
    expect(slow and slow[0].startswith("STUB-REPLY"), "slow turn completed", slow[:1])
    time.sleep(0.5)
    os.environ.clear()
    os.environ.update(prev)
    ok = wait_until(lambda: len(nudges_from_transcript(state, job_id="job_late")) >= 1, 15)
    expect(ok, "nudge arrives after turn completes")
    ok_rec = wait_until(lambda: len(director_wake_turns(fake, CONV)) >= 1, 15)
    expect(ok_rec, "wake follow-up recorded after slow turn completes")




