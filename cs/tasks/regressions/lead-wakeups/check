def main() -> int:
    for mode in ("bound", "stale", "missing"):
        test_socket_not_listening(mode)
    if not STUB.is_file():
        expect(False, "stub_stream_cli missing")
        print("lead-wakeups: FAIL")
        for item in problems:
            print(" -", item)
        return 1
    STUB.chmod(stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP)
    STUB_DELAY.chmod(stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP)

    global _FAKE
    fake = _FAKE = FakeDirector()
    fake.start()
    try:
        with scratch_dir(prefix="lead-wakeups-") as raw:
            root = Path(raw)
            state, cs_root, _cfg, env = start_fixture_env(root, fake)
            test_report_lead_watch_unit()
            test_review_fixes_unit(root, state, cs_root, env)
            test_single_nudge(state, cs_root, env, fake)
            test_batch_two(state, cs_root, env, fake)
            test_nudge_after_turn(state, cs_root, env, fake)
            test_wake_turn_after_host_turn(state, cs_root, env, fake)
            test_resync_after_drop(state, cs_root, env, fake)
            test_unwatched_ignored(state, cs_root, env, fake)
            test_nonblocking_ping_during_wake(state, cs_root, env, fake)
            test_durable_wake_spool(state, cs_root, env, fake)
            test_idle_hold_until_watch_ends(state, cs_root, env, fake)
            test_restart_nudge_after_down(state, cs_root, env, fake)
            test_other_lanes_status(state, cs_root, env, fake)
            test_other_lanes_fetch_fail(state, cs_root, env, fake)
            test_other_lanes_overflow(state, cs_root, env, fake)
            test_other_lanes_redaction(state, cs_root, env, fake)
            kill_serve(state)
    finally:
        fake.stop()

    if problems:
        print("lead-wakeups: FAIL")
        for item in problems:
            print(" -", item)
        return 1
    print("lead-wakeups: ok")
    return 0


if __name__ == "__main__":
