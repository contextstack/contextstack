def kill_serve(state: Path) -> None:
    st = _lead_host.load_state(_lead_host.state_file(state, CONV))
    pid = st.get("serve_pid")
    if pid:
        try:
            os.kill(int(pid), signal.SIGTERM)
        except OSError:
            pass
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            try:
                os.kill(int(pid), 0)
            except OSError:
                break
            time.sleep(0.05)
    sock = _lead_host.socket_file(state, CONV)
    sock.unlink(missing_ok=True)


def reset_conversation_artifacts(state: Path) -> None:
    kill_serve(state)
    sf = _lead_host.state_file(state, CONV)
    sf.unlink(missing_ok=True)
    sf.with_suffix(".ndjson").unlink(missing_ok=True)
    log = state / "lead-sessions" / ("%s-serve.log" % CONV)
    log.unlink(missing_ok=True)
    sess = state / "lead-sessions" / CONV
    (sess / _lead_wake.WATCHES_FILE).unlink(missing_ok=True)
    spool = sess / _lead_wake.WAKE_SPOOL_DIR
    if spool.is_dir():
        shutil.rmtree(spool)


def spool_files(state: Path) -> list[Path]:
    root = state / "lead-sessions" / CONV / _lead_wake.WAKE_SPOOL_DIR
    return sorted(root.glob("*.json")) if root.is_dir() else []


def serve_pid_alive(state: Path) -> bool:
    pid = _lead_host.load_state(_lead_host.state_file(state, CONV)).get("serve_pid")
    if not pid:
        return False
    try:
        # The serve is this test process's child (Popen): once it exits it is a zombie until reaped, and
        # kill(pid, 0) still succeeds. Reap it first.
        done, _ = os.waitpid(int(pid), os.WNOHANG)
        if done:
            return False
    except ChildProcessError:
        pass  # not our child: fall through to the signal probe
    try:
        os.kill(int(pid), 0)
        return True
    except OSError:
        return False




def director_wake_turns(fake: FakeDirector, conversation: str) -> list[dict]:
    return [row for row in fake.turns.get(conversation, []) if row.get("origin") == "wake"]

def nudges_from_transcript(state: Path, *, job_id: str | None = None) -> list[str]:
    found: list[str] = []
    ndjson = _lead_host.state_file(state, CONV).with_suffix(".ndjson")
    if ndjson.is_file():
        for line in ndjson.read_text(encoding="utf-8").splitlines():
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            if row.get("dir") != "in":
                continue
            msg = row.get("msg") or {}
            if msg.get("type") != "user":
                continue
            content = (msg.get("message") or {}).get("content", "")
            if isinstance(content, str) and content.startswith("Lane ") and " ended:" in content:
                text = content.strip()
                if job_id and job_id not in text:
                    continue
                found.append(text)
    return found


def count_stub_results(ndjson: Path) -> int:
    if not ndjson.is_file():
        return 0
    n = 0
    for line in ndjson.read_text(encoding="utf-8").splitlines():
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        if row.get("dir") == "out" and row.get("msg", {}).get("type") == "result":
            n += 1
    return n


def watch_job(sock_path: Path, job_id: str, *, lane: str | None = None) -> None:
    payload = {"op": "watch_job", "job_id": job_id}
    if lane:
        payload["lane"] = lane
    _lead_host.socket_request(sock_path, payload, timeout=5)


def wait_until(predicate, timeout: float = 10.0) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if predicate():
            return True
        time.sleep(0.05)
    return False


