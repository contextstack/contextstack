#!/usr/bin/env python3
"""The release-bundle workflow builds three platforms and merges their channel manifests.

YAML is read with a stdlib subset (the workflow's own shape: maps, lists, quotes, `|` blocks).
When target/release/cs-tools is already built, the same file must also match `yaml-json`.
publish() records one platform; merge() is what the final CI job runs. Scratch dirs are tempfile.
"""
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
