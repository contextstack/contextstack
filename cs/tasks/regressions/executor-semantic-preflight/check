#!/usr/bin/env python3
import json
import sys
import shutil
import subprocess
import tempfile
from pathlib import Path

sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))  # frozen copies too
from scratch import scratch_dir
from hermetic_env import hermetic_env

ROOT = Path(__file__).resolve().parents[3]
with scratch_dir(prefix="executor-preflight-") as raw:
    lab = Path(raw) / "lab"
    ops, task, setup, ledger = (lab / "ops/bin", lab / "tasks/fixture",
                                lab / "tasks/fixture/setup", lab / "ledger")
    for path in (ops, task, setup, ledger): path.mkdir(parents=True, exist_ok=True)
    for name in ('_stuck.py', '_provider_limits.py', '_dispatch.py', '_lifecycle_evidence.py', '_estate_io.py', '_roots.py', "_executor.py", "_toolchains.py", "_lanes.py", "_lane_policy.py", "_job_memory.py", "_job_identity.py", "_job_darwin.py", "_job_linux.py", "_vitals.py", "_muse.py", "_yaml.py", "_agent_stream.py", "_job_reason.py", "_cli_native.py", "_harness_usage.py", "capture-stimulus", "_est.py", "_grant.py",
                 "_corpus_contract.py", "_workspace_setup.py", "_frozen_inputs.py", "_harvest_git.py", "_setup_workspace.py", "publish-evidence",
                 "_run_record.py", "_env_policy.py", "_errors.py", "finalize-run"):
        shutil.copy2(ROOT / "ops/bin" / name, ops / name)
    from native_runtime import stage_native_runtime
    stage_native_runtime(ops)
    (lab / "ESTATE").write_text("dev\n")  # finalize-run's node identity
    (ops / "_executor.py").chmod(0o755)
    (ops / "capture-stimulus").chmod(0o755)
    fixture_home = Path(raw) / "home"
    fixture_home.mkdir()
    marker = Path(raw) / "cli-was-invoked"
    fake = Path(raw) / "expensive-cli"
    fake.write_text("#!/bin/sh\ntouch " + str(marker) + "\nexit 99\n")
    fake.chmod(0o755)
    (ops / "executor-templates.json").write_text(json.dumps({"fake-opus": {
        "binary": str(fake), "args": ["{{prompt}}"], "env_drop": [],
        "cost_class": "subscription", "cost_usd": 0,
        "cost_per_1k": 0.025, "auth": "subscription"}}) + "\n")
    (task / "goal.md").write_text("Do not run.\n")
    task_check = task / "check"
    task_check.write_text("#!/bin/sh\ntest ! -e judgment.json\n")
    task_check.chmod(0o755)
    preflight = task / "preflight"
    preflight.write_text('#!/bin/sh\necho \'{"run":false,"reason":"rank is not escalated"}\'\nexit 3\n')
    preflight.chmod(0o755)
    result = subprocess.run([str(ops / "_executor.py")], input=json.dumps({
        "executor": "fake-opus", "task": "tasks/fixture",
        "exp": "task-fixture", "trial": 1, "timeout_s": 60}),
        cwd=lab, text=True, capture_output=True, timeout=15, env={**hermetic_env(), "HOME": str(fixture_home)})
    assert result.returncode == 0, result.stderr or result.stdout
    receipt = json.loads(result.stdout.splitlines()[-1])
    assert receipt["verdict"] == "pass" and receipt["stop"] == "preflight_skip"
    assert receipt["cli_invoked"] is False
    assert receipt["est_usd"] == 0 and receipt["est_basis"] == "not_invoked"
    assert receipt["preflight_reason"] == "rank is not escalated"
    assert not marker.exists()
    rows = [json.loads(line) for line in (ledger / "ledger.jsonl").read_text().splitlines()]
    assert len(rows) == 1 and rows[0]["cli_invoked"] is False
    assert "intent" not in rows[0] and "exp" not in rows[0]
    assert "intent" not in json.loads(next((ledger / "runs").glob("*/terminal.json")).read_text())
    spec = lab / "spec.yaml"
    base = "id: fixture\nmodel: fake-opus\ntrials: 1\n"
    intent = "01ARZ3NDEKTSV4RRFFQ69G5FAV"
    spec.write_text(base + "intent: " + intent + "\n")
    payload = {"executor": "fake-opus", "task": "tasks/fixture", "spec": "spec.yaml", "trial": 1, "timeout_s": 60}
    linked = subprocess.run([str(ops / "_executor.py")], input=json.dumps(payload),
        cwd=lab, text=True, capture_output=True, timeout=15, env={**hermetic_env(), "HOME": str(fixture_home)})
    assert linked.returncode == 0, linked.stderr or linked.stdout
    rows = [json.loads(line) for line in (ledger / "ledger.jsonl").read_text().splitlines()]
    assert rows[-1]["intent"] == intent and "exp" not in rows[-1]
    terminal = lab / rows[-1]["transcript"] / "terminal.json"
    assert json.loads(terminal.read_text())["intent"] == intent
    for retired in ("INT-" + "0001", "EXP-" + "1"):
        spec.write_text(base + "intent: " + retired + "\n")
        refused = subprocess.run([str(ops / "_executor.py")], input=json.dumps(payload),
            cwd=lab, text=True, capture_output=True, timeout=15, env={**hermetic_env(), "HOME": str(fixture_home)})
        assert refused.returncode != 0 and "retired format" in refused.stdout + refused.stderr

print("check: deterministic no-work preflight skips subscription CLI before launch")
