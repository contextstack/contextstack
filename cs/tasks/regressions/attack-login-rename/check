#!/usr/bin/env python3
"""Decoy-only attacks against owner logins under production per-job profiles."""
import sys
from pathlib import Path
sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))
from scratch import scratch_dir

import ast
import json
import os
from pathlib import Path
import stat
import subprocess
import sys
import tempfile

OPS = Path(__file__).resolve().parents[3] / 'ops/bin'
sys.path.insert(0, str(OPS))

import _executor  # noqa: E402

PROBE = r'''
import errno
import json
import os
from pathlib import Path
import sys
import tempfile

spec = json.loads(Path(sys.argv[1]).read_text())
results = []
for index, entry in enumerate(spec):
    owner, copied = Path(entry['owner']), Path(entry['copy'])
    payload = b'{"marker":"attacker"}\n'
    workspace = Path.cwd() / ('replacement-%s' % index)
    workspace.write_bytes(payload)
    # TMPDIR is deliberately bypassed: exercise the system /tmp rename route.
    fd, raw = tempfile.mkstemp(prefix='login-attack-', dir='/tmp')
    os.write(fd, payload)
    os.close(fd)
    system_tmp = Path(raw)
    # This runs as the sandboxed job, whose cwd is its workspace under the system temp dir.
    job_workspace = Path.cwd()
    fd, raw = tempfile.mkstemp(prefix='.auth-', dir=job_workspace)
    os.write(fd, payload)
    os.close(fd)
    atomic = Path(raw)
    def unlink_create():
        owner.unlink()
        owner.write_bytes(payload)
    routes = {
        'rename-workspace': lambda: os.replace(workspace, owner),
        'rename-tmp': lambda: os.replace(system_tmp, owner),
        'rename-auth': lambda: os.replace(atomic, owner),
        'hardlink-to-owner': lambda: os.link(workspace, owner),
        'hardlink-from-owner': lambda: os.link(owner, Path.cwd() / ('alias-%s' % index)),
        'symlink': lambda: os.symlink(workspace, owner),
        'unlink-create': unlink_create,
        'overwrite': lambda: owner.write_bytes(payload),
        'chmod': lambda: owner.chmod(0o644),
    }
    try:
        for route, operation in routes.items():
            try:
                operation()
            except OSError as error:
                results.append([index, route, error.errno == errno.EPERM])
            else:
                results.append([index, route, False])
        copied.write_bytes(payload)
        assert copied.read_bytes() == payload, 'private copy rewrite failed'
    finally:
        for path in (workspace, system_tmp, atomic):
            path.unlink(missing_ok=True)
print(json.dumps(results))
'''


def main():
    if '--darwin-probe' not in sys.argv or sys.platform != 'darwin':
        print('SKIP: requires --darwin-probe on macOS')
        return
    capability = subprocess.run(
        ['sandbox-exec', '-p', '(version 1)(allow default)', '/usr/bin/true'],
        capture_output=True, text=True, timeout=10)
    if capability.returncode:
        assert 'sandbox_apply: Operation not permitted' in capability.stderr, capability.stderr
        print('SKIP: nested sandbox-exec refused (sandbox_apply: Operation not permitted)')
        return
    from _cli_native import stage, finish_copies, unstage

    ns = {'sandbox_cmd': _executor.sandbox_cmd}
    sources = {'~/.grok/auth.json', '~/.codex/auth.json', '~/.pi/agent/auth.json', '~/.claude/.credentials.json'}
    templates = json.loads((OPS / 'executor-templates.json').read_text())
    selected = {name: tmpl for name, tmpl in templates.items()
                if sources.intersection(tmpl.get('copies', {}).values())}
    assert selected, 'no copied-login templates exercised'
    assert sources == {src for tmpl in selected.values() for src in tmpl['copies'].values()}
    with scratch_dir(prefix='attack-login-rename-') as raw:
        root = Path(raw).resolve()
        home = root / 'home'
        original = b'{"marker":"owner-decoy"}\n'
        for source in sources:
            owner = home / source[2:]
            owner.parent.mkdir(parents=True, exist_ok=True)
            owner.write_bytes(original)
            owner.chmod(0o600)
        _executor.HOME = home
        for name, template in selected.items():
            run = root / name
            ws, private = run / 'workspace', run / 'tmp'
            ws.mkdir(parents=True)
            private.mkdir()
            records = []
            env, links = stage(template, private, home, copy_records=records)
            assert len(records) == len(template['copies']), (name, 'missing staged copies')
            try:
                spec = private / 'routes.json'
                spec.write_text(json.dumps([dict(owner=str(r['real']), copy=str(r['copy'])) for r in records]))
                probe = private / 'probe.py'
                probe.write_text(PROBE)
                profile = private / 'sandbox.sb'
                ns['sandbox_cmd'](sys.executable, [], ws, private, profile,
                                  caller=dict(deny_write_roots=[str(home / p[2:] if p.startswith('~/') else Path(p)) for p in template.get('deny_write', [])]), read_links=links,
                                  login_writes=template)
                done = subprocess.run(
                    ['sandbox-exec', '-f', str(profile), sys.executable, str(probe), str(spec)],
                    cwd=ws, env={'HOME': str(home), 'PATH': '/usr/bin:/bin', 'TMPDIR': str(private), **env},
                    capture_output=True, text=True, timeout=30)
                # Task completion never opts into Claude's trusted no-tools refresh.
                results = finish_copies(records)
                assert done.returncode == 0, (name, done.stderr)
                routes = json.loads(done.stdout)
                assert len(routes) == len(results) * 9, (name, 'incomplete probe')
                assert all(refused for _, _, refused in routes), (name, routes)
                assert all(r['status'] == 'task_copy' for r in results), (name, results)
                for source in sources:
                    owner = home / source[2:]
                    assert owner.read_bytes() == original, (name, 'owner bytes changed')
                    assert stat.S_IMODE(owner.stat().st_mode) == 0o600, (name, 'owner mode changed')
                print('PASS: %s: all routes EPERM; owner intact; task copies discarded' % name)
            finally:
                if records:
                    finish_copies(records)
                unstage(links)


if __name__ == '__main__':
    main()
