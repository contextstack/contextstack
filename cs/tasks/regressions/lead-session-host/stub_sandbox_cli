#!/usr/bin/env python3
"""Stub CLI entry that enables the darwin sandbox credential probe."""
import runpy
import sys
from pathlib import Path

here = Path(__file__).resolve().parent
target = here / "stub_stream_cli"
sys.argv = [str(target), "--sandbox-probe", *sys.argv[1:]]
runpy.run_path(str(target), run_name="__main__")
