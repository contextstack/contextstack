#!/usr/bin/env python3
"""Stub CLI with turn delay for serialization regression."""
import runpy
import sys
from pathlib import Path

here = Path(__file__).resolve().parent
target = here / "stub_stream_cli"
sys.argv = [str(target), "--turn-delay", "1.5", *sys.argv[1:]]
runpy.run_path(str(target), run_name="__main__")
