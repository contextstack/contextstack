        assert process["attributes"]["exit_status"] == 0
        assert process["attributes"]["received_events"] == 2
        assert process["attributes"]["usage_reported"] is True
        events = [json.loads(json.loads(line)["output"])
                  for line in (run_dir / "cli-events.jsonl").read_text().splitlines()]
        assert [event["type"] for event in events] == ["system", "result"]
        usage = next(span["attributes"] for span in spans if span["kind"] == "cli_usage")
        assert usage["source"] == "claude_code_native"
        assert (usage["input_tokens"], usage["output_tokens"]) == (5, 12)
        terminal = json.loads((run_dir / "terminal.json").read_text())
        assert (terminal["est_usd"], terminal["est_basis"], terminal["cost_usd"]) == (0.00017, "rate", 0), terminal
