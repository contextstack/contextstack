def login_copies_only():
    """Host lifecycle checks without sockets, sandbox-exec, or personal credentials."""
    from _lead_session import ClaudeStreamSession, prepare_runtime_home

    with scratch_dir(prefix="lead-login-copies-") as raw:
        root = Path(raw)
        owner = root / "owner"
        source = owner / ".claude/.credentials.json"
        source.parent.mkdir(parents=True)
        original = {"claudeAiOauth": {"accountUuid": "owner-account", "organizationUuid": "owner-org",
                                      "refreshToken": "fixture-original"}}
        source.write_text(json.dumps(original))
        with patch.dict(os.environ, {"HOME": str(owner)}):
            transcript = root / "events.ndjson"
            session = ClaudeStreamSession(root, root / "runtime", root / "tmp",
                                          binary="/usr/bin/true", transcript=transcript)
            session.start()
            session.stop()
            assert session.login_copy_refresh[-1]["status"] == "unchanged"
            copied = session.home / ".claude/.credentials.json"
            assert not copied.exists()

            def stage_copy():
                session._login_copies = prepare_runtime_home(session.home)
                assert copied.is_file() and not copied.is_symlink()
                assert stat.S_IMODE(copied.stat().st_mode) == 0o600 and copied.stat().st_nlink == 1

            refreshed = {"claudeAiOauth": {**original["claudeAiOauth"], "refreshToken": "fixture-rotated"}}
            stage_copy()
            copied.write_text(json.dumps(refreshed))
            assert json.loads(source.read_text()) == original
            session.stop()
            assert session.login_copy_refresh[-1]["status"] == "task_copy"
            assert json.loads(source.read_text()) == original and not copied.exists()

            stage_copy()
            copied.write_text(json.dumps({"claudeAiOauth": {**refreshed["claudeAiOauth"], "accountUuid": "other"}}))
            session.stop()
            assert session.login_copy_refresh[-1]["status"] == "task_copy"
            assert json.loads(source.read_text()) == original and not copied.exists()

            stage_copy()
            copied.write_text(json.dumps(refreshed))
            owner_refresh = {"claudeAiOauth": {**refreshed["claudeAiOauth"], "refreshToken": "fixture-owner-newer"}}
            source.write_text(json.dumps(owner_refresh))
            session.stop()
            assert session.login_copy_refresh[-1]["status"] == "owner_changed"
            assert json.loads(source.read_text()) == owner_refresh and not copied.exists()
            events = [json.loads(line)["msg"] for line in transcript.read_text().splitlines()]
            assert [event["login_copy_refresh"][0]["status"] for event in events] == [
                "unchanged", "task_copy", "task_copy", "owner_changed"]
            assert all(set(event) == {"login_copy_refresh"} and
                       set(event["login_copy_refresh"][0]) == {"source", "status"} for event in events)

            failed = ClaudeStreamSession(root, root / "failed-runtime", root / "tmp", binary=str(root / "missing-cli"))
            try:
                failed.start()
            except FileNotFoundError:
                pass
            else:
                raise AssertionError("missing CLI accepted")
            assert failed.login_copy_refresh[-1]["status"] == "unchanged"
            assert not (failed.home / ".claude/.credentials.json").exists()

            source.unlink()
            keychain_only = ClaudeStreamSession(root, root / "keychain-only", root / "tmp", binary="/usr/bin/true")
            keychain_only.start()
            keychain_only.stop()
            assert keychain_only.login_copy_refresh == []
            assert not (keychain_only.home / ".claude/.credentials.json").exists()
    print("PASS: hosted lead private login lifecycle, task refresh discard, owner precedence, failure cleanup and evidence")
    return 0


