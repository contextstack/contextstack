            False,
            "executor hosted turn timed out (step=executor subprocess, limit=%ds)" % CHECK_TIMEOUT_EXECUTOR,
        )
        kill_serve(state, CONV_EXECUTOR)
        return
    expect(done.returncode in (0, 3), "executor hosted turn exits", (done.returncode, done.stderr))
    run_id = None
    for line in reversed((done.stdout or "").splitlines()):
        line = line.strip()
