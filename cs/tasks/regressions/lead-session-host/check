def kill_serve(state: Path, conversation: str, sock: Path | None = None) -> None:
    st = _lead_host.load_state(_lead_host.state_file(state, conversation))
    pid = st.get("serve_pid")
    if pid:
        pid = int(pid)
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                break
            except OSError:
                break
            time.sleep(0.1)
        else:
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
    if sock is None:
        sock = _lead_host.socket_file(state, conversation)
    sock.unlink(missing_ok=True)


def wait_serve_exit(
    pid: int, timeout: float = CHECK_SERVE_EXIT_S, label: str = "serve", *, state: Path | None = None, conversation: str | None = None
) -> bool:
    sock = _lead_host.socket_file(state, conversation) if state is not None and conversation else None
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        gone = False
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            gone = True
        if sock is not None and not sock.is_socket():
            return True
        if gone:
            return True
        time.sleep(0.1)
    return False


