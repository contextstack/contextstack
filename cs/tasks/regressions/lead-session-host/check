def raw_request(sock: Path, payload: dict) -> dict:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(5)
        client.connect(str(sock))
        client.sendall((json.dumps(payload) + "\n").encode())
        return json.loads(client.recv(65536))


def test_socket_security(root: Path, state: Path, cfg: Path, sock: Path) -> None:
    expect(sock.parent.stat().st_uid == os.getuid(), "socket directory belongs to host user")
    expect(stat.S_IMODE(sock.parent.stat().st_mode) == 0o700, "socket directory mode 0700")
    token = sock.parent / "token"
    expect(token.is_file() and stat.S_IMODE(token.stat().st_mode) == 0o600, "per-serve token mode 0600")
    token.chmod(0o644)
    try:
        _lead_host.read_socket_token(sock)
        expect(False, "publicly readable socket token refused")
    except (SystemExit, ValueError, OSError):
        pass
    finally:
        token.chmod(0o600)
    for payload in ({"op": "ping"}, {"op": "turn", "workspace": str(root)},
                    {"op": "watch_job", "job_id": "attacker"}, {"op": "ping", "token": "wrong"}):
        answer = raw_request(sock, payload)
        expect(bool(answer.get("error")), "unauthenticated socket request refused", answer)

    attacker = root / "attacker-workspace"
    (attacker / "session").mkdir(parents=True)
    (attacker / "session/mcp.json").write_text(json.dumps({"mcpServers": {"evil": {"command": "attacker"}}}))
    answer = _lead_host.socket_request(sock, {"op": "turn", "workspace": str(attacker)}, timeout=5)
    expect(bool(answer.get("error")), "arbitrary workspace and attacker MCP refused", answer)
    # Host-side clients must reject this before attempting a replacement serve, too.
    with patch.object(
            _lead_host, "ensure_serving", side_effect=AssertionError("untrusted workspace started a serve")):
        try:
            _lead_host.client_turn(attacker, conversation_id=CONV_MAIN, config_root=cfg,
                                   state=state, cli_binary=str(STUB), sandbox=False)
            expect(False, "invalid workspace refused before serve replacement")
        except (SystemExit, ValueError):
            pass
    stranger = state / "jobs" / "other-conversation"
    (stranger / "tasks/turn").mkdir(parents=True)
    (stranger / "job.json").write_text(json.dumps({"job_id": stranger.name, "task": "tasks/turn", "spec": "spec.yaml"}))
    (stranger / "tasks/turn/goal.md").write_text("forged owner turn")
    DIRECTOR.add_turn("con_other", stranger.name)
    answer = _lead_host.socket_request(sock, {"op": "turn", "workspace": str(stranger)}, timeout=5)
    expect(bool(answer.get("error")), "another conversation's job bundle refused", answer)

    stale = sock.parent / "stale-socket"
    for kind in ("file", "symlink"):
        if kind == "file":
            stale.write_text("must survive")
        else:
            stale.symlink_to(token)
        try:
            _lead_host.remove_stale_socket(stale)
            expect(False, "stale " + kind + " refused without unlinking")
        except (SystemExit, ValueError, OSError):
            expect(stale.exists() or stale.is_symlink(), "unsafe stale path remains intact")
        finally:
            stale.unlink(missing_ok=True)

    for label in ("public", "symlink"):
        conversation = "con_unsafe_" + label
        candidate = _lead_host.socket_file(state, conversation)
        candidate.parent.parent.mkdir(parents=True, exist_ok=True)
        if label == "public":
            candidate.parent.mkdir(mode=0o755)
            candidate.parent.chmod(0o755)
        else:
            target = root / "symlink-target"
            target.mkdir(mode=0o700)
            candidate.parent.symlink_to(target, target_is_directory=True)
        try:
            _lead_host.ensure_serving(conversation, state, cfg, model="sonnet", cli_binary=str(STUB), sandbox=False)
            expect(False, label + " socket directory refused")
        except (SystemExit, ValueError, OSError):
            pass
        finally:
            if candidate.parent.is_symlink():
                candidate.parent.unlink()
            elif candidate.parent.exists():
                candidate.parent.rmdir()


def test_serve_outlives_client(cs_root: Path, state: Path, env: dict) -> None:
    """The serve a turn client spawns keeps running after that client exits: lane wake-ups need it between turns."""
    write_hosted_lead(cs_root / "config", CONV_LIFETIME)
    code = ("import sys; sys.path.insert(0, %r); import _lead_host; from pathlib import Path; "
            "_lead_host.ensure_serving(%r, Path(%r), Path(%r), model='sonnet', cli_binary=%r, sandbox=False)"
            % (str(OPS), CONV_LIFETIME, str(state), str(cs_root / "config"), str(STUB)))
    child_env = {k: v for k, v in env.items() if k != "LEAD_HOST_WATCH_PID"}
    try:
        done = subprocess.run([sys.executable, "-I", "-c", code], env=child_env, timeout=CHECK_TIMEOUT_TURN,
                              capture_output=True, text=True)
        expect(done.returncode == 0, "lifetime client spawned a serve", done.stderr[-400:])
        time.sleep(2.5)  # past several serve poll intervals: a serve watching the client would be gone
        pid = _lead_host.load_state(_lead_host.state_file(state, CONV_LIFETIME)).get("serve_pid")
        alive = False
        if pid:
            try:
                os.kill(int(pid), 0)
                alive = True
            except OSError:
                alive = False
        expect(alive, "serve outlives the turn client that spawned it", pid)
    finally:
        kill_serve(state, CONV_LIFETIME)


