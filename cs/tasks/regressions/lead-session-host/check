def test_turn_serialization(cs_root: Path, state: Path, env: dict) -> None:
    write_hosted_lead(cs_root / "config", CONV_SERIAL)
    ws_a = workspace_turn(state.parent, 60, "Concurrent A")
    ws_b = workspace_turn(state.parent, 61, "Concurrent B")
    prev = dict(os.environ.items())
    delay_env = dict(env, LEAD_HOST_CLI_EXTRA=json.dumps(["--turn-delay", "1.5"]))
    os.environ.update(delay_env)
    order = []
    errors = []

    def run_turn(label, ws):
        try:
            _lead_host.client_turn(
                ws,
                conversation_id=CONV_SERIAL,
                config_root=cs_root / "config",
                state=state,
                cli_binary=str(STUB),
                sandbox=False,
                timeout=CHECK_TIMEOUT_TURN_SLOW,
            )
            order.append(label)
        except BaseException as error:  # fail() raises SystemExit, which a thread would swallow
            errors.append("%s: %r" % (label, error))

    try:
        ta = threading.Thread(target=run_turn, args=("A", ws_a))
        tb = threading.Thread(target=run_turn, args=("B", ws_b))
        ta.start()
        time.sleep(0.05)
        tb.start()
        ta.join(timeout=CHECK_TIMEOUT_JOIN_SERIAL)
        tb.join(timeout=CHECK_TIMEOUT_JOIN_SERIAL)
        if ta.is_alive():
            expect(False, "concurrent turn A timed out (step=serialization thread join, limit=%ds)" % CHECK_TIMEOUT_JOIN_SERIAL)
        if tb.is_alive():
            expect(False, "concurrent turn B timed out (step=serialization thread join, limit=%ds)" % CHECK_TIMEOUT_JOIN_SERIAL)
        expect(not errors, "concurrent turns complete", errors)
        expect(len(order) == 2, "both turns finished", order)
        expect(order[0] != order[1] or order == ["A", "B"] or order == ["B", "A"], "serialized turns", order)
        expect(abs(order.index("A") - order.index("B")) == 1, "turns did not overlap", order)
    finally:
        kill_serve(state, CONV_SERIAL)
        os.environ.clear()
        os.environ.update(prev)


def test_executor_hook(root: Path, cs_root: Path, state: Path, env: dict) -> None:
