        assert final["attributes"]["verdict"] == out["verdict"] == "pass"
        assert [json.loads(line)["event"] for line in messages.read_text().splitlines()] == ["turn"]

    kill_serve(state, CONV_EXECUTOR)


def test_serve_lifecycle(root: Path, cs_root: Path, state: Path, env: dict) -> None:
    write_hosted_lead(cs_root / "config", CONV_LIFECYCLE)
    ws = workspace_turn(root, 70, "Lifecycle idle.")
    prev = dict(os.environ.items())
    idle_env = dict(env, LEAD_HOST_IDLE_EXIT_S="2", LEAD_HOST_WAKE="0")
    os.environ.update(idle_env)
    try:
        timed_client_turn(
            "lifecycle idle client_turn",
            workspace=ws,
            conversation_id=CONV_LIFECYCLE,
            config_root=cs_root / "config",
            state=state,
            cli_binary=str(STUB),
            sandbox=False,
            timeout=CHECK_TIMEOUT_TURN,
        )
        st = _lead_host.load_state(_lead_host.state_file(state, CONV_LIFECYCLE))
        pid = st.get("serve_pid")
        expect(pid, "lifecycle serve recorded pid", st)
        if pid:
            idle_s = float(os.environ.get("LEAD_HOST_IDLE_EXIT_S", "2") or "2")
            idle_deadline = time.monotonic() + max(CHECK_SERVE_EXIT_S, idle_s * 10 + 5)
            exited = False
            while time.monotonic() < idle_deadline:
                if wait_serve_exit(
                    int(pid), timeout=0.2, label="idle-exit serve", state=state, conversation=CONV_LIFECYCLE
                ):
                    exited = True
                    break
                time.sleep(0.1)
            expect(exited, "serve exits after idle timeout (step=LEAD_HOST_IDLE_EXIT_S)", {"pid": pid, "st": st})

        ws2 = workspace_turn(root, 71, "Lifecycle state file.")
        no_idle = dict(env, LEAD_HOST_IDLE_EXIT_S="3600")
        os.environ.clear()
        os.environ.update(no_idle)
        timed_client_turn(
            "lifecycle respawn client_turn",
            workspace=ws2,
            conversation_id=CONV_LIFECYCLE,
            config_root=cs_root / "config",
            state=state,
            cli_binary=str(STUB),
            sandbox=False,
            timeout=CHECK_TIMEOUT_TURN,
        )
        st2 = _lead_host.load_state(_lead_host.state_file(state, CONV_LIFECYCLE))
        pid2 = st2.get("serve_pid")
        sf = _lead_host.state_file(state, CONV_LIFECYCLE)
        expect(pid2, "lifecycle serve respawned", st2)
        if pid2:
            sf.unlink(missing_ok=True)
            t0 = step_begin("lifecycle serve exit on state removal")
            exited = wait_serve_exit(
                int(pid2), timeout=CHECK_SERVE_EXIT_S, label="state-file removal serve", state=state, conversation=CONV_LIFECYCLE
            )
            step_done("lifecycle serve exit on state removal", t0)
            expect(exited, "serve exits when state file removed (step=conversation state file)", {"pid2": pid2})
    finally:
        kill_serve(state, CONV_LIFECYCLE)
        os.environ.clear()
        os.environ.update(prev)


def main():
    if not STUB.is_file():
        expect(False, "stub_stream_cli exists")
        print("lead-session-host: FAIL")
        return 1
    for path in (STUB, STUB_DELAY, STUB_SANDBOX):
        if path.is_file():
            path.chmod(stat.S_IRWXU | stat.S_IRGRP | stat.S_IXGRP)

    DIRECTOR.start()
    with scratch_dir(prefix="lead-session-host-") as raw:
        root = Path(raw)
        fixture_home = root / "login-home"
        fixture_home.mkdir()
        state = root / "state"
        state.mkdir(parents=True, exist_ok=True)
        cs_root = root / "cs"
        cfg = cs_root / "config"
        cfg.mkdir(parents=True)
        (cfg / "lead-credential").write_text(SECRET + "\n", encoding="utf-8")
        os.chmod(cfg / "lead-credential", 0o600)
        write_hosted_lead(cfg, CONV_MAIN)
        tools = str(KIT.parent / "target/release/cs-tools")
        env = dict(
            hermetic_env(),
            HOME=str(fixture_home),
            CS_STATE_ROOT=str(state),
            CS_CONFIG_ROOT=str(cs_root / "config"),
            CS_CODE_ROOT=str(KIT),
            CS_TOOLS_BIN=tools,
            LEAD_HOST_SERVE_READY_S=CHECK_SERVE_READY_S,
            LEAD_HOST_WAKE="0",
            LEAD_HOST_NO_SANDBOX="1", CS_EXECUTOR_ALLOW_UNSANDBOXED="1",
        )
        sock = _lead_host.socket_file(state, CONV_MAIN)
        prev = dict(os.environ.items())
        os.environ.update(env)
        try:
            test_credential_escape(cs_root)

            ws1 = workspace_turn(root, 1, "Hello from turn one.")
            reply1 = timed_client_turn(
                "first client_turn",
                workspace=ws1,
                conversation_id=CONV_MAIN,
                config_root=cs_root / "config",
                state=state,
                cli_binary=str(STUB),
                sandbox=False,
                timeout=CHECK_TIMEOUT_TURN,
            )
            expect(reply1 == "STUB-REPLY: Hello from turn one.", "first turn reply", reply1)

            st = _lead_host.load_state(_lead_host.state_file(state, CONV_MAIN))
            sid = st.get("cli_session_id")
            expect(sid, "session id persisted", st)

            ws2 = workspace_turn(root, 2, "Second message.")
            reply2 = timed_client_turn(
                "second client_turn",
                workspace=ws2,
                conversation_id=CONV_MAIN,
                config_root=cs_root / "config",
                state=state,
                cli_binary=str(STUB),
                sandbox=False,
                timeout=CHECK_TIMEOUT_TURN,
            )
            expect(reply2 == "STUB-REPLY: Second message.", "second turn reply", reply2)

            ndjson_path = _lead_host.state_file(state, CONV_MAIN).with_suffix(".ndjson")
            ndjson_body = ndjson_path.read_text(encoding="utf-8") if ndjson_path.is_file() else ""
            expect(ndjson_body.count('"subtype": "init"') == 1, "one CLI process: single init for two turns")

            expect(sock.is_socket(), "serve creates unix socket")
            mode = sock.stat().st_mode & 0o777
            expect(mode == 0o600, "socket mode 0600", oct(mode))
            ndjson = ndjson_path
            text = ndjson.read_text(encoding="utf-8") if ndjson.is_file() else ""
            serve_log = _lead_host.sessions_root(state) / ("%s-serve.log" % CONV_MAIN)
            if serve_log.is_file():
                text += serve_log.read_text(encoding="utf-8")
            expect(SECRET not in text, "credential token absent from logs")

            test_socket_security(root, state, cfg, sock)
            first_token = (sock.parent / "token").read_text()
            test_redaction(cs_root, state, env)
            test_serve_outlives_client(cs_root, state, env)

            kill_serve(state, CONV_MAIN, sock)
            t0 = step_begin("wait socket gone after kill")
            expect(wait_socket_gone(sock), "socket removed after kill", sock)
            step_done("wait socket gone after kill", t0)

            write_hosted_lead(cfg, CONV_MAIN)
            ws3 = workspace_turn(root, 3, "After restart.")
            reply3 = timed_client_turn(
                "resume client_turn",
                workspace=ws3,
                conversation_id=CONV_MAIN,
                config_root=cs_root / "config",
                state=state,
                cli_binary=str(STUB),
                sandbox=False,
                timeout=CHECK_TIMEOUT_TURN,
            )
            expect(reply3 == "STUB-REPLY: After restart.", "resume turn reply", reply3)
            expect((sock.parent / "token").read_text() != first_token, "serve restart rotates authentication token")
            expect(bool(raw_request(sock, {"op": "ping", "token": first_token.strip()}).get("error")),
                   "previous serve token cannot authenticate replacement")
            st2 = _lead_host.load_state(_lead_host.state_file(state, CONV_MAIN))
            expect(st2.get("cli_session_id") == sid, "session id unchanged across restart", st2)

            test_turn_serialization(cs_root, state, env)
            test_executor_hook(root, cs_root, state, env)
            test_serve_lifecycle(root, cs_root, state, env)

        finally:
            kill_serve(state, CONV_MAIN, sock)
            for conv in (CONV_REDACTION, CONV_SERIAL, CONV_EXECUTOR, CONV_LIFECYCLE):
                kill_serve(state, conv)
            os.environ.clear()
            os.environ.update(prev)
            DIRECTOR.stop()

    try:
        smoke = timed_subprocess(
            "darwin_sandbox_smoke",
            args=[sys.executable, str(HERE / "darwin_sandbox_smoke.py")],
            capture_output=True,
            text=True,
            timeout=CHECK_TIMEOUT_SMOKE,
        )
    except subprocess.TimeoutExpired as exc:
        expect(
            False,
            "darwin sandbox smoke timed out (step=darwin_sandbox_smoke subprocess, limit=%ds)" % CHECK_TIMEOUT_SMOKE,
            (exc.stdout or "")[-500:] + (exc.stderr or "")[-500:],
        )
        smoke = None
    if smoke is not None:
        if sys.platform == "darwin":
            expect(smoke.returncode == 0, "darwin sandbox smoke", smoke.stderr or smoke.stdout)
        elif smoke.returncode != 0:
            expect(False, "darwin sandbox smoke should skip off darwin", smoke.stderr)

    # A hosted turn reads its job bundle, not the executor's run workspace (task = <bundle>/tasks/turn).
    with scratch_dir(prefix="lead-bundle-") as raw:
        bundle, run_ws = Path(raw) / "job", Path(raw) / "run-ws"
        (bundle / "session").mkdir(parents=True); (bundle / "tasks/turn").mkdir(parents=True); run_ws.mkdir()
        (bundle / "session/mcp.json").write_text("{}")
        expect(_lead_host.turn_bundle(bundle / "tasks/turn", run_ws) == bundle.resolve(),
               "a hosted turn reads session/ from its job bundle, not the run workspace")
        expect(_lead_host.turn_bundle(run_ws / "tasks/turn", run_ws) == run_ws,
               "task parent remains the bundle candidate; host validates it before use")

    # cs mcp under the private HOME gets its node and Director from hosted-lead.json.
    with scratch_dir(prefix="lead-mcp-") as raw:
        b = Path(raw); (b / "session").mkdir(); cred_file = b / "cred"; cred_file.write_text("x")
        (b / "session/mcp.json").write_text(json.dumps({"mcpServers": {"evil": {"command": "attacker"}}}))
        trusted_config = _lead_host.build_mcp_config(b, cred_file, {"node": "workstation", "director": "http://127.0.0.1:8780"})
        expect("evil" not in trusted_config.get("mcpServers", {}), "MCP config ignores attacker workspace contents")
        args = _lead_host.build_mcp_config(b, cred_file, {"node": "workstation", "director": "http://127.0.0.1:8780"})["mcpServers"]["contextstack"]["args"]
        expect(args[args.index("--node") + 1] == "workstation" and args[args.index("--director") + 1] == "http://127.0.0.1:8780"
               and "--no-land" in args and str(cred_file) in args,
               "the lead's cs mcp names its node and Director and keeps --no-land", args)
        expect(args[args.index("--max-wait") + 1] == "30", "the lead's wait_tasks is capped below its turn deadline", args)
        # 2026-11-12: a 300 s wait_tasks outlived the lead's 300 s turn. A capped wait returns early with a note.
        sys.path.insert(0, str(KIT / "scripts"))
        import cs_mcp

        class _Capped(cs_mcp.Tools):
            def open_stream(self, deadline):
                return None

            def job(self, job_id, timeout=None):
                return {"id": job_id, "state": "running"}

        t0 = time.time()
        waited = _Capped(None, "workstation", can_land=False, max_wait=1).wait_tasks(["j1"], timeout_seconds=300)
        expect(time.time() - t0 < 5 and waited["timed_out"] and "end your turn" in waited.get("note", ""),
               "a hosted wait_tasks stops at its cap and tells the lead to end its turn", waited)

    # The host approves only the lead's Director tools (2026-11-12: it denied every call, so a lead could do nothing).
    from _lead_session import allowed_tool
    expect(allowed_tool("mcp__contextstack__start_task") and allowed_tool("mcp__contextstack__needs_you"),
           "the lead session host allows the contextstack MCP tools")
    expect(not any(allowed_tool(t) for t in ("Bash", "Write", "mcp__other__x", "mcp__contextstack__", "mcp__contextstackx__start_task")),
           "the lead session host denies built-in tools and other MCP servers")

    if sys.platform == "darwin":
        # The lead's Claude reads its login from the Keychain (2026-11-12: "Not logged in" in every
        # sandboxed turn). Its profile re-allows only login.keychain-db, as the executor's does.
        with scratch_dir(prefix="lead-keychain-") as raw:
            kroot = Path(raw)
            previous_home = os.environ.get("HOME")
            os.environ["HOME"] = str(kroot / "login-home")
            Path.home().mkdir()
            _lead_host._SANDBOX_CMD_CACHE = None
            (kroot / "ws").mkdir()
            session = _lead_host.make_session(kroot / "ws", kroot / "tmp", model="sonnet", resume=None,
                                              binary="/usr/bin/true", mcp_config={"mcpServers": {}},
                                              transcript=None, sandbox=True)
            from _lead_session import prepare_runtime_home
            prepare_runtime_home(session.home)
            (kroot / "tmp").mkdir(exist_ok=True)
            session.argv()
            profile = (kroot / "tmp/sandbox.sb").read_text()
            keychains = str((Path.home() / "Library/Keychains").resolve())
            # A persistent per-conversation HOME (claude --resume across turns) is writable in the sandbox.
            conv_home = kroot / "state/lead-sessions/con_x/home"
            s2 = _lead_host.make_session(kroot / "ws", kroot / "tmp2", model="sonnet", resume=None,
                                         binary="/usr/bin/true", mcp_config={"mcpServers": {}},
                                         transcript=None, sandbox=True, runtime_home=conv_home)
            prepare_runtime_home(s2.home)
            (kroot / "tmp2").mkdir()
            s2.argv()
            p2 = (kroot / "tmp2/sandbox.sb").read_text()
            expect(s2.home == conv_home and '(allow file-read* file-write* (subpath %s))' % json.dumps(str(conv_home.parent.resolve())) in p2,
                   "the lead session's persistent HOME is writable in its sandbox")
            expect("login\\.keychain-db" in profile and re.escape(keychains) in profile,
                   "the lead session profile re-allows the login Keychain database", profile[-400:])
            expect('(allow file-read* (subpath "%s"))' % keychains not in profile,
                   "the lead session profile does not open all of ~/Library/Keychains")
            if previous_home is None:
                os.environ.pop("HOME", None)
            else:
                os.environ["HOME"] = previous_home
            _lead_host._SANDBOX_CMD_CACHE = None

    # File-backed Claude login is a private copy, finalized by the host at process exit.
    with scratch_dir(prefix="lead-file-login-") as raw:
        root = Path(raw)
        login_home = root / "login-home"
        source = login_home / ".claude/.credentials.json"
        source.parent.mkdir(parents=True)
        original = {"claudeAiOauth": {"accountUuid": "owner-account", "organizationUuid": "owner-org", "refreshToken": "dummy"}}
        source.write_text(json.dumps(original))
        source.chmod(0o600)
        old_home = os.environ.get("HOME")
        old_optins = {k: os.environ.get(k) for k in ("LEAD_HOST_NO_SANDBOX", "CS_EXECUTOR_ALLOW_UNSANDBOXED")}
        os.environ["HOME"] = str(login_home)
        _lead_host._SANDBOX_CMD_CACHE = None
        try:
            from _lead_session import prepare_runtime_home
            ws, tmp = root / "ws", root / "tmp"
            ws.mkdir(); tmp.mkdir()
            if sys.platform != "darwin":
                os.environ.update(LEAD_HOST_NO_SANDBOX="1", CS_EXECUTOR_ALLOW_UNSANDBOXED="1")
            session = _lead_host.make_session(ws, tmp, model="sonnet", resume=None,
                                              binary="/usr/bin/true", mcp_config={},
                                              transcript=None, sandbox=sys.platform == "darwin",
                                              runtime_home=root / "state/lead-sessions/con_file/home")
            copied = session.home / ".claude/.credentials.json"
            expect(not copied.exists(), "lead defers login staging until process start")
            session.start()
            session.stop()
            expect(not copied.exists() and json.loads(source.read_text()) == original,
                   "lead exit discards unchanged copy and preserves owner login")
            # Stage another run and rotate only the private copy, then exercise host cleanup.
            session._login_copies = prepare_runtime_home(session.home)
            expect(copied.is_file() and not copied.is_symlink() and copied.stat().st_mode & 0o777 == 0o600,
                   "lead stages a private 0600 credential copy")
            refreshed = {"claudeAiOauth": {**original["claudeAiOauth"], "refreshToken": "rotated"}}
            copied.write_text(json.dumps(refreshed))
            expect(json.loads(source.read_text()) == original, "lead copy refresh leaves owner file alone during run")
            session.stop()
            expect(json.loads(source.read_text()) == original and not copied.exists(), "lead host discards task refresh")
            expect(session.login_copy_refresh[-1]["status"] == "task_copy", "lead records refresh status without credentials")
            if sys.platform == "darwin":
                session.argv()
                profile = (tmp / "sandbox.sb").read_text()
                target = json.dumps(str(source.resolve()))
                expect('(allow file-read* (literal %s))' % target not in profile,
                       "lead profile grants no read of real credential")
                expect('(allow file-write* (literal %s))' % target not in profile and
                       '(deny file-write* file-link (literal %s))' % target in profile,
                       "lead profile denies real credential writes and links")
            source.unlink()
            source.symlink_to(root / "other")
            try:
                prepare_runtime_home(session.home)
                expect(False, "lead refuses source symlink swap")
            except ValueError:
                pass
            source.unlink(); source.mkdir()
            try:
                prepare_runtime_home(session.home)
                expect(False, "lead refuses non-file credential")
            except ValueError:
                pass
        finally:
            if old_home is None:
                os.environ.pop("HOME", None)
            else:
                os.environ["HOME"] = old_home
            _lead_host._SANDBOX_CMD_CACHE = None
            for key, value in old_optins.items():
                if value is None:
                    os.environ.pop(key, None)
                else:
                    os.environ[key] = value

    if problems:
        print("lead-session-host: FAIL (%d)" % len(problems), flush=True)
        for p in problems:
            print("  " + p, flush=True)
    else:
        print("lead-session-host: ok", flush=True)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
