def expect(ok, msg, detail=""):
    if not ok:
        line = msg + ("" if detail == "" else " (" + repr(detail) + ")")
        problems.append(line)
        print("  ASSERT FAIL: %s" % line, flush=True)


def step_begin(name: str) -> float:
    print("  step begin: %s" % name, flush=True)
    return time.monotonic()


def step_done(name: str, t0: float) -> None:
    print("  step done: %s %.2fs" % (name, time.monotonic() - t0), flush=True)


def wait_socket_gone(sock: Path, timeout: float = CHECK_SOCKET_GONE_S) -> bool:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if not sock.is_socket():
            return True
        time.sleep(0.05)
    return not sock.is_socket()


def timed_client_turn(step: str, **kwargs) -> str:
    t0 = step_begin(step)
    try:
        return _lead_host.client_turn(**kwargs)
    finally:
        step_done(step, t0)


def timed_subprocess(step: str, **kwargs) -> subprocess.CompletedProcess:
    t0 = step_begin(step)
    try:
        return subprocess.run(**kwargs)
    finally:
        step_done(step, t0)


def workspace_turn(root: Path, seq: int, message: str) -> Path:
    state = Path(os.environ["CS_STATE_ROOT"])
    cfg = Path(os.environ["CS_CONFIG_ROOT"])
    conversation = json.loads((cfg / "hosted-lead.json").read_text())["conversation_id"]
    ws = state / "jobs" / ("turn-%d" % seq)
    ws.mkdir(parents=True)
    (ws / "job.json").write_text(json.dumps({"job_id": ws.name, "task": "tasks/turn", "spec": "spec.yaml"}))
    DIRECTOR.add_turn(conversation, ws.name)
    for rel, src in (
        ("spec.yaml", LEAD / "spec.yaml"),
        ("prompts/system.md", LEAD / "prompts/system.md"),
        ("session/mcp.json", LEAD / "session/mcp.json"),
        ("session/host.json", LEAD / "session/host.json"),
    ):
        dest = ws / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy(src, dest)
    (ws / "conversation").mkdir(exist_ok=True)
    (ws / "conversation/context.md").write_text(
        "Thread context for turn %d.\n" % seq if seq > 1 else "First turn: no prior thread.\n", encoding="utf-8"
    )
    turn = ws / "tasks/turn"
    turn.mkdir(parents=True)
    (turn / "goal.md").write_text(message, encoding="utf-8")
    (turn / "check").write_text("#!/bin/sh\nexit 0\n", encoding="utf-8")
    (turn / "check").chmod(stat.S_IRWXU)
    return ws


