#!/usr/bin/env python3
# Fixture-only runtime exe binary. Not a lab tool: it reports the argv it was exec'd with,
# its stdin and its cwd, so tool-exe-dispatch pins argv = bin + the descriptor's args, with the model's
# input on stdin only.
import json
import os
import sys

print(json.dumps({"argv0": os.path.basename(sys.argv[0]), "args": sys.argv[1:], "stdin": json.load(sys.stdin),
                  "cwd_base": os.path.basename(os.getcwd())}, sort_keys=True))
