{
 "env": {
  "FX_SECRET_OK": "requested-and-permitted",
  "FX_SECRET_NO": "never-requested"
 },
 "policy": {
  "version": 1,
  "always": [
   "PATH",
   "HOME",
   "USER",
   "LOGNAME",
   "TERM",
   "LANG",
   "LC_ALL",
   "LC_CTYPE",
   "TMPDIR",
   "TMP",
   "TEMP",
   "SHELL",
   "HOMEBREW_PREFIX",
   "HOMEBREW_CELLAR",
   "CS_JOB_ID",
   "CS_TRIAL",
   "CS_SCHEDULE_DATE",
   "CS_SCHEDULE_SLOT",
   "CS_SCHEDULE_TIMEZONE",
   "CS_VIDEO_MUTATION",
   "CS_STEP_TTY"
  ],
  "on_request": [
   "FX_SECRET_OK"
  ]
 }
}
