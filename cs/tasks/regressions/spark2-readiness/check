#!/usr/bin/env python3
import sys
from pathlib import Path
sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))
from scratch import scratch_dir

import http.server, json, os, subprocess, threading, tempfile, shutil, ast
from pathlib import Path
op = Path(__file__).resolve().parents[3] / 'ops/bin/local-model-ready'
class Handler(http.server.BaseHTTPRequestHandler):
    aliases = ['local-coder']
    def log_message(self, *args): pass
    def do_GET(self):
        self.send_response(200); self.end_headers()
        self.wfile.write(json.dumps({'data':[{'id':a} for a in self.aliases]}).encode())
server = http.server.ThreadingHTTPServer(('127.0.0.1',0),Handler)
threading.Thread(target=server.serve_forever,daemon=True).start()
try:
    env = {'PATH':os.environ['PATH'], 'LOCAL_CODER_HEALTH_URL':f'http://127.0.0.1:{server.server_port}/v1/models'}
    for aliases, requested, expected in [(['local-coder'],'local-reasoner',1),(['local-reasoner'],'local-reasoner',0),(['local-reasoner'],'local-coder',1),(['local-coder'],'local-coder',0)]:
        Handler.aliases=aliases
        r=subprocess.run([str(op),requested],env=env,capture_output=True,text=True)
        assert r.returncode==expected,(aliases,requested,r.stdout)
        assert json.loads(r.stdout)['model']==requested
    with scratch_dir() as raw:
        root=Path(raw); target=root/'code_root/ops/bin/local-model-ready';target.parent.mkdir(parents=True)
        shutil.copy2(op,target)
        gateway=root/'modelgateway';gateway.mkdir()
        (gateway/'models.json').write_text(json.dumps({'deployments':[{'models':['local-reasoner'],'endpoint':f'http://127.0.0.1:{server.server_port}/v1'}]}))
        Handler.aliases=['local-reasoner']
        r=subprocess.run([str(target),'local-reasoner'],env={'PATH':os.environ['PATH']},capture_output=True,text=True)
        assert r.returncode==0,r.stdout+r.stderr
        # Exercise the dispatcher's real alias selector and readiness adapter.
        source=ast.parse((op.parent/'tick').read_text())
        functions=[n for n in source.body if isinstance(n,ast.FunctionDef) and n.name in {'local_model','local_model_ready'}]
        spec=root/'code_root/specs/fixture.yaml';spec.parent.mkdir();spec.write_text('model: local-reasoner\n')
        namespace={'CODE_ROOT':root/'code_root','HERE':target.parent,'subprocess':subprocess,'spec_value':lambda text,key:text.split(':',1)[1].strip()}
        exec(compile(ast.Module(body=functions,type_ignores=[]),'tick','exec'),namespace)
        assert namespace['local_model']({'spec':'specs/fixture.yaml'})=='local-reasoner'
        assert namespace['local_model_ready']('local-reasoner')
finally:
    server.shutdown();server.server_close()
print('PASS: DGX model readiness is specific to the requested alias')
