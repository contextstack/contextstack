class Gateway(BaseHTTPRequestHandler):
    def do_POST(self):
        gateway_calls.append((self.path, json.loads(self.rfile.read(int(self.headers["Content-Length"])))))
        data = json.dumps(model).encode()
        self.send_response(200)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, *args):
        pass


def start_peer(stack, stream, handler):
    thread = Thread(target=handler, args=(stream,), daemon=True)
    thread.start()
    stack.callback(thread.join)


class FixtureSocket:
    """Route a named connect to its fixture over an anonymous Unix socket pair."""
    def __init__(self, stack, handlers, family, kind):
        assert (family, kind) == (socket.AF_UNIX, socket.SOCK_STREAM)
        self.stream, self.peer = socket.socketpair()
        stack.callback(self.peer.close)
        stack.callback(self.stream.close)
        self.stack, self.handlers = stack, handlers

    def __getattr__(self, name):
        return getattr(self.stream, name)

    def __enter__(self):
        return self

    def __exit__(self, *args):
        self.stream.close()

    def connect(self, path):
        handler = self.handlers.get(Path(path))
        if handler is None:
            raise FileNotFoundError(path)
        start_peer(self.stack, self.peer, handler)


def native_host(stream):
    with stream, stream.makefile("rb") as request:
        browser_calls.append(json.loads(request.readline()))
        stream.sendall(json.dumps(page).encode() + b"\n")


def gateway(stream):
    with stream:
        Gateway(stream, None, None)


with tempfile.TemporaryDirectory(prefix=".tasks-test-") as temp, ExitStack() as stack:
    root = Path(temp)
    state, config, vault = (root / name for name in ("state", "config", "vault"))
    for directory in (state, config, vault):
        directory.mkdir()
    home = root / ".contextstack"
    handlers = {
        home / "browser/native-sockets/google-tasks.sock": native_host,
        home / "gateway/csgateway.sock": gateway,
    }
    # Keep the global socket module intact so socketpair can create real sockets.
    class SocketModule:
        AF_UNIX = socket.AF_UNIX
        SOCK_STREAM = socket.SOCK_STREAM

        @staticmethod
        def socket(family, kind):
            return FixtureSocket(stack, handlers, family, kind)

    stack.enter_context(patch.object(reader, "socket", SocketModule))
    env = dict(hermetic_env(), HOME=str(root), CS_CONFIG_ROOT=str(config))
    env.pop("CSGATEWAY_AUTH_TOKEN", None)
    stack.enter_context(patch.dict(os.environ, env, clear=True))
    row = {"id": "google-tasks", **json.loads((CS / "ops/bin/schedule-enable.json").read_text())[
        "templates"]["google-tasks"], "timezone": "UTC", "node": "fixture", "enabled": True}
    schedules = state / "schedules.jsonl"
    schedules.write_text(json.dumps(row) + "\n")
    (config / "delivery.json").write_text(json.dumps({
        "file_root": str(vault.resolve()), "schedules": {"google-tasks": [{"file": "Tasks.md"}]},
    }))
    tick = runpy.run_path(str(CS / "ops/bin/schedule-tick"))
    # Exercise the real scheduler branches with the estate grant check stubbed.
    stack.enter_context(patch.dict(tick["main"].__globals__, {"schedule_error": lambda row: ""}))

    def fire(day, **extra):
        args = {"now": f"2026-11-{day}T08:00:00+00:00", "scan_stale": False, **extra}
        args.update({key: str(state / name) for key, name in {
            "schedules": "schedules.jsonl", "fires": "schedule-fires.jsonl",
            "dispatch": "dispatch.jsonl", "lock": "schedule.lock",
        }.items()})
        output = io.StringIO()
        with patch("sys.stdin", io.StringIO(json.dumps(args))), redirect_stdout(output):
            tick["main"]()
        return json.loads(output.getvalue() or "{}").get("admitted", [])

    assert fire(23, dry_run=True)[0]["job"] == "dry-run"
    assert not browser_calls and not gateway_calls
    success, = fire(23)
    assert "evidence" in success, (state / "dispatch.jsonl").read_text()
    assert json.loads((state / success["evidence"]).read_text()) == {"output": RESULT, "cost_usd": 0}
    report = (vault / "Tasks.md").read_text()
    assert "Buy milk" in report and "Cost: $0 (actual)" in report
    assert "Untrusted browser data" in report
    for data in (
        {"lists": [{"title": "x" * 513, "tasks": []}]},
        {"lists": [{"title": "Tasks", "tasks": [{"title": "x", "completed": False}] * 201}]},
        {"lists": [{"title": "Tasks", "tasks": [{"title": "x", "notes": "x" * 2049, "completed": False}]}]},
    ):
        try:
            reader.validate(data)
        except reader.ReadError:
            pass
        else:
            raise AssertionError("unbounded reader output was accepted")
    assert len(gateway_calls) == 1
    path, request = gateway_calls[0]
    assert path == "/v1/agent/model.call"
    assert request["tool_schema"] == [] and "tool_choice" not in request
    assert request["messages"][1:] == [{"role": "user", "content": TEXT}]
    assert request["messages"][0]["role"] == "system" and HOSTILE not in request["messages"][0]["content"]

    model["message"]["content"] = json.dumps({**RESULT, "actions": {"post": True},
                                               "origins": ["https://elsewhere.invalid"]})
    assert fire(24)[0]["error_kind"] == "reader_schema_invalid"
    model["message"]["content"] = json.dumps(RESULT)
    model["tool_calls"] = [{"name": "post", "args": {"url": "https://elsewhere.invalid"}}]
    assert fire(25)[0]["error_kind"] == "reader_schema_invalid"

    page = {"ok": False, "error_kind": "sign_in_required"}
    assert fire(26)[0]["kind"] == "needs_you"
    assert not fire(26)
    assert not fire(27)
    assert json.loads(schedules.read_text().splitlines()[-1])["hold"] == "browser:logged_out"
    attention, = map(json.loads, (state / "attention.jsonl").read_text().splitlines())
    assert attention["kind"] == "needs_you"
    assert attention["error_kind"] == "logged_out"
    assert len(gateway_calls) == 3
    assert browser_calls == [{"verb": "open", "url": reader.URL}] * 4
    assert (vault / "Tasks.md").read_text() == report
    assert list((state / "runs").rglob("*.*")) == [state / success["evidence"]]

    # Chrome starts once. The connection arrives during the startup wait.
    page = {"ok": True, "final_url": reader.URL, "text": TEXT}
    model.pop("tool_calls")
    native_path = home / "browser/native-sockets/google-tasks.sock"
    del handlers[native_path]
    clock = [0]

    def sleep(seconds):
        clock[0] += seconds
        handlers[native_path] = native_host

    with patch.object(reliability, "running_product", return_value=None), \
            patch.object(reliability, "launch_chrome", return_value=True) as launch, \
            patch.object(reliability.time, "monotonic", side_effect=lambda: clock[0]), \
            patch.object(reliability.time, "sleep", side_effect=sleep):
        restored, = fire(28, retry_failed=["google-tasks"])
    launch.assert_called_once_with()
    assert clock[0] > 0
    assert json.loads(schedules.read_text().splitlines()[-1])["enabled"]

    # Startup timeouts are retried once and share an attention item across slots.
    del handlers[native_path]

    def advance(seconds):
        clock[0] += seconds

    with patch.object(reliability, "running_product", return_value=None), \
            patch.object(reliability, "launch_chrome", return_value=True) as launch, \
            patch.object(reliability, "startup_wait", return_value=1), \
            patch.object(reliability.time, "monotonic", side_effect=lambda: clock[0]), \
            patch.object(reliability.time, "sleep", side_effect=advance) as delay:
        for day in (29, 30):
            failure, = fire(day)
            assert failure["error_kind"] == "chrome_not_running"
            assert failure["kind"] == "needs_you"
            assert json.loads(schedules.read_text().splitlines()[-1])["last_result"]["fix"] == failure["fix"]
            assert json.loads((state / "dispatch.jsonl").read_text().splitlines()[-1])["message"] == failure["message"]
        assert launch.call_count == 2
        assert delay.call_args_list.count(((1,), {})) == 2
    original, latest = map(json.loads, (state / "attention.jsonl").read_text().splitlines())
    assert original["id"] != latest["id"] and latest["error_kind"] == "chrome_not_running"
    assert "evidence" in restored

    handlers[native_path] = native_host
    page = {"ok": True, "final_url": reader.URL, "text": TEXT}
    assert "evidence" in fire(30, retry_failed=["google-tasks"])[0]
    page = {"ok": False, "error_kind": "sign_in_required"}
    assert fire(30, now="2026-12-01T08:00:00+00:00")[0]["error_kind"] == "logged_out"
    assert len((state / "attention.jsonl").read_text().splitlines()) == 3
    report_body, _ = schedule_report(state, {})
    schedule, = report_body["schedules"]
    assert schedule["definition"]["last_result"]["error_kind"] == "logged_out"
    assert report_body["firings"][-1]["detail"].startswith("logged_out.")

    for kind in (*reliability.ERRORS, "unexpected"):
        page = {"ok": False, "error_kind": kind, "error": HOSTILE}
        try:
            reader.page_text(native_path)
        except reliability.BrowserFailure as failure:
            assert failure.kind == (kind if kind in reliability.ERRORS else "unknown")
            assert failure.fix and HOSTILE not in str(failure)
        else:
            raise AssertionError(kind)

    attempts = []

    def transient_read():
        attempts.append("read")
        if len(attempts) == 1:
            raise reliability.BrowserFailure("page_timeout")
        return TEXT

    with patch.object(reliability.time, "sleep") as backoff:
        assert reliability.read_with_recovery(transient_read, root) == TEXT
    backoff.assert_called_once_with(1)
    assert len(attempts) == 2

    def missing_socket():
        raise ConnectionRefusedError

    for registered, kind in ((False, "native_host_unregistered"),
                             (True, "extension_missing_or_disabled")):
        with patch.object(reliability, "running_product", return_value="google-chrome"), \
                patch.object(reliability, "registered", return_value=registered), \
                patch.object(reliability, "startup_wait", return_value=0), \
                patch.object(reliability, "launch_chrome") as launch:
            try:
                reliability.read_with_recovery(missing_socket, root)
            except reliability.BrowserFailure as failure:
                assert failure.kind == kind
            else:
                raise AssertionError(kind)
        launch.assert_not_called()

    for platform, command in (
        ("darwin", ["/usr/bin/open", "-g", "-a", "Google Chrome"]),
        ("linux", ["/fake/chromium"]),
    ):
        with patch.object(reliability.sys, "platform", platform), \
                patch.object(reliability.shutil, "which", side_effect=[None, "/fake/chromium"]), \
                patch.object(reliability.subprocess, "Popen") as spawn:
            assert reliability.launch_chrome()
        assert spawn.call_args.args[0] == command

    with patch.object(reliability.sys, "platform", "linux"), patch.dict(os.environ, {"XDG_CONFIG_HOME": ""}):
        registration = root / ".config/google-chrome/NativeMessagingHosts"
        registration.mkdir(parents=True)
        executable = root / "browser-host"
        executable.touch(mode=0o700)
        browser_dir = home / "browser"
        browser_dir.mkdir(parents=True)
        (browser_dir / "native-host.json").write_text(json.dumps({"extension_id": reliability.EXTENSION_ID}))
        manifest = {"name": reliability.HOST_NAME, "type": "stdio", "path": str(executable.resolve()),
                    "allowed_origins": [f"chrome-extension://{reliability.EXTENSION_ID}/"]}
        manifest_path = registration / (reliability.HOST_NAME + ".json")
        manifest_path.write_text(json.dumps(manifest))
        status = browser_dir / "extension-status.json"
        status.write_text(json.dumps({"origins": ["https://tasks.google.com/*"]}))
        findings = reliability.doctor_findings(root, state, CS)
        assert all(row["ok"] for row in findings), findings
        assert "https://tasks.google.com" in findings[-1]["detail"]
        manifest_path.write_text(json.dumps(dict(manifest, allowed_origins=["chrome-extension://wrong/"])))
        status.write_text(json.dumps({"origins": ["https://other.example/*"]}))
        os.utime(status, (0, 0))
        findings = reliability.doctor_findings(root, state, CS)
        assert all(not row["ok"] and row["fix"] for row in findings), findings
        assert "missing: https://tasks.google.com" in findings[-1]["detail"]

    for path in root.rglob("*"):
        if path.is_file():
            assert HOSTILE.encode() not in path.read_bytes(), path

