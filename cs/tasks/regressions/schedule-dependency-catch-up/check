# Failed catch-up freezes the caught-up slot for the day: no second automatic
# admission, and a dependent stays dependency_not_ready on that required slot.
with scratch_dir(prefix="schedule-catchup-freeze-") as raw:
    root = Path(raw)
    write_jsonl(root / "schedules.jsonl", [
        {**schedule("upstream", 10), "catch_up_window_minutes": 1440},
        {**schedule("downstream", 12, requires=["upstream"]), "catch_up_window_minutes": 1440},
    ])
    # Catch-up fired the 10:00 slot late; it failed hard.
    write_jsonl(root / "fires.jsonl", [{
        "ts": "2026-09-02T15:58:00Z",
        "id": "upstream",
        "slot": "2026-09-02T10:00:00Z",
        "job": "catchup-failed",
        "lane": "shadow",
    }])
    write_jsonl(root / "dispatch.jsonl", [{
        "ts": "2026-09-02T16:00:00Z",
        "id": "catchup-failed",
        "schedule_id": "upstream",
        "schedule_slot": "2026-09-02T10:00:00Z",
        "state": "error",
        "verdict": "fail",
        "stop": "budget:turns",
    }])
    later = tick(root, "2026-09-02T16:30:00+00:00")
    assert later["admitted"] == []
    assert {"id": "upstream", "slot": "2026-09-02T10:00:00Z",
            "reason": "prior_attempt_failed"} in later["deferred"]
    blocked = [row for row in later["deferred"] if row.get("id") == "downstream"]
    assert blocked and blocked[0].get("reason") == "dependency_not_ready"
    assert blocked[0].get("dependency") == "upstream"
    # Still frozen an hour later without retry_failed.
    still = tick(root, "2026-09-02T17:30:00+00:00")
    assert still["admitted"] == []
    assert {"id": "upstream", "slot": "2026-09-02T10:00:00Z",
            "reason": "prior_attempt_failed"} in still["deferred"]

print("check: dependency waits and transport retries preserve schedule slots")
print("check: failed catch-up freezes the slot; dependents stay not ready")
