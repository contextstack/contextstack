    root = Path(raw)
    dispatch = root / "dispatch.jsonl"
    write_jsonl(dispatch, [{
        "ts": "2026-09-02T14:01:00Z",
        "id": "orphaned-job",
        "state": "running",
        "pid": 2147483647,
