with scratch_dir(prefix="schedule-dependency-") as raw:
    root = Path(raw)
    write_jsonl(root / "schedules.jsonl", [
        schedule("upstream", 14),
        schedule("downstream", 15, ["upstream"]),
    ])
    first = tick(root, "2026-09-02T15:00:00+00:00")
    assert [row["id"] for row in first["admitted"]] == ["upstream"]
    assert first["deferred"] == [{
        "id": "downstream",
        "slot": "2026-09-02T15:00:00Z",
        "reason": "dependency_not_ready",
        "dependency": "upstream",
        "required_slot": "2026-09-02T14:00:00Z",
    }]
    assert [json.loads(line)["id"] for line in (root / "fires.jsonl").read_text().splitlines()
            if json.loads(line).get("job")] == ["upstream"]

    write_jsonl(root / "dispatch.jsonl", [{
        "ts": "2026-09-02T15:01:00Z",
        "id": "dry-run",
        "state": "done",
        "schedule_id": "upstream",
