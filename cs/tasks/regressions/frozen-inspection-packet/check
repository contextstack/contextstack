#!/usr/bin/env python3
"""Promoted 09-09 audit reproduction; only temporary candidates are mutated."""
import json, shutil, subprocess, tempfile
from pathlib import Path
import sys

sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))  # frozen copies too
from scratch import scratch_dir
from hermetic_env import hermetic_env

CODE_ROOT = Path(__file__).resolve().parents[3]
def op(name, payload):
    r = subprocess.run([str(CODE_ROOT/'ops/bin'/name)], input=json.dumps(payload), text=True, capture_output=True, env={**hermetic_env()})
    assert not r.returncode, (name,r.stderr)
    return json.loads(r.stdout.splitlines()[-1])

# Unsafe archive members must not be advertised as ready by the publisher.
with scratch_dir(prefix='unsafe-packet-') as raw:
    root=Path(raw); task=root/'task'; task.mkdir(); run=root/'run'; ws=run/'workspace'; ws.mkdir(parents=True)
    (task/'goal.md').write_text('fixture\n'); (task/'check').write_text('#!/bin/sh\nexit 0\n')
    op('capture-stimulus',{'run_dir':str(run),'task':str(task),'workspace':str(ws),'adapter':'fixture'})
    (ws/'outside').symlink_to('/etc/passwd')
    published=op('publish-evidence',{'run_dir':str(run),'verdict':'pass','stop':'done','check_exit':0})
    assert not published['ready'] and published['capture_state']=='incomplete',published
    assert not (run/'ready_for_inspection').exists()
print('check: unsafe candidate archives refuse inspection readiness')
