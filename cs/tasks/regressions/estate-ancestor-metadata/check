#!/usr/bin/env python3
"""A run's tmp under ~/.contextstack resolves inside the agent profile (2026-11-12: Codex could not
canonicalize CODEX_HOME because the estate deny also denied metadata on the tmp's parents), while
the parents' contents stay unreadable. Host-only: --darwin-probe."""
import sys
from pathlib import Path
sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))
from scratch import scratch_dir

import os, subprocess, sys, tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
OPS = HERE.parents[2] / "ops/bin"
if "--darwin-probe" not in sys.argv or sys.platform != "darwin":
    print("estate-ancestor-metadata: SKIP (host-only; run with --darwin-probe on macOS)")
    raise SystemExit(0)
with scratch_dir(prefix="estate-ancestors-") as raw:
    home = Path(raw).resolve() / "home"
    run = home / ".contextstack/state/runs/r1"
    ws, tmp = run / "ws", run / "tmp"
    for d in (ws, tmp / "codex-home"):
        d.mkdir(parents=True)
    (home / ".contextstack/state/runs/other-run").mkdir()
    (home / ".contextstack/state/runs/other-run/secret").write_text("decoy")
    os.environ["HOME"] = str(home)
    sys.path.insert(0, str(OPS))
    import _lead_host
    _lead_host._SANDBOX_CMD_CACHE = None
    sandbox_cmd = _lead_host._load_sandbox_cmd()
    probe = tmp / "probe.py"
    probe.write_text(
        "import os, sys\n"
        "target = sys.argv[1]\n"
        "import ctypes\n"
        "libc = ctypes.CDLL('/usr/lib/libSystem.B.dylib', use_errno=True)\n"
        "libc.realpath.restype = ctypes.c_char_p\n"
        "buf = ctypes.create_string_buffer(4096)\n"
        "resolved = libc.realpath(target.encode(), buf)  # what Rust canonicalize (Codex) calls\n"
        "assert resolved, 'realpath(3) failed: errno %d' % ctypes.get_errno()\n"
        "assert resolved.decode() == target, resolved\n"
        "os.stat(target)\n"
        "for secret in sys.argv[2:]:\n"
        "    try:\n"
        "        open(secret).read()\n"
        "    except PermissionError:\n"
        "        continue\n"
        "    raise SystemExit('estate content readable: ' + secret)\n"
        "try:\n"
        "    os.listdir(os.path.dirname(os.path.dirname(target)))\n"
        "except PermissionError:\n"
        "    pass\n"
        "else:\n"
        "    raise SystemExit('estate parent listable')\n"
        "print('ok')\n")
    cmd = sandbox_cmd(sys.executable, [str(probe), str(tmp / "codex-home"),
                                       str(home / ".contextstack/state/runs/other-run/secret")],
                      ws, tmp, tmp / "p.sb")
    done = subprocess.run(cmd, cwd=ws, capture_output=True, text=True, timeout=60,
                          env={"PATH": "/usr/bin:/bin", "HOME": str(home)})
    assert done.returncode == 0 and done.stdout.strip() == "ok", (done.returncode, done.stdout, done.stderr)
print("estate-ancestor-metadata: PASS (run tmp resolves; sibling runs and parent listings stay denied)")
