#!/usr/bin/env python3
"""check-git-env regression (goal.md): scripts/check never lets a rule inherit the caller's GIT_*.

Runs scripts/check's rule 9 alone (LAB_SPILL_ONLY=1) against a fixture dest whose .lab-out is tracked, with GIT_DIR,
GIT_INDEX_FILE and GIT_WORK_TREE pointed at a throwaway bare repo and index under a temp dir (never the real
repository). The rule must find the dest's spill (its git ran against the dest), and the throwaway repo must be
byte for byte unchanged. Without the scrub, git reads the throwaway's empty index and the spill is missed."""
import sys
from pathlib import Path
sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))  # frozen copies too
from hermetic_env import hermetic_env

import hashlib
import os
import shutil
import subprocess
import tempfile

LAB = Path(__file__).resolve().parents[3]
CLEAN = {k: v for k, v in hermetic_env().items() if not k.startswith("GIT_")}
problems = []


def expect(cond, msg):
    print(("ok   " if cond else "FAIL ") + msg)
    if not cond:
        problems.append(msg)


def git(*args, cwd):
    return subprocess.run(["git", *args], cwd=str(cwd), env=CLEAN, capture_output=True, text=True, check=True).stdout


def snapshot(root):
    """Every file under the throwaway repo with its sha256: config, refs, objects, index, hooks."""
    return {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()
            for p in sorted(root.rglob("*")) if p.is_file()}


def main():
    tmp = Path(tempfile.mkdtemp(prefix="check-git-env-", suffix=".noindex"))
    try:
        dest = tmp / "dest"
        dest.mkdir()
        git("init", "-q", cwd=dest)
        (dest / ".lab-out").write_text("spill\n")
        git("add", ".lab-out", cwd=dest)
        git("-c", "user.name=t", "-c", "user.email=t@t", "commit", "-qm", "spill", cwd=dest)
        decoy = tmp / "decoy.git"  # what a hook's GIT_DIR would point at; a throwaway, never the real repo
        git("init", "-q", "--bare", str(decoy), cwd=tmp)
        index = decoy / "index"
        index.write_bytes(b"")
        subprocess.run(["git", "read-tree", "--empty"], env=dict(CLEAN, GIT_DIR=str(decoy), GIT_INDEX_FILE=str(index)),
                       check=True)
        before = snapshot(decoy)
        env = dict(CLEAN, GIT_DIR=str(decoy), GIT_INDEX_FILE=str(index), GIT_WORK_TREE=str(tmp),
                   GIT_PREFIX="lab/", LAB_SPILL_ONLY="1", LAB_SPILL_DESTS=str(dest),
                   LAB_SPILL_RUNS_ROOT=str(tmp / "no-runs"), LAB_SPILL_PRUNE="2026-01-01T00:00:00")
        r = subprocess.run(["bash", str(LAB / "scripts/check")], cwd=str(LAB), env=env, capture_output=True, text=True,
                           timeout=120)
        out = r.stdout + r.stderr
        expect(".lab-* tracked in dest %s" % dest in out and r.returncode == 1,
               "with a hook's GIT_DIR/GIT_INDEX_FILE/GIT_WORK_TREE set, rule 9 still reads the fixture dest and finds "
               "its tracked .lab-out (exit %s): %s" % (r.returncode, out.strip().splitlines()[-1:] or out))
        expect(snapshot(decoy) == before, "the repository GIT_DIR named is untouched (config, refs, objects, index)")
        expect(not any(ln.startswith(".lab-* is tracked") for ln in out.splitlines()),
               "lab itself is judged by its own repository, not the decoy")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    print("check: check-git-env %d problem(s)" % len(problems))
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
