#!/usr/bin/env python3
import json
import shutil
import subprocess
import tempfile
from pathlib import Path
import sys
sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))  # frozen copies too
from scratch import scratch_dir
from hermetic_env import hermetic_env

CODE_ROOT = Path(__file__).resolve().parents[3]


def run_tick(root, ready):
    ops = root / "ops/bin"
    ops.mkdir(parents=True, exist_ok=True)
    for name in ("schedule-tick", "_grant.py", "_estate_io.py", "_void.py"):
        shutil.copy2(CODE_ROOT / "ops/bin" / name, ops / name)
    (root / "ESTATE").write_text("dev\n")
    (root / "grants").mkdir(exist_ok=True)
    (root / "grants/fixture.yaml").write_text(
        f'id: fixture\nestate: dev\nrepo: {root / "corpus"}\n'
        'paths: [tasks, specs]\ngates: ["true"]\ncommit: true\n'
        'status: active\nexpiry: 2999-01-01T00:00:00Z\n')
    schedules = root / "schedules.jsonl"
    fires = root / "fires.jsonl"
    lock = root / "schedule.lock"
    row = {
        "id": "outage-fixture",
        "enabled": True, "grant": "fixture",
        "cron": "0 12 * * *",
        "timezone": "UTC",
        "catch_up_window_minutes": 60,
        "task": "tasks/sweeps/outage-fixture",
        "spec": "specs/sweeps/outage-fixture.yaml",
        "root": str(root / "corpus"),
        "lane": "shadow",
    }
    schedules.write_text(json.dumps(row) + "\n", encoding="utf-8")
    payload = {
        "now": "2026-09-02T12:00:00+00:00",
        "schedules": str(schedules),
        "fires": str(fires),
        "lock": str(lock),
        "scan_stale": False,
        "dry_run": True,
        "local_model_ready": ready,
    }
    result = subprocess.run(
        [str(ops / "schedule-tick")],
        input=json.dumps(payload), text=True, capture_output=True, cwd=CODE_ROOT,
     env={**hermetic_env()})
    assert result.returncode == 0, result.stderr
    receipt = json.loads(result.stdout)
    return fires, receipt


with scratch_dir() as raw:
    root = Path(raw)
    fires, receipt = run_tick(root, False)
    assert receipt["admitted"] == []
    assert receipt["deferred"] == [{
        "id": "outage-fixture",
        "reason": "local_coder_unavailable",
        "slot": "2026-09-02T12:00:00Z",
    }]
    deferred_rows = [json.loads(line) for line in fires.read_text(encoding="utf-8").splitlines() if line.strip()]
    assert deferred_rows and deferred_rows[0].get("event") == "schedule_deferred"
    assert deferred_rows[0]["reason"] == "local_coder_unavailable"

    fires, receipt = run_tick(root, True)
    assert len(receipt["admitted"]) == 1
    admitted = [json.loads(line) for line in fires.read_text(encoding="utf-8").splitlines()
                if json.loads(line).get("job")]
    assert admitted[-1]["slot"] == "2026-09-02T12:00:00Z"

tick_source = (CODE_ROOT / "ops/bin/tick").read_text(encoding="utf-8")
gate = tick_source.index("local_coder_unavailable")
running = tick_source.index('"state": "running"')
assert gate < running, "pending local-coder jobs are marked running before the health gate"

print("check: local-coder outages defer without consuming schedule slots")
