DECOYS = (
    ".zsh_history",
    ".bash_history",
    ".git-credentials",
    ".gitconfig",
    ".npmrc",
    ".pypirc",
    ".docker/config.json",
    ".kube/config",
    ".aws/credentials",
    ".ssh/id_ed25519",
