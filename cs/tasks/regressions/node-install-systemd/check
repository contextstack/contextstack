def fail(msg):
    problems.append(msg)
    print("FAIL " + msg)


def expect(cond, msg):
    (print("ok   " + msg) if cond else fail(msg))


def load_mod(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    loader.exec_module(mod)
    return mod


def spawn_env(home, path, **more):
    env = {**hermetic_env()}
    env["HOME"] = str(home)
    env.pop("CS_STATE_ROOT", None)
    env.pop("CSGATEWAY_ENDPOINT", None)
    env["PATH"] = path
    env["NODE_INSTALL_USER_PATH"] = "%s/.local/bin:/usr/bin:/bin" % home
    env.update(more)
    return env


# Record the synthetic token at the storage boundary, while still passing it
# through real release activation.
TOKEN_RUNNER = """
import runpy
import sys
from pathlib import Path

sys.argv = sys.argv[1:]
sys.path.insert(0, str(Path(sys.argv[0]).parent))
import _node_layout

def record_token(name, token):
    assert name == "CONTEXTSTACK_NODE_TOKEN" and token == expected_token
    return True

expected_token = sys.argv.pop()
_node_layout.write_node_token = record_token
runpy.run_path(sys.argv[0], run_name="__main__")
"""


def run_nr(home, path, *args, **more):
    env = spawn_env(home, path, **more)
    r = subprocess.run([sys.executable, "-I", "-c", TOKEN_RUNNER, str(RELEASE), *args, TOKEN],
                       capture_output=True, text=True, env=env, cwd="/")
    try:
        out = json.loads(r.stdout)
    except ValueError:
        out = {"unparsed": (r.stdout or "")[-2000:], "stderr": (r.stderr or "")[-2000:]}
    return r, out


