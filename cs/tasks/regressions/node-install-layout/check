    root = home / ".contextstack"
    existing = {"gateway/providers.d/dgx.json": '{"schema": "csgateway.providers.v1", "providers": []}',
                "gateway/discovery-health.json": "{}", "gateway/csgateway.err.log": "old log\n",
                "code_root/setups/s1/marker": "setup\n", "browser/browser-state/x": "b\n", "director/estate/ledger.jsonl": "{}\n",
                "credentials/openai": "not-a-real-key\n", "state/ledger.jsonl": '{"estate": "dev"}\n',
                "state/runs/r1/terminal.json": "{}\n", "estate-deploy/cache": "c\n"}
    for rel, text in existing.items():
        (root / rel).parent.mkdir(parents=True, exist_ok=True)
        (root / rel).write_text(text)
    (root / "credentials").chmod(0o700)
    (root / "credentials/openai").chmod(0o600)
    (root / "state").chmod(0o755)
    agents = home / "Library/LaunchAgents"
    agents.mkdir(parents=True)
    dev_plist = plistlib.dumps({"Label": "com.contextstack.csgateway-socket",
                                "ProgramArguments": [str(tmp / "checkout/modelgateway/csgateway")]})
    (agents / "com.contextstack.csgateway-socket.plist").write_bytes(dev_plist)
    _bundle.seed_python(home, A, managed)

    def outside_releases():
        return {k: v for k, v in tree(root).items() if not k.startswith("releases")}
    before = outside_releases()
    r, rep = node_install(home, "install", str(tmp / "bundle-a"), "--estate", "workstation", "--no-load")
    expect(r.returncode == 1 and "com.contextstack.csgateway-socket.plist" in rep.get("refused", "") and "--adopt" in rep.get("refused", ""),
           "director host: the checkout's gateway plist is refused, named: %s" % rep.get("refused"))
    expect(outside_releases() == before and (agents / "com.contextstack.csgateway-socket.plist").read_bytes() == dev_plist,
           "the refusal changed nothing outside releases/ and left the plist")
    r, rep = node_install(home, "install", str(tmp / "bundle-a"), "--estate", "workstation", "--adopt",
                          "com.contextstack.csgateway-socket", "--no-load")
    after = tree(root)
    expect(r.returncode == 0 and rep.get("node") is False and not (agents / "com.contextstack.node.plist").exists()
           and (root / "config/ESTATE").read_text() == "workstation\n", "director host: --estate workstation, no receiver, no node plist")
    kept = list((root / "config/replaced-agents").glob("com.contextstack.csgateway-socket.plist.*"))
    expect(len(kept) == 1 and kept[0].read_bytes() == dev_plist
           and str(root / "current/bin/cs-gateway") in (agents / "com.contextstack.csgateway-socket.plist").read_text(),
           "--adopt kept the original in config/replaced-agents/ and wrote ours")
    genv = plistlib.loads((agents / "com.contextstack.csgateway-socket.plist").read_bytes())["EnvironmentVariables"]
    expect(genv.get("CSGATEWAY_CREDENTIALS") == str(root / "credentials") and rep.get("credentials") == "file",
           "director host: the file store, CSGATEWAY_CREDENTIALS=%s set explicitly (no Keychain, the owner 2026-11-10)"
           % (root / "credentials"))
    changed = []
    for k, v in before.items():
        got = after.get(k)
        if got == v or k == "state":
            continue
        if (root / k).is_dir() and isinstance(got, tuple) and got[2] == v[2]:
            continue  # a dir may gain entries; its mode stays
        changed.append(k)
    expect(not changed and stat.S_IMODE((root / "state").stat().st_mode) == 0o700,
           "existing files and other directory modes are preserved, and the state root is repaired: %s" % changed)
    expect(not (root / "state/runs").is_symlink()
           and (root / "state/runs/r1/terminal.json").read_text() == "{}\n",
           "existing state/runs is left in place (a real directory)")
    expect((root / "config/gateway/providers.d/dgx.json").read_text() == existing["gateway/providers.d/dgx.json"]
           and (root / "gateway/providers.d/dgx.json").is_file(), "providers.d copied into config/gateway, the original kept")
    node_install(home, "uninstall", "--no-load")
    expect(all((root / rel).read_text() == text for rel, text in existing.items()), "uninstall leaves all of it")


def part_laravel_retired(tmp, uv, managed):
    """The Laravel director's serving mode is retired (2026-11-11): --serve-director is no longer an option; a record
    that still names serve_director refuses every activation with the fix (boot out its agents, drop the keys) and
    changes nothing; --purge still refuses while its director.env (APP_KEY) exists unless --purge-secrets, and
    ROOT/director/ always stays."""
    _bundle.bundle(tmp / "bundle-c", uv, C, _bundle.fake_bins(tmp / "fakebin-c"))
    home = tmp / "home-serve"
    root = home / ".contextstack"
    agents = home / "Library/LaunchAgents"
    _bundle.seed_python(home, A, managed)
    _bundle.seed_python(home, C, managed)
    r, rep = node_install(home, "install", str(tmp / "bundle-a"), "--estate", "workstation", "--serve-director", "127.0.0.1:18790",
                          "--no-load")
    expect(r.returncode == 1 and "retired" in rep.get("refused", "") and "--serve-director-rs" in rep.get("refused", "")
           and not os.path.lexists(root / "current"),
           "--serve-director is retired: refused, naming --serve-director-rs, nothing activated: %s" % rep.get("refused"))
    r, rep = node_install(home, "install", str(tmp / "bundle-a"), "--estate", "workstation", "--serve-director", "--no-load")
    expect(r.returncode == 1 and "retired" in rep.get("refused", "") and not os.path.lexists(root / "current"),
           "a bare --serve-director never abbreviates to --serve-director-rs: %s" % rep.get("refused"))
    r, rep = node_install(home, "install", str(tmp / "bundle-a"), "--estate", "workstation", "--no-load")
    if r.returncode != 0:
        return fail("install --estate workstation: %s %s" % (rep, r.stderr[-400:]))
    record = root / "config/install.json"
    rec = json.loads(record.read_text())
    rec.update({"serve_director": "127.0.0.1:18790", "php": "/usr/bin/php"})
    record.write_text(json.dumps(rec))
    before = os.readlink(root / "current")
    r, rep = node_install(home, "install", str(tmp / "bundle-c"), "--no-load")
    why = rep.get("refused", "")
    expect(r.returncode == 1 and "serve_director" in why and "launchctl bootout" in why
           and "com.contextstack.director-queue" in why and str(record) in why
           and os.readlink(root / "current") == before and not (agents / "com.contextstack.director.plist").exists(),
           "a recorded serve_director refuses the next activation with the fix; current and agents unchanged: %s" % why)
    for k in ("serve_director", "php"):
        rec.pop(k)
    record.write_text(json.dumps(rec))
    r, rep = node_install(home, "install", str(tmp / "bundle-c"), "--no-load")
    expect(r.returncode == 0 and rep.get("release") == C, "with the keys removed, activation proceeds: %s" % rep.get("refused"))
    envf = root / "config/director/director.env"
    envf.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    envf.write_text("APP_KEY=base64:%s=\n" % ("k" * 43))
    (root / "director").mkdir(mode=0o700, exist_ok=True)
    (root / "director/database.sqlite").write_text("db")
    r, rep = node_install(home, "uninstall", "--purge", "--no-load")
    expect(r.returncode == 1 and "--purge-secrets" in rep.get("refused", "") and "APP_KEY" in rep.get("refused", "")
           and envf.is_file() and os.path.lexists(root / "current"),
           "--purge refuses while director.env exists, names --purge-secrets, removes nothing: %s" % rep.get("refused"))
    r, rep = node_install(home, "uninstall", "--purge", "--purge-secrets", "--no-load")
    expect(r.returncode == 0 and not (root / "config").exists() and (root / "director/database.sqlite").read_text() == "db",
           "--purge --purge-secrets removes config/; ROOT/director/ (the old database) stays")


