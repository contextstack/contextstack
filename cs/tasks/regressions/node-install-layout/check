def part_path_profiles(tmp):
    sys.path.insert(0, str(CODE_ROOT / "scripts"))
    import importlib.machinery
    import importlib.util
    env_home = os.environ.get("HOME")
    os.environ["HOME"], os.environ["NODE_INSTALL_USER_PATH"] = str(tmp / "probe-home"), "/usr/bin:/bin"
    try:
        loader = importlib.machinery.SourceFileLoader("node_release", str(CODE_ROOT / "scripts/_node_layout.py"))
        mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("node_release", loader))
        loader.exec_module(mod)  # HOME is read at import: the probe home, never the real one
        import io
        from unittest.mock import patch
        local = tmp / "probe-home/.local/bin"
        expect(mod.pick_link_dir(None, None) == local, "clean PATH always chooses user bin without Homebrew")
        profile = mod.HOME / ".zprofile"
        profile.parent.mkdir(parents=True, exist_ok=True)
        profile.write_text("# existing settings\n")
        class Terminal(io.StringIO):
            def isatty(self):
                return True
        with patch.dict(os.environ, SHELL="/bin/zsh"), patch.object(sys, "stdin", Terminal("\n")), \
                patch.object(sys, "stderr", io.StringIO()) as output:
            mod.setup_path(local)
            expect("Add ~/.local/bin to your PATH in ~/.zprofile? [Y/n]" in output.getvalue(), "TTY asks before editing")
        mod.setup_path(local)
        expect(profile.read_text().count(mod.PATH_MARKER) == 1, "second install does not duplicate PATH line")
        mod.remove_path()
        expect(profile.read_text() == "# existing settings\n", "uninstall removes only marked PATH line")
        for shell, profile in zip(("zsh", "bash", "fish"), mod.shell_profiles()):
            before = profile.read_text() if profile.exists() else None
            with patch.dict(os.environ, SHELL="/bin/" + shell), patch.object(sys, "stdin", Terminal("\n")), \
                    patch.object(sys, "stderr", io.StringIO()) as output:
                mod.setup_path(local, yes=True)
                expect(mod.PATH_MARKER in output.getvalue(), "--yes prints exact %s PATH line" % shell)
                expect((profile.read_text() if profile.exists() else None) == before, "--yes leaves %s profile alone" % shell)
            with patch.dict(os.environ, SHELL="/bin/" + shell), patch.object(sys, "stdin", io.StringIO("")), \
                    patch.object(sys, "stderr", io.StringIO()) as output:
                mod.setup_path(local)
                expect(mod.PATH_MARKER in output.getvalue(), "no TTY prints %s PATH line" % shell)
    finally:
        os.environ["HOME"] = env_home
        os.environ.pop("NODE_INSTALL_USER_PATH", None)



def part_churn(tmp, uv, managed):
    """Bundle retention and migration of an existing bundles/ and state/runs/."""
    home = tmp / "home-churn"
    root = home / ".contextstack"
    bundles = root / "bundles"
    bundles.mkdir(parents=True)
    live = bundles / "live"
    clone_tree(tmp / "bundle-a", live)
    os.utime(live, (1000, 1000))

    def fake(name, rid, mtime):
        d = bundles / name
        d.mkdir()
        (d / "bundle.json").write_text(json.dumps({"release": rid}) + "\n")
        (d / "marker").write_text(name)
        os.utime(d, (mtime, mtime))

    fake("also-a", A, 1500)  # another bundle the kept release came from; older than the newest three
    fake("drop", "20990108-dropdropd", 2000)
    fake("mid", "20990104-mmmmmmmmm", 3000)
    fake("new1", "20990105-nnnnnnnnn", 4000)
    fake("new2", "20990106-ooooooooo", 5000)
    notes = bundles / "notes"
    notes.mkdir()
    (notes / "readme").write_text("leave me")
    trick = bundles / "trick"
    trick.mkdir()
    (trick / "data").write_text("safe")
    os.symlink("data", trick / "bundle.json")  # not a regular bundle.json: never a bundle
    os.utime(trick, (500, 500))
    outside = tmp / "outside-bundle"
    outside.mkdir()
    (outside / "bundle.json").write_text("{}\n")
    (outside / "precious").write_text("keep")
    os.symlink(os.path.relpath(outside, bundles), bundles / "escape")
    os.symlink("drop", bundles / "alias-drop")
    (root / "state/runs/old").mkdir(parents=True)
    (root / "state/runs/old/row.json").write_text("row\n")
    _bundle.seed_python(home, A, managed)
    r, rep = node_install(home, "install", str(live), "--node", "test-node", "--director", "http://127.0.0.1:9", "--no-load")
    if r.returncode != 0:
        return fail("churn install: exit %s %s\n%s" % (r.returncode, rep, r.stderr[-2000:]))
    real = root / "bundles.noindex"
    dirs = sorted(e.name for e in os.scandir(real) if not e.is_symlink() and e.is_dir(follow_symlinks=False))
    links = sorted(e.name for e in os.scandir(real) if e.is_symlink())
    expect(os.readlink(root / "bundles") == "bundles.noindex" and not (root / "state/runs").is_symlink(),
           "existing bundles/ became a symlink to bundles.noindex; state/runs stays a real directory")
    expect((root / "state/runs/old/row.json").read_text() == "row\n" and not (root / "state/runs.noindex").exists(),
           "run data is left in place")
    expect(dirs == ["also-a", "live", "mid", "new1", "new2", "notes", "trick"] and links == ["alias-drop", "escape"]
           and rep.get("pruned_bundles") == ["drop"],
           "retention keeps 3 newest plus the installed release's bundles, drops only drop: dirs %s links %s pruned %s"
           % (dirs, links, rep.get("pruned_bundles")))
    expect((root / "bundles/notes/readme").read_text() == "leave me" and (root / "bundles/trick/data").read_text() == "safe"
           and (outside / "precious").read_text() == "keep" and (real / "live/bundle.json").is_file(),
           "a non-bundle, a symlink bundle.json, and a symlink out of bundles/ are never deleted")
    probe = r"""
import json, os, sys
from pathlib import Path
home = Path(sys.argv[2])
if Path(os.environ["HOME"]) != home or "home-churn" not in home.parts:
    sys.exit("refusing to prune outside the regression home")
sys.path.insert(0, sys.argv[1])
import _node_layout as layout
root = home / ".contextstack" / "bundles.noindex"
decoy = root / "path-only"
decoy.mkdir()
(decoy / "bundle.json").write_text(json.dumps({"release": "not-kept"}) + "\n")
os.utime(decoy, (10, 10))
victim = root / "path-victim"
victim.mkdir()
(victim / "bundle.json").write_text(json.dumps({"release": "also-not-kept"}) + "\n")
os.utime(victim, (20, 20))
removed = layout.prune_bundles(str(decoy))
sys.stdout.write(json.dumps({"removed": removed, "decoy": decoy.is_dir(), "victim": victim.exists(),
                             "live": (root / "live").is_dir()}))
"""
    env = _bundle.dead_network_env(home)
    for key in ("CS_STATE_ROOT", "CS_CONFIG_ROOT", "CS_WORKSPACES_ROOT"):
        env.pop(key, None)
    r = subprocess.run([sys.executable, "-I", "-c", probe, str(CODE_ROOT / "scripts"), str(home)],
                       capture_output=True, text=True, env=env, cwd=str(CODE_ROOT.parent))
    try:
        got = json.loads(r.stdout)
    except ValueError:
        got = {}
    expect(r.returncode == 0 and got.get("decoy") is True and got.get("victim") is False and got.get("live") is True
           and got.get("removed") == ["path-victim"],
           "the bundle just installed is kept even when its release id is not a kept one: %s %s"
           % (got, r.stderr[-500:]))


def main():
    with scratch_dir(prefix="path-profiles-") as directory:
        part_path_profiles(Path(directory))
    if problems:
        return 1
    uv, managed = _bundle.host_python()
    if uv is None:
        print("SKIP node-install-layout: %s" % managed)
        return 0
    real = Path.home()
    watched = [real / ".local/bin", real / "Library/LaunchAgents"]
    before = [_bundle.directory_snapshot(w) for w in watched]
    host_py = {str(p): p.stat().st_mtime_ns for p in managed.rglob("*") if p.is_file() and not p.is_symlink()}
    agents = _bundle.real_agents()
    tmp = Path(tempfile.mkdtemp(prefix="node-install-layout-", suffix=".noindex"))
    try:
        part_layout(tmp, uv, managed)
        part_churn(tmp, uv, managed)
        part_kit_root_compat(tmp, uv)
        part_foreign(tmp, uv, managed)
        part_director_host(tmp, uv, managed)
        part_estate_rename(tmp, uv, managed)
        part_laravel_retired(tmp, uv, managed)
        part_link_dir(tmp, uv, managed)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    after = [_bundle.directory_snapshot(w) for w in watched]
    expect(before == after, "the real ~/.local/bin and ~/Library/LaunchAgents are unchanged")
    leak = _bundle.launchd_untouched(agents)
    expect(not leak, leak or "the real launchd domain gained no com.contextstack.* job and restarted none")
    touched = [k for k, v in host_py.items() if not os.path.exists(k) or os.stat(k).st_mtime_ns != v]
    expect(not touched, "the host's uv-managed interpreter is unchanged (seeded copies are independent): %s" % touched[:3])
    print("check: node-install-layout %d problem(s)" % len(problems))
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
