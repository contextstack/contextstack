def fail(msg):
    problems.append(msg)
    print("FAIL " + msg)


def ok(msg):
    print("ok   " + msg)


def expect(cond, msg, detail=""):
    (ok if cond else fail)(msg if cond or not detail else "%s: %s" % (msg, detail))


def node_install(home, *args, path_probe=None):
    env = _bundle.dead_network_env(home, NODE_INSTALL_USER_PATH=path_probe if path_probe is not None
                                   else "%s/.local/bin:/usr/bin:/bin" % home)
    r = subprocess.run(["sh", str(INSTALL), *args], capture_output=True, text=True, env=env,
                       cwd=str(CODE_ROOT.parent), umask=0o022)
    return r, _bundle.report(r.stdout)


def tree(root):
    """Every path under root with its link target or size and mtime (idempotence compares it)."""
    out = {}
    for p in sorted(root.rglob("*")):
        st = p.lstat()
        out[str(p.relative_to(root))] = os.readlink(p) if p.is_symlink() else (st.st_size, st.st_mtime_ns, st.st_mode)
    return out


def check_plists(home, root, runner="cs-harness", gateway="cs-gateway", credentials="off", kit="cs"):
    agents = home / "Library/LaunchAgents"
    gw = plistlib.loads((agents / "com.contextstack.csgateway-socket.plist").read_bytes())
    node = plistlib.loads((agents / "com.contextstack.node.plist").read_bytes())
    links = home / ".local/bin"
    for name, p in (("gateway", gw), ("node", node)):
        text = json.dumps(p)
        paths = p["ProgramArguments"][:1] + [p["WorkingDirectory"], p["StandardOutPath"], p["StandardErrorPath"]]
        expect(all(x.startswith("/") for x in paths) and "~" not in text and "$HOME" not in text,
               "%s plist: absolute paths only" % name)
        expect(str(links) + "/" not in text.replace(str(links) + ":", ""), "%s plist never names a PATH link" % name)
        expect(p["EnvironmentVariables"].get("PATH", "").startswith("/"), "%s plist sets an explicit PATH" % name)
    expect(gw["ProgramArguments"] == [str(root / "current/bin" / gateway)] and gw["KeepAlive"] is True,
           "gateway plist runs %s from current/bin, KeepAlive" % gateway)
    genv = gw["EnvironmentVariables"]
    expect(genv.get("CSGATEWAY_PROVIDERS_DIR") == str(root / "config/gateway/providers.d")
           and genv.get("CSAGENT_MODELS_CONFIG") == str(root / "gateway/models.json")
           and genv.get("CSGATEWAY_SOCKET") == "default"
           and genv.get("CS_STATE_ROOT") == str(root / "state") and genv.get("PATH", "").startswith(str(root / "current" / kit / ".venv/bin") + ":"),
           "gateway plist: providers.d under config, derived models.json, the state root, the release's python3 first")
    models = json.loads((root / "gateway/models.json").read_text())
    expect(models.get("cli_executor") == str(root / "current" / kit / "ops/bin/_executor.py"),
           "derived models.json points cli_executor into current, not the dev checkout")
    expect(genv.get("CSGATEWAY_CREDENTIALS") == credentials,
           "gateway plist: CSGATEWAY_CREDENTIALS=%s on a node (never the Keychain unless asked): %r"
           % (credentials, genv.get("CSGATEWAY_CREDENTIALS")))
    env = node["EnvironmentVariables"]
    expect(env["PATH"].split(":")[0] == str(root / "current" / kit / ".venv/bin") and "/opt/homebrew/bin" in env["PATH"].split(":"),
           "node plist PATH starts with the release's pinned interpreter, then Homebrew")
    expect(node["ProgramArguments"][0] == str(root / "current" / kit / ".venv/bin/python3")
           and node["ProgramArguments"][1] == str(root / "current" / kit / "ops/bin/tick"),
           "node plist runs tick with the release's interpreter by absolute path")
    expect({k: env.get(k) for k in ("CS_CONFIG_ROOT", "CS_STATE_ROOT", "CS_WORKSPACES_ROOT", "CS_RUNNER_BIN")} ==
           {"CS_CONFIG_ROOT": str(root / "config"), "CS_STATE_ROOT": str(root / "state"),
            "CS_WORKSPACES_ROOT": str(root / "workspaces"), "CS_RUNNER_BIN": str(root / "current/bin" / runner)},
           "node plist: configured roots outside the code tree, runner %s" % runner)
    expect(env.get("CSGATEWAY_ENDPOINT") == "http://127.0.0.1:9200/v1/agent/model.call",
           "node plist names the local gateway's model-call endpoint (the runner refuses to start without it)")
    return node


def run_tick(home, node):
    """Exactly what launchd would run, with the plist's environment: an unreachable director is one quiet line."""
    env = dict(node["EnvironmentVariables"], HOME=str(home))
    r = subprocess.run(node["ProgramArguments"], cwd=node["WorkingDirectory"], env=env, capture_output=True,
                       text=True, timeout=120)
    try:
        out = json.loads(r.stdout.strip().splitlines()[-1])
    except (ValueError, IndexError):
        out = {}
    return r, out


def run_gateway(home, root):
    """The gateway plist's own command and environment (a free port, socket and credential store off): it must
    come up healthy. First fall (prod-1, 2026-11-10): the shipped models.json named the dev checkout's
    cli_executor, and the gateway exited at startup."""
    gw = plistlib.loads((home / "Library/LaunchAgents/com.contextstack.csgateway-socket.plist").read_bytes())
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        port = sock.getsockname()[1]
    overlay = {"schema": "csgateway.providers.v1", "providers": [  # dgx.json as installed: models.json names both adapters at these endpoints
        {"name": "vllm", "endpoint": "http://127.0.0.1:8000/v1", "host": "test",
         "capabilities": {"images": False, "tools": True, "streaming": False}},
        {"name": "vllm-spark2", "protocol": "openai_chat_completions", "endpoint": "http://127.0.0.1:8001/v1",
         "host": "test", "capabilities": {"images": False, "tools": True, "streaming": False}}]}
    (root / "config/gateway/providers.d/dgx.json").write_text(json.dumps(overlay))
    env = dict(gw["EnvironmentVariables"], HOME=str(home), CSGATEWAY_PORT=str(port), CSGATEWAY_SOCKET="",
               CSGATEWAY_CREDENTIALS="off")
    proc = subprocess.Popen(gw["ProgramArguments"], cwd=gw["WorkingDirectory"], env=env, stdout=subprocess.DEVNULL,
                            stderr=subprocess.PIPE, text=True)
    try:
        deadline = time.monotonic() + 30  # readiness, not what is tested: a loaded machine starts it slowly
        while time.monotonic() < deadline:
            if proc.poll() is not None:
                break
            try:
                with urllib.request.urlopen("http://127.0.0.1:%d/v1/health" % port, timeout=1) as r:
                    return r.status, ""
            except OSError:
                time.sleep(0.1)
        return None, (proc.stderr.read() if proc.poll() is not None else "no answer in 30 s")[-600:]
    finally:
        proc.terminate()
        proc.wait(10)
        (root / "config/gateway/providers.d/dgx.json").unlink()


def part_layout(tmp, uv, managed):
    home = tmp / "home"
    root = home / ".contextstack"
    bins = _bundle.fake_bins(tmp / "fakebin")
    real_gateway = CODE_ROOT.parent / "target/release/cs-gateway"  # the default gateway (the owner 2026-11-10); else the fake
    if os.access(real_gateway, os.X_OK):
        bins["cs-gateway"] = real_gateway
    _bundle.bundle(tmp / "bundle-a", uv, A, bins)
    _bundle.bundle(tmp / "bundle-b", uv, B, bins, extra={"RELEASE-B": "b\n"})
    _bundle.seed_python(home, A, managed)
    _bundle.seed_python(home, B, managed)
    director = ["--node", "test-node", "--director", "http://127.0.0.1:1", "--installation", "inst-test"]

    r, rep = node_install(home, "install", str(tmp / "bundle-a"), *director)
    if r.returncode != 0:
        return fail("install A: exit %s %s\n%s" % (r.returncode, rep, r.stderr[-2000:]))
    expect(os.readlink(root / "current") == "releases/" + A and (root / "releases" / A / ".complete").is_file(),
           "install A: current -> releases/%s" % A)
    private_roots = (root, root / "state", root / "workspaces")
    expect(all(p.is_dir() and stat.S_IMODE(p.stat().st_mode) == 0o700 for p in private_roots),
           "fresh loaded install under umask 022: install, state and workspace roots are 0700")
    expect(all((root / d).is_dir() and stat.S_IMODE((root / d).stat().st_mode) == 0o700
               for d in ("config", "logs", "config/gateway/providers.d")),
           "config/, logs/ and config/gateway/providers.d exist, 0700")
    expect(os.readlink(root / "bundles") == "bundles.noindex"
           and (root / "bundles.noindex").is_dir() and not (root / "bundles.noindex").is_symlink()
           and (root / "bundles.noindex").stat().st_mode & 0o077 == 0
           and not (root / "state/runs").is_symlink() and not (root / "state/runs.noindex").exists(),
           "new install: bundles is a symlink to bundles.noindex; state/runs stays a real directory")
    rel = root / "releases" / A
    expect(all((rel / "bin" / n).is_file() for n in _bundle.BIN_NAMES) and not any((rel / "cs" / d).exists() for d in ("ledger", "specs", "tasks"))
           and not os.path.lexists(rel / "code_root"),
           "release: bin/ holds all four binaries; cs/ has no ledger/, specs/, tasks/; no code_root entry (the link is dropped)")
    expect(not any(p.is_symlink() for p in (rel / "bin").iterdir()),
           "release: binaries have no compatibility symlinks")
    expect(not (rel / "cs-kit").exists(), "release: only cs code root")
    expect(not any((rel / "bin" / n).exists() for n in ("code_root", "cs", "cs-go", "csgateway")),
           "release: no bin/cs, bin/cs-go or bin/csgateway (the release ships cs-harness and cs-gateway)")
    expect(os.path.samefile(rel / "target/release/cs-tools", rel / "bin/cs-tools"),
           "release: target/release/cs-tools is bin/cs-tools (where descriptors resolve it)")
    spool = json.loads((root / "config/policy/spool.json").read_text())
    expect((root / "config/ESTATE").read_text() == "test-node\n" and spool["receiver"] == {
        "kind": "director", "url": "http://127.0.0.1:1", "node": "test-node", "token_env": "CONTEXTSTACK_NODE_TOKEN",
        "installation": "inst-test"},
        "config: ESTATE and a director receiver, with --installation's ID, in policy/spool.json (node protocol §2)")
    links = home / ".local/bin"
    expect({n: os.readlink(links / n) for n in ("csgateway", "cs", "node-install")} ==
           {"csgateway": str(root / "current/bin/cs-gateway"), "cs": str(root / "current/cs/scripts/cs"),
            "node-install": str(root / "current/cs/scripts/node-install")} and not os.path.lexists(links / "code_root"),
           "PATH links in ~/.local/bin (on the login PATH) point through current; cs is the Rust runner; no code_root link")
    node = check_plists(home, root)
    listen = plistlib.loads((home / "Library/LaunchAgents/com.contextstack.node-listen.plist").read_bytes())
    expect(listen["ProgramArguments"][:1] == node["ProgramArguments"][:1]
           and listen["ProgramArguments"][1] == str(root / "current/cs/ops/bin/node-listen")
           and listen["EnvironmentVariables"] == node["EnvironmentVariables"] and listen["KeepAlive"] == {"SuccessfulExit": False},
           "node-listen plist beside the tick: same interpreter and env, node.env loaded privately, KeepAlive unless it exits 0")
    if bins["cs-gateway"] == real_gateway:
        status, err = run_gateway(home, root)
        expect(status == 200, "the gateway plist's command comes up healthy (real csgateway): %s %s" % (status, err))
    else:
        print("SKIP gateway start: target/release/cs-gateway is not built")

    def install_snapshot():
        releases = tree(root / "releases")
        lock = (root / "releases/install.lock").lstat()
        # Each invocation records its PID. Compare the lock's identity and mode.
        releases["install.lock"] = (lock.st_dev, lock.st_ino, lock.st_mode)
        return (releases, tree(home / "Library"), tree(links),
                (root / "config/install.json").read_bytes(), (root / "config/policy/spool.json").read_bytes())

    snapshot = install_snapshot()
    r, rep2 = node_install(home, "install", str(tmp / "bundle-a"), *director, "--no-load")
    after = install_snapshot()
    expect(r.returncode == 0 and after == snapshot and not any(p["changed"] for p in rep2["plists"].values()),
           "install A again: idempotent (releases, plists, links and config unchanged)")
    expect(os.readlink(root / "bundles") == "bundles.noindex" and not (root / "state/runs").is_symlink(),
           "install A again leaves the bundles .noindex symlink in place and state/runs real")

    code_before = tree(rel)
    r, out = run_tick(home, node)
    expect(r.returncode == 0 and "error" in out.get("job_pull", {}) and r.stderr.strip() == "",
           "tick with the plist's env, director down: exit 0, one line, job_pull error, empty stderr: %s %s"
           % (out.get("job_pull"), r.stderr[-300:]))
    expect(tree(rel) == code_before, "tick wrote nothing into the code tree")
    expect((root / "state/dispatch.jsonl").is_file(), "tick wrote its shelf under state/")

    for path in private_roots:
        path.chmod(0o755)
    r, rep = node_install(home, "install", str(tmp / "bundle-b"), "--no-load")
    expect(r.returncode == 0 and os.readlink(root / "current") == "releases/" + B and (root / "releases" / A).is_dir()
           and rep.get("previous") == A, "install B: current -> B, A kept")
    expect(all(stat.S_IMODE(p.stat().st_mode) == 0o700 for p in private_roots),
           "upgrade repairs 0755 install, state and workspace roots")
    kept = json.loads((root / "config/policy/spool.json").read_text())["receiver"]
    expect(kept["node"] == "test-node" and kept.get("installation") == "inst-test",
           "install B without options keeps the recorded node, director and installation")
    r, rep = node_install(home, "rollback", "--no-load")
    expect(r.returncode == 0 and os.readlink(root / "current") == "releases/" + A, "rollback: current -> A")
    r, rep = node_install(home, "switch", B, "--no-load")
    expect(r.returncode == 0 and os.readlink(root / "current") == "releases/" + B, "switch B: current -> B")
    r, rep = node_install(home, "switch", "20990103-nothere", "--no-load")
    expect(r.returncode == 1 and os.readlink(root / "current") == "releases/" + B and "not installed" in rep.get("refused", ""),
           "switch to a release that is not installed: refused, current unchanged")

    def running_row(job_id, pid):
        return {"ts": "2026-11-11T00:00:00Z", "id": job_id, "job": job_id, "director_job": job_id,
                "spec": "specs/fx.yaml", "state": "running", "pid": pid, "origin": "dispatch"}

    def write_dispatch(*rows):
        (root / "state/dispatch.jsonl").write_text("".join(json.dumps(row) + "\n" for row in rows))

    env = _bundle.dead_network_env(home, NODE_INSTALL_USER_PATH="%s/.local/bin:/usr/bin:/bin" % home)
    sleeper = subprocess.Popen(["/bin/sh", "-c", "sleep 30"])
    try:
        write_dispatch(running_row("job-wait", sleeper.pid))
        proc = subprocess.Popen(["sh", str(INSTALL), "switch", A, "--wait", "5"],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=env, cwd=str(CODE_ROOT.parent))
        time.sleep(1)
        sleeper.terminate()
        sleeper.wait(5)
        out, err = proc.communicate(timeout=30)
        rep = _bundle.report(out)
        expect(proc.returncode == 0 and os.readlink(root / "current") == "releases/" + A
               and "waiting for active jobs" in err and (rep.get("drain") or {}).get("waited_s", 0) >= 1,
               "switch waits for active jobs and proceeds when they drain",
               {"rc": proc.returncode, "stderr": err[-300:], "drain": rep.get("drain")})
    finally:
        if sleeper.poll() is None:
            sleeper.kill()
            sleeper.wait(5)

    sleeper = subprocess.Popen(["/bin/sh", "-c", "sleep 30"])
    try:
        write_dispatch(running_row("job-nowait", sleeper.pid))
        r, rep = node_install(home, "switch", B, "--no-wait")
        reason = rep.get("reason") if isinstance(rep, dict) else {}
        expect(r.returncode == 2 and os.readlink(root / "current") == "releases/" + A
               and isinstance(reason, dict) and reason.get("code") == "active_jobs"
               and any(j.get("job_id") == "job-nowait" for j in reason.get("active") or []),
               "--no-wait refuses with exit 2 and a JSON reason when jobs are active",
               {"rc": r.returncode, "reason": reason})
    finally:
        if sleeper.poll() is None:
            sleeper.kill()
            sleeper.wait(5)

    sleeper = subprocess.Popen(["/bin/sh", "-c", "sleep 30"])
    try:
        write_dispatch(running_row("job-force", sleeper.pid))
        r, rep = node_install(home, "switch", B, "--force")
        expect(r.returncode == 0 and os.readlink(root / "current") == "releases/" + B
               and (rep.get("drain") or {}).get("forced") is True,
               "--force switches despite active jobs", {"rc": r.returncode, "drain": rep.get("drain")})
    finally:
        if sleeper.poll() is None:
            sleeper.kill()
            sleeper.wait(5)

    write_dispatch(running_row("job-orphan", 999999))
    listen = plistlib.loads((home / "Library/LaunchAgents/com.contextstack.node-listen.plist").read_bytes())
    token_env = json.loads((root / "config/install.json").read_text()).get("token_env", "CONTEXTSTACK_NODE_TOKEN")
    (root / "config/node.env").write_text("export %s=fixture-node-token\n" % token_env)
    (root / "config/node.env").chmod(0o600)
    listen_env = dict(listen["EnvironmentVariables"], HOME=str(home))
    r = subprocess.run(listen["ProgramArguments"], input='{"seconds": 2, "dispatch": false}', text=True,
                       capture_output=True, env=listen_env, cwd=listen["WorkingDirectory"], timeout=30)
    rows = [json.loads(line) for line in (root / "state/dispatch.jsonl").read_text().splitlines() if line.strip()]
    orphan = [row for row in rows if row.get("id") == "job-orphan" and row.get("state") == "error"]
    expect(r.returncode == 0 and len(orphan) == 1 and orphan[0].get("reason") == "node restarted while the job ran",
           "node-listen start closes orphaned jobs with the restart reason",
           {"rc": r.returncode, "reason": (orphan[0].get("reason") if orphan else None), "stderr": r.stderr[-200:]})

    plists_before = tree(home / "Library")
    r, rep = node_install(home, "select", "--runner", "go", "--no-load")
    expect(r.returncode == 1 and "has no bin/cs-go" in rep.get("refused", "") and "earlier release" in rep.get("refused", "")
           and os.readlink(links / "cs") == str(root / "current/cs/scripts/cs") and tree(home / "Library") == plists_before
           and os.readlink(root / "current") == "releases/" + B,
           "select --runner go on a release without bin/cs-go: refused clearly, nothing changed: %s" % rep.get("refused"))
    r, rep = node_install(home, "select", "--gateway", "go", "--no-load")
    expect(r.returncode == 1 and "has no bin/csgateway" in rep.get("refused", "") and "earlier release" in rep.get("refused", "")
           and os.readlink(links / "csgateway") == str(root / "current/bin/cs-gateway") and tree(home / "Library") == plists_before
           and os.readlink(root / "current") == "releases/" + B,
           "select --gateway go on a release without bin/csgateway: refused clearly, nothing changed: %s" % rep.get("refused"))
    # An earlier release still carries the Go runner and gateway: a Go rollback is a switch to it (stand-ins in A).
    for name in ("cs-go", "csgateway"):
        (root / "releases" / A / "bin" / name).write_text("#!/bin/sh\necho %s \"$@\"\n" % name)
        (root / "releases" / A / "bin" / name).chmod(0o755)
    r, rep = node_install(home, "switch", A, "--no-load")
    r, rep = node_install(home, "select", "--gateway", "go", "--runner", "go", "--no-load")
    expect(r.returncode == 0 and os.readlink(links / "csgateway") == str(root / "current/bin/csgateway")
           and os.readlink(links / "cs") == str(root / "current/cs/scripts/cs")
           and os.readlink(root / "current") == "releases/" + A,
           "select --gateway go --runner go on a release that has both: csgateway and cs links follow")
    check_plists(home, root, runner="cs-go", gateway="csgateway")
    r, rep = node_install(home, "rollback", "--no-load")
    expect(r.returncode == 1 and "has no bin/cs-go" in rep.get("refused", "") and os.readlink(root / "current") == "releases/" + A,
           "rollback to a release without cs-go while Go is selected: refused, current unchanged")
    check_plists(home, root, runner="cs-go", gateway="csgateway")  # the selection is recorded, not per release
    r, rep = node_install(home, "select", "--runner", "rust", "--no-load")
    expect(r.returncode == 0 and os.readlink(links / "csgateway") == str(root / "current/bin/csgateway"),
           "select --runner rust on the earlier release keeps the Go gateway: %s" % rep.get("refused"))
    r, rep = node_install(home, "rollback", "--no-load")
    expect(r.returncode == 1 and "has no bin/csgateway" in rep.get("refused", "") and os.readlink(root / "current") == "releases/" + A,
           "rollback to a release without the Go gateway while it is selected: refused, current unchanged")
    r, rep = node_install(home, "select", "--gateway", "rust", "--runner", "rust", "--credentials", "file", "--no-load")
    check_plists(home, root, credentials=str(root / "credentials"))
    expect(json.loads((root / "config/install.json").read_text()).get("credentials") == "file",
           "the credential choice is recorded in config/install.json")
    r, rep = node_install(home, "select", "--credentials", "keychain", "--no-load")
    check_plists(home, root, credentials="keychain")  # explicit opt-in only, written as such (never left unset)
    r, rep = node_install(home, "select", "--credentials", "off", "--no-load")
    check_plists(home, root)
    env = _bundle.dead_network_env(home, NODE_INSTALL_USER_PATH="%s/.local/bin:/usr/bin:/bin" % home, PATH="/usr/bin:/bin")
    r = subprocess.run(["sh", str(INSTALL), "select", "--credentials", "off"], capture_output=True, text=True, env=env, cwd=str(CODE_ROOT.parent))
    expect(r.returncode == 1 and "refusing the real launchctl" in _bundle.report(r.stdout).get("refused", ""),
           "without --no-load and without a shim, a fake HOME never reaches the real launchctl: %s" % r.stdout[-200:])

    r, rep = node_install(home, "install", str(tmp / "bundle-a"), "--node", "other", "--no-load")
    expect(r.returncode == 1 and "keeps its name" in rep.get("refused", "")
           and (root / "config/ESTATE").read_text() == "test-node\n", "a different --node is refused, ESTATE kept")

    r, rep = node_install(home, "uninstall", "--no-load")
    expect(r.returncode == 0 and not os.path.lexists(root / "current") and not (root / "releases").exists()
           and not any(os.path.lexists(links / n) for n in ("csgateway", "cs", "node-install", "code_root"))
           and not any((home / "Library/LaunchAgents").iterdir()),
