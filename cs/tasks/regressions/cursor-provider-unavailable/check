def make_spec(path, task, hypothesis, stuck):
    if stuck is None:
        budget = "{turns: 80, tool_calls: 20, usd: 0.25, seconds: 120}"
    elif stuck == "off":
        budget = "{turns: 80, tool_calls: 20, usd: 0.25, seconds: 120, stuck: off}"
    else:
        budget = "{turns: 80, tool_calls: 20, usd: 0.25, seconds: 120, stuck: {repeat: %d, idle_turns: 40}}" % int(stuck)
    path.write_text(
        "\n".join((
            "id: fixture-" + path.stem,
            "model: fake-cursor",
            "system: prompts/system.md",
            "context: []",
            "tools: []",
            "mcp: []",
            "budget: " + budget,
            "check_window: %d" % max(5, int(5 * float(os.environ.get("CHECK_TIMEOUT_SCALE", "1")))),  # harness wait
            "tasks: [tasks/%s]" % task,
            "trials: 1",
            "hypothesis: %s" % json.dumps(hypothesis),
            "",
        )),
        encoding="utf-8",
    )


def run_case(code_root, mode, task, spec):
    (code_root / "mode.txt").write_text(mode + "\n", encoding="utf-8")
    payload = {
        "executor": "fake-cursor",
        "task": "tasks/%s" % task,
        "spec": "specs/%s.yaml" % spec,
        "exp": "task-stuck",
        "trial": 1,
        "timeout_s": 120,
    }
    started = time.monotonic()
    done = subprocess.run(
        cli_command(sys.executable, code_root / "ops/bin/_executor.py"),
        cwd=code_root,
        input=json.dumps(payload),
        text=True,
        capture_output=True,
        timeout=40,
        env={**hermetic_env(), "HOME": str(code_root / "home"), "GIT_CONFIG_GLOBAL": str(code_root / "home/.gitconfig"), "CS_TOOLS_BIN": os.environ.get("CS_TOOLS_BIN", str(CODE_ROOT.parent / "target/release/cs-tools"))},
    )
    assert done.stdout.strip(), (mode, done.stderr)
    result = json.loads(done.stdout.strip().splitlines()[-1])
    run = Path("ledger/runs") / result["run_id"]
    row = json.loads((code_root / "ledger/ledger.jsonl").read_text(encoding="utf-8").splitlines()[-1])
    return done, result, row, code_root / run, round(time.monotonic() - started, 2)



sys.path.insert(0, str(OPS))
from _agent_stream import CursorAvailability
from _errors import classify_stop, row_error

FAKE = r'''#!/usr/bin/env python3
import json, sys, time
from pathlib import Path
mode = (Path(__file__).parent / "code_root/mode.txt").read_text().strip()
def emit(v):
    v["session_id"] = "fixture"
    print(json.dumps(v), flush=True)
def cycle():
    for kind, sub in (("connection", "reconnecting"), ("retry", "starting"),
                      ("retry", "resuming"), ("connection", "reconnected")):
        emit({"type": kind, "subtype": sub, "attempt": 3})
if mode == "forever":
    while True:
        cycle()
        time.sleep(.1)
elif mode == "exit":
    cycle()
    print("RetriableError: [unavailable] Error", file=sys.stderr)
    sys.exit(1)
else:
    for block in ({"type": "text", "text": "working"},
                  {"type": "tool_use", "id": "t", "name": "Bash", "input": {}}):
        cycle()
        cycle()
        emit({"type": "assistant", "message": {"content": [block]}})
    cycle()
    cycle()
    emit({"type": "result", "result": "done", "is_error": False})
'''

# One reconnect followed by a long quiet think is healthy: the time branch needs repeated churn.
now = [0]
monitor = CursorAvailability(clock=lambda: now[0])
assert monitor.feed(b'{"type":"connection","subtype":"reconnecting"}') is None
now[0] = 300
assert monitor.poll() is None
# Three reconnects with no progress for 120 s is an outage, even below the count threshold.
now = [0]
monitor = CursorAvailability(clock=lambda: now[0])
for _ in range(3):
    assert monitor.feed(b'{"type":"connection","subtype":"reconnecting"}') is None
now[0] = 120
assert monitor.poll()["stop"] == "provider_unavailable"
assert classify_stop("provider_unavailable")["retryable"] is True

with scratch_dir(prefix="cursor-provider-unavailable-") as raw:
    root = Path(raw)
    code_root = root / "code_root"
    ops = code_root / "ops/bin"
    for path in (ops, code_root / "tasks/work", code_root / "specs", code_root / "prompts",
                 code_root / "home/Library/Keychains", code_root / "ledger"):
        path.mkdir(parents=True, exist_ok=True)
    for name in FILES:
        shutil.copy2(OPS / name, ops / name)
    from native_runtime import stage_native_runtime
    stage_native_runtime(ops)
    (code_root / "home/.gitconfig").write_text("[user]\n name = Fixture\n email = fixture@example.invalid\n")
    binary = root / "cursor-agent"
    binary.write_text(FAKE)
    binary.chmod(0o755)
    (ops / "executor-templates.json").write_text(json.dumps({"fake-cursor": {
        "binary": str(binary), "args": ["{{prompt}}"], "cost_class": "subscription",
        "cost_usd": 0, "cost_per_1k": .01, "auth": "subscription"}}))
    (code_root / "ESTATE").write_text("dev\n")
    (code_root / "prompts/system.md").write_text("Fixture\n")
    (code_root / "tasks/work/goal.md").write_text("Do work\n")
    (code_root / "tasks/work/check").write_text("#!/bin/sh\nexit 0\n")
    (code_root / "tasks/work/check").chmod(0o755)
    make_spec(code_root / "specs/work.yaml", "work", "fixture cursor unavailability", "off")
    for mode in ("forever", "exit", "healthy"):
        done, result, row, run_dir, seconds = run_case(code_root, mode, "work", "work")
        assert seconds < 15, (mode, seconds)
        if mode == "healthy":
            assert done.returncode == 0 and row["stop"] == "done", (result, done.stderr)
        else:
            assert done.returncode == 1 and row["verdict"] == "fail", (result, done.stderr)
            assert row["stop"] == "provider_unavailable", row
            assert "quota may be used up" in row["reason"] and "try another model" in row["reason"], row
            assert row_error(row)["retryable"] is True, row
print("check: Cursor reconnect guard, unavailable exit, and progress resets")
