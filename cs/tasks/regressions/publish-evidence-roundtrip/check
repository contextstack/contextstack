#!/usr/bin/env python3
"""Writer archives the live walk; reconstruct matches each missed class."""
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))  # frozen copies too
from scratch import scratch_dir
from hermetic_env import hermetic_env

# Directly imported estate helpers must see the same isolated roots as children.
_fixture_env = hermetic_env()
os.environ.clear()
os.environ.update(_fixture_env)

CODE_ROOT = Path(__file__).resolve().parents[3]
CAPTURE = CODE_ROOT / "ops/bin/capture-stimulus"
PUBLISH = CODE_ROOT / "ops/bin/publish-evidence"
CANARY = "ENV_SECRET_CANARY_1900_9f3a"
loader = importlib.machinery.SourceFileLoader("prune_ws", str(CODE_ROOT / "ops/bin/prune-workspaces"))
prune = importlib.util.module_from_spec(importlib.util.spec_from_loader("prune_ws", loader))
loader.exec_module(prune)


def op(binary, payload):
    result = subprocess.run([str(binary)], input=json.dumps(payload), text=True,
                            capture_output=True, cwd=str(CODE_ROOT), env={**hermetic_env()})
    if result.returncode:
        raise SystemExit("check: %s failed: %s" % (binary.name, (result.stderr or result.stdout)[:400]))
    return json.loads(result.stdout.strip().splitlines()[-1])


def git(cwd, *args):
    return subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True, check=True, env={**hermetic_env()})


with scratch_dir(prefix="publish-roundtrip-") as raw:
    root = Path(raw)
    task = root / "tasks/work/demo"
    task.mkdir(parents=True)
    (task / "goal.md").write_text("roundtrip\n")
    check = task / "check"
    check.write_text("#!/bin/sh\nexit 0\n")
    check.chmod(0o755)
    run_dir = root / "ledger/runs/run-rt"
    ws = run_dir / "workspace"
    ws.mkdir(parents=True)
    git(ws, "init", "-q", "-b", "main")
    git(ws, "config", "user.email", "fixture@example.test")
    git(ws, "config", "user.name", "Fixture")
    (ws / "tracked.txt").write_text("base\n")
    (ws / ".gitignore").write_text("ignored.txt\n.env\ncookies.json\n*.sqlite\ncache/\n")
    git(ws, "add", "-A")
    git(ws, "commit", "-qm", "base")
    op(CAPTURE, {"run_dir": str(run_dir), "task": str(task), "run_id": "run-rt",
                 "adapter": "fixture", "workspace": str(ws)})
    # Classes the 09-17 autopsy named: untracked, ignored, executable, symlink.
    (ws / "untracked.txt").write_text("untracked\n")
    (ws / "ignored.txt").write_text("secret\n")
    (ws / ".env").write_text("APP_KEY=%s\n" % CANARY)
    (ws / "cookies.json").write_text('{"sid":"%s"}\n' % CANARY)
    (ws / "database.sqlite").write_bytes(b"SQLite format 3\x00" + CANARY.encode() + b"\n")
    (ws / "cache").mkdir()
    (ws / "cache" / "session").write_text(CANARY + "\n")
    exe = ws / "tool.sh"
    exe.write_text("#!/bin/sh\necho ok\n")
    exe.chmod(0o755)
    git(ws, "add", "tool.sh")
    (ws / "link-to-tracked").symlink_to("tracked.txt")
    # Stale git diff, then a post-diff write the archive must still capture.
    stale = git(ws, "diff", "--binary", "HEAD")
    (ws / "after-diff.txt").write_text("written after git diff\n")
    assert "after-diff" not in stale.stdout
    published = op(PUBLISH, {"run_dir": str(run_dir), "verdict": "usable",
                             "stop": "done", "check_exit": 0})
    assert published.get("ok"), published
    rebuilt = prune.reconstruct_evidence(run_dir, ws, git(ws, "rev-parse", "HEAD").stdout.strip())
    live = prune.tree_hash(ws)
    assert rebuilt == live, "reconstruct missed a live-walk class"
    needle = CANARY.encode()
    for path in (run_dir / "evidence").rglob("*"):
        if path.is_file() and needle in path.read_bytes():
            raise AssertionError("canary leaked into " + path.name)
    from _lifecycle_evidence import inspection_workspace
    evidence = json.loads((run_dir / "evidence/manifest.json").read_text())
    with inspection_workspace(run_dir, evidence) as frozen:
        assert (frozen / "untracked.txt").read_text() == "untracked\n"
        assert (frozen / "ignored.txt").read_text() == "secret\n"
        assert (frozen / "after-diff.txt").read_text() == "written after git diff\n"
        assert (frozen / "link-to-tracked").is_symlink()
        assert os.readlink(frozen / "link-to-tracked") == "tracked.txt"
        assert (frozen / "tool.sh").stat().st_mode & 0o111
        assert not (frozen / ".env").exists()
        assert not (frozen / "cookies.json").exists()
        assert not (frozen / "database.sqlite").exists()
        assert not (frozen / "cache" / "session").exists()

print("check: publish-evidence archives the live walk and keeps .env/sqlite/cookie/cache out of evidence")
