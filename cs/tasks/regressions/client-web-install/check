           "state/client-web created 0700 with Laravel's storage dirs")
    return key


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


class StandIn(http.server.BaseHTTPRequestHandler):
    """A Director that answers the Client API only with the local credential."""
    seen = []

    def do_GET(self):
        auth = self.headers.get("Authorization") or ""
        StandIn.seen.append((self.path, auth == "Bearer " + LOCAL_SECRET))
        if auth != "Bearer " + LOCAL_SECRET:
            body, code = {"error": "unauthenticated"}, 401
        elif self.path.startswith("/api/v1/client/intents"):
            body, code = {"intents": [], "jobs": []}, 200
        else:
            body, code = {}, 200
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, *args):
        pass


def get(url):
    try:
        with urllib.request.urlopen(url, timeout=10) as r:
            return r.status, r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode("utf-8", "replace")
    except OSError:
        return 0, ""


def part_run(home, root, p, php):
    """The plist's own command, its port changed, against a stand-in Director: /intents is 200 with the local credential."""
    envf = root / "config/client-web/client-web.env"
    saved = envf.read_bytes()
    director = http.server.ThreadingHTTPServer(("127.0.0.1", 0), StandIn)
    threading.Thread(target=director.serve_forever, daemon=True).start()
    envf.write_text(re.sub(r"(?m)^DIRECTOR_URL=.*$", "DIRECTOR_URL=http://127.0.0.1:%d" % director.server_port, saved.decode()))
    cred = root / "state/director/local-credential"
    cred.write_text(LOCAL_SECRET + "\n")
    cred.chmod(0o600)
    port = free_port()
    args = [a if a != LISTEN else "127.0.0.1:%d" % port for a in p["ProgramArguments"]]
    proc = subprocess.Popen(args, cwd=p["WorkingDirectory"], env=dict(p["EnvironmentVariables"], HOME=str(home)),
                            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True, start_new_session=True)
    try:
        code = 0
        for _ in range(100):
            code, _ = get("http://127.0.0.1:%d/up" % port)
            if code or proc.poll() is not None:
                break
            time.sleep(0.1)
        code, body = get("http://127.0.0.1:%d/intents" % port)
    finally:
        try:
            os.killpg(proc.pid, signal.SIGTERM)  # the server and its workers
        except ProcessLookupError:
            pass
        proc.wait(10)
        director.shutdown()
        director.server_close()
        envf.write_bytes(saved)
        envf.chmod(0o600)
    err = proc.stderr.read()[-600:]
    expect(code == 200 and any(path.split("?")[0] == "/api/v1/client/intents" and ok for path, ok in StandIn.seen),
           "the plist's command serves /intents (200) from the Director with the local credential: %s %s %s"
           % (code, StandIn.seen[:3], err if code != 200 else ""))
    expect(LOCAL_SECRET not in body and any((root / "state/client-web/framework/sessions").iterdir())
           and not (root / "current/client-web/storage").exists(),
           "its session is in state/client-web, nothing in the release; the page never shows the credential")


