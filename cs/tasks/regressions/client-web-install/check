    expect(not [a for a in agents if "schedule" in a or "queue" in a or a.startswith("com.contextstack.director.")] and not dbs,
           "one client-web agent: no schedule or queue agent, no Laravel director, no database: %s %s" % (agents, dbs))
    return p


def env_differences(root, text):
    values = dict(re.findall(r"(?m)^([A-Z][A-Z0-9_]*)=(.*)$", text))
    expected = {"DIRECTOR_URL": "http://127.0.0.1:8780",
                "DIRECTOR_LOCAL_CREDENTIAL": str(root / "state/director/local-credential"),
                "LARAVEL_STORAGE_PATH": str(root / "state/client-web"), "APP_URL": "http://" + LISTEN,
                "SESSION_DRIVER": "file", "CACHE_STORE": "file", "QUEUE_CONNECTION": "sync"}
    # Name differing fields only: even a malformed env must never expose a key or credential value.
    differences = [k + (" missing" if k not in values else " differs")
                   for k, want in expected.items() if values.get(k) != want]
    differences += ["unexpected " + k for k in values if k.startswith("DB_")]
    # ROOT paths can legitimately contain '__' (including tempfile's random suffix).
    if re.search(r"__[A-Z][A-Z0-9_]*__", text):
        differences.append("unresolved template placeholder")
    return differences


def part_env_differences():
    root = Path("/tmp/client-web-install-e7gj__1z/home/.contextstack")
    fields = {"DIRECTOR_URL": "http://127.0.0.1:8780",
              "DIRECTOR_LOCAL_CREDENTIAL": str(root / "state/director/local-credential"),
              "LARAVEL_STORAGE_PATH": str(root / "state/client-web"), "APP_URL": "http://" + LISTEN,
              "SESSION_DRIVER": "file", "CACHE_STORE": "file", "QUEUE_CONNECTION": "sync"}
    render = lambda fields: "\n".join(k + "=" + v for k, v in fields.items())
    assert env_differences(root, render(fields)) == []
    for k in fields:
        assert k + " differs" in env_differences(root, render({**fields, k: LOCAL_SECRET}))
        assert k + " missing" in env_differences(root, render({n: v for n, v in fields.items() if n != k}))
    for token in ("__ROOT__", "__URL__", "__DIRECTOR_URL__"):
        assert "unresolved template placeholder" in env_differences(root, render(fields) + "\nOTHER=" + token)
    differences = env_differences(root, render({**fields, "APP_KEY": LOCAL_SECRET, "DB_PASSWORD": LOCAL_SECRET}))
    assert differences == ["unexpected DB_PASSWORD"] and LOCAL_SECRET not in str(differences)
    print("ok   env comparison: double underscores in paths, differing/missing fields, placeholders and secret-safe diagnostics")


