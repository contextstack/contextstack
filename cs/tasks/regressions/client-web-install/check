def node_install(home, *args, user_path="/usr/bin:/bin", **env_more):
    """The fake HOME's ~/.local/bin always leads the login-shell PATH, so links never fall back to /opt/homebrew/bin."""
    env = _bundle.dead_network_env(home, NODE_INSTALL_USER_PATH="%s/.local/bin:%s" % (home, user_path), **env_more)
    r = subprocess.run(["sh", str(INSTALL), *args], capture_output=True, text=True, env=env, cwd="/")
    return r, _bundle.report(r.stdout)


def tree(root):
    out = {}
    for p in sorted(root.rglob("*")) if root.exists() else []:
        st = p.lstat()
        out[str(p.relative_to(root))] = os.readlink(p) if p.is_symlink() else (st.st_size, st.st_mtime_ns, st.st_mode)
    return out


def fake_php(where, version):
    where.mkdir(parents=True, exist_ok=True)
    (where / "php").write_text('#!/bin/sh\n[ "$1" = -r ] && { printf %d; exit 0; }\nexec sleep 30\n' % version)
    (where / "php").chmod(0o755)
    return where / "php"


def real_php():
    """(php, the checkout's client-web) when php >= 8.3 and the checkout has its built vendor/ and public/build/."""
    nb = _bundle.node_bundle()
    src = CODE_ROOT.parent / nb.CLIENT_WEB_SRC
    php = shutil.which("php")
    if not php or not (src / "vendor/autoload.php").is_file() or not (src / "public/build/manifest.json").is_file():
        return None, "no php, or %s has no vendor/ and public/build/ (composer install; npm ci && npm run build)" % src
    got = subprocess.run([php, "-r", "echo PHP_VERSION_ID;"], capture_output=True, text=True).stdout.strip()
    return (php, src) if got.isdigit() and int(got) >= 80300 else (None, "php %s is older than 8.3" % got)


def stand_in_build(src, php):
    """CLIENT_WEB_BUILD for a network-free test: the checkout's built trees (cloned) and one real boot, or placeholders."""
    py = sys.executable
    if php:
        clone = ["cp", "-cR"] if sys.platform == "darwin" else ["cp", "-R"]
        return ([*clone, str(src / "vendor"), "vendor"], ["mkdir", "-p", "public"],
                [*clone, str(src / "public/build"), "public/build"],
                [php, "artisan", "package:discover", "--no-interaction"], [php, "artisan", "list", "--no-interaction"])
    write = ("import pathlib,sys\nfor p in sys.argv[1:]:\n    pathlib.Path(p).parent.mkdir(parents=True, exist_ok=True)\n"
             "    pathlib.Path(p).write_text('<?php return [];\\n')")
    return ([py, "-c", write, "vendor/autoload.php", ROUTER, "public/build/manifest.json",
             "bootstrap/cache/packages.php", "bootstrap/cache/services.php"],)


