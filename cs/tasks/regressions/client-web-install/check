           and not (root / "config").exists(), "uninstall --purge: the plist and config/ go; state/client-web stays: %s"
           % rep.get("refused"))


def cs_cli():
    loader = importlib.machinery.SourceFileLoader("cs_cli_check", str(HERE.parent / "cs-cli/check"))
    mod = importlib.util.module_from_spec(importlib.util.spec_from_loader("cs_cli_check", loader))
    loader.exec_module(mod)
    return mod


def part_cs(home, shim, root, key):
    mod = cs_cli()
    mod.write_shims(shim)
    (shim / "http.json").write_text(json.dumps([[":8781/up", [200, "ok"]], [":8780/api/v1/client/me", [401, {"error": "no"}]]]))
    (root / "logs/client-web.err.log").write_text("boot APP_KEY=%s\nworker 2 ready\n" % key)
    envf, storage = root / "config/client-web/client-web.env", root / "state/client-web"

    def cs(*args):
        env = _bundle.dead_network_env(home, PATH="%s:%s" % (shim / "bin", os.environ.get("PATH", "/usr/bin:/bin")))
        env.pop("CS_PLATFORM", None)
        r = subprocess.run([str(root / "current/cs/scripts/cs"), *args], capture_output=True, text=True, env=env,
                           cwd="/", timeout=120)
        out = r.stdout + r.stderr
        expect(key not in out and key[7:] not in out and LOCAL_SECRET not in out, "cs %s prints no APP_KEY or credential" % " ".join(args))
        return r

    r = cs("start", "client-web")
    calls = (shim / "calls.log").read_text() if (shim / "calls.log").exists() else ""
    expect(r.returncode == 0 and "launchctl bootstrap" in calls and str(home / "Library/LaunchAgents" / (LABEL + ".plist")) in calls
           and "now up" in r.stdout, "cs start client-web: bootstraps com.contextstack.client-web: %r" % r.stdout[-300:])
    r = cs("status", "--json")
    try:
        d = json.loads(r.stdout)
    except ValueError:
        return fail("cs status --json: %r %r" % (r.stdout[-400:], r.stderr[-400:]))
    cw = d.get("client_web") or {}
    expect(cw == {"url": "http://" + LISTEN, "answers": True, "http": 200, "director": "http://127.0.0.1:8780",
                  "env_file": str(envf), "storage": str(storage), "modes": {"env_file": "600", "storage": "700"}},
           "cs status --json: client-web's URL, answer, Director, env file and storage modes: %s" % cw)
    expect([v["up"] for v in d["services"].get("client-web", [])] == [True], "cs status: the client-web service is up")
    r = cs("status")
    line = "client-web http://%s answers HTTP 200; director http://127.0.0.1:8780; env %s, storage %s (env_file 600, storage 700)" \
        % (LISTEN, envf, storage)
    expect(line in r.stdout, "cs status: one client-web line: %r" % [l for l in r.stdout.splitlines() if "client-web" in l])
    r = cs("logs", "client-web", "-n", "5")
    expect(r.returncode == 0 and "worker 2 ready" in r.stdout and "APP_KEY=<redacted>" in r.stdout,
           "cs logs client-web: its log files, the APP_KEY redacted")
    r = cs("doctor", "--json")
    found = {f["check"]: f for f in json.loads(r.stdout or "[]")}
    expect(found.get("client-web http://" + LISTEN, {}).get("ok") is True
           and all(found.get("client-web mode %s" % n, {}).get("ok") for n in ("env file", "storage"))
           and found.get("plist paths %s" % LABEL, {}).get("ok") is True and found.get("agent PATH %s" % LABEL, {}).get("ok") is True,
           "cs doctor: client-web answers; its env file, storage and plist are fine: %s"
           % {k: v for k, v in found.items() if "client-web" in k and not v["ok"]})
    envf.chmod(0o644)
    r = cs("doctor")
    expect(r.returncode == 1 and "FAIL  client-web mode env file" in r.stdout and "chmod 600 %s" % envf in r.stdout,
           "cs doctor: an env file readable by others fails, with its fix")
    envf.chmod(0o600)
    r = cs("restart", "client-web")
    expect(r.returncode == 0 and "launchctl kickstart -k gui/%d/%s" % (os.getuid(), LABEL) in (shim / "calls.log").read_text(),
           "cs restart client-web: kickstart -k")
    r = cs("stop", "client-web")
    expect(r.returncode == 0 and "launchctl bootout gui/%d/%s" % (os.getuid(), LABEL) in (shim / "calls.log").read_text(),
           "cs stop client-web: bootout")
    (shim / "http.json").write_text("[]")
    r = cs("doctor", "--json")
    found = {f["check"]: f for f in json.loads(r.stdout or "[]")}
    f = found.get("client-web http://" + LISTEN, {})
    expect(r.returncode == 1 and f.get("ok") is False and "cs start client-web" in f.get("fix", ""),
           "cs doctor: a client-web that does not answer fails, with cs start client-web as the fix")


_SKIP = ""


def part_director_url():
    """client-web talks to the Director served here, else the one this node is registered with, else the default."""
    loader = importlib.machinery.SourceFileLoader("node_release_cw", str(CODE_ROOT / "scripts/node-release"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    expect(mod.director_url({"serve_director_rs": True, "director_rs_listen": ["127.0.0.1:8780", "192.0.2.9:8780"]})
           == "http://127.0.0.1:8780", "director_url: the Director served here, its first listen address")
    expect(mod.director_url({"director": "http://192.0.2.10:8780/"}) == "http://192.0.2.10:8780",
           "director_url: a node host's client-web talks to the Director the node is registered with")
    expect(mod.director_url({}) == "http://127.0.0.1:8780", "director_url: the default when neither is known")


def main():
    global _SKIP
    part_env_differences()
    uv, managed = _bundle.host_python()
    if uv is None:
        print("SKIP client-web-install: %s" % managed)
        return 0
    php, src = real_php()
    if php is None:
        _SKIP, src = src, None
    real = Path.home()
    watched = [real / ".local/bin", real / "Library/LaunchAgents", Path("/opt/homebrew/bin")]
    before = [_bundle.directory_snapshot(w) for w in watched]
    agents = _bundle.real_agents()
    part_director_url()
    tmp = Path(tempfile.mkdtemp(prefix="client-web-install-__", suffix=".noindex"))
    try:
        cw_tree = part_bundle(tmp, php, src)
        if cw_tree:
            part_serve(tmp, uv, managed, cw_tree, php)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    after = [_bundle.directory_snapshot(w) for w in watched]
    expect(before == after, "the real ~/.local/bin, ~/Library/LaunchAgents and /opt/homebrew/bin are unchanged")
    leak = _bundle.launchd_untouched(agents)
    expect(not leak, leak or "the real launchd domain gained no com.contextstack.* job and restarted none")
    print("check: client-web-install %d problem(s)" % len(problems))
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
