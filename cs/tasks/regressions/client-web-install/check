def cw_bundle(tmp, name, uv, rid, tree_src, extra=None):
    out = tmp / name
    if tree_src:
        (out / "release").mkdir(parents=True)
        subprocess.run(["cp", "-cR" if sys.platform == "darwin" else "-R", str(tree_src), str(out / "release/client-web")], check=True)
    bins = _bundle.fake_bins(tmp / ("fakebin-" + name))
    rs = tmp / ("fakebin-" + name) / "director-rs"  # this Mac serves the Rust Director beside client-web (C too)
    rs.write_text("#!/bin/sh\necho director-rs \"$@\"\n")
    rs.chmod(0o755)
    bins["director-rs"] = rs
    _bundle.bundle(out, uv, rid, bins, extra=extra)
    if tree_src:
        nb = _bundle.node_bundle()
        meta = json.loads((out / "bundle.json").read_text())
        meta["client_web"] = {"src": nb.CLIENT_WEB_SRC, "path": "client-web", "requires_php_id": 80300}
        nb.write_meta(out, meta)
        expect("release/client-web/public/index.php" in meta["files"] and "release/client-web/vendor/autoload.php" in meta["files"],
               "bundle %s: client-web files are listed and hashed" % rid)
    return out


