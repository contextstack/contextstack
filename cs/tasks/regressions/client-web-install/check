    env = p["EnvironmentVariables"]
    text = json.dumps(p)
    expect(p["ProgramArguments"] == want and p["WorkingDirectory"] == str(app / "public") and p.get("KeepAlive") is True
           and p.get("RunAtLoad") is True, "client-web plist: php -S %s from current/client-web/public, Laravel's router, "
           "KeepAlive: %s" % (LISTEN, p["ProgramArguments"]))
    expect(env.get("PHP_CLI_SERVER_WORKERS") == "16" and env.get("DIRECTOR_ENV_FILE") == str(root / "config/client-web/client-web.env"),
           "client-web plist: PHP_CLI_SERVER_WORKERS=16, DIRECTOR_ENV_FILE is config/client-web/client-web.env")
    expect(env.get("PATH", "").split(":")[0] == os.path.dirname(php) and "/opt/homebrew/bin" in env["PATH"].split(":")
           and "~" not in text and "$HOME" not in text and str(home / ".local/bin") not in text,
           "client-web plist: explicit PATH (php's dir first), absolute paths only, no PATH link")
