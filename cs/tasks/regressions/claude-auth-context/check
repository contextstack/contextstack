#!/usr/bin/env python3
import json
from pathlib import Path
p=Path('auth-context.json')
assert p.is_file(), 'fake CLI metadata missing'
d=json.loads(p.read_text())
assert set(d)=={'config_names','cli_path','cli_version','cli_version_exit','classification','HOME','USER','CLAUDE_CONFIG_DIR','claude_directory','claude_directory_exists','auth_profile_source_path','auth_profile_source_exists','personal_claude_config_path','personal_claude_config_exists','keychain_find_exit'}
assert d['classification']=='probe' and type(d['keychain_find_exit']) is int
assert d['auth_profile_source_path'] is None and d['auth_profile_source_exists'] is None
assert type(d['personal_claude_config_exists']) is bool
print('check: metadata-only probe, no authentication success inferred')
