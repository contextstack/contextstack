#!/usr/bin/env python3
"""estate-commit must work with lab/ as a monorepo subdirectory and as the toplevel."""
import sys
from pathlib import Path
sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))  # frozen copies too
from scratch import scratch_dir
from hermetic_env import hermetic_env

import json
import os
import subprocess
import tempfile

LAB = Path(__file__).resolve().parents[3]
# refusing live lab root as a write target: the op, its classifier and ops-cap
# are copied into temporary repositories; every commit, state, lock, dispatch
# and alert write stays inside TemporaryDirectory.
OP = LAB / "ops/bin/estate-commit"
assert OP.is_file() and os.access(OP, os.X_OK)

ENV = {**{k: v for k, v in hermetic_env().items() if not k.startswith("GIT_")},
       "GIT_AUTHOR_NAME": "Fixture", "GIT_AUTHOR_EMAIL": "fixture@example.test",
       "GIT_COMMITTER_NAME": "Fixture", "GIT_COMMITTER_EMAIL": "fixture@example.test"}


def git(cwd, *args):
    return subprocess.run(["git", *args], cwd=cwd, env=ENV, capture_output=True,
                          text=True, check=True).stdout


def rows(path):
    if not path.is_file():
        return []
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


def build(root, nested):
    """A repo at root; lab is root/lab when nested, else root itself."""
    lab = root / "lab" if nested else root
    (lab / "ops/bin").mkdir(parents=True)
    (lab / "scripts").mkdir()
    (lab / "ledger").mkdir()
    (lab / "tasks/work/sample").mkdir(parents=True)
    for rel in ("ops/bin/estate-commit", "ops/bin/_estate_io.py",
                "scripts/estate_classify.py", "scripts/ops-cap.py"):
        (lab / rel).write_bytes((LAB / rel).read_bytes())
    (lab / "ops/bin/estate-commit").chmod(0o755)
    (lab / "scripts/check").write_text("#!/bin/sh\nexit 0\n")
    (lab / "scripts/check").chmod(0o755)
    (lab / "ESTATE").write_text("dev\n")
    (lab / "ledger/ledger.jsonl").write_text('{"event":"base"}\n')
    (lab / "tasks/work/sample/notes.md").write_text("base\n")
    (lab / ".gitignore").write_text("__pycache__/\nledger/dispatch.jsonl\nledger/estate-commit-state.json\n"
                                    "ledger/estate-commit.lock\nledger/estate-commit.jsonl\n")
    if nested:
        (root / "README.md").write_text("monorepo root\n")
        (root / "other").mkdir()
        (root / "other/file.txt").write_text("not lab's business\n")
    git(root, "init", "-q", "-b", "main")
    git(root, "add", "-A", "-f", ".")
    git(root, "commit", "--no-verify", "-qm", "base")
    return lab


def run(root, lab, cwd):
    env = {**ENV, "LAB_ESTATE_ROOT": str(lab), "PYTHONDONTWRITEBYTECODE": "1"}
    result = subprocess.run([str(lab / "ops/bin/estate-commit")], input='{"force": true}',
                            text=True, capture_output=True, cwd=cwd, env=env)
    assert result.returncode == 0, (result.stdout, result.stderr)
    assert "Traceback" not in result.stderr, result.stderr
    return json.loads(result.stdout.splitlines()[-1])


def committed_files(root):
    return sorted(git(root, "show", "--name-only", "--format=", "HEAD").split())


def exercise(nested):
    with scratch_dir(prefix="estate-commit-monorepo-") as raw:
        root = Path(raw).resolve()
        lab = build(root, nested)
        prefix = "lab/" if nested else ""
        base = git(root, "rev-parse", "HEAD").strip()
        alerts = lab / "ledger/estate-commit.jsonl"
        state = lab / "ledger/estate-commit-state.json"

        # Facts: a ledger row inside lab; noise outside lab must be invisible.
        with (lab / "ledger/ledger.jsonl").open("a") as out:
            out.write('{"event":"grew"}\n')
        if nested:
            (root / "README.md").write_text("monorepo root edited\n")
            (root / "other/new.txt").write_text("untracked outside lab\n")
        receipt = run(root, lab, cwd=root)
        assert receipt.get("committed") is True and receipt.get("facts_commit"), receipt
        assert receipt.get("facts_counts") == {"ledger": 1}, receipt
        assert "refused" not in receipt, receipt
        assert git(root, "rev-parse", "HEAD").strip() != base
        assert committed_files(root) == [prefix + "ledger/ledger.jsonl"], committed_files(root)
        assert git(root, "diff", "--cached", "--name-only") == "", "something left staged"
        porcelain = set(git(root, "status", "--porcelain=v1").splitlines())
        if nested:
            assert porcelain == {" M README.md", "?? other/new.txt"}, porcelain
        else:
            assert porcelain == set(), porcelain
        assert not [r for r in rows(alerts) if r.get("event") in
                    ("estate_commit_refused", "estate_dirty_stale")], rows(alerts)
        since = json.loads(state.read_text()).get("dirty_since") or {}
        assert set(since) <= {"ledger/ledger.jsonl"}, since

        # Rules: tasks/work notes inside lab commit through ops-cap's commit-msg footer.
        (lab / "tasks/work/sample/notes.md").write_text("rules edited\n")
        receipt = run(root, lab, cwd=lab)
        assert receipt.get("committed") is True and receipt.get("rules_commit"), receipt
        assert committed_files(root) == [prefix + "tasks/work/sample/notes.md"], committed_files(root)
        assert "Ops-cap-state:" in git(root, "show", "-s", "--format=%B", "HEAD"), "ops-cap footer missing"
        if nested:
            assert " M README.md" in git(root, "status", "--porcelain=v1"), "outside edit was swept"
        assert not [r for r in rows(alerts) if r.get("reason") == "check_failed"], rows(alerts)

        # HEAD blob lookup must resolve through the prefix: truncation is still refused.
        (lab / "ledger/ledger.jsonl").write_text("")
        head = git(root, "rev-parse", "HEAD").strip()
        receipt = run(root, lab, cwd=root)
        assert receipt.get("refused") is True and receipt.get("reason") == "ledger_truncated", receipt
        assert git(root, "rev-parse", "HEAD").strip() == head
        assert [r.get("reason") for r in rows(alerts) if r.get("event") == "estate_commit_refused"] == ["ledger_truncated"], rows(alerts)


exercise(nested=True)
exercise(nested=False)
print("check: estate-commit commits lab-relative facts and rules whether lab is a monorepo subdirectory or the toplevel; paths outside lab stay untouched and unalerted")
