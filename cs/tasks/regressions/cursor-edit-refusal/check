#!/usr/bin/env python3
"""Exercise the executor with a fake Cursor stream and an isolated estate."""
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents
                           if (p / "tasks/regressions/_lib").is_dir())))
from hermetic_env import hermetic_env
from cli_execution import command as cli_command
from scratch import scratch_dir

KIT = Path(__file__).resolve().parents[3]
# The outer lane can forbid nested Seatbelt. Run the fake CLI and check directly.
EXECUTE = """
import _executor

_executor.sandbox_cmd = lambda binary, args, *rest, **kwargs: [binary, *args]
raise SystemExit(_executor.main())
"""
FAKE = """#!{python}
import json
import sys
import time
from pathlib import Path


def complete(call_id, name, path, result):
    print(json.dumps({{
        "type": "tool_call", "subtype": "completed", "call_id": call_id,
        "tool_call": {{name: {{"args": {{"path": path, "content": "fixture file contents"}}, "result": result}}}},
    }}), flush=True)


def refuse(call_id, path, name="editToolCall"):
    complete(call_id, name, path, {{
        "error": {{"message": "Write permission denied: " + path + ": Blocked by permissions configuration"}}
    }})


refuse("read", "read.txt", "readToolCall")
refuse("first", "first.txt")
refuse("first", "first.txt")
if sys.argv[1] == "refused":
    refuse("second", "second file.txt", "writeToolCall")
    time.sleep(60)
else:
    Path("edited.txt").write_text("ok")
    complete("success", "writeToolCall", "edited.txt", {{"success": {{}}}})
    refuse("second", "second file.txt", "writeToolCall")
    print(json.dumps({{"type": "result", "subtype": "success", "is_error": False, "result": "done"}}), flush=True)
"""


def run_case(root, ops, mode):
    task = root / "tasks" / mode
    task.mkdir(parents=True)
    (task / "goal.md").write_text("Fixture goal.\n")
    check = task / "check"
    check.write_text("#!/bin/sh\ntest -f edited.txt\n")
    check.chmod(0o755)
    spec = root / "specs" / (mode + ".yaml")
    spec.write_text(f"""id: {mode}
model: cursor-sol
system: prompts/system.md
context: []
tools: []
mcp: []
budget: {{turns: 80, tool_calls: 20, usd: 0.25, seconds: 90}}
check_window: 5
tasks: [tasks/{mode}]
trials: 1
hypothesis: Cursor edit refusal fixture
""")
    binary = ops / "cursor-agent"
    (ops / "executor-templates.json").write_text(json.dumps({"cursor-sol": {
        "binary": str(binary), "args": [mode, "{{prompt}}"], "cost_class": "subscription",
        "cost_usd": 0, "auth": "subscription",
    }}))
    fixture_bin = root / "bin"
    fixture_bin.mkdir(exist_ok=True)
    sandbox_exec = fixture_bin / "sandbox-exec"
    sandbox_exec.write_text('#!/bin/sh\nshift 2\nexec "$@"\n')
    sandbox_exec.chmod(0o755)
    from native_runtime import stage_native_runtime
    stage_native_runtime(ops)
    base = hermetic_env()
    env = {**base, "HOME": str(root / "home"), "PATH": str(fixture_bin) + os.pathsep + base["PATH"],
           "XDG_CONFIG_HOME": str(root / "home/.config"), "GIT_CONFIG_NOSYSTEM": "1",
           "GIT_CONFIG_GLOBAL": str(root / "home/.gitconfig"),
           "GIT_AUTHOR_NAME": "Fixture", "GIT_AUTHOR_EMAIL": "fixture@example.test",
           "GIT_COMMITTER_NAME": "Fixture", "GIT_COMMITTER_EMAIL": "fixture@example.test",
           "PYTHONDONTWRITEBYTECODE": "1", "PYTHONPATH": str(ops),
           "CS_EXECUTOR_ALLOW_UNSANDBOXED": "1",
           "CS_TOOLS_BIN": os.environ.get("CS_TOOLS_BIN", str(KIT.parent / "target/release/cs-tools"))}
    done = subprocess.run(
        cli_command(sys.executable, "-c", EXECUTE), cwd=root, env=env, text=True,
        input=json.dumps({"executor": "cursor-sol", "task": str(task), "spec": str(spec.relative_to(root)),
                          "exp": "cursor-edit-refusal", "trial": 1, "timeout_s": 90}),
        capture_output=True, timeout=30,
    )
    expected = "provider_edit_refused" if mode == "refused" else "done"
    assert done.stdout.strip() and done.returncode == (1 if mode == "refused" else 0), (mode, done.stdout, done.stderr)
    result = json.loads(done.stdout.strip().splitlines()[-1])
    assert result["stop"] == expected, result
    raw = (root / "ledger/runs" / result["run_id"] / "terminal.json").read_text()
    terminal = json.loads(raw)
    assert terminal["stop"] == expected, terminal
    assert "fixture file contents" not in raw, terminal
    if mode == "refused":
        assert terminal["refused_paths"] == ["first.txt", "second file.txt"], terminal
    else:
        assert "refused_paths" not in terminal, terminal


with scratch_dir(prefix="cursor-edit-refusal-") as raw:
    root = Path(raw).resolve() / "estate"
    ops = root / "ops/bin"
    for directory in (ops, root / "home/Library/Keychains", root / "prompts", root / "specs"):
        directory.mkdir(parents=True)
    # Keep Git discovery for the staged identity inside the temporary estate.
    subprocess.run(["git", "init", "--quiet", "--template=", str(root)], check=True,
                   env={**hermetic_env(), "HOME": str(root / "home"), "GIT_CONFIG_NOSYSTEM": "1"})
    for path in (KIT / "ops/bin").glob("_*.py"):
        shutil.copy2(path, ops / path.name)
    for name in ("capture-stimulus", "publish-evidence", "harvest", "finalize-run"):
        shutil.copy2(KIT / "ops/bin" / name, ops / name)
    (root / "home/.gitconfig").write_text("[user]\nname = Fixture\nemail = fixture@example.test\n")
    (root / "ESTATE").write_text("fixture\n")
    (root / "prompts/system.md").write_text("Fixture system prompt.\n")
    binary = ops / "cursor-agent"
    binary.write_text(FAKE.format(python=sys.executable))
    binary.chmod(0o755)
    for mode in ("refused", "recovered"):
        run_case(root, ops, mode)

print("check: Cursor edit refusals stop with paths and a successful edit lets the run continue")
