#!/usr/bin/env python3
"""cli-pins-per-machine regression (goal.md)."""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from unittest.mock import patch

sys.path.insert(0, str(next(p / "tasks/regressions/_lib" for p in Path(__file__).resolve().parents if (p / "tasks/regressions/_lib").is_dir())))
from hermetic_env import hermetic_env

SOURCE = Path(__file__).resolve().parents[3]


def fake_cli(path, version_out="fixture-v1"):
    path.write_text("#!" + sys.executable + "\nimport sys\n"
                    "if '--version' in sys.argv:\n    print(%r);sys.exit()\n" % version_out)
    path.chmod(0o755)


with tempfile.TemporaryDirectory(prefix="cli-pins-") as raw:
    root = Path(raw)
    config = root / "config"
    config.mkdir()
    code_root = root / "code_root"
    code_root = code_root / "ops/bin"
    code_root.mkdir(parents=True)
    shutil.copy2(SOURCE / "INVARIANTS.md", code_root / "INVARIANTS.md")
    for path in (SOURCE / "ops/bin").glob("_*.py"):
        shutil.copy2(path, code_root / path.name)
    for name in ("cli-profiles.json",):
        shutil.copy2(SOURCE / "ops/bin" / name, code_root / name)
    from native_runtime import stage_native_runtime
    stage_native_runtime(code_root)  # Muse/adapter profiles render through cs-sandbox with the estate's policy
    home = root / "home"
    home.mkdir()
    binary = root / "fake-opencode"
    fake_cli(binary)

    profiles = json.loads((code_root / "cli-profiles.json").read_text())
    profiles["opencode"]["binary"] = str(binary)
    profiles["opencode"].pop("sha256", None)
    profiles["opencode"].pop("version", None)
    (code_root / "cli-profiles.json").write_text(json.dumps(profiles))

    env = {**hermetic_env(), "HOME": str(home), "CS_CONFIG_ROOT": str(config), "CS_CODE_ROOT": str(code_root)}
    os.environ.update(env)
    sys.path.insert(0, str(code_root))
    from _cli_pins import changed_message, ensure_pin, load_pins, resolve_binary

    digest_v1 = hashlib.sha256(binary.read_bytes()).hexdigest()
    ensure_pin("opencode", binary, "fixture-v1", env=env)
    pin_path = config / "cli-pins.json"
    assert pin_path.is_file() and pin_path.stat().st_mode & 0o777 == 0o600
    assert not list((root / "code_root").rglob("cli-pins.json")), "pins must not live under the code root"
    assert load_pins(env)["opencode"]["sha256"] == digest_v1

    ensure_pin("opencode", binary, "fixture-v1", env=env)  # unchanged: pass

    binary.write_text(binary.read_text() + "# changed\n")
    failed = False
    try:
        ensure_pin("opencode", binary, "fixture-v2", env=env)
    except ValueError as error:
        failed = True
        assert changed_message("opencode", "fixture-v1", "fixture-v2") == str(error)
    assert failed, "changed binary must refuse"

    ensure_pin("opencode", binary, "fixture-v2", env=env, repin=True)
    assert load_pins(env)["opencode"]["sha256"] == hashlib.sha256(binary.read_bytes()).hexdigest()

    import _cli_adapter
    import _muse

    class Probe:
        returncode = 0
        stdout = "fixture-v2"
        stderr = ""
        peak_rss_bytes = 0

    ws = root / "workspace"
    ws.mkdir()
    (ws / ".cs-tmp").mkdir()
    with patch.object(_muse, "run_process", return_value=Probe()), patch.object(_muse, "require_resources"), patch.object(_cli_adapter, "stage_git", return_value={}):
        out = _cli_adapter.prepare({
            "name": "opencode", "ws": ws, "HOME": home, "HERE": code_root, "timeout": 15,
            "cost_class": "free_local", "auth": "none", "on_probe": lambda: None,
            "allowlist_env": lambda *_: {"PATH": "/usr/bin:/bin"},
            "sandbox_extra": (),
        })
    assert out[3]["version"] == "fixture-v2"

print("cli-pins-per-machine: first-use pin, unchanged pass, changed refuse, repin, prepare uses machine pin")
